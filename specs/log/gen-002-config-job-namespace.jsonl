1\t\t\tIt(\"returns false when one has nil TaskTypes and the other has a non-empty slice\", func() {\n612\t\t\t\ta := agentv1.ConfigSpec{Assignee: \"x\", Image: \"y\", Heartbeat: \"1m\", TaskType: \"claude\"}\n613\t\t\t\tb := agentv1.ConfigSpec{Assignee: \"x\", Image: \"y\", Heartbeat: \"1m\", TaskType: \"claude\",\n614\t\t\t\t\tTaskTypes: []string{\"healthcheck\"}}\n615\t\t\t\tExpect(a.Equal(b)).To(BeFalse())\n616\t\t\t})\n617\t\n618\t\t\tIt(\"returns true when both TaskTypes are nil\", func() {\n619\t\t\t\ta := agentv1.ConfigSpec{Assignee: \"x\", Image: \"y\", Heartbeat: \"1m\", TaskType: \"claude\"}\n620\t\t\t\tb := agentv1.ConfigSpec{Assignee: \"x\", Image: \"y\", Heartbeat: \"1m\", TaskType: \"claude\"}\n621\t\t\t\tExpect(a.Equal(b)).To(BeTrue())\n622\t\t\t})\n623\t\n624\t\t\tIt(\"returns true when TaskTypes are identical slices\", func() {\n625\t\t\t\ta := agentv1.ConfigSpec{Assignee: \"x\", Image: \"y\", Heartbeat: \"1m\",\n626\t\t\t\t\tTaskTypes: []string{\"pr-review\", \"healthcheck\"}}\n627\t\t\t\tb := agentv1.ConfigSpec{Assignee: \"x\", Image: \"y\", Heartbeat: \"1m\",\n628\t\t\t\t\tTaskTypes: []string{\"pr-review\", \"healthcheck\"}}\n629\t\t\t\tExpect(a.Equal(b)).To(BeTrue())\n630\t\t\t})\n631\t\t})\n632\t\n633\t\tDescribe(\"Validate - zombie knobs\", func() {\n634\t\t\tptrInt32 := func(v int32) *int32 { return &v }\n635\t\n636\t\t\tbaseSpec := func() agentv1.ConfigSpec {\n637\t\t\t\treturn agentv1.ConfigSpec{\n638\t\t\t\t\tAssignee:  \"agent\",\n639\t\t\t\t\tImage:     \"img:latest\",\n640\t\t\t\t\tHeartbeat: \"1m\",\n641\t\t\t\t\tTaskType:  \"claude\",\n642\t\t\t\t}\n643\t\t\t}\n644\t\n645\t\t\tIt(\"accepts nil zombie fields\", func() {\n646\t\t\t\tspec := baseSpec()\n647\t\t\t\tExpect(spec.Validate(ctx)).To(Succeed())\n648\t\t\t})\n649\t\n650\t\t\tIt(\"accepts valid zombie values at the floor\", func() {\n651\t\t\t\tspec := baseSpec()\n652\t\t\t\tspec.ZombieSweeperIntervalSeconds = ptrInt32(10)\n653\t\t\t\tspec.ZombieJobTimeoutSeconds = ptrInt32(30)\