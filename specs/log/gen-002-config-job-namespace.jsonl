{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-abd691ed07cf3459","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"strings\"\n9\t\n10\t\tagentv1 \"github.com/bborbe/agent-task-executor/k8s/apis/agent.benjamin-borbe.de/v1\"\n11\t)\n12\t\n13\t// appendBranchTag appends \":\"+branch to image as a tag, UNLESS image already\n14\t// carries a tag (or digest). An image is considered already-tagged when a \":\"\n15\t// appears in its final path segment — i.e. after the last \"/\". This excludes\n16\t// registry-port colons (e.g. \"reg:443/repo\" is untagged) but catches both\n17\t// \"repo:tag\" and digest refs \"repo@sha256:...\". Pinning an image to an immutable\n18\t// semver tag (e.g. \"reg/bborbe/agent-claude:v0.1.1\") therefore leaves it\n19\t// untouched instead of producing an invalid \"…:v0.1.1:dev\".\n20\tfunc appendBranchTag(image string, branch string) string {\n21\t\tif strings.LastIndex(image, \":\") > strings.LastIndex(image, \"/\") {\n22\t\t\treturn image\n23\t\t}\n24\t\treturn image + \":\" + branch\n25\t}\n26\t\n27\t// AgentConfiguration defines the container image and environment for one agent type.\n28\ttype AgentConfiguration struct {\n29\t\t// Assignee is the task frontmatter assignee value that routes to this agent.\n30\t\tAssignee string\n31\t\t// TaskType is the singular task_type value from ConfigSpec.TaskType.\n32\t\t// Deprecated in favour of TaskTypes; stays functional.\n33\t\tTaskType string\n34\t\t// TaskTypes is the list of task_type values from ConfigSpec.TaskTypes.\n35\t\t// Nil when the CRD only sets the singular TaskType field.\n36\t\tTaskTypes []string\n37\t\t// Image is the container image base name (without tag). Tag is appended at runtime from branch.\n38\t\tImage string\n39\t\t// Env holds per-agent environment variables (e.g. API keys, config).\n40\t\t// These are merged with shared env vars (TASK_CONTENT, TASK_ID, KAFKA_BROKERS, BRANCH)\n41\t\t// when spawning the K8s Job.\n42\t\tEnv map[string]string\n43\t\t// VolumeClaim is the name of an existing PVC to mount into the container.\n44\t\t// Empty means no volume mount.\n45\t\tVolumeClaim string\n46\t\t// VolumeMountPath is the container path where the PVC is mounted.\n47\t\t// Required when VolumeClaim is set.\n48\t\tVolumeMountPath string\n49\t\t// SecretName is the name of a K8s Secret to mount as envFrom on the container.\n50\t\t// Empty means no secret is mounted.\n51\t\tSecretName string\n52\t\t// Resources declares optional resource requests and limits for the agent container.\n53\t\t// Nil means \"do not set, keep the k8s builder default\".\n54\t\tResources *agentv1.AgentResources\n55\t\t// MaxConcurrentJobs caps how many Jobs this agent may run at once.\n56\t\t// 0 means unlimited.\n57\t\tMaxConcurrentJobs int\n58\t\t// PriorityClassName is the Kubernetes PriorityClass name to stamp onto spawned Job PodTemplates.\n59\t\tPriorityClassName string\n60\t\t// ImagePullSecret is the name of the K8s Secret used for image pulls.\n61\t\t// Empty uses the cluster default (typically \"docker\").\n62\t\tImagePullSecret string\n63\t\t// Trigger declares the per-agent phase and status conditions under which the executor spawns a Job.\n64\t\tTrigger *agentv1.Trigger\n65\t\t// ZombieJobTimeoutSeconds mirrors ConfigSpec.ZombieJobTimeoutSeconds. The\n66\t\t// spawner stamps this value onto Job.Spec.ActiveDeadlineSeconds; the sweeper\n67\t\t// uses it as the elapsed-time threshold. nil means \"use the default\n68\t\t// DefaultZombieJobTimeoutSeconds from the CRD types package\".\n69\t\tZombieJobTimeoutSeconds *int32\n70\t}\n71\t\n72\t// EffectiveZombieJobTimeoutSeconds returns the effective deadline in seconds:\n73\t// the configured value when non-nil, else agentv1.DefaultZombieJobTimeoutSeconds.\n74\tfunc (a AgentConfiguration) EffectiveZombieJobTimeoutSeconds() int32 {\n75\t\tif a.ZombieJobTimeoutSeconds != nil {\n76\t\t\treturn *a.ZombieJobTimeoutSeconds\n77\t\t}\n78\t\treturn agentv1.DefaultZombieJobTimeoutSeconds\n79\t}\n80\t\n81\t// AgentConfigurations is a list of agent configurations.\n82\ttype AgentConfigurations []AgentConfiguration\n83\t\n84\t// FindByAssignee returns the configuration for the given assignee name.\n85\t// Returns the config and true if found, zero value and false otherwise.\n86\tfunc (a AgentConfigurations) FindByAssignee(assignee string) (AgentConfiguration, bool) {\n87\t\tfor _, c := range a {\n88\t\t\tif c.Assignee == assignee {\n89\t\t\t\treturn c, true\n90\t\t\t}\n91\t\t}\n92\t\treturn AgentConfiguration{}, false\n93\t}\n94\t\n95\t// TaggedConfigurations returns a new AgentConfigurations with the branch appended\n96\t// to each untagged image as a tag (e.g. \"registry/image\" + \":\" + \"dev\" →\n97\t// \"registry/image:dev\"). Images that already carry a tag or digest are left as-is\n98\t// (see appendBranchTag), so semver-pinned images are not double-tagged.\n99\tfunc (a AgentConfigurations) TaggedConfigurations(branch string) AgentConfigurations {\n100\t\tresult := make(AgentConfigurations, len(a))\n101\t\tfor i, c := range a {\n102\t\t\tresult[i] = AgentConfiguration{\n103\t\t\t\tAssignee:                c.Assignee,\n104\t\t\t\tTaskType:                c.TaskType,\n105\t\t\t\tTaskTypes:               append([]string(nil), c.TaskTypes...),\n106\t\t\t\tImage:                   appendBranchTag(c.Image, branch),\n107\t\t\t\tEnv:                     c.Env,\n108\t\t\t\tVolumeClaim:             c.VolumeClaim,\n109\t\t\t\tVolumeMountPath:         c.VolumeMountPath,\n110\t\t\t\tSecretName:              c.SecretName,\n111\t\t\t\tResources:               c.Resources.DeepCopy(),\n112\t\t\t\tMaxConcurrentJobs:       c.MaxConcurrentJobs,\n113\t\t\t\tPriorityClassName:       c.PriorityClassName,\n114\t\t\t\tImagePullSecret:         c.ImagePullSecret,\n115\t\t\t\tTrigger:                 c.Trigger,\n116\t\t\t\tZombieJobTimeoutSeconds: c.ZombieJobTimeoutSeconds,\n117\t\t\t}\n118\t\t}\n119\t\treturn result\n120\t}\n121\t"}]},"parent_tool_use_id":"chatcmpl-tool-a883ed86f0a5df7d","session_id":"649c3b71-f1fd-46a9-a844-34ab62b5da5e","uuid":"f9c70a8d-4d0d-42c7-b227-31cfd00b4e8d","timestamp":"2026-09-03T17:46:32.380Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec 002"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-9bb92accc087ddf6","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage factory\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\n10\t\t\"github.com/IBM/sarama\"\n11\t\tlib \"github.com/bborbe/agent\"\n12\t\t\"github.com/bborbe/cqrs/base\"\n13\t\tcdb \"github.com/bborbe/cqrs/cdb\"\n14\t\tlibcron \"github.com/bborbe/cron\"\n15\t\tlibk8s \"github.com/bborbe/k8s\"\n16\t\tlibkafka \"github.com/bborbe/kafka\"\n17\t\t\"github.com/bborbe/log\"\n18\t\t\"github.com/bborbe/run\"\n19\t\tlibtime \"github.com/bborbe/time\"\n20\t\t\"k8s.io/client-go/kubernetes\"\n21\t\t\"k8s.io/client-go/rest\"\n22\t\t\"k8s.io/client-go/tools/cache\"\n23\t\n24\t\tpkg \"github.com/bborbe/agent-task-executor/pkg\"\n25\t\t\"github.com/bborbe/agent-task-executor/pkg/handler\"\n26\t\t\"github.com/bborbe/agent-task-executor/pkg/probe\"\n27\t\t\"github.com/bborbe/agent-task-executor/pkg/spawner\"\n28\t)\n29\t\n30\t// CreateJobWatcher creates a JobWatcher that reacts to terminal batch/v1 Job states.\n31\tfunc CreateJobWatcher(\n32\t\tkubeClient kubernetes.Interface,\n33\t\tnamespace libk8s.Namespace,\n34\t\ttaskStore *pkg.TaskStore,\n35\t\tpublisher pkg.ResultPublisher,\n36\t) pkg.JobWatcher {\n37\t\treturn pkg.NewJobWatcher(kubeClient, namespace, taskStore, publisher)\n38\t}\n39\t\n40\t// CreateZombieSweeper creates a deadline sweeper that classifies stuck tasks as\n41\t// zombies and emits failure events via the publisher. Interval and per-task\n42\t// deadline are sourced from the AgentConfig CRD knobs (see ConfigSpec). The\n43\t// sweeper receives the JobWatcher (not its lister) because the lister is\n44\t// populated only after JobWatcher.Run completes its informer cache sync; passing\n45\t// the watcher lets the sweeper resolve the lister lazily on each tick and skip\n46\t// the tick if cache sync has not yet happened (avoids a nil-deref panic at the\n47\t// first tick when service.Run starts all components concurrently).\n48\tfunc CreateZombieSweeper(\n49\t\tjobWatcher pkg.JobWatcher,\n50\t\tnamespace libk8s.Namespace,\n51\t\ttaskStore *pkg.TaskStore,\n52\t\tpublisher pkg.ResultPublisher,\n53\t\tconfigProvider pkg.EventHandlerConfig,\n54\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n55\t) pkg.ZombieSweeper {\n56\t\treturn pkg.NewZombieSweeper(\n57\t\t\tjobWatcher,\n58\t\t\tnamespace,\n59\t\t\ttaskStore,\n60\t\t\tpublisher,\n61\t\t\tconfigProvider,\n62\t\t\tcurrentDateTime,\n63\t\t)\n64\t}\n65\t\n66\t// CreateK8sConnector returns a K8sConnector wired to the given rest.Config.\n67\tfunc CreateK8sConnector(config *rest.Config) pkg.K8sConnector {\n68\t\treturn pkg.NewK8sConnector(config, pkg.DefaultCRDClientBuilder)\n69\t}\n70\t\n71\t// CreateEventHandlerConfig returns an empty in-memory event handler for Config resources.\n72\tfunc CreateEventHandlerConfig() pkg.EventHandlerConfig {\n73\t\treturn pkg.NewEventHandlerConfig()\n74\t}\n75\t\n76\t// CreateResourceEventHandlerConfig adapts an EventHandlerConfig to cache.ResourceEventHandler.\n77\tfunc CreateResourceEventHandlerConfig(\n78\t\tctx context.Context,\n79\t\thandler pkg.EventHandlerConfig,\n80\t) cache.ResourceEventHandler {\n81\t\treturn pkg.NewResourceEventHandlerConfig(ctx, handler)\n82\t}\n83\t\n84\t// CreateConfigResolver returns a ConfigResolver backed by the given store,\n85\t// scoped to the given vault so Config CRs resolve by {assignee}-{vaultName}.\n86\tfunc CreateConfigResolver(\n87\t\thandler pkg.EventHandlerConfig,\n88\t\tbranch base.Branch,\n89\t\tvaultName string,\n90\t) pkg.ConfigResolver {\n91\t\treturn pkg.NewConfigResolver(handler, branch, vaultName)\n92\t}\n93\t\n94\t// CreateConsumer wires together all components and returns a Kafka Consumer that\n95\t// reads task events and spawns K8s Jobs for qualifying tasks, along with the\n96\t// TaskEventHandler so callers can wire RunDeferredRespawnLoop.\n97\tfunc CreateConsumer(\n98\t\tsaramaClient sarama.Client,\n99\t\tbranch base.Branch,\n100\t\ttopicPrefix base.TopicPrefix,\n101\t\tkubeClient kubernetes.Interface,\n102\t\tnamespace libk8s.Namespace,\n103\t\tkafkaBrokers string,\n104\t\tresolver pkg.ConfigResolver,\n105\t\tlogSamplerFactory log.SamplerFactory,\n106\t\tcurrentDateTimeGetter libtime.CurrentDateTimeGetter,\n107\t\tresultPublisher pkg.ResultPublisher,\n108\t\ttaskStore *pkg.TaskStore,\n109\t\tjobTTLSecondsAfterFinished int32,\n110\t\tjobKafkaClientCertSecret string,\n111\t\tjobKafkaCaCertSecret string,\n112\t) (libkafka.Consumer, handler.TaskEventHandler) {\n113\t\tjobSpawner := spawner.NewJobSpawner(\n114\t\t\tkubeClient,\n115\t\t\tnamespace,\n116\t\t\tkafkaBrokers,\n117\t\t\tstring(branch),\n118\t\t\tstring(topicPrefix),\n119\t\t\tcurrentDateTimeGetter,\n120\t\t\tjobTTLSecondsAfterFinished,\n121\t\t\tjobKafkaClientCertSecret,\n122\t\t\tjobKafkaCaCertSecret,\n123\t\t)\n124\t\ttaskEventHandler := handler.NewTaskEventHandler(\n125\t\t\tjobSpawner,\n126\t\t\tbranch,\n127\t\t\tresolver,\n128\t\t\tresultPublisher,\n129\t\t\ttaskStore,\n130\t\t\tcurrentDateTimeGetter,\n131\t\t)\n132\t\ttopic := lib.TaskV1SchemaID.EventTopic(topicPrefix)\n133\t\toffsetManager := libkafka.NewSaramaOffsetManager(\n134\t\t\tsaramaClient,\n135\t\t\tlibkafka.Group(\"agent-task-executor\"),\n136\t\t\tlibkafka.OffsetOldest,\n137\t\t\tlibkafka.OffsetOldest,\n138\t\t)\n139\t\treturn libkafka.NewOffsetConsumerHighwaterMarks(\n140\t\t\tsaramaClient,\n141\t\t\ttopic,\n142\t\t\toffsetManager,\n143\t\t\ttaskEventHandler,\n144\t\t\trun.NewTrigger(),\n145\t\t\tlogSamplerFactory,\n146\t\t), taskEventHandler\n147\t}\n148\t\n149\t// CreateHealthcheckRunner creates the healthcheck runner shared between the cron path and the\n150\t// HTTP trigger path. Callers must pass the same instance to both CreateHealthcheckCron and\n151\t// the HTTP handler so probe behavior is identical regardless of invocation path.\n152\tfunc CreateHealthcheckRunner(\n153\t\tconfigProvider pkg.EventHandlerConfig,\n154\t\tsyncProducer libkafka.SyncProducer,\n155\t\ttopicPrefix base.TopicPrefix,\n156\t\tbranch base.Branch,\n157\t) probe.HealthcheckRunner {\n158\t\tsender := cdb.NewCommandObjectSender(syncProducer, topicPrefix, log.DefaultSamplerFactory)\n159\t\tpublisher := probe.NewCommandPublisher(sender)\n160\t\treturn probe.NewHealthcheckRunner(configProvider, publisher, branch)\n161\t}\n162\t\n163\t// CreateHealthcheckCron wraps the given runner in a cron scheduler. Pass the runner returned by\n164\t// CreateHealthcheckRunner so the cron and the HTTP handler share the same instance.\n165\tfunc CreateHealthcheckCron(\n166\t\texpression libcron.Expression,\n167\t\trunner probe.HealthcheckRunner,\n168\t) pkg.CronScheduler {\n169\t\treturn libcron.NewExpressionCron(expression, runner)\n170\t}\n171\t"}]},"parent_tool_use_id":"chatcmpl-tool-a883ed86f0a5df7d","session_id":"649c3b71-f1fd-46a9-a844-34ab62b5da5e","uuid":"a2e9dc05-4528-4599-9898-84ed9e21a8ce","timestamp":"2026-09-03T17:46:32.386Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec 002"}
