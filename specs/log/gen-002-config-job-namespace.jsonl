"phases,omitempty\"`\n49\t\tStatuses domain.TaskStatuses `json:\"statuses,omitempty\"`\n50\t}\n51\t\n52\t// ConfigSpec defines the desired state of a Config.\n53\ttype ConfigSpec struct {\n54\t\t// Assignee is the task frontmatter assignee value that routes to this agent.\n55\t\tAssignee string `json:\"assignee\"`\n56\t\t// Image is the container image base name (without tag).\n57\t\tImage string `json:\"image\"`\n58\t\t// Heartbeat is the interval at which the agent re-spawns (e.g. \"30m\").\n59\t\tHeartbeat string `json:\"heartbeat\"`\n60\t\t// Deprecated: prefer TaskTypes (list). Stays functional indefinitely; use taskTypes for new agents.\n61\t\t// TaskType is the task_type value in task frontmatter that routes to this agent.\n62\t\tTaskType string `json:\"taskType\"`\n63\t\t// TaskTypes is the list of task_type values in task frontmatter that route to this agent.\n64\t\t// Optional when taskType is set; at least one of taskType or taskTypes must be non-empty.\n65\t\tTaskTypes []string `json:\"taskTypes,omitempty\"`\n66\t\t// Resources holds optional resource requests for the agent container.\n67\t\tResources *AgentResources `json:\"resources,omitempty\"`\n68\t\t// Env holds per-agent environment variables.\n69\t\tEnv map[string]string `json:\"env,omitempty\"`\n70\t\t// SecretName is the name of a K8s Secret to mount as envFrom.\n71\t\tSecretName string `json:\"secretName,omitempty\"`\n72\t\t// VolumeClaim is the name of an existing PVC to mount.\n73\t\tVolumeClaim string `json:\"volumeClaim,omitempty\"`\n74\t\t// VolumeMountPath is the container path where the PVC is mounted.\n75\t\tVolumeMountPath string `json:\"volumeMountPath,omitempty\"`\n76\t\t// PriorityClassName is the Kubernetes PriorityClass name to stamp onto spawned Job PodTemplates.\n77\t\tPriorityClassName string `json:\"priorityClassName,omitempty\"`\n78\t\t// MaxConcurrentJobs caps how many Jobs this agent may run at once. Spawns\n79\t\t// beyond the cap are deferred and retried, never dropped. 0 (the default)\n80\t\t// means unlimited, preserving existing behaviour for every agent that does\n81\t\t// not set it.\n82\t\tMaxConcurrentJobs int `json:\"maxConcurrentJobs,omitempty\"`\n83\t\t// Trigger declares the per-agent phase and status conditions under which the executor spawns a Job.\n84\t\tTrigger *Trigger `json:\"trigger,omitempty\"`\n85\t\t// ZombieSweeperIntervalSeconds is how often the executor's deadline sweeper\n86\t\t// walks the TaskStore looking for zombie jobs. Optional; when nil, the executor\n87\t\t// uses DefaultZombieSweeperIntervalSeconds (60). Values below\n88\t\t// MinZombieSweeperIntervalSeconds (10) are rejected at admission to prevent\n89\t\t// sweeper thrash. Pointer-typed so \"unset\" is distinguishable from \"0\".\n90\t\tZombieSweeperIntervalSeconds *int32 `json:\"zombieSweeperIntervalSeconds,omitempty\"`\n91\t\t// ZombieJobTimeoutSeconds is the deadline applied to every spawned Job (via\n92\t\t// Job.Spec.ActiveDeadlineSeconds) AND the elapsed-time threshold the sweeper\n93\t\t// uses when classifying zombies. Optional; when nil, the executor uses\n94\t\t// DefaultZombieJobTimeoutSeconds (1800 — 30 minutes). Values below\n95\t\t// MinZombieJobTimeoutSeconds (30) are rejected at admission to prevent\n96\t\t// pathological short-deadline kills. Pointer-typed so \"unset\" is\n97\t\t// distinguishable from \"0\".\n98\t\tZombieJobTimeoutSeconds *int32 `json:\"zombieJobTimeoutSeconds,omitempty\"`\n99\t}\n100\t\n101\t// AgentResources holds optional resource requests and limits for the agent container.\n102\ttype AgentResources struct {\n103\t\t// Requests declares the minimum resources the container needs.\n104\t\tRequests AgentResourceList `json:\"requests,omitempty\"`\n105\t\t// Limits declares the maximum resources the container may use.\n106\t\tLimits AgentResourceList `json:\"limits,omitempty\"`\n107\t}\n108\t\n109\t// AgentResourceList describes a CPU / memory / ephemeral-storage triple\n110\t// used by both Requests and Limits on AgentResources.\n111\ttype AgentResourceList struct {\n112\t\t// CPU is the CPU resource value (e.g. \"500m\").\n113\t\tCPU string `json:\"cpu,omitempty\"`\n114\t\t// Memory is the memory resource value (e.g. \"256Mi\").\n115\t\tMemory string `json:\"memory,omitempty\"`\n116\t\t// EphemeralStorage is the ephemeral-storage resource value (e.g. \"1Gi\").\n117\t\tEphemeralStorage string `json:\"ephemeral-storage,omitempty\"`\n118\t}\n119\t\n120\t// +k8s:deepcopy-gen:interfaces=k8s.io/apimachinery/pkg/runtime.Object\n121\t\n122\t// ConfigList is a list of Config resources.\n123\ttype ConfigList struct {\n124\t\tmetav1.TypeMeta `         json:\",inline\"`\n125\t\tmetav1.ListMeta `         json:\"metadata\"`\n126\t\t// Items is the list of Config resources.\n127\t\tItems []Config `json:\"items\"`\n128\t}\n129\t\n130\t// Equal returns true if this Config has the same spec as other.\n131\tfunc (a Config) Equal(other libk8s.Type) bool {\n132\t\tswitch o := other.(type) {\n133\t\tcase Config:\n134\t\t\treturn a.Spec.Equal(o.Spec)\n135\t\tcase *Config:\n136\t\t\treturn a.Spec.Equal(o.Spec)\n137\t\tdefault:\n138\t\t\treturn false\n139\t\t}\n140\t}\n141\t\n142\t// Identifier returns a unique identifier for this Config.\n143\tfunc (a Config) Identifier() libk8s.Identifier {\n144\t\treturn libk8s.Identifier(libk8s.BuildName(a.Namespace, a.Name))\n145\t}\n146\t\n147\t// Validate validates the Config spec.\n148\tfunc (a Config) Validate(ctx context.Context) error {\n149\t\treturn a.Spec.Validate(ctx)\n150\t}\n151\t\n152\t// String returns the name of the Config.\n153\tfunc (a Config) String() string {\n154\t\treturn a.Name\n155\t}\n156\t\n157\t// Equal returns true if the two ConfigSpec values are identical.\n158\tfunc (s ConfigSpec) Equal(o ConfigSpec) bool {\n159\t\treturn s.Assignee == o.Assignee &&\n160\t\t\ts.Image == o.Image &&\n161\t\t\ts.Heartbeat == o.Heartbeat &&\n162\t\t\ts.TaskType == o.TaskType &&\n163\t\t\treflect.DeepEqual(s.TaskTypes, o.TaskTypes) &&\n164\t\t\ts.SecretName == o.SecretName &&\n165\t\t\ts.VolumeClaim == o.VolumeClaim &&\n166\t\t\ts.VolumeMountPath == o.VolumeMountPath &&\n167\t\t\ts.PriorityClassName == o.PriorityClassName &&\n168\t\t\ts.MaxConcurrentJobs == o.MaxConcurrentJobs &&\n169\t\t\treflect.DeepEqual(s.Env, o.Env) &&\n170\t\t\treflect.DeepEqual(s.Resources, o.Resources) &&\n171\t\t\treflect.DeepEqual(s.Trigger, o.Trigger) &&\n172\t\t\treflect.DeepEqual(s.ZombieSweeperIntervalSeconds, o.ZombieSweeperIntervalSeconds) &&\n173\t\t\treflect.DeepEqual(s.ZombieJobTimeoutSeconds, o.ZombieJobTimeoutSeconds)\n174\t}\n175\t\n176\t// Validate validates the ConfigSpec fields.\n177\tfunc (s ConfigSpec) Validate(ctx context.Context) error {\n178\t\tif s.Assignee == \"\" {\n179\t\t\treturn errors.Wrapf(ctx, validation.Error, \"assignee is empty\")\n180\t\t}\n181\t\tif s.Image == \"\" {\n182\t\t\treturn errors.Wrapf(ctx, validation.Error, \"image is empty\")\n183\t\t}\n184\t\tif s.Heartbeat == \"\" {\n185\t\t\treturn errors.Wrapf(ctx, validation.Error, \"heartbeat is empty\")\n186\t\t}\n187\t\tif s.VolumeClaim != \"\" && s.VolumeMountPath == \"\" {\n188\t\t\treturn errors.Wrapf(ctx, validation.Error, \"VolumeMountPath required when VolumeClaim set\")\n189\t\t}\n190\t\tif err := validateTrigger(ctx, s.Trigger); err != nil {\n191\t\t\treturn err\n192\t\t}\n193\t\tif s.TaskType == \"\" && len(s.TaskTypes) == 0 {\n194\t\t\treturn errors.Wrapf(\n195\t\t\t\tctx,\n196\t\t\t\tvalidation.Error,\n197\t\t\t\t\"at least one of taskType or taskTypes must be set\",\n198\t\t\t)\n199\t\t}\n200\t\tif err := validateTaskTypeValue(ctx, s.TaskType); err != nil {\n201\t\t\treturn err\n202\t\t}\n203\t\tif err := validateTaskTypesList(ctx, s.TaskTypes); err != nil {\n204\t\t\treturn err\n205\t\t}\n206\t\tif err := validateZombieSweeperInterval(ctx, s.ZombieSweeperIntervalSeconds); err != nil {\n207\t\t\treturn err\n208\t\t}\n209\t\treturn validateZombieJobTimeout(ctx, s.ZombieJobTimeoutSeconds)\n210\t}\n211\t\n212\tfunc validateZombieSweeperInterval(ctx context.Context, v *int32) error {\n213\t\tif v == nil {\n214\t\t\treturn nil\n215\t\t}\n216\t\tif *v < MinZombieSweeperIntervalSeconds {\n217\t\t\treturn errors.Wrapf(\n218\t\t\t\tctx,\n219\t\t\t\tvalidation.Error,\n220\t\t\t\t\"zombieSweeperIntervalSeconds invalid: must be >= %d\",\n221\t\t\t\tMinZombieSweeperIntervalSeconds,\n222\t\t\t)\n223\t\t}\n224\t\treturn nil\n225\t}\n226\t\n227\tfunc validateZombieJobTimeout(ctx context.Context, v *int32) error {\n228\t\tif v == nil {\n229\t\t\treturn nil\n230\t\t}\n231\t\tif *v < MinZombieJobTimeoutSeconds {\n232\t\t\treturn errors.Wrapf(\n233\t\t\t\tctx,\n234\t\t\t\tvalidation.Error,\n235\t\t\t\t\"zombieJobTimeoutSeconds invalid: must be >= %d\",\n236\t\t\t\tMinZombieJobTimeoutSeconds,\n237\t\t\t)\n238\t\t}\n239\t\treturn nil\n240\t}\n241\t\n242\tfunc validateTrigger(ctx context.Context, trigger *Trigger) error {\n243\t\tif trigger == nil {\n244\t\t\treturn nil\n245\t\t}\n246\t\tfor _, phase := range trigger.Phases {\n247\t\t\tif err := phase.Validate(ctx); err != nil {\n248\t\t\t\treturn errors.Wrapf(ctx, err, \"invalid trigger phase %q\", phase)\n249\t\t\t}\n250\t\t}\n251\t\tfor _, status := range trigger.Statuses {\n252\t\t\tif err := status.Validate(ctx); err != nil {\n253\t\t\t\treturn errors.Wrapf(ctx, err, \"invalid trigger status %q\", status)\n254\t\t\t}\n255\t\t}\n256\t\treturn nil\n257\t}\n258\t\n259\tfunc validateTaskTypeValue(ctx context.Context, taskType string) error {\n260\t\tif taskType == \"\" {\n261\t\t\treturn nil\n262\t\t}\n263\t\tif !taskTypePattern.MatchString(taskType) {\n264\t\t\treturn errors.Wrapf(ctx, validation.Error, \"taskType must match ^[a-z0-9-]+$\")\n265\t\t}\n266\t\tif len(taskType) > 63 {\n267\t\t\treturn errors.Wrapf(ctx, validation.Error, \"taskType exceeds maximum length of 63\")\n268\t\t}\n269\t\treturn nil\n270\t}\n271\t\n272\tfunc validateTaskTypesList(ctx context.Context, types []string) error {\n273\t\tfor _, t := range types {\n274\t\t\tif !taskTypePattern.MatchString(t) {\n275\t\t\t\treturn errors.Wrapf(\n276\t\t\t\t\tctx,\n277\t\t\t\t\tvalidation.Error,\n278\t\t\t\t\t\"taskTypes element %q must match ^[a-z0-9-]+$\",\n279\t\t\t\t\tt,\n280\t\t\t\t)\n281\t\t\t}\n282\t\t\tif len(t) > 63 {\n283\t\t\t\treturn errors.Wrapf(\n284\t\t\t\t\tctx,\n285\t\t\t\t\tvalidation.Error,\n286\t\t\t\t\t\"taskTypes element %q exceeds maximum length of 63\",\n287\t\t\t\t\tt,\n288\t\t\t\t)\n289\t\t\t}\n290\t\t}\n291\t\treturn nil\n292\t}\n293\t"}]},"parent_tool_use_id":"chatcmpl-tool-92879bdf48abd110","session_id":"649c3b71-f1fd-46a9-a844-34ab62b5da5e","uuid":"fe5dcb7c-3b6d-45e4-9b21-66d10275d398","timestamp":"2026-09-03T17:53:10.796Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 1 (model)"}
