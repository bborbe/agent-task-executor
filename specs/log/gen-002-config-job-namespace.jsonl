{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-a10cdbeda1b30f53","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\tstderrors \"errors\"\n10\t\n11\t\t\"github.com/bborbe/cqrs/base\"\n12\t\t\"github.com/bborbe/errors\"\n13\t\t\"github.com/bborbe/k8s\"\n14\t\n15\t\tagentv1 \"github.com/bborbe/agent-task-executor/k8s/apis/agent.benjamin-borbe.de/v1\"\n16\t)\n17\t\n18\t// ErrConfigNotFound is returned by ConfigResolver.Resolve when no\n19\t// Config in the store has a matching Spec.Assignee.\n20\tvar ErrConfigNotFound = stderrors.New(\"config not found\")\n21\t\n22\t//counterfeiter:generate -o ../mocks/config_resolver.go --fake-name FakeConfigResolver . ConfigResolver\n23\t\n24\t// ConfigResolver looks up the AgentConfiguration for an assignee by\n25\t// iterating the in-memory Config store and converting the matching entry.\n26\ttype ConfigResolver interface {\n27\t\tResolve(ctx context.Context, assignee string) (AgentConfiguration, error)\n28\t}\n29\t\n30\t// NewConfigResolver returns a ConfigResolver backed by the given\n31\t// typed store. The branch is captured here and appended as the image tag at\n32\t// resolution time. Resolutions are scoped to the given vault: each task's\n33\t// plain assignee is matched against the composed {assignee}-{vaultName}\n34\t// Config assignee, so per-vault Config CRs apply per executor instance. When\n35\t// no composed Config exists, Resolve falls back to the plain assignee, so the\n36\t// singular shared-topic executor (v0.6.x Config CRs without a vault suffix)\n37\t// keeps resolving on the v0.7+ line.\n38\tfunc NewConfigResolver(\n39\t\tprovider k8s.Provider[agentv1.Config],\n40\t\tbranch base.Branch,\n41\t\tvaultName string,\n42\t) ConfigResolver {\n43\t\treturn &configResolver{provider: provider, branch: branch, vaultName: vaultName}\n44\t}\n45\t\n46\ttype configResolver struct {\n47\t\tprovider  k8s.Provider[agentv1.Config]\n48\t\tbranch    base.Branch\n49\t\tvaultName string\n50\t}\n51\t\n52\tfunc (r *configResolver) Resolve(\n53\t\tctx context.Context,\n54\t\tassignee string,\n55\t) (AgentConfiguration, error) {\n56\t\titems, err := r.provider.Get(ctx)\n57\t\tif err != nil {\n58\t\t\treturn AgentConfiguration{}, errors.Wrapf(ctx, err, \"list agent configs\")\n59\t\t}\n60\t\tcomposed := assignee + \"-\" + r.vaultName\n61\t\tfor _, it := range items {\n62\t\t\tselect {\n63\t\t\tcase <-ctx.Done():\n64\t\t\t\treturn AgentConfiguration{}, errors.Wrapf(\n65\t\t\t\t\tctx,\n66\t\t\t\t\tctx.Err(),\n67\t\t\t\t\t\"resolve config %q cancelled\",\n68\t\t\t\t\tcomposed,\n69\t\t\t\t)\n70\t\t\tdefault:\n71\t\t\t}\n72\t\t\tif it.Spec.Assignee == composed {\n73\t\t\t\treturn convert(ctx, it, r.branch.String())\n74\t\t\t}\n75\t\t}\n76\t\t// No {assignee}-{vaultName} Config: fall back to the plain assignee so the\n77\t\t// singular executor's un-suffixed Config CRs (v0.6.x naming) keep resolving.\n78\t\t// Per-vault installs still match composed first, so vault scoping wins when\n79\t\t// a composed Config exists.\n80\t\tfor _, it := range items {\n81\t\t\tselect {\n82\t\t\tcase <-ctx.Done():\n83\t\t\t\treturn AgentConfiguration{}, errors.Wrapf(\n84\t\t\t\t\tctx,\n85\t\t\t\t\tctx.Err(),\n86\t\t\t\t\t\"resolve config %q cancelled\",\n87\t\t\t\t\tassignee,\n88\t\t\t\t)\n89\t\t\tdefault:\n90\t\t\t}\n91\t\t\tif it.Spec.Assignee == assignee {\n92\t\t\t\treturn convert(ctx, it, r.branch.String())\n93\t\t\t}\n94\t\t}\n95\t\treturn AgentConfiguration{}, errors.Wrapf(\n96\t\t\tctx,\n97\t\t\tErrConfigNotFound,\n98\t\t\t\"find composed assignee %q\",\n99\t\t\tcomposed,\n100\t\t)\n101\t}\n102\t\n103\tfunc convert(ctx context.Context, obj agentv1.Config, branch string) (AgentConfiguration, error) {\n104\t\tenv, err := copyEnv(ctx, obj.Spec.Env)\n105\t\tif err != nil {\n106\t\t\treturn AgentConfiguration{}, errors.Wrapf(ctx, err, \"convert config %q\", obj.Spec.Assignee)\n107\t\t}\n108\t\treturn AgentConfiguration{\n109\t\t\tAssignee:                obj.Spec.Assignee,\n110\t\t\tTaskType:                obj.Spec.TaskType,\n111\t\t\tTaskTypes:               append([]string(nil), obj.Spec.TaskTypes...),\n112\t\t\tImage:                   appendBranchTag(obj.Spec.Image, branch),\n113\t\t\tEnv:                     env,\n114\t\t\tSecretName:              obj.Spec.SecretName,\n115\t\t\tVolumeClaim:             obj.Spec.VolumeClaim,\n116\t\t\tVolumeMountPath:         obj.Spec.VolumeMountPath,\n117\t\t\tResources:               obj.Spec.Resources.DeepCopy(),\n118\t\t\tMaxConcurrentJobs:       obj.Spec.MaxConcurrentJobs,\n119\t\t\tPriorityClassName:       obj.Spec.PriorityClassName,\n120\t\t\tTrigger:                 obj.Spec.Trigger,\n121\t\t\tZombieJobTimeoutSeconds: obj.Spec.ZombieJobTimeoutSeconds,\n122\t\t}, nil\n123\t}\n124\t\n125\tfunc copyEnv(ctx context.Context, in map[string]string) (map[string]string, error) {\n126\t\tout := make(map[string]string, len(in))\n127\t\tfor k, v := range in {\n128\t\t\tselect {\n129\t\t\tcase <-ctx.Done():\n130\t\t\t\treturn nil, errors.Wrapf(ctx, ctx.Err(), \"copy env cancelled\")\n131\t\t\tdefault:\n132\t\t\t}\n133\t\t\tout[k] = v\n134\t\t}\n135\t\treturn out, nil\n136\t}\n137\t"}]},"parent_tool_use_id":"chatcmpl-tool-a883ed86f0a5df7d","session_id":"649c3b71-f1fd-46a9-a844-34ab62b5da5e","uuid":"a5be2561-0f4c-416c-9a17-75841e5f6f39","timestamp":"2026-09-03T17:46:40.728Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec 002"}
