t\t\"test-ns\",\n54\t\t\t\t\"kafka:9092\",\n55\t\t\t\t\"develop\",\n56\t\t\t\t\"test-prefix\",\n57\t\t\t\tcurrentDateTime,\n58\t\t\t\t1800,\n59\t\t\t\t\"\",\n60\t\t\t\t\"\",\n61\t\t\t)\n62\t\t})\n63\t\n64\t\tDescribe(\"SpawnJob\", func() {\n65\t\t\tIt(\"creates a job with correct name and env vars\", func() {\n66\t\t\t\ttask := lib.Task{\n67\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"abc12345-rest-ignored\"),\n68\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n69\t\t\t\t\t\t\"assignee\": \"claude\",\n70\t\t\t\t\t\t\"phase\":    \"planning\",\n71\t\t\t\t\t},\n72\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n73\t\t\t\t}\n74\t\t\t\tconfig := pkg.AgentConfiguration{\n75\t\t\t\t\tAssignee: \"claude\",\n76\t\t\t\t\tImage:    \"my-image:latest\",\n77\t\t\t\t\tEnv:      map[string]string{\"GEMINI_API_KEY\": \"test-gemini-key\"},\n78\t\t\t\t}\n79\t\t\t\t_, err := jobSpawner.SpawnJob(ctx, task, config)\n80\t\t\t\tExpect(err).To(BeNil())\n81\t\n82\t\t\t\tjobs, err := fakeClient.BatchV1().Jobs(\"test-ns\").List(ctx, metav1.ListOptions{})\n83\t\t\t\tExpect(err).To(BeNil())\n84\t\t\t\tExpect(jobs.Items).To(HaveLen(1))\n85\t\n86\t\t\t\tjob := jobs.Items[0]\n87\t\t\t\tExpect(job.Name).To(Equal(\"claude-abc12345-20260403173500\"))\n88\t\t\t\tExpect(job.Namespace).To(Equal(\"test-ns\"))\n89\t\t\t\tExpect(*job.Spec.BackoffLimit).To(Equal(int32(0)))\n90\t\t\t\tExpect(job.Spec.Template.Spec.RestartPolicy).To(Equal(corev1.RestartPolicyNever))\n91\t\n92\t\t\t\tExpect(job.Spec.TTLSecondsAfterFinished).NotTo(BeNil())\n93\t\t\t\tExpect(*job.Spec.TTLSecondsAfterFinished).To(Equal(int32(1800)))\n94\t\n95\t\t\t\tExpect(job.Spec.Template.Labels).To(HaveKeyWithValue(\"app\", \"agent\"))\n96\t\t\t\tExpect(job.Spec.Template.Labels).To(HaveKey(\"component\"))\n97\t\n98\t\t\t\tExpect(job.Spec.Template.Spec.ImagePullSecrets).To(HaveLen(1))\n99\t\t\t\tExpect(job.Spec.Template.Spec.ImagePullSecrets[0].Name).To(Equal(\"docker\"))\n100\t\n101\t\t\t\tcontainer := job.Spec.Template.Spec.Containers[0]\n102\t\t\t\tExpect(container.Image).To(Equal(\"my-image:latest\"))\n103\t\n104\t\t\t\tenvMap := make(map[string]string)\n105\t\t\t\tfor _, e := range container.Env {\n106\t\t\t\t\tenvMap[e.Name] = e.Value\n107\t\t\t\t}\n108\t\t\t\tExpect(envMap[\"TASK_CONTENT\"]).To(HavePrefix(\"---\\n\"))\n109\t\t\t\tExpect(envMap[\"TASK_CONTENT\"]).To(ContainSubstring(\"\\n---\\n\"))\n110\t\t\t\tExpect(envMap[\"TASK_CONTENT\"]).To(ContainSubstring(\"assignee: claude\"))\n111\t\t\t\tExpect(envMap[\"TASK_CONTENT\"]).To(ContainSubstring(\"phase: planning\"))\n112\t\t\t\tExpect(envMap[\"TASK_CONTENT\"]).To(HaveSuffix(\"\\n---\\ndo the work\"))\n113\t\t\t\tExpect(envMap[\"TASK_ID\"]).To(Equal(\"abc12345-rest-ignored\"))\n114\t\t\t\tExpect(envMap[\"KAFKA_BROKERS\"]).To(Equal(\"kafka:9092\"))\n115\t\t\t\tExpect(envMap[\"BRANCH\"]).To(Equal(\"develop\"))\n116\t\t\t\tExpect(envMap[\"TOPIC_PREFIX\"]).To(Equal(\"test-prefix\"))\n117\t\t\t\tExpect(envMap[\"GEMINI_API_KEY\"]).To(Equal(\"test-gemini-key\"))\n118\t\t\t\tExpect(envMap[\"PHASE\"]).To(Equal(\"planning\"))\n119\t\t\t\tExpect(envMap[\"TASK_TYPE\"]).To(Equal(\"\"))\n120\t\t\t})\n121\t\n122\t\t\tIt(\"sets TOPIC_PREFIX to empty string when configured topicPrefix is empty\", func() {\n123\t\t\t\tjobSpawner = spawner.NewJobSpawner(\n124\t\t\t\t\tfakeClient,\n125\t\t\t\t\t\"test-ns\",\n126\t\t\t\t\t\"kafka:9092\",\n127\t\t\t\t\t\"develop\",\n128\t\t\t\t\t\"\",\n129\t\t\t\t\tcurrentDateTime,\n130\t\t\t\t\t1800,\n131\t\t\t\t\t\"\",\n132\t\t\t\t\t\"\",\n133\t\t\t\t)\n134\t\t\t\ttask := lib.Task{\n135\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"no-prefix-task\"),\n136\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n137\t\t\t\t\t\t\"assignee\": \"claude\",\n138\t\t\t\t\t},\n139\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n140\t\t\t\t}\n141\t\t\t\tconfig := pkg.AgentConfiguration{\n142\t\t\t\t\tAssignee: \"claude\",\n143\t\t\t\t\tImage:    \"my-image:latest\",\n144\t\t\t\t\tEnv:      map[string]string{},\n145\t\t\t\t}\n146\t\t\t\t_, err := jobSpawner.SpawnJob(ctx, task, config)\n147\t\t\t\tExpect(err).To(BeNil())\n148\t\n149\t\t\t\tjobs, err := fakeClient.BatchV1().Jobs(\"test-ns\").List(ctx, metav1.ListOptions{})\n150\t\t\t\tExpect(err).To(BeNil())\n151\t\t\t\tExpect(jobs.Items).To(HaveLen(1))\n152\t\n153\t\t\t\tenvMap := make(map[string]string)\n154\t\t\t\tfor _, e := range jobs.Items[0].Spec.Template.Spec.Containers[0].Env {\n155\t\t\t\t\tenvMap[e.Name] = e.Value\n156\t\t\t\t}\n157\t\t\t\tExpect(envMap).To(HaveKey(\"TOPIC_PREFIX\"))\n158\t\t\t\tExpect(envMap[\"TOPIC_PREFIX\"]).To(Equal(\"\"))\n159\t\t\t})\n160\t\n161\t\t\tIt(\"propagates a non-default ttlSecondsAfterFinished to the Job spec\", func() {\n162\t\t\t\tcustomTTL := int32(60)\n163\t\t\t\tjobSpawner = spawner.NewJobSpawner(\n164\t\t\t\t\tfakeClient,\n165\t\t\t\t\t\"test-ns\",\n166\t\t\t\t\t\"kafka:9092\",\n167\t\t\t\t\t\"develop\",\n168\t\t\t\t\t\"test-prefix\",\n169\t\t\t\t\tcurrentDateTime,\n170\t\t\t\t\tcustomTTL,\n171\t\t\t\t\t\"\",\n172\t\t\t\t\t\"\",\n173\t\t\t\t)\n174\t\t\t\ttask := lib.Task{\n175\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"ttl-custom\"),\n176\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n177\t\t\t\t\t\t\"assignee\": \"claude\",\n178\t\t\t\t\t\t\"phase\":    \"planning\",\n179\t\t\t\t\t},\n180\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n181\t\t\t\t}\n182\t\t\t\tconfig := pkg.AgentConfiguration{\n183\t\t\t\t\tAssignee: \"claude\",\n184\t\t\t\t\tImage:    \"my-image:latest\",\n185\t\t\t\t\tEnv:      map[string]string{\"GEMINI_API_KEY\": \"test-gemini-key\"},\n186\t\t\t\t}\n187\t\t\t\t_, err := jobSpawner.SpawnJob(ctx, task, config)\n188\t\t\t\tExpect(err).To(BeNil())\n189\t\n190\t\t\t\tjobs, err := fakeClient.BatchV1().Jobs(\"test-ns\").List(ctx, metav1.ListOptions{})\n191\t\t\t\tExpect(err).To(BeNil())\n192\t\t\t\tExpect(jobs.Items).To(HaveLen(1))\n193\t\t\t\tExpect(jobs.Items[0].Spec.TTLSecondsAfterFinished).NotTo(BeNil())\n194\t\t\t\tExpect(*jobs.Items[0].Spec.TTLSecondsAfterFinished).To(Equal(customTTL))\n195\t\t\t})\n196\t\n197\t\t\tIt(\n198\t\t\t\t\"includes frontmatter delimiters and keys in TASK_CONTENT so spawned agents can parse fields like clone_url\",\n199\t\t\t\tfunc() {\n200\t\t\t\t\ttask := lib.Task{\n201\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"pr-task-uuid\"),\n202\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n203\t\t\t\t\t\t\t\"assignee\":  \"pr-reviewer\",\n204\t\t\t\t\t\t\t\"phase\":     \"in_progress\",\n205\t\t\t\t\t\t\t\"clone_url\": \"https://github.com/bborbe/code-reviewer.git\",\n206\t\t\t\t\t\t\t\"ref\":       \"f82244d6abcdef\",\n207\t\t\t\t\t\t\t\"base_ref\":  \"master\",\n208\t\t\t\t\t\t},\n209\t\t\t\t\t\tContent: lib.TaskContent(\"# PR Review:\\n\\nbody here\"),\n210\t\t\t\t\t}\n211\t\t\t\t\tconfig := pkg.AgentConfiguration{\n212\t\t\t\t\t\tAssignee: \"pr-reviewer\",\n213\t\t\t\t\t\tImage:    \"pr-reviewer-agent:latest\",\n214\t\t\t\t\t\tEnv:      map[string]string{},\n215\t\t\t\t\t}\n216\t\t\t\t\t_, err := jobSpawner.SpawnJob(ctx, task, config)\n217\t\t\t\t\tExpect(err).To(BeNil())\n218\t\n219\t\t\t\t\tjobs, err := fakeClient.BatchV1().Jobs(\"test-ns\").List(ctx, metav1.ListOptions{})\n220\t\t\t\t\tExpect(err).To(BeNil())\n221\t\t\t\t\tExpect(jobs.Items).To(HaveLen(1))\n222\t\t\t\t\tcontainer := jobs.Items[0].Spec.Template.Spec.Containers[0]\n223\t\t\t\t\tenvMap := make(map[string]string)\n224\t\t\t\t\tfor _, e := range container.Env {\n225\t\t\t\t\t\tenvMap[e.Name] = e.Value\n226\t\t\t\t\t}\n227\t\t\t\t\tgot := envMap[\"TASK_CONTENT\"]\n228\t\t\t\t\t// wrapper present\n229\t\t\t\t\tExpect(got).To(HavePrefix(\"---\\n\"))\n230\t\t\t\t\tExpect(got).To(ContainSubstring(\"\\n---\\n# PR Review:\"))\n231\t\t\t\t\t// frontmatter keys propagated — these are exactly the fields the\n232\t\t\t\t\t// pr-reviewer execution step reads\n233\t\t\t\t\tExpect(\n234\t\t\t\t\t\tgot,\n235\t\t\t\t\t).To(ContainSubstring(\"clone_url: https://github.com/bborbe/code-reviewer.git\"))\n236\t\t\t\t\tExpect(got).To(ContainSubstring(\"ref: f82244d6abcdef\"))\n237\t\t\t\t\tExpect(got).To(ContainSubstring(\"base_ref: master\"))\n238\t\t\t\t\tExpect(got).To(ContainSubstring(\"assignee: pr-reviewer\"))\n239\t\t\t\t\t// body preserved\n240\t\t\t\t\tExpect(got).To(ContainSubstring(\"# PR Review:\\n\\nbody here\"))\n241\t\t\t\t},\n242\t\t\t)\n243\t\n244\t\t\tIt(\n245\t\t\t\t\"emits TASK_CONTENT that lib.ParseMarkdown round-trips back to the original frontmatter\",\n246\t\t\t\tfunc() {\n247\t\t\t\t\ttask := lib.Task{\n248\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"roundtrip-task\"),\n249\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n250\t\t\t\t\t\t\t\"assignee\":  \"pr-reviewer\",\n251\t\t\t\t\t\t\t\"clone_url\": \"https://github.com/bborbe/code-reviewer.git\",\n252\t\t\t\t\t\t\t\"ref\":       \"abc123\",\n253\t\t\t\t\t\t\t\"base_ref\":  \"master\",\n254\t\t\t\t\t\t},\n255\t\t\t\t\t\tContent: lib.TaskContent(\"# Body\\n\"),\n256\t\t\t\t\t}\n257\t\t\t\t\tconfig := pkg.AgentConfiguration{Assignee: \"pr-reviewer\", Image: \"x:y\"}\n258\t\t\t\t\t_, err := jobSpawner.SpawnJob(ctx, task, config)\n259\t\t\t\t\tExpect(err).To(BeNil())\n260\t\n261\t\t\t\t\tjobs, err := fakeClient.BatchV1().Jobs(\"test-ns\").List(ctx, metav1.ListOptions{})\n262\t\t\t\t\tExpect(err).To(BeNil())\n263\t\t\t\t\tcontainer := jobs.Items[0].Spec.Template.Spec.Containers[0]\n264\t\t\t\t\tvar taskContent string\n265\t\t\t\t\tfor _, e := range container.Env {\n266\t\t\t\t\t\tif e.Name == \"TASK_CONTENT\" {\n267\t\t\t\t\t\t\ttaskContent = e.Value\n268\t\t\t\t\t\t}\n269\t\t\t\t\t}\n270\t\t\t\t\tExpect(taskContent).NotTo(BeEmpty())\n271\t\n272\t\t\t\t\tparsed, parseErr := lib.ParseMarkdown(ctx, taskContent)\n273\t\t\t\t\tExpect(parseErr).NotTo(HaveOccurred())\n274\t\t\t\t\tExpect(\n275\t\t\t\t\t\tparsed.Frontmatter,\n276\t\t\t\t\t).To(HaveKeyWithValue(\"clone_url\", \"https://github.com/bborbe/code-reviewer.git\"))\n277\t\t\t\t\tExpect(parsed.Frontmatter).To(HaveKeyWithValue(\"ref\", \"abc123\"))\n278\t\t\t\t\tExpect(parsed.Frontmatter).To(HaveKeyWithValue(\"base_ref\", \"master\"))\n279\t\t\t\t\tExpect(parsed.Frontmatter).To(HaveKeyWithValue(\"assignee\", \"pr-reviewer\"))\n280\t\t\t\t},\n281\t\t\t)\n282\t\n283\t\t\tIt(\"emits raw body without wrapper when frontmatter is empty\", func() {\n284\t\t\t\ttask := lib.Task{\n285\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"no-fm-task\"),\n286\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{}, // explicitly empty\n287\t\t\t\t\tContent:        lib.TaskContent(\"just a body\"),\n288\t\t\t\t}\n289\t\t\t\tconfig := pkg.AgentConfiguration{Assignee: \"claude\", Image: \"x:y\"}\n290\t\t\t\t_, err := jobSpawner.SpawnJob(ctx, task, config)\n291\t\t\t\tExpect(err).To(BeNil())\n292\t\n293\t\t\t\tjobs, err := fakeClient.BatchV1().Jobs(\"test-ns\").List(ctx, metav1.ListOptions{})\n294\t\t\t\tExpect(err).To(BeNil())\n295\t\t\t\tcontainer := jobs.Items[0].Spec.Template.Spec.Containers[0]\n296\t\t\t\tenvMap := make(map[string]string)\n297\t\t\t\tfor _, e := range container.Env {\n298\t\t\t\t\tenvMap[e.Name] = e.Value\n299\t\t\t\t}\n300\t\t\t\tExpect(envMap[\"TASK_CONTENT\"]).To(Equal(\"just a body\"))\n301\t\t\t\tExpect(envMap[\"TASK_CONTENT\"]).NotTo(ContainSubstring(\"---\"))\n302\t\t\t\tExpect(envMap[\"TASK_CONTENT\"]).NotTo(ContainSubstring(\"{}\"))\n303\t\t\t})\n304\t\n305\t\t\tIt(\"injects empty PHASE when task frontmatter has no phase\", func() {\n306\t\t\t\ttask := lib.Task{\n307\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"no-phase-task\"),\n308\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n309\t\t\t\t\t\t\"assignee\": \"claude\",\n310\t\t\t\t\t},\n311\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n312\t\t\t\t}\n313\t\t\t\tconfig := pkg.AgentConfiguration{\n314\t\t\t\t\tAssignee: \"claude\",\n315\t\t\t\t\tImage:    \"my-image:latest\",\n316\t\t\t\t\tEnv:      map[string]string{},\n317\t\t\t\t}\n318\t\t\t\t_, err := jobSpawner.SpawnJob(ctx, task, config)\n319\t\t\t\tExpect(err).To(BeNil())\n320\t\n321\t\t\t\tjobs, err := fakeClient.BatchV1().Jobs(\"test-ns\").List(ctx, metav1.ListOptions{})\n322\t\t\t\tExpect(err).To(BeNil())\n323\t\t\t\tExpect(jobs.Items).To(HaveLen(1))\n324\t\n325\t\t\t\tenvMap := make(map[string]string)\n326\t\t\t\tfor _, e := range jobs.Items[0].Spec.Template.Spec.Containers[0].Env {\n327\t\t\t\t\tenvMap[e.Name] = e.Value\n328\t\t\t\t}\n329\t\t\t\tExpect(envMap).To(HaveKey(\"PHASE\"))\n330\t\t\t\tExpect(envMap[\"PHASE\"]).To(Equal(\"\"))\n331\t\t\t})\n332\t\n333\t\t\tIt(\"sets agent.benjamin-borbe.de/task-id label on spawned job\", func() {\n334\t\t\t\ttask := lib.Task{\n335\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"task-uuid-label-test\"),\n336\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n337\t\t\t\t\t\t\"assignee\": \"claude\",\n338\t\t\t\t\t},\n339\t\t\t\t}\n340\t\t\t\tconfig := pkg.AgentConfiguration{\n341\t\t\t\t\tAssignee: \"claude\",\n342\t\t\t\t\tImage:    \"my-image:latest\",\n343\t\t\t\t\tEnv:      map[string]string{},\n344\t\t\t\t}\n345\t\t\t\tjobName, err := jobSpawner.SpawnJob(ctx, task, config)\n346\t\t\t\tExpect(err).NotTo(HaveOccurred())\n347\t\t\t\tExpect(jobName).NotTo(BeEmpty())\n348\t\n349\t\t\t\tjobs, listErr := fakeClient.BatchV1().Jobs(\"test-ns\").List(ctx, metav1.ListOptions{})\n350\t\t\t\tExpect(listErr).To(BeNil())\n351\t\t\t\tExpect(jobs.Items).To(HaveLen(1))\n352\t\t\t\tExpect(\n353\t\t\t\t\tjobs.Items[0].Labels,\n354\t\t\t\t).To(HaveKeyWithValue(\"agent.benjamin-borbe.de/task-id\", string(task.TaskIdentifier)))\n355\t\t\t\tExpect(\n356\t\t\t\t\tjobs.Items[0].Spec.Template.Labels,\n357\t\t\t\t).To(HaveKeyWithValue(\"agent.benjamin-borbe.de/task-id\", string(task.TaskIdentifier)))\n358\t\t\t})\n359\t\n360\t\t\tIt(\"includes all per-agent env vars from config\", func() {\n361\t\t\t\ttask := lib.Task{\n362\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"abc-multi-env\"),\n363\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n364\t\t\t\t\t\t\"assignee\": \"trade-analysis-agent\",\n365\t\t\t\t\t},\n366\t\t\t\t}\n367\t\t\t\tconfig := pkg.AgentConfiguration{\n368\t\t\t\t\tAssignee: \"trade-analysis-agent\",