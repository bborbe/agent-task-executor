{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-930a0a95565fbf97","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"strings\"\n9\t\n10\t\tagentv1 \"github.com/bborbe/agent-task-executor/k8s/apis/agent.benjamin-borbe.de/v1\"\n11\t)\n12\t\n13\t// appendBranchTag appends \":\"+branch to image as a tag, UNLESS image already\n14\t// carries a tag (or digest). An image is considered already-tagged when a \":\"\n15\t// appears in its final path segment — i.e. after the last \"/\". This excludes\n16\t// registry-port colons (e.g. \"reg:443/repo\" is untagged) but catches both\n17\t// \"repo:tag\" and digest refs \"repo@sha256:...\". Pinning an image to an immutable\n18\t// semver tag (e.g. \"reg/bborbe/agent-claude:v0.1.1\") therefore leaves it\n19\t// untouched instead of producing an invalid \"…:v0.1.1:dev\".\n20\tfunc appendBranchTag(image string, branch string) string {\n21\t\tif strings.LastIndex(image, \":\") > strings.LastIndex(image, \"/\") {\n22\t\t\treturn image\n23\t\t}\n24\t\treturn image + \":\" + branch\n25\t}\n26\t\n27\t// AgentConfiguration defines the container image and environment for one agent type.\n28\ttype AgentConfiguration struct {\n29\t\t// Assignee is the task frontmatter assignee value that routes to this agent.\n30\t\tAssignee string\n31\t\t// TaskType is the singular task_type value from ConfigSpec.TaskType.\n32\t\t// Deprecated in favour of TaskTypes; stays functional.\n33\t\tTaskType string\n34\t\t// TaskTypes is the list of task_type values from ConfigSpec.TaskTypes.\n35\t\t// Nil when the CRD only sets the singular TaskType field.\n36\t\tTaskTypes []string\n37\t\t// Image is the container image base name (without tag). Tag is appended at runtime from branch.\n38\t\tImage string\n39\t\t// Env holds per-agent environment variables (e.g. API keys, config).\n40\t\t// These are merged with shared env vars (TASK_CONTENT, TASK_ID, KAFKA_BROKERS, BRANCH)\n41\t\t// when spawning the K8s Job.\n42\t\tEnv map[string]string\n43\t\t// VolumeClaim is the name of an existing PVC to mount into the container.\n44\t\t// Empty means no volume mount.\n45\t\tVolumeClaim string\n46\t\t// VolumeMountPath is the container path where the PVC is mounted.\n47\t\t// Required when VolumeClaim is set.\n48\t\tVolumeMountPath string\n49\t\t// SecretName is the name of a K8s Secret to mount as envFrom on the container.\n50\t\t// Empty means no secret is mounted.\n51\t\tSecretName string\n52\t\t// Resources declares optional resource requests and limits for the agent container.\n53\t\t// Nil means \"do not set, keep the k8s builder default\".\n54\t\tResources *agentv1.AgentResources\n55\t\t// MaxConcurrentJobs caps how many Jobs this agent may run at once.\n56\t\t// 0 means unlimited.\n57\t\tMaxConcurrentJobs int\n58\t\t// PriorityClassName is the Kubernetes PriorityClass name to stamp onto spawned Job PodTemplates.\n59\t\tPriorityClassName string\n60\t\t// ImagePullSecret is the name of the K8s Secret used for image pulls.\n61\t\t// Empty uses the cluster default (typically \"docker\").\n62\t\tImagePullSecret string\n63\t\t// Trigger declares the per-agent phase and status conditions under which the executor spawns a Job.\n64\t\tTrigger *agentv1.Trigger\n65\t\t// ZombieJobTimeoutSeconds mirrors ConfigSpec.ZombieJobTimeoutSeconds. The\n66\t\t// spawner stamps this value onto Job.Spec.ActiveDeadlineSeconds; the sweeper\n67\t\t// uses it as the elapsed-time threshold. nil means \"use the default\n68\t\t// DefaultZombieJobTimeoutSeconds from the CRD types package\".\n69\t\tZombieJobTimeoutSeconds *int32\n70\t}\n71\t\n72\t// EffectiveZombieJobTimeoutSeconds returns the effective deadline in seconds:\n73\t// the configured value when non-nil, else agentv1.DefaultZombieJobTimeoutSeconds.\n74\tfunc (a AgentConfiguration) EffectiveZombieJobTimeoutSeconds() int32 {\n75\t\tif a.ZombieJobTimeoutSeconds != nil {\n76\t\t\treturn *a.ZombieJobTimeoutSeconds\n77\t\t}\n78\t\treturn agentv1.DefaultZombieJobTimeoutSeconds\n79\t}\n80\t\n81\t// AgentConfigurations is a list of agent configurations.\n82\ttype AgentConfigurations []AgentConfiguration\n83\t\n84\t// FindByAssignee returns the configuration for the given assignee name.\n85\t// Returns the config and true if found, zero value and false otherwise.\n86\tfunc (a AgentConfigurations) FindByAssignee(assignee string) (AgentConfiguration, bool) {\n87\t\tfor _, c := range a {\n88\t\t\tif c.Assignee == assignee {\n89\t\t\t\treturn c, true\n90\t\t\t}\n91\t\t}\n92\t\treturn AgentConfiguration{}, false\n93\t}\n94\t\n95\t// TaggedConfigurations returns a new AgentConfigurations with the branch appended\n96\t// to each untagged image as a tag (e.g. \"registry/image\" + \":\" + \"dev\" →\n97\t// \"registry/image:dev\"). Images that already carry a tag or digest are left as-is\n98\t// (see appendBranchTag), so semver-pinned images are not double-tagged.\n99\tfunc (a AgentConfigurations) TaggedConfigurations(branch string) AgentConfigurations {\n100\t\tresult := make(AgentConfigurations, len(a))\n101\t\tfor i, c := range a {\n102\t\t\tresult[i] = AgentConfiguration{\n103\t\t\t\tAssignee:                c.Assignee,\n104\t\t\t\tTaskType:                c.TaskType,\n105\t\t\t\tTaskTypes:               append([]string(nil), c.TaskTypes...),\n106\t\t\t\tImage:                   appendBranchTag(c.Image, branch),\n107\t\t\t\tEnv:                     c.Env,\n108\t\t\t\tVolumeClaim:             c.VolumeClaim,\n109\t\t\t\tVolumeMountPath:         c.VolumeMountPath,\n110\t\t\t\tSecretName:              c.SecretName,\n111\t\t\t\tResources:               c.Resources.DeepCopy(),\n112\t\t\t\tMaxConcurrentJobs:       c.MaxConcurrentJobs,\n113\t\t\t\tPriorityClassName:       c.PriorityClassName,\n114\t\t\t\tImagePullSecret:         c.ImagePullSecret,\n115\t\t\t\tTrigger:                 c.Trigger,\n116\t\t\t\tZombieJobTimeoutSeconds: c.ZombieJobTimeoutSeconds,\n117\t\t\t}\n118\t\t}\n119\t\treturn result\n120\t}\n121\t"}]},"parent_tool_use_id":"chatcmpl-tool-92879bdf48abd110","session_id":"649c3b71-f1fd-46a9-a844-34ab62b5da5e","uuid":"b56f404f-75b4-4bd9-bc89-7055e89451ec","timestamp":"2026-09-03T17:53:17.268Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 1 (model)"}
