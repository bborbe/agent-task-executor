n889\t\t\t\t\t\t_, err := spawner.SpawnJob(ctx, makeTask(), makeConfig())\n890\t\t\t\t\t\tExpect(err).To(BeNil())\n891\t\n892\t\t\t\t\t\tjobs, err := fakeClient.BatchV1().\n893\t\t\t\t\t\t\tJobs(\"test-ns\").\n894\t\t\t\t\t\t\tList(ctx, metav1.ListOptions{})\n895\t\t\t\t\t\tExpect(err).To(BeNil())\n896\t\t\t\t\t\tExpect(jobs.Items).To(HaveLen(1))\n897\t\n898\t\t\t\t\t\tjob := jobs.Items[0]\n899\t\n900\t\t\t\t\t\t// Build name-indexed maps for stable assertions\n901\t\t\t\t\t\tvolumeMap := make(map[string]corev1.Volume)\n902\t\t\t\t\t\tfor _, v := range job.Spec.Template.Spec.Volumes {\n903\t\t\t\t\t\t\tvolumeMap[v.Name] = v\n904\t\t\t\t\t\t}\n905\t\t\t\t\t\tcontainer := job.Spec.Template.Spec.Containers[0]\n906\t\t\t\t\t\tmountMap := make(map[string]corev1.VolumeMount)\n907\t\t\t\t\t\tfor _, m := range container.VolumeMounts {\n908\t\t\t\t\t\t\tmountMap[m.MountPath] = m\n909\t\t\t\t\t\t}\n910\t\n911\t\t\t\t\t\tif expectCerts {\n912\t\t\t\t\t\t\t// client-cert volume\n913\t\t\t\t\t\t\tExpect(volumeMap).To(HaveKey(\"client-cert\"))\n914\t\t\t\t\t\t\tclientCertVol := volumeMap[\"client-cert\"]\n915\t\t\t\t\t\t\tExpect(clientCertVol.Secret).NotTo(BeNil())\n916\t\t\t\t\t\t\tExpect(clientCertVol.Secret.SecretName).To(Equal(\"kafka-client-cert\"))\n917\t\t\t\t\t\t\tExpect(clientCertVol.Secret.Items).To(HaveLen(1))\n918\t\t\t\t\t\t\tExpect(clientCertVol.Secret.Items[0].Key).To(Equal(\"user.crt\"))\n919\t\t\t\t\t\t\tExpect(clientCertVol.Secret.Items[0].Path).To(Equal(\"file\"))\n920\t\t\t\t\t\t\tExpect(clientCertVol.Secret.DefaultMode).NotTo(BeNil())\n921\t\t\t\t\t\t\tExpect(*clientCertVol.Secret.DefaultMode).To(Equal(int32(288)))\n922\t\n923\t\t\t\t\t\t\t// client-key volume\n924\t\t\t\t\t\t\tExpect(volumeMap).To(HaveKey(\"client-key\"))\n925\t\t\t\t\t\t\tclientKeyVol := volumeMap[\"client-key\"]\n926\t\t\t\t\t\t\tExpect(clientKeyVol.Secret).NotTo(BeNil())\n927\t\t\t\t\t\t\tExpect(clientKeyVol.Secret.SecretName).To(Equal(\"kafka-client-cert\"))\n928\t\t\t\t\t\t\tExpect(clientKeyVol.Secret.Items).To(HaveLen(1))\n929\t\t\t\t\t\t\tExpect(clientKeyVol.Secret.Items[0].Key).To(Equal(\"user.key\"))\n930\t\t\t\t\t\t\tExpect(clientKeyVol.Secret.Items[0].Path).To(Equal(\"file\"))\n931\t\t\t\t\t\t\tExpect(clientKeyVol.Secret.DefaultMode).NotTo(BeNil())\n932\t\t\t\t\t\t\tExpect(*clientKeyVol.Secret.DefaultMode).To(Equal(int32(288)))\n933\t\n934\t\t\t\t\t\t\t// server-cert volume\n935\t\t\t\t\t\t\tExpect(volumeMap).To(HaveKey(\"server-cert\"))\n936\t\t\t\t\t\t\tserverCertVol := volumeMap[\"server-cert\"]\n937\t\t\t\t\t\t\tExpect(serverCertVol.Secret).NotTo(BeNil())\n938\t\t\t\t\t\t\tExpect(serverCertVol.Secret.SecretName).To(Equal(\"kafka-ca-cert\"))\n939\t\t\t\t\t\t\tExpect(serverCertVol.Secret.Items).To(HaveLen(1))\n940\t\t\t\t\t\t\tExpect(serverCertVol.Secret.Items[0].Key).To(Equal(\"ca.crt\"))\n941\t\t\t\t\t\t\tExpect(serverCertVol.Secret.Items[0].Path).To(Equal(\"file\"))\n942\t\t\t\t\t\t\tExpect(serverCertVol.Secret.DefaultMode).NotTo(BeNil())\n943\t\t\t\t\t\t\tExpect(*serverCertVol.Secret.DefaultMode).To(Equal(int32(288)))\n944\t\n945\t\t\t\t\t\t\t// volume mounts\n946\t\t\t\t\t\t\tExpect(mountMap).To(HaveKey(\"/client-cert\"))\n947\t\t\t\t\t\t\tExpect(mountMap[\"/client-cert\"].Name).To(Equal(\"client-cert\"))\n948\t\t\t\t\t\t\tExpect(mountMap).To(HaveKey(\"/client-key\"))\n949\t\t\t\t\t\t\tExpect(mountMap[\"/client-key\"].Name).To(Equal(\"client-key\"))\n950\t\t\t\t\t\t\tExpect(mountMap).To(HaveKey(\"/server-cert\"))\n951\t\t\t\t\t\t\tExpect(mountMap[\"/server-cert\"].Name).To(Equal(\"server-cert\"))\n952\t\t\t\t\t\t} else {\n953\t\t\t\t\t\t\t// No cert volumes or mounts\n954\t\t\t\t\t\t\tExpect(volumeMap).NotTo(HaveKey(\"client-cert\"))\n955\t\t\t\t\t\t\tExpect(volumeMap).NotTo(HaveKey(\"client-key\"))\n956\t\t\t\t\t\t\tExpect(volumeMap).NotTo(HaveKey(\"server-cert\"))\n957\t\t\t\t\t\t\tExpect(mountMap).NotTo(HaveKey(\"/client-cert\"))\n958\t\t\t\t\t\t\tExpect(mountMap).NotTo(HaveKey(\"/client-key\"))\n959\t\t\t\t\t\t\tExpect(mountMap).NotTo(HaveKey(\"/server-cert\"))\n960\t\t\t\t\t\t}\n961\t\t\t\t\t},\n962\t\t\t\t\tEntry(\"both secrets set — mounts three cert volumes\",\n963\t\t\t\t\t\t\"kafka-client-cert\", \"kafka-ca-cert\", true),\n964\t\t\t\t\tEntry(\"neither secret set — no cert volumes\",\n965\t\t\t\t\t\t\"\", \"\", false),\n966\t\t\t\t\tEntry(\"only client cert set — no cert volumes\",\n967\t\t\t\t\t\t\"kafka-client-cert\", \"\", false),\n968\t\t\t\t\tEntry(\"only CA cert set — no cert volumes\",\n969\t\t\t\t\t\t\"\", \"kafka-ca-cert\", false),\n970\t\t\t\t)\n971\t\t\t})\n972\t\t})\n973\t\n974\t\tDescribe(\"IsJobActive\", func() {\n975\t\t\tIt(\"returns false when no jobs exist\", func() {\n976\t\t\t\tactive, err := jobSpawner.IsJobActive(ctx, lib.TaskIdentifier(\"tid-1\"))\n977\t\t\t\tExpect(err).To(BeNil())\n978\t\t\t\tExpect(active).To(BeFalse())\n979\t\t\t})\n980\t\n981\t\t\tIt(\"returns true when active job exists (status.active > 0)\", func() {\n982\t\t\t\tjob := &batchv1.Job{\n983\t\t\t\t\tObjectMeta: metav1.ObjectMeta{\n984\t\t\t\t\t\tName:      \"claude-20260403173500\",\n985\t\t\t\t\t\tNamespace: \"test-ns\",\n986\t\t\t\t\t\tLabels:    map[string]string{\"agent.benjamin-borbe.de/task-id\": \"tid-2\"},\n987\t\t\t\t\t},\n988\t\t\t\t\tStatus: batchv1.JobStatus{\n989\t\t\t\t\t\tActive: 1,\n990\t\t\t\t\t},\n991\t\t\t\t}\n992\t\t\t\tfakeClient = fake.NewClientset(job)\n993\t\t\t\tjobSpawner = spawner.NewJobSpawner(\n994\t\t\t\t\tfakeClient,\n995\t\t\t\t\t\"test-ns\",\n996\t\t\t\t\t\"kafka:9092\",\n997\t\t\t\t\t\"develop\",\n998\t\t\t\t\t\"test-prefix\",\n999\t\t\t\t\tcurrentDateTime,\n1000\t\t\t\t\t1800,\n1001\t\t\t\t\t\"\",\n1002\t\t\t\t\t\"\",\n1003\t\t\t\t)\n1004\t\n1005\t\t\t\tactive, err := jobSpawner.IsJobActive(ctx, lib.TaskIdentifier(\"tid-2\"))\n1006\t\t\t\tExpect(err).To(BeNil())\n1007\t\t\t\tExpect(active).To(BeTrue())\n1008\t\t\t})\n1009\t\n1010\t\t\tIt(\"CountActiveJobs counts only non-terminal jobs for the assignee\", func() {\n1011\t\t\t\tmkJob := func(name, assignee stri