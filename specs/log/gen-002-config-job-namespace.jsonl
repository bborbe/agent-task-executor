{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-94f19fedb59e2f09","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"strings\"\n9\t\n10\t\tagentv1 \"github.com/bborbe/agent-task-executor/k8s/apis/agent.benjamin-borbe.de/v1\"\n11\t)\n12\t\n13\t// appendBranchTag appends \":\"+branch to image as a tag, UNLESS image already\n14\t// carries a tag (or digest). An image is considered already-tagged when a \":\"\n15\t// appears in its final path segment — i.e. after the last \"/\". This excludes\n16\t// registry-port colons (e.g. \"reg:443/repo\" is untagged) but catches both\n17\t// \"repo:tag\" and digest refs \"repo@sha256:...\". Pinning an image to an immutable\n18\t// semver tag (e.g. \"reg/bborbe/agent-claude:v0.1.1\") therefore leaves it\n19\t// untouched instead of producing an invalid \"…:v0.1.1:dev\".\n20\tfunc appendBranchTag(image string, branch string) string {\n21\t\tif strings.LastIndex(image, \":\") > strings.LastIndex(image, \"/\") {\n22\t\t\treturn image\n23\t\t}\n24\t\treturn image + \":\" + branch\n25\t}\n26\t\n27\t// AgentConfiguration defines the container image and environment for one agent type.\n28\ttype AgentConfiguration struct {\n29\t\t// Assignee is the task frontmatter assignee value that routes to this agent.\n30\t\tAssignee string\n31\t\t// TaskType is the singular task_type value from ConfigSpec.TaskType.\n32\t\t// Deprecated in favour of TaskTypes; stays functional.\n33\t\tTaskType string\n34\t\t// TaskTypes is the list of task_type values from ConfigSpec.TaskTypes.\n35\t\t// Nil when the CRD only sets the singular TaskType field.\n36\t\tTaskTypes []string\n37\t\t// Image is the container image base name (without tag). Tag is appended at runtime from branch.\n38\t\tImage string\n39\t\t// Env holds per-agent environment variables (e.g. API keys, config).\n40\t\t// These are merged with shared env vars (TASK_CONTENT, TASK_ID, KAFKA_BROKERS, BRANCH)\n41\t\t// when spawning the K8s Job.\n42\t\tEnv map[string]string\n43\t\t// VolumeClaim is the name of an existing PVC to mount into the container.\n44\t\t// Empty means no volume mount.\n45\t\tVolumeClaim string\n46\t\t// VolumeMountPath is the container path where the PVC is mounted.\n47\t\t// Required when VolumeClaim is set.\n48\t\tVolumeMountPath string\n49\t\t// SecretName is the name of a K8s Secret to mount as envFrom on the container.\n50\t\t// Empty means no secret is mounted.\n51\t\tSecretName string\n52\t\t// Resources declares optional resource requests and limits for the agent container.\n53\t\t// Nil means \"do not set, keep the k8s builder default\".\n54\t\tResources *agentv1.AgentResources\n55\t\t// MaxConcurrentJobs caps how many Jobs this agent may run at once.\n56\t\t// 0 means unlimited.\n57\t\tMaxConcurrentJobs int\n58\t\t// PriorityClassName is the Kubernetes PriorityClass name to stamp onto spawned Job PodTemplates.\n59\t\tPriorityClassName string\n60\t\t// ImagePullSecret is the name of the K8s Secret used for image pulls.\n61\t\t// Empty uses the cluster default (typically \"docker\").\n62\t\tImagePullSecret string\n63\t\t// Trigger declares the per-agent phase and status conditions under which the executor spawns a Job.\n64\t\tTrigger *agentv1.Trigger\n65\t\t// ZombieJobTimeoutSeconds mirrors ConfigSpec.ZombieJobTimeoutSeconds. The\n66\t\t// spawner stamps this value onto Job.Spec.ActiveDeadlineSeconds; the sweeper\n67\t\t// uses it as the elapsed-time threshold. nil means \"use the default\n68\t\t// DefaultZombieJobTimeoutSeconds from the CRD types package\".\n69\t\tZombieJobTimeoutSeconds *int32\n70\t}\n71\t\n72\t// EffectiveZombieJobTimeoutSeconds returns the effective deadline in seconds:\n73\t// the configured value when non-nil, else agentv1.DefaultZombieJobTimeoutSeconds.\n74\tfunc (a AgentConfiguration) EffectiveZombieJobTimeoutSeconds() int32 {\n75\t\tif a.ZombieJobTimeoutSeconds != nil {\n76\t\t\treturn *a.ZombieJobTimeoutSeconds\n77\t\t}\n78\t\treturn agentv1.DefaultZombieJobTimeoutSeconds\n79\t}\n80\t\n81\t// AgentConfigurations is a list of agent configurations.\n82\ttype AgentConfigurations []AgentConfiguration\n83\t\n84\t// FindByAssignee returns the configuration for the given assignee name.\n85\t// Returns the config and true if found, zero value and false otherwise.\n86\tfunc (a AgentConfigurations) FindByAssignee(assignee string) (AgentConfiguration, bool) {\n87\t\tfor _, c := range a {\n88\t\t\tif c.Assignee == assignee {\n89\t\t\t\treturn c, true\n90\t\t\t}\n91\t\t}\n92\t\treturn AgentConfiguration{}, false\n93\t}\n94\t\n95\t// TaggedConfigurations returns a new AgentConfigurations with the branch appended\n96\t// to each untagged image as a tag (e.g. \"registry/image\" + \":\" + \"dev\" →\n97\t// \"registry/image:dev\"). Images that already carry a tag or digest are left as-is\n98\t// (see appendBranchTag), so semver-pinned images are not double-tagged.\n99\tfunc (a AgentConfigurations) TaggedConfigurations(branch string) AgentConfigurations {\n100\t\tresult := make(AgentConfigurations, len(a))\n101\t\tfor i, c := range a {\n102\t\t\tresult[i] = AgentConfiguration{\n103\t\t\t\tAssignee:                c.Assignee,\n104\t\t\t\tTaskType:                c.TaskType,\n105\t\t\t\tTaskTypes:               append([]string(nil), c.TaskTypes...),\n106\t\t\t\tImage:                   appendBranchTag(c.Image, branch),\n107\t\t\t\tEnv:                     c.Env,\n108\t\t\t\tVolumeClaim:             c.VolumeClaim,\n109\t\t\t\tVolumeMountPath:         c.VolumeMountPath,\n110\t\t\t\tSecretName:              c.SecretName,\n111\t\t\t\tResources:               c.Resources.DeepCopy(),\n112\t\t\t\tMaxConcurrentJobs:       c.MaxConcurrentJobs,\n113\t\t\t\tPriorityClassName:       c.PriorityClassName,\n114\t\t\t\tImagePullSecret:         c.ImagePullSecret,\n115\t\t\t\tTrigger:                 c.Trigger,\n116\t\t\t\tZombieJobTimeoutSeconds: c.ZombieJobTimeoutSeconds,\n117\t\t\t}\n118\t\t}\n119\t\treturn result\n120\t}\n121\t"}]},"parent_tool_use_id":"chatcmpl-tool-91a56ff2901772f3","session_id":"649c3b71-f1fd-46a9-a844-34ab62b5da5e","uuid":"a850a577-9acf-444e-9ee8-5f1d78925aa5","timestamp":"2026-09-03T17:53:32.328Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 2 (spawner)"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-aa8b391f7d9cccda","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\tstderrors \"errors\"\n10\t\n11\t\t\"github.com/bborbe/cqrs/base\"\n12\t\t\"github.com/bborbe/errors\"\n13\t\t\"github.com/bborbe/k8s\"\n14\t\n15\t\tagentv1 \"github.com/bborbe/agent-task-executor/k8s/apis/agent.benjamin-borbe.de/v1\"\n16\t)\n17\t\n18\t// ErrConfigNotFound is returned by ConfigResolver.Resolve when no\n19\t// Config in the store has a matching Spec.Assignee.\n20\tvar ErrConfigNotFound = stderrors.New(\"config not found\")\n21\t\n22\t//counterfeiter:generate -o ../mocks/config_resolver.go --fake-name FakeConfigResolver . ConfigResolver\n23\t\n24\t// ConfigResolver looks up the AgentConfiguration for an assignee by\n25\t// iterating the in-memory Config store and converting the matching entry.\n26\ttype ConfigResolver interface {\n27\t\tResolve(ctx context.Context, assignee string) (AgentConfiguration, error)\n28\t}\n29\t\n30\t// NewConfigResolver returns a ConfigResolver backed by the given\n31\t// typed store. The branch is captured here and appended as the image tag at\n32\t// resolution time. Resolutions are scoped to the given vault: each task's\n33\t// plain assignee is matched against the composed {assignee}-{vaultName}\n34\t// Config assignee, so per-vault Config CRs apply per executor instance. When\n35\t// no composed Config exists, Resolve falls back to the plain assignee, so the\n36\t// singular shared-topic executor (v0.6.x Config CRs without a vault suffix)\n37\t// keeps resolving on the v0.7+ line.\n38\tfunc NewConfigResolver(\n39\t\tprovider k8s.Provider[agentv1.Config],\n40\t\tbranch base.Branch,\n41\t\tvaultName string,\n42\t) ConfigResolver {\n43\t\treturn &configResolver{provider: provider, branch: branch, vaultName: vaultName}\n44\t}\n45\t\n46\ttype configResolver struct {\n47\t\tprovider  k8s.Provider[agentv1.Config]\n48\t\tbranch    base.Branch\n49\t\tvaultName string\n50\t}\n51\t\n52\tfunc (r *configResolver) Resolve(\n53\t\tctx context.Context,\n54\t\tassignee string,\n55\t) (AgentConfiguration, error) {\n56\t\titems, err := r.provider.Get(ctx)\n57\t\tif err != nil {\n58\t\t\treturn AgentConfiguration{}, errors.Wrapf(ctx, err, \"list agent configs\")\n59\t\t}\n60\t\tcomposed := assignee + \"-\" + r.vaultName\n61\t\tfor _, it := range items {\n62\t\t\tselect {\n63\t\t\tcase <-ctx.Done():\n64\t\t\t\treturn AgentConfiguration{}, errors.Wrapf(\n65\t\t\t\t\tctx,\n66\t\t\t\t\tctx.Err(),\n67\t\t\t\t\t\"resolve config %q cancelled\",\n68\t\t\t\t\tcomposed,\n69\t\t\t\t)\n70\t\t\tdefault:\n71\t\t\t}\n72\t\t\tif it.Spec.Assignee == composed {\n73\t\t\t\treturn convert(ctx, it, r.branch.String())\n74\t\t\t}\n75\t\t}\n76\t\t// No {assignee}-{vaultName} Config: fall back to the plain assignee so the\n77\t\t// singular executor's un-suffixed Config CRs (v0.6.x naming) keep resolving.\n78\t\t// Per-vault installs still match composed first, so vault scoping wins when\n79\t\t// a composed Config exists.\n80\t\tfor _, it := range items {\n81\t\t\tselect {\n82\t\t\tcase <-ctx.Done():\n83\t\t\t\treturn AgentConfiguration{}, errors.Wrapf(\n84\t\t\t\t\tctx,\n85\t\t\t\t\tctx.Err(),\n86\t\t\t\t\t\"resolve config %q cancelled\",\n87\t\t\t\t\tassignee,\n88\t\t\t\t)\n89\t\t\tdefault:\n90\t\t\t}\n91\t\t\tif it.Spec.Assignee == assignee {\n92\t\t\t\treturn convert(ctx, it, r.branch.String())\n93\t\t\t}\n94\t\t}\n95\t\treturn AgentConfiguration{}, errors.Wrapf(\n96\t\t\tctx,\n97\t\t\tErrConfigNotFound,\n98\t\t\t\"find composed assignee %q\",\n99\t\t\tcomposed,\n100\t\t)\n101\t}\n102\t\n103\tfunc convert(ctx context.Context, obj agentv1.Config, branch string) (AgentConfiguration, error) {\n104\t\tenv, err := copyEnv(ctx, obj.Spec.Env)\n105\t\tif err != nil {\n106\t\t\treturn AgentConfiguration{}, errors.Wrapf(ctx, err, \"convert config %q\", obj.Spec.Assignee)\n107\t\t}\n108\t\treturn AgentConfiguration{\n109\t\t\tAssignee:                obj.Spec.Assignee,\n110\t\t\tTaskType:                obj.Spec.TaskType,\n111\t\t\tTaskTypes:               append([]string(nil), obj.Spec.TaskTypes...),\n112\t\t\tImage:                   appendBranchTag(obj.Spec.Image, branch),\n113\t\t\tEnv:                     env,\n114\t\t\tSecretName:              obj.Spec.SecretName,\n115\t\t\tVolumeClaim:             obj.Spec.VolumeClaim,\n116\t\t\tVolumeMountPath:         obj.Spec.VolumeMountPath,\n117\t\t\tResources:               obj.Spec.Resources.DeepCopy(),\n118\t\t\tMaxConcurrentJobs:       obj.Spec.MaxConcurrentJobs,\n119\t\t\tPriorityClassName:       obj.Spec.PriorityClassName,\n120\t\t\tTrigger:                 obj.Spec.Trigger,\n121\t\t\tZombieJobTimeoutSeconds: obj.Spec.ZombieJobTimeoutSeconds,\n122\t\t}, nil\n123\t}\n124\t\n125\tfunc copyEnv(ctx context.Context, in map[string]string) (map[string]string, error) {\n126\t\tout := make(map[string]string, len(in))\n127\t\tfor k, v := range in {\n128\t\t\tselect {\n129\t\t\tcase <-ctx.Done():\n130\t\t\t\treturn nil, errors.Wrapf(ctx, ctx.Err(), \"copy env cancelled\")\n131\t\t\tdefault:\n132\t\t\t}\n133\t\t\tout[k] = v\n134\t\t}\n135\t\treturn out, nil\n136\t}\n137\t"}]},"parent_tool_use_id":"chatcmpl-tool-91a56ff2901772f3","session_id":"649c3b71-f1fd-46a9-a844-34ab62b5da5e","uuid":"96f6ffd9-f873-4ceb-a145-6d7334e396e2","timestamp":"2026-09-03T17:53:32.329Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 2 (spawner)"}
