{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-9553db4297f89e06","type":"tool_result","content":"1300\t\t\t\tExpect(job.Spec.ActiveDeadlineSeconds).NotTo(BeNil())\n1301\t\t\t\tExpect(*job.Spec.ActiveDeadlineSeconds).To(Equal(int64(1800)))\n1302\t\t\t})\n1303\t\t})\n1304\t\n1305\t\t// Regression guard: SpawnJob and IsJobActive must agree on the label key used\n1306\t\t// to identify a Job. A mismatch causes the executor to treat a freshly-spawned\n1307\t\t// Job as \"no active job\" and respawn another every poll cycle.\n1308\t\tDescribe(\"SpawnJob + IsJobActive label contract\", func() {\n1309\t\t\tIt(\"IsJobActive returns true for a Job just spawned via SpawnJob (same taskID)\", func() {\n1310\t\t\t\ttaskID := lib.TaskIdentifier(\"e2e-tid-contract-1\")\n1311\t\t\t\ttask := lib.Task{\n1312\t\t\t\t\tTaskIdentifier: taskID,\n1313\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\"},\n1314\t\t\t\t\tContent:        lib.TaskContent(\"do the work\"),\n1315\t\t\t\t}\n1316\t\t\t\tconfig := pkg.AgentConfiguration{\n1317\t\t\t\t\tAssignee: \"claude\",\n1318\t\t\t\t\tImage:    \"my-image:latest\",\n1319\t\t\t\t}\n1320\t\n1321\t\t\t\t_, err := jobSpawner.SpawnJob(ctx, task, config)\n1322\t\t\t\tExpect(err).To(BeNil())\n1323\t\n1324\t\t\t\tactive, err := jobSpawner.IsJobActive(ctx, taskID)\n1325\t\t\t\tExpect(err).To(BeNil())\n1326\t\t\t\tExpect(active).\n1327\t\t\t\t\tTo(BeTrue(), \"IsJobActive must recognise the Job that SpawnJob just created\")\n1328\t\t\t})\n1329\t\n1330\t\t\tIt(\"IsJobActive returns false for a different taskID than the one spawned\", func() {\n1331\t\t\t\tspawned := lib.TaskIdentifier(\"e2e-tid-contract-2\")\n1332\t\t\t\tother := lib.TaskIdentifier(\"e2e-tid-contract-other\")\n1333\t\t\t\ttask := lib.Task{\n1334\t\t\t\t\tTaskIdentifier: spawned,\n1335\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\"},\n1336\t\t\t\t}\n1337\t\t\t\t_, err := jobSpawner.SpawnJob(ctx, task, pkg.AgentConfiguration{\n1338\t\t\t\t\tAssignee: \"claude\", Image: \"my-image:latest\",\n1339\t\t\t\t})\n1340\t\t\t\tExpect(err).To(BeNil())\n1341\t\n1342\t\t\t\tactive, err := jobSpawner.IsJobActive(ctx, other)\n1343\t\t\t\tExpect(err).To(BeNil())\n1344\t\t\t\tExpect(active).\n1345\t\t\t\t\tTo(BeFalse(), \"IsJobActive must not match a different task's spawned Job\")\n1346\t\t\t})\n1347\t\t})\n1348\t\n1349\t\tDescribe(\"applyTaskIDLabel\", func() {\n1350\t\t\tIt(\"creates new Labels map when job.Labels is nil (via Create reactor)\", func() {\n1351\t\t\t\t// Use a Create reactor to capture the job at the moment of creation.\n1352\t\t\t\t// applyTaskIDLabel is called BEFORE the K8s Create call, so the\n1353\t\t\t\t// captured job will have the labels already set.\n1354\t\t\t\tvar capturedJob *batchv1.Job\n1355\t\t\t\tfakeClient.PrependReactor(\n1356\t\t\t\t\t\"create\",\n1357\t\t\t\t\t\"jobs\",\n1358\t\t\t\t\tfunc(action k8stesting.Action) (bool, runtime.Object, error) {\n1359\t\t\t\t\t\tcreateAction, ok := action.(k8stesting.CreateAction)\n1360\t\t\t\t\t\tif !ok {\n1361\t\t\t\t\t\t\treturn false, nil, nil\n1362\t\t\t\t\t\t}\n1363\t\t\t\t\t\tcapturedJob, ok = createAction.GetObject().(*batchv1.Job)\n1364\t\t\t\t\t\tif !ok {\n1365\t\t\t\t\t\t\treturn false, nil, nil\n1366\t\t\t\t\t\t}\n1367\t\t\t\t\t\treturn false, nil, nil // pass through to fake client\n1368\t\t\t\t\t},\n1369\t\t\t\t)\n1370\t\t\t\ttask := lib.Task{\n1371\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"nil-labels-task\"),\n1372\t\t\t\t\tFrontmatter:    lib.TaskFrontmatter{\"assignee\": \"claude\"},\n1373\t\t\t\t}\n1374\t\t\t\t_, err := jobSpawner.SpawnJob(ctx, task, pkg.AgentConfiguration{\n1375\t\t\t\t\tAssignee: \"claude\", Image: \"my-image:latest\",\n1376\t\t\t\t})\n1377\t\t\t\tExpect(err).To(BeNil())\n1378\t\t\t\tExpect(capturedJob).NotTo(BeNil())\n1379\t\t\t\tExpect(capturedJob.Labels).NotTo(BeNil())\n1380\t\t\t\tExpect(\n1381\t\t\t\t\tcapturedJob.Labels[\"agent.benjamin-borbe.de/task-id\"],\n1382\t\t\t\t).To(Equal(\"nil-labels-task\"))\n1383\t\t\t\tExpect(capturedJob.Spec.Template.Labels).NotTo(BeNil())\n1384\t\t\t\tExpect(\n1385\t\t\t\t\tcapturedJob.Spec.Template.Labels[\"agent.benjamin-borbe.de/task-id\"],\n1386\t\t\t\t).To(Equal(\"nil-labels-task\"))\n1387\t\t\t})\n1388\t\t})\n1389\t})"}]},"parent_tool_use_id":"chatcmpl-tool-91a56ff2901772f3","session_id":"649c3b71-f1fd-46a9-a844-34ab62b5da5e","uuid":"75d6ecbf-1199-44f2-a1fa-bceaeb7643af","timestamp":"2026-09-03T17:53:28.242Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 2 (spawner)"}
