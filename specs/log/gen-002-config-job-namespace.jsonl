{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-bce70d24dd96c310","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"time\"\n10\t\n11\t\t\"github.com/bborbe/errors\"\n12\t\tlibk8s \"github.com/bborbe/k8s\"\n13\t\tapiextensionsv1 \"k8s.io/apiextensions-apiserver/pkg/apis/apiextensions/v1\"\n14\t\tapiextensionsclient \"k8s.io/apiextensions-apiserver/pkg/client/clientset/clientset\"\n15\t\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"\n16\t\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"\n17\t\t\"k8s.io/client-go/rest\"\n18\t\t\"k8s.io/client-go/tools/cache\"\n19\t\n20\t\tagentv1 \"github.com/bborbe/agent-task-executor/k8s/apis/agent.benjamin-borbe.de/v1\"\n21\t\tversioned \"github.com/bborbe/agent-task-executor/k8s/client/clientset/versioned\"\n22\t\tagentinformers \"github.com/bborbe/agent-task-executor/k8s/client/informers/externalversions\"\n23\t)\n24\t\n25\t// crdMinZero is the lower bound for integer CRD fields that count things.\n26\t// apiextensionsv1 takes *float64, so it needs an addressable value.\n27\tvar crdMinZero = float64(0)\n28\t\n29\t// crdMinZombieSweeperInterval / crdMinZombieJobTimeout mirror the chart's\n30\t// config-crd.yaml minimums and the admission guards in the v1 types package.\n31\tvar (\n32\t\tcrdMinZombieSweeperInterval = float64(agentv1.MinZombieSweeperIntervalSeconds)\n33\t\tcrdMinZombieJobTimeout      = float64(agentv1.MinZombieJobTimeoutSeconds)\n34\t)\n35\t\n36\t//counterfeiter:generate -o ../mocks/k8s_connector.go --fake-name FakeK8sConnector . K8sConnector\n37\t\n38\t// K8sConnector installs the Config CRD and starts an informer.\n39\ttype K8sConnector interface {\n40\t\tSetupCustomResourceDefinition(ctx context.Context) error\n41\t\tListen(\n42\t\t\tctx context.Context,\n43\t\t\tnamespace libk8s.Namespace,\n44\t\t\thandler cache.ResourceEventHandler,\n45\t\t) error\n46\t}\n47\t\n48\t// CRDClientBuilder constructs the apiextensions clientset from a rest.Config.\n49\t// Injected to allow fake clientsets in tests.\n50\ttype CRDClientBuilder func(*rest.Config) (apiextensionsclient.Interface, error)\n51\t\n52\t// DefaultCRDClientBuilder wraps apiextensionsclient.NewForConfig to satisfy CRDClientBuilder.\n53\tfunc DefaultCRDClientBuilder(c *rest.Config) (apiextensionsclient.Interface, error) {\n54\t\treturn apiextensionsclient.NewForConfig(c)\n55\t}\n56\t\n57\t// NewK8sConnector returns a K8sConnector using the given rest config and builder.\n58\t// Production callers pass DefaultCRDClientBuilder as the builder.\n59\tfunc NewK8sConnector(config *rest.Config, crdBuilder CRDClientBuilder) K8sConnector {\n60\t\treturn &k8sConnector{config: config, crdBuilder: crdBuilder}\n61\t}\n62\t\n63\t// k8sConnector implements K8sConnector using a REST config and a CRD client builder.\n64\ttype k8sConnector struct {\n65\t\tconfig     *rest.Config\n66\t\tcrdBuilder CRDClientBuilder\n67\t}\n68\t\n69\t// SetupCustomResourceDefinition installs or updates the Config CRD on the cluster.\n70\tfunc (c *k8sConnector) SetupCustomResourceDefinition(ctx context.Context) error {\n71\t\tclientset, err := c.crdBuilder(c.config)\n72\t\tif err != nil {\n73\t\t\treturn errors.Wrapf(ctx, err, \"build apiextensions clientset\")\n74\t\t}\n75\t\tcrds := clientset.ApiextensionsV1().CustomResourceDefinitions()\n76\t\texisting, err := crds.Get(ctx, \"configs.agent.benjamin-borbe.de\", metav1.GetOptions{})\n77\t\tif apierrors.IsNotFound(err) {\n78\t\t\tcrd := &apiextensionsv1.CustomResourceDefinition{\n79\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"configs.agent.benjamin-borbe.de\"},\n80\t\t\t\tSpec:       desiredCRDSpec(),\n81\t\t\t}\n82\t\t\tif _, err := crds.Create(ctx, crd, metav1.CreateOptions{}); err != nil {\n83\t\t\t\treturn errors.Wrapf(ctx, err, \"create CRD\")\n84\t\t\t}\n85\t\t\treturn nil\n86\t\t}\n87\t\tif err != nil {\n88\t\t\treturn errors.Wrapf(ctx, err, \"get CRD\")\n89\t\t}\n90\t\texisting.Spec = desiredCRDSpec()\n91\t\tif _, err := crds.Update(ctx, existing, metav1.UpdateOptions{}); err != nil {\n92\t\t\treturn errors.Wrapf(ctx, err, \"update CRD\")\n93\t\t}\n94\t\treturn nil\n95\t}\n96\t\n97\t// defaultResync is the re-sync period for the shared informer factory.\n98\tconst defaultResync = 5 * time.Minute\n99\t\n100\t// Listen starts a Kubernetes informer for Config resources in the given namespace\n101\t// and dispatches events to the provided handler until ctx is cancelled.\n102\tfunc (c *k8sConnector) Listen(\n103\t\tctx context.Context,\n104\t\tnamespace libk8s.Namespace,\n105\t\thandler cache.ResourceEventHandler,\n106\t) error {\n107\t\tclientset, err := versioned.NewForConfig(c.config)\n108\t\tif err != nil {\n109\t\t\treturn errors.Wrapf(ctx, err, \"build agentconfig clientset\")\n110\t\t}\n111\t\tfactory := agentinformers.NewSharedInformerFactoryWithOptions(\n112\t\t\tclientset,\n113\t\t\tdefaultResync,\n114\t\t\tagentinformers.WithNamespace(namespace.String()),\n115\t\t)\n116\t\tinformer := factory.Agent().V1().Configs().Informer()\n117\t\tif _, err := informer.AddEventHandler(handler); err != nil {\n118\t\t\treturn errors.Wrapf(ctx, err, \"add event handler\")\n119\t\t}\n120\t\tstopCh := make(chan struct{})\n121\t\tfactory.Start(stopCh)\n122\t\tdefer close(stopCh)\n123\t\tselect {\n124\t\tcase <-ctx.Done():\n125\t\tcase <-stopCh:\n126\t\t}\n127\t\treturn nil\n128\t}\n129\t\n130\tfunc desiredCRDSpec() apiextensionsv1.CustomResourceDefinitionSpec {\n131\t\treturn apiextensionsv1.CustomResourceDefinitionSpec{\n132\t\t\tGroup: \"agent.benjamin-borbe.de\",\n133\t\t\tNames: apiextensionsv1.CustomResourceDefinitionNames{\n134\t\t\t\tKind:       \"Config\",\n135\t\t\t\tListKind:   \"ConfigList\",\n136\t\t\t\tPlural:     \"configs\",\n137\t\t\t\tSingular:   \"config\",\n138\t\t\t\tShortNames: []string{\"cfg\"},\n139\t\t\t},\n140\t\t\tScope: apiextensionsv1.NamespaceScoped,\n141\t\t\tVersions: []apiextensionsv1.CustomResourceDefinitionVersion{\n142\t\t\t\t{\n143\t\t\t\t\tName:    \"v1\",\n144\t\t\t\t\tServed:  true,\n145\t\t\t\t\tStorage: true,\n146\t\t\t\t\tSchema: &apiextensionsv1.CustomResourceValidation{\n147\t\t\t\t\t\tOpenAPIV3Schema: &apiextensionsv1.JSONSchemaProps{\n148\t\t\t\t\t\t\tType: \"object\",\n149\t\t\t\t\t\t\tProperties: map[string]apiextensionsv1.JSONSchemaProps{\n150\t\t\t\t\t\t\t\t\"spec\": configSpecSchema(),\n151\t\t\t\t\t\t\t},\n152\t\t\t\t\t\t},\n153\t\t\t\t\t},\n154\t\t\t\t},\n155\t\t\t},\n156\t\t\tPreserveUnknownFields: false,\n157\t\t}\n158\t}\n159\t\n160\t// configSpecSchema is the authoritative schema for Config.spec — SetupCustomResourceDefinition\n161\t// overwrites the cluster CRD with it on EVERY executor start.\n162\t//\n163\t// Any field added to AgentConfiguration must be added here too, or the API server prunes it\n164\t// from every Config within seconds of the next restart. The failure is silent and reads as\n165\t// \"the operator never set it\": v0.5.0 shipped maxConcurrentJobs in AgentConfiguration and in\n166\t// the Helm chart's crds/ but not here, so the field was pruned everywhere, a pruned integer\n167\t// read as 0, and the cap treated 0 as unlimited — the feature was inert in prod for weeks\n168\t// while hand-applied CRD fixes appeared to \"revert\" (each revert was just the next pod start).\n169\t//\n170\t// Keep in sync with helm/crds/config-crd.yaml in bborbe/agent.\n171\tfunc configSpecSchema() apiextensionsv1.JSONSchemaProps {\n172\t\treturn apiextensionsv1.JSONSchemaProps{\n173\t\t\tType:         \"object\",\n174\t\t\tRequired:     []string{\"assignee\", \"image\", \"heartbeat\"},\n175\t\t\tXValidations: configSpecValidations(),\n176\t\t\tProperties:   configSpecProperties(),\n177\t\t}\n178\t}\n179\t\n180\tfunc configSpecValidations() apiextensionsv1.ValidationRules {\n181\t\treturn apiextensionsv1.ValidationRules{\n182\t\t\t{\n183\t\t\t\tRule:    \"(has(self.taskType) && size(self.taskType) > 0) || (has(self.taskTypes) && size(self.taskTypes) > 0)\",\n184\t\t\t\tMessage: \"at least one of spec.taskType or spec.taskTypes must be non-empty\",\n185\t\t\t},\n186\t\t}\n187\t}\n188\t\n189\tfunc configSpecProperties() map[string]apiextensionsv1.JSONSchemaProps {\n190\t\tminLen := int64(1)\n191\t\tmaxLen63 := int64(63)\n192\t\tresourceList := apiextensionsv1.JSONSchemaProps{\n193\t\t\tType: \"object\",\n194\t\t\tProperties: map[string]apiextensionsv1.JSONSchemaProps{\n195\t\t\t\t\"cpu\":               {Type: \"string\"},\n196\t\t\t\t\"memory\":            {Type: \"string\"},\n197\t\t\t\t\"ephemeral-storage\": {Type: \"string\"},\n198\t\t\t},\n199\t\t}\n200\t\treturn map[string]apiextensionsv1.JSONSchemaProps{\n201\t\t\t\"assignee\":  {Type: \"string\", MinLength: &minLen},\n202\t\t\t\"image\":     {Type: \"string\", MinLength: &minLen},\n203\t\t\t\"heartbeat\": {Type: \"string\", Pattern: \"^[0-9]+(s|m|h)$\"},\n204\t\t\t\"taskType\": {\n205\t\t\t\tType:      \"string\",\n206\t\t\t\tPattern:   `^[a-z0-9-]+$`,\n207\t\t\t\tMaxLength: &maxLen63,\n208\t\t\t},\n209\t\t\t\"taskTypes\": {\n210\t\t\t\tType: \"array\",\n211\t\t\t\tItems: &apiextensionsv1.JSONSchemaPropsOrArray{\n212\t\t\t\t\tSchema: &apiextensionsv1.JSONSchemaProps{\n213\t\t\t\t\t\tType:      \"string\",\n214\t\t\t\t\t\tPattern:   `^[a-z0-9-]+$`,\n215\t\t\t\t\t\tMaxLength: &maxLen63,\n216\t\t\t\t\t},\n217\t\t\t\t},\n218\t\t\t},\n219\t\t\t\"resources\": {\n220\t\t\t\tType: \"object\",\n221\t\t\t\tProperties: map[string]apiextensionsv1.JSONSchemaProps{\n222\t\t\t\t\t\"requests\": resourceList,\n223\t\t\t\t\t\"limits\":   resourceList,\n224\t\t\t\t},\n225\t\t\t},\n226\t\t\t\"env\": {\n227\t\t\t\tType: \"object\",\n228\t\t\t\tAdditionalProperties: &apiextensionsv1.JSONSchemaPropsOrBool{\n229\t\t\t\t\tSchema: &apiextensionsv1.JSONSchemaProps{Type: \"string\"},\n230\t\t\t\t},\n231\t\t\t},\n232\t\t\t\"secretName\":      {Type: \"string\"},\n233\t\t\t\"volumeClaim\":     {Type: \"string\"},\n234\t\t\t\"volumeMountPath\": {Type: \"string\"},\n235\t\t\t\"priorityClassName\": {\n236\t\t\t\tType:    \"string\",\n237\t\t\t\tPattern: \"^[a-z0-9]([-a-z0-9]*[a-z0-9])?$\",\n238\t\t\t},\n239\t\t\t\"imagePullSecret\": {Type: \"string\"},\n240\t\t\t// 0 = unlimited (see AgentConfiguration.MaxConcurrentJobs).\n241\t\t\t\"maxConcurrentJobs\": {Type: \"integer\", Minimum: &crdMinZero},\n242\t\t\t// Minimums mirror the Helm chart's config-crd.yaml (10 / 30) and the\n243\t\t\t// admission guards in k8s/apis/agent.benjamin-borbe.de/v1/types.go.\n244\t\t\t\"zombieSweeperIntervalSeconds\": {\n245\t\t\t\tType:    \"integer\",\n246\t\t\t\tMinimum: &crdMinZombieSweeperInterval,\n247\t\t\t},\n248\t\t\t\"zombieJobTimeoutSeconds\": {Type: \"integer\", Minimum: &crdMinZombieJobTimeout},\n249\t\t\t\"trigger\": {\n250\t\t\t\tType: \"object\",\n251\t\t\t\tProperties: map[string]apiextensionsv1.JSONSchemaProps{\n252\t\t\t\t\t\"phases\": {\n253\t\t\t\t\t\tType: \"array\",\n254\t\t\t\t\t\tItems: &apiextensionsv1.JSONSchemaPropsOrArray{\n255\t\t\t\t\t\t\tSchema: &apiextensionsv1.JSONSchemaProps{Type: \"string\"},\n256\t\t\t\t\t\t},\n257\t\t\t\t\t},\n258\t\t\t\t\t\"statuses\": {\n259\t\t\t\t\t\tType: \"array\",\n260\t\t\t\t\t\tItems: &apiextensionsv1.JSONSchemaPropsOrArray{\n261\t\t\t\t\t\t\tSchema: &apiextensionsv1.JSONSchemaProps{Type: \"string\"},\n262\t\t\t\t\t\t},\n263\t\t\t\t\t},\n264\t\t\t\t},\n265\t\t\t},\n266\t\t}\n267\t}\n268\t"}]},"parent_tool_use_id":"chatcmpl-tool-92879bdf48abd110","session_id":"649c3b71-f1fd-46a9-a844-34ab62b5da5e","uuid":"0468d54e-f2e6-45ea-8bf5-304719869bf4","timestamp":"2026-09-03T17:53:19.041Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 1 (model)"}
