n788\t\t\t\t\t\t\"assignee\":  \"claude\",\n789\t\t\t\t\t\t\"phase\":     \"planning\",\n790\t\t\t\t\t\t\"task_type\": \"healthcheck\",\n791\t\t\t\t\t},\n792\t\t\t\t\tContent: lib.TaskContent(\"run health probe\"),\n793\t\t\t\t}\n794\t\t\t\tconfig := pkg.AgentConfiguration{\n795\t\t\t\t\tAssignee: \"claude\",\n796\t\t\t\t\tImage:    \"claude-agent:latest\",\n797\t\t\t\t\tEnv:      map[string]string{},\n798\t\t\t\t}\n799\t\t\t\t_, err := jobSpawner.SpawnJob(ctx, task, config)\n800\t\t\t\tExpect(err).To(BeNil())\n801\t\n802\t\t\t\tjobs, err := fakeClient.BatchV1().Jobs(\"test-ns\").List(ctx, metav1.ListOptions{})\n803\t\t\t\tExpect(err).To(BeNil())\n804\t\t\t\tExpect(jobs.Items).To(HaveLen(1))\n805\t\n806\t\t\t\tenvMap := make(map[string]string)\n807\t\t\t\tfor _, e := range jobs.Items[0].Spec.Template.Spec.Containers[0].Env {\n808\t\t\t\t\tenvMap[e.Name] = e.Value\n809\t\t\t\t}\n810\t\t\t\tExpect(envMap[\"TASK_TYPE\"]).To(Equal(\"healthcheck\"))\n811\t\t\t})\n812\t\n813\t\t\tIt(\"sets TASK_TYPE to empty string when task_type is absent from frontmatter\", func() {\n814\t\t\t\ttask := lib.Task{\n815\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"no-type-task-id\"),\n816\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n817\t\t\t\t\t\t\"assignee\": \"claude\",\n818\t\t\t\t\t\t\"phase\":    \"planning\",\n819\t\t\t\t\t},\n820\t\t\t\t\tContent: lib.TaskContent(\"work without task type\"),\n821\t\t\t\t}\n822\t\t\t\tconfig := pkg.AgentConfiguration{\n823\t\t\t\t\tAssignee: \"claude\",\n824\t\t\t\t\tImage:    \"claude-agent:latest\",\n825\t\t\t\t\tEnv:      map[string]string{},\n826\t\t\t\t}\n827\t\t\t\t_, err := jobSpawner.SpawnJob(ctx, task, config)\n828\t\t\t\tExpect(err).To(BeNil())\n829\t\n830\t\t\t\tjobs, err := fakeClient.BatchV1().Jobs(\"test-ns\").List(ctx, metav1.ListOptions{})\n831\t\t\t\tExpect(err).To(BeNil())\n832\t\t\t\tExpect(jobs.Items).To(HaveLen(1))\n833\t\n834\t\t\t\tenvMap := make(map[string]string)\n835\t\t\t\tfor _, e := range jobs.Items[0].Spec.Template.Spec