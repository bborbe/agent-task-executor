{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-92a610282db3763a","type":"tool_result","content":"200\t\tglog.V(3).\n201\t\t\tInfof(\"task %s %s: cleared task store + deferred respawn\", task.TaskIdentifier, status)\n202\t}\n203\t\n204\tfunc (h *taskEventHandler) ConsumeMessage(ctx context.Context, msg *sarama.ConsumerMessage) error {\n205\t\ttask, config, skip, err := h.parseAndFilter(ctx, msg)\n206\t\tif err != nil {\n207\t\t\treturn err\n208\t\t}\n209\t\tif skip {\n210\t\t\treturn nil\n211\t\t}\n212\t\t_, err = h.spawnIfNeeded(ctx, task, config)\n213\t\treturn err\n214\t}\n215\t\n216\t// parseAndFilter unmarshals the message and applies all pre-spawn filter checks.\n217\t// Returns (task, config, true, nil) when the message should be silently skipped.\n218\t// Returns (task, config, false, nil) when the task qualifies for spawning.\n219\t// Returns (_, _, false, err) when an unexpected error occurred.\n220\tfunc (h *taskEventHandler) parseAndFilter(\n221\t\tctx context.Context,\n222\t\tmsg *sarama.ConsumerMessage,\n223\t) (lib.Task, *pkg.AgentConfiguration, bool, error) {\n224\t\tif len(msg.Value) == 0 {\n225\t\t\tglog.V(3).Infof(\"skip empty message at offset %d\", msg.Offset)\n226\t\t\treturn lib.Task{}, nil, true, nil\n227\t\t}\n228\t\n229\t\tvar task lib.Task\n230\t\tif err := json.Unmarshal(msg.Value, &task); err != nil {\n231\t\t\tglog.Warningf(\"failed to unmarshal task event at offset %d: %v\", msg.Offset, err)\n232\t\t\treturn lib.Task{}, nil, true, nil\n233\t\t}\n234\t\n235\t\tif task.TaskIdentifier == \"\" {\n236\t\t\tglog.Warningf(\"task event at offset %d has empty TaskIdentifier, skipping\", msg.Offset)\n237\t\t\treturn lib.Task{}, nil, true, nil\n238\t\t}\n239\t\n240\t\th.cleanupTerminalTask(task)\n241\t\n242\t\t// Resolve the per-agent Config before the status/phase checks so both filters\n243\t\t// can use the per-Config trigger. Skip lookup when assignee is empty.\n244\t\tconfig, skip, err := h.resolveConfig(ctx, task)\n245\t\tif err != nil {\n246\t\t\treturn lib.Task{}, nil, false, err\n247\t\t}\n248\t\tif skip {\n249\t\t\treturn lib.Task{}, nil, true, nil\n250\t\t}\n251\t\n252\t\t// Type filter: effective set = {cfg.TaskType} ∪ cfg.TaskTypes.\n253\t\t// Skipped when the effective set is empty (agent has no task types configured).\n254\t\tif mismatch := taskTypeMismatchReason(task, config); mismatch != \"\" {\n255\t\t\tif err := h.resultPublisher.PublishTypeMismatchFailure(ctx, task, mismatch); err != nil {\n256\t\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n257\t\t\t\treturn lib.Task{}, nil, false, errors.Wrapf(\n258\t\t\t\t\tctx, err, \"publish type mismatch failure for task %s\", task.TaskIdentifier,\n259\t\t\t\t)\n260\t\t\t}\n261\t\t\tglog.V(2).Infof(\"type mismatch: %s (task %s)\", mismatch, task.TaskIdentifier)\n262\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"type_mismatch\").Inc()\n263\t\t\treturn lib.Task{}, nil, true, nil\n264\t\t}\n265\t\n266\t\tif !effectiveTriggerStatuses(config).Contains(task.Frontmatter.Status()) {\n267\t\t\tglog.V(3).Infof(\n268\t\t\t\t\"skip task %s with status %s\", task.TaskIdentifier, task.Frontmatter.Status(),\n269\t\t\t)\n270\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_status\").Inc()\n271\t\t\treturn lib.Task{}, nil, true, nil\n272\t\t}\n273\t\n274\t\tphase := task.Frontmatter.Phase()\n275\t\t// terminal phases must not be spawned again — operator escalation required\n276\t\tif phase != nil && applyPhaseGate(task, *phase) {\n277\t\t\th.removeDeferredEntry(task.TaskIdentifier)\n278\t\t\treturn lib.Task{}, nil, true, nil\n279\t\t}\n280\t\tif phase == nil || !effectiveTriggerPhases(config).Contains(*phase) {\n281\t\t\tglog.V(3).Infof(\"skip task %s with phase %v\", task.TaskIdentifier, phase)\n282\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_phase\").Inc()\n283\t\t\treturn lib.Task{}, nil, true, nil\n284\t\t}\n285\t\n286\t\tstage := task.Frontmatter.Stage()\n287\t\tif stage != string(h.branch) {\n288\t\t\tglog.V(3).Infof(\n289\t\t\t\t\"skip task %s with stage %s (executor branch %s)\",\n290\t\t\t\ttask.TaskIdentifier, stage, h.branch,\n291\t\t\t)\n292\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_stage\").Inc()\n293\t\t\treturn lib.Task{}, nil, true, nil\n294\t\t}\n295\t\n296\t\tif task.Frontmatter.Assignee() == \"\" {\n297\t\t\tglog.V(3).Infof(\"skip task %s with empty assignee\", task.TaskIdentifier)\n298\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_assignee\").Inc()\n299\t\t\treturn lib.Task{}, nil, true, nil\n300\t\t}\n301\t\n302\t\treturn task, config, false, nil\n303\t}\n304\t\n305\t// resolveConfig looks up the agent Config CR for the task's assignee.\n306\t// Returns (nil, false, nil) when assignee is empty (caller handles the empty-assignee path).\n307\t// Returns (nil, true, nil) when the assignee is unknown (ErrConfigNotFound).\n308\t// Returns (nil, false, err) on unexpected resolver errors.\n309\tfunc (h *taskEventHandler) resolveConfig(\n310\t\tctx context.Context,\n311\t\ttask lib.Task,\n312\t) (*pkg.AgentConfiguration, bool, error) {\n313\t\tif task.Frontmatter.Assignee() == \"\" {\n314\t\t\treturn nil, false, nil\n315\t\t}\n316\t\tresolved, err := h.resolver.Resolve(ctx, string(task.Frontmatter.Assignee()))\n317\t\tif err != nil {\n318\t\t\tif stderrors.Is(err, pkg.ErrConfigNotFound) {\n319\t\t\t\tglog.Warningf(\n320\t\t\t\t\t\"skip task %s: unknown assignee %s\",\n321\t\t\t\t\ttask.TaskIdentifier,\n322\t\t\t\t\ttask.Frontmatter.Assignee(),\n323\t\t\t\t)\n324\t\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_unknown_assignee\").Inc()\n325\t\t\t\treturn nil, true, nil\n326\t\t\t}\n327\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n328\t\t\treturn nil, false, errors.Wrapf(\n329\t\t\t\tctx,\n330\t\t\t\terr,\n331\t\t\t\t\"resolve agent config for task %s\",\n332\t\t\t\ttask.TaskIdentifier,\n333\t\t\t)\n334\t\t}\n335\t\treturn &resolved, false, nil\n336\t}\n337\t\n338\t// taskTypeMismatchReason returns a