{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-be721f27411b0652","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage gitrestclient\n6\t\n7\timport (\n8\t\t\"bytes\"\n9\t\t\"context\"\n10\t\t\"encoding/json\"\n11\t\tstderrors \"errors\"\n12\t\t\"io\"\n13\t\t\"net/http\"\n14\t\t\"net/url\"\n15\t\t\"strings\"\n16\t\t\"time\"\n17\t\n18\t\t\"github.com/bborbe/errors\"\n19\t\n20\t\t\"github.com/bborbe/agent-task-controller/pkg/metrics\"\n21\t)\n22\t\n23\t//counterfeiter:generate -o ../../mocks/git_rest_client.go --fake-name GitRestClient . GitRestClient\n24\t\n25\t// ErrAlreadyExists is returned by PostIfAbsent when the target path is already\n26\t// occupied (git-rest responds 409 Conflict for a create-only write). It is a\n27\t// benign conflict, not a transport failure — callers use errors.Is to treat it\n28\t// as \"already there\" instead of an error worth retrying.\n29\tvar ErrAlreadyExists = stderrors.New(\"file already exists\")\n30\t\n31\t// GitRestClient is the HTTP client for git-rest's /api/v1/files REST API.\n32\t// All paths are relative to the repo root (e.g. \"tasks/foo.md\").\n33\ttype GitRestClient interface {\n34\t\t// Get retrieves the current content of the file at relPath.\n35\t\tGet(ctx context.Context, relPath string) ([]byte, error)\n36\t\t// Post writes content to relPath; git-rest auto-commits and pushes.\n37\t\tPost(ctx context.Context, relPath string, content []byte) error\n38\t\t// PostIfAbsent writes content to relPath only when no file exists there yet;\n39\t\t// git-rest auto-commits and pushes. Returns ErrAlreadyExists (via errors.Is)\n40\t\t// when relPath is already occupied — nothing is written in that case.\n41\t\tPostIfAbsent(ctx context.Context, relPath string, content []byte) error\n42\t\t// Delete removes the file at relPath; git-rest auto-commits and pushes.\n43\t\tDelete(ctx context.Context, relPath string) error\n44\t\t// List returns relative paths matching the single-level glob pattern (e.g. \"tasks/*.md\").\n45\t\tList(ctx context.Context, glob string) ([]string, error)\n46\t\t// IsReady reports whether git-rest's /readiness returns 200.\n47\t\t// Returns (false, nil) when git-rest returns 503 — that is a valid not-ready state, not an error.\n48\t\t// Returns (false, err) only on network failure or unexpected response.\n49\t\tIsReady(ctx context.Context) (bool, error)\n50\t}\n51\t\n52\t// NewGitRestClient creates a GitRestClient targeting the git-rest instance at baseURL.\n53\t// gatewaySecret is the shared secret enforced by git-rest's gateway-secret auth (git-rest spec 004).\n54\t// When gatewaySecret is empty, no auth headers are sent (backward-compat with auth-disabled git-rest).\n55\t// gatewayInitiator is the caller identity logged by git-rest on auth failure;\n56\t// pass a stable, human-readable value (e.g. \"agent-task-controller\").\n57\tfunc NewGitRestClient(\n58\t\tbaseURL, gatewaySecret, gatewayInitiator string,\n59\t\tmetrics metrics.Metrics,\n60\t) GitRestClient {\n61\t\treturn newGitRestClientWithBackoff(\n62\t\t\tbaseURL,\n63\t\t\tgatewaySecret,\n64\t\t\tgatewayInitiator,\n65\t\t\texponentialBackoff,\n66\t\t\tmetrics,\n67\t\t)\n68\t}\n69\t\n70\tfunc newGitRestClientWithBackoff(\n71\t\tbaseURL, gatewaySecret, gatewayInitiator string,\n72\t\tbackoff func(attempt int) time.Duration,\n73\t\tmetrics metrics.Metrics,\n74\t) GitRestClient {\n75\t\treturn &gitRestClient{\n76\t\t\tbaseURL:          strings.TrimRight(baseURL, \"/\"),\n77\t\t\thttpClient:       &http.Client{Timeout: 30 * time.Second},\n78\t\t\tbackoff:          backoff,\n79\t\t\tgatewaySecret:    gatewaySecret,\n80\t\t\tgatewayInitiator: gatewayInitiator,\n81\t\t\tmetrics:          metrics,\n82\t\t}\n83\t}\n84\t\n85\tfunc exponentialBackoff(attempt int) time.Duration {\n86\t\treturn time.Duration(\n87\t\t\t1<<uint(attempt-1),\n88\t\t) * time.Second // #nosec G115 -- attempt is always >= 1 when called\n89\t}\n90\t\n91\ttype gitRestClient struct {\n92\t\tbaseURL          string\n93\t\thttpClient       *http.Client\n94\t\tbackoff          func(attempt int) time.Duration\n95\t\tgatewaySecret    string\n96\t\tgatewayInitiator string\n97\t\tmetrics          metrics.Metrics\n98\t}\n99\t\n100\t// setAuthHeaders sets the gateway-secret auth headers on req when the secret is configured.\n101\t// No-op when gatewaySecret is empty — keeps backward compatibility with auth-disabled git-rest.\n102\t//\n103\t// Header names are part of the git-rest public contract (spec 004) — do NOT alter:\n104\t//\n105\t//\tX-Gateway-Secret   — the shared secret\n106\t//\tX-Gateway-Initator — caller identity (deliberate misspelling, do NOT change to \"Initiator\")\n107\tfunc (g *gitRestClient) setAuthHeaders(req *http.Request) {\n108\t\tif g.gatewaySecret == \"\" {\n109\t\t\treturn\n110\t\t}\n111\t\treq.Header.Set(\"X-Gateway-Secret\", g.gatewaySecret)\n112\t\treq.Header.Set(\"X-Gateway-Initator\", g.gatewayInitiator)\n113\t}\n114\t\n115\t// fileURL builds /api/v1/files/<relPath> with proper percent-escaping so\n116\t// characters like %, space, # in relPath survive the round-trip to git-rest.\n117\tfunc (g *gitRestClient) fileURL(relPath string) string {\n118\t\tsegments := strings.Split(relPath, \"/\")\n119\t\tfor i, s := range segments {\n120\t\t\tsegments[i] = url.PathEscape(s)\n121\t\t}\n122\t\treturn g.baseURL + \"/api/v1/files/\" + strings.Join(segments, \"/\")\n123\t}\n124\t\n125\t// Get retrieves file content from git-rest. Does not retry — reads fail-fast.\n126\tfunc (g *gitRestClient) Get(ctx context.Context, relPath string) ([]byte, error) {\n127\t\treqURL := g.fileURL(relPath)\n128\t\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n129\t\tif err != nil {\n130\t\t\tg.metrics.GitRestCallsTotal(\"get\", \"error\").Inc()\n131\t\t\treturn nil, errors.Wrapf(ctx, err, \"create GET request for %s\", relPath)\n132\t\t}\n133\t\tg.setAuthHeaders(req)\n134\t\tresp, err := g.httpClient.Do(req)\n135\t\tif err != nil {\n136\t\t\tg.metrics.GitRestCallsTotal(\"get\", \"error\").Inc()\n137\t\t\treturn nil, errors.Wrapf(ctx, err, \"GET %s\", relPath)\n138\t\t}\n139\t\tdefer resp.Body.Close()\n140\t\tbody, err := io.ReadAll(io.LimitReader(resp.Body, 10*1024*1024)) // 10 MiB max\n141\t\tif err != nil {\n142\t\t\tg.metrics.GitRestCallsTotal(\"get\", \"error\").Inc()\n143\t\t\treturn nil, errors.Wrapf(ctx, err, \"read GET response body for %s\", relPath)\n144\t\t}\n145\t\tif resp.StatusCode != http.StatusOK {\n146\t\t\tg.metrics.GitRestCallsTotal(\"get\", \"error\").Inc()\n147\t\t\tpreview := string(body)\n148\t\t\tif len(preview) > 100 {\n149\t\t\t\tpreview = preview[:100]\n150\t\t\t}\n151\t\t\treturn nil, errors.Errorf(ctx, \"GET %s returned %d: %s\", relPath, resp.StatusCode, preview)\n152\t\t}\n153\t\tg.metrics.GitRestCallsTotal(\"get\", \"success\").Inc()\n154\t\treturn body, nil\n155\t}\n156\t\n157\t// Post writes content to relPath with retry on 5xx or network errors.\n158\tfunc (g *gitRestClient) Post(ctx context.Context, relPath string, content []byte) error {\n159\t\treturn g.post(ctx, relPath, content, false)\n160\t}\n161\t\n162\t// PostIfAbsent writes content to relPath only when no file exists there yet.\n163\t// git-rest answers 409 Conflict for an occupied path; that is mapped to\n164\t// ErrAlreadyExists (via errors.Is) and is not retried. All other failures share\n165\t// Post's retry behavior.\n166\tfunc (g *gitRestClient) PostIfAbsent(ctx context.Context, relPath string, content []byte) error {\n167\t\treturn g.post(ctx, relPath, content, true)\n168\t}\n169\t\n170\t// post writes content to relPath with retry on 5xx or network errors. When\n171\t// createOnly is true the request carries ?create_only=1 and a 409 Conflict\n172\t// response is returned as ErrAlreadyExists instead of being retried.\n173\tfunc (g *gitRestClient) post(\n174\t\tctx context.Context,\n175\t\trelPath string,\n176\t\tcontent []byte,\n177\t\tcreateOnly bool,\n178\t) error {\n179\t\treqURL := g.fileURL(relPath)\n180\t\tif createOnly {\n181\t\t\treqURL += \"?create_only=1\"\n182\t\t}\n183\t\tvar lastErr error\n184\t\tfor attempt := 0; attempt < 5; attempt++ {\n185\t\t\tselect {\n186\t\t\tcase <-ctx.Done():\n187\t\t\t\treturn errors.Wrapf(ctx, ctx.Err(), \"POST %s cancelled before attempt\", relPath)\n188\t\t\tdefault:\n189\t\t\t}\n190\t\t\tif attempt > 0 {\n191\t\t\t\tg.metrics.KafkaConsumePausedTotal().Inc()\n192\t\t\t\tbackoff := g.backoff(attempt)\n193\t\t\t\tselect {\n194\t\t\t\tcase <-ctx.Done():\n195\t\t\t\t\treturn errors.Wrapf(ctx, ctx.Err(), \"POST %s cancelled during backoff\", relPath)\n196\t\t\t\tcase <-time.After(backoff):\n197\t\t\t\t}\n198\t\t\t}\n199\t\t\treq, err := http.NewRequestWithContext(\n200\t\t\t\tctx,\n201\t\t\t\thttp.MethodPost,\n202\t\t\t\treqURL,\n203\t\t\t\tbytes.NewReader(content),\n204\t\t\t)\n205\t\t\tif err != nil {\n206\t\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"error\").Inc()\n207\t\t\t\tlastErr = errors.Wrapf(ctx, err, \"create POST request for %s\", relPath)\n208\t\t\t\tcontinue\n209\t\t\t}\n210\t\t\treq.Header.Set(\"Content-Type\", \"application/octet-stream\")\n211\t\t\tg.setAuthHeaders(req)\n212\t\t\tresp, err := g.httpClient.Do(req)\n213\t\t\tif err != nil {\n214\t\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"error\").Inc()\n215\t\t\t\tlastErr = errors.Wrapf(ctx, err, \"POST %s attempt %d\", relPath, attempt+1)\n216\t\t\t\tcontinue\n217\t\t\t}\n218\t\t\t_, _ = io.Copy(io.Discard, resp.Body)\n219\t\t\t_ = resp.Body.Close()\n220\t\t\tif resp.StatusCode >= 200 && resp.StatusCode < 300 {\n221\t\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"success\").Inc()\n222\t\t\t\treturn nil\n223\t\t\t}\n224\t\t\tif createOnly && resp.StatusCode == http.StatusConflict {\n225\t\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"error\").Inc()\n226\t\t\t\treturn errors.Wrapf(\n227\t\t\t\t\tctx,\n228\t\t\t\t\tErrAlreadyExists,\n229\t\t\t\t\t\"POST %s create-only: path already exists\",\n230\t\t\t\t\trelPath,\n231\t\t\t\t)\n232\t\t\t}\n233\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"error\").Inc()\n234\t\t\tlastErr = errors.Errorf(\n235\t\t\t\tctx,\n236\t\t\t\t\"POST %s attempt %d returned %d\",\n237\t\t\t\trelPath,\n238\t\t\t\tattempt+1,\n239\t\t\t\tresp.StatusCode,\n240\t\t\t)\n241\t\t}\n242\t\treturn errors.Wrapf(ctx, lastErr, \"POST %s failed after 5 attempts\", relPath)\n243\t}\n244\t\n245\t// Delete removes the file at relPath with retry on 5xx or network errors.\n246\tfunc (g *gitRestClient) Delete(ctx context.Context, relPath string) error {\n247\t\treqURL := g.fileURL(relPath)\n248\t\tvar lastErr error\n249\t\tfor attempt := 0; attempt < 5; attempt++ {\n250\t\t\tselect {\n251\t\t\tcase <-ctx.Done():\n252\t\t\t\treturn errors.Wrapf(ctx, ctx.Err(), \"DELETE %s cancelled before attempt\", relPath)\n253\t\t\tdefault:\n254\t\t\t}\n255\t\t\tif attempt > 0 {\n256\t\t\t\tg.metrics.KafkaConsumePausedTotal().Inc()\n257\t\t\t\tbackoff := g.backoff(attempt)\n258\t\t\t\tselect {\n259\t\t\t\tcase <-ctx.Done():\n260\t\t\t\t\treturn errors.Wrapf(ctx, ctx.Err(), \"DELETE %s cancelled during backoff\", relPath)\n261\t\t\t\tcase <-time.After(backoff):\n262\t\t\t\t}\n263\t\t\t}\n264\t\t\treq, err := http.NewRequestWithContext(ctx, http.MethodDelete, reqURL, nil)\n265\t\t\tif err != nil {\n266\t\t\t\tg.metrics.GitRestCallsTotal(\"delete\", \"error\").Inc()\n267\t\t\t\tlastErr = errors.Wrapf(ctx, err, \"create DELETE request for %s\", relPath)\n268\t\t\t\tcontinue\n269\t\t\t}\n270\t\t\tg.setAuthHeaders(req)\n271\t\t\tresp, err := g.httpClient.Do(req)\n272\t\t\tif err != nil {\n273\t\t\t\tg.metrics.GitRestCallsTotal(\"delete\", \"error\").Inc()\n274\t\t\t\tlastErr = errors.Wrapf(ctx, err, \"DELETE %s attempt %d\", relPath, attempt+1)\n275\t\t\t\tcontinue\n276\t\t\t}\n277\t\t\t_, _ = io.Copy(io.Discard, resp.Body)\n278\t\t\t_ = resp.Body.Close()\n279\t\t\tif resp.StatusCode >= 2