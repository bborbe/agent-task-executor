{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-bdea70b3def91118","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage metrics\n6\t\n7\timport (\n8\t\t\"github.com/prometheus/client_golang/prometheus\"\n9\t\t\"github.com/prometheus/client_golang/prometheus/promauto\"\n10\t)\n11\t\n12\t// TaskEventsTotal counts task event processing outcomes.\n13\tvar TaskEventsTotal = promauto.NewCounterVec(\n14\t\tprometheus.CounterOpts{\n15\t\t\tName: \"agent_executor_task_events_total\",\n16\t\t\tHelp: \"Total number of task events processed.\",\n17\t\t},\n18\t\t[]string{\"result\"},\n19\t)\n20\t\n21\t// JobsSpawnedTotal counts successfully spawned jobs.\n22\tvar JobsSpawnedTotal = promauto.NewCounter(\n23\t\tprometheus.CounterOpts{\n24\t\t\tName: \"agent_executor_jobs_spawned_total\",\n25\t\t\tHelp: \"Total number of jobs successfully spawned.\",\n26\t\t},\n27\t)\n28\t\n29\tfunc init() {\n30\t\tTaskEventsTotal.WithLabelValues(\"spawned\").Add(0)\n31\t\tTaskEventsTotal.WithLabelValues(\"skipped_status\").Add(0)\n32\t\tTaskEventsTotal.WithLabelValues(\"skipped_phase\").Add(0)\n33\t\tTaskEventsTotal.WithLabelValues(\"skipped_assignee\").Add(0)\n34\t\tTaskEventsTotal.WithLabelValues(\"skipped_unknown_assignee\").Add(0)\n35\t\tTaskEventsTotal.WithLabelValues(\"skipped_active_job\").Add(0)\n36\t\tTaskEventsTotal.WithLabelValues(\"skipped_stage\").Add(0)\n37\t\tTaskEventsTotal.WithLabelValues(\"skipped_trigger_cap\").Add(0)\n38\t\tTaskEventsTotal.WithLabelValues(\"error\").Add(0)\n39\t\tTaskEventsTotal.WithLabelValues(\"type_mismatch\").Add(0)\n40\t\tTaskEventsTotal.WithLabelValues(\"spawn_suppressed_terminal_phase\").Add(0)\n41\t\tTaskEventsTotal.WithLabelValues(\"unknown_phase\").Add(0)\n42\t\tTaskEventsTotal.WithLabelValues(\"respawn_grace_window\").Add(0)\n43\t\tTaskEventsTotal.WithLabelValues(\"respawn_after_grace_window\").Add(0)\n44\t}\n45\t"}]},"parent_tool_use_id":"chatcmpl-tool-b68d74ad5231f9ea","session_id":"3667b84f-c892-4ca5-8115-a830204bf3b3","uuid":"017eaf23-ddb3-4cac-aa73-afec50a325e3","timestamp":"2026-09-03T17:57:30.868Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec 005"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-a260086bd95e5cdc","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage spawner\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\n10\t\tlib \"github.com/bborbe/agent\"\n11\t\t\"github.com/bborbe/errors\"\n12\t\tk8s \"github.com/bborbe/k8s\"\n13\t\tlibtime \"github.com/bborbe/time\"\n14\t\t\"github.com/golang/glog\"\n15\t\t\"gopkg.in/yaml.v3\"\n16\t\tbatchv1 \"k8s.io/api/batch/v1\"\n17\t\tcorev1 \"k8s.io/api/core/v1\"\n18\t\tk8serrors \"k8s.io/apimachinery/pkg/api/errors\"\n19\t\t\"k8s.io/apimachinery/pkg/api/resource\"\n20\t\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"\n21\t\t\"k8s.io/client-go/kubernetes\"\n22\t\n23\t\tpkg \"github.com/bborbe/agent-task-executor/pkg\"\n24\t)\n25\t\n26\t// taskIDLabelKey labels a spawned Job with the task UUID so IsJobActive\n27\t// can look it up. Must match the selector used in IsJobActive.\n28\tconst taskIDLabelKey = \"agent.benjamin-borbe.de/task-id\"\n29\t\n30\t// assigneeLabelKey labels a spawned Job with the agent assignee so\n31\t// CountActiveJobs can size concurrency per agent rather than globally.\n32\t// Different agents have very different runtimes and resource profiles, so a\n33\t// single fleet-wide limit would throttle cheap agents to protect expensive ones.\n34\tconst assigneeLabelKey = \"agent.benjamin-borbe.de/assignee\"\n35\t\n36\t//counterfeiter:generate -o ../../mocks/job_spawner.go --fake-name FakeJobSpawner . JobSpawner\n37\t\n38\t// JobSpawner creates a K8s Job for a task.\n39\ttype JobSpawner interface {\n40\t\t// SpawnJob creates a K8s Job for the task and returns the job name.\n41\t\t// Returns the job name even when the job already exists (idempotent).\n42\t\tSpawnJob(ctx context.Context, task lib.Task, config pkg.AgentConfiguration) (string, error)\n43\t\t// IsJobActive returns true if an active (not completed/failed) K8s Job exists\n44\t\t// for the given task identifier. Uses the agent.benjamin-borbe.de/task-id\n45\t\t// label set by SpawnJob.\n46\t\tIsJobActive(ctx context.Context, taskIdentifier lib.TaskIdentifier) (bool, error)\n47\t\t// CountActiveJobs returns the number of non-terminal K8s Jobs currently\n48\t\t// running for the given assignee. Uses the agent.benjamin-borbe.de/assignee\n49\t\t// label set by SpawnJob. Jobs spawned before that label existed are not\n50\t\t// counted, so the cap under-counts during the rollout and never over-counts.\n51\t\tCountActiveJobs(ctx context.Context, assignee string) (int, error)\n52\t}\n53\t\n54\t// NewJobSpawner creates a new JobSpawner backed by the K8s batch/v1 API.\n55\t// jobTTLSecondsAfterFinished controls how long completed Job pods survive\n56\t// before Kubernetes' TTL controller garbage-collects them.\n57\t// jobKafkaClientCertSecret and jobKafkaCaCertSecret are the names of K8s secrets\n58\t// to mount into spawned Jobs for Kafka mTLS; empty strings mean no cert mounting.\n59\tfunc NewJobSpawner(\n60\t\tkubeClient kubernetes.Interface,\n61\t\tnamespace k8s.Namespace,\n62\t\tkafkaBrokers string,\n63\t\tbranch string,\n64\t\ttopicPrefix string,\n65\t\tcurrentDateTimeGetter libtime.CurrentDateTimeGetter,\n66\t\tjobTTLSecondsAfterFinished int32,\n67\t\tjobKafkaClientCertSecret string,\n68\t\tjobKafkaCaCertSecret string,\n69\t) JobSpawner {\n70\t\treturn &jobSpawner{\n71\t\t\tkubeClient:                 kubeClient,\n72\t\t\tnamespace:                  namespace,\n73\t\t\tkafkaBrokers:               kafkaBrokers,\n74\t\t\tbranch:                     branch,\n75\t\t\ttopicPrefix:                topicPrefix,\n76\t\t\tcurrentDateTimeGetter:      currentDateTimeGetter,\n77\t\t\tjobTTLSecondsAfterFinished: jobTTLSecondsAfterFinished,\n78\t\t\tjobKafkaClientCertSecret:   jobKafkaClientCertSecret,\n79\t\t\tjobKafkaCaCertSecret:       jobKafkaCaCertSecret,\n80\t\t}\n81\t}\n82\t\n83\t// jobSpawner implements JobSpawner by creating batch/v1 Jobs via the K8s client.\n84\ttype jobSpawner struct {\n85\t\tkubeClient                 kubernetes.Interface\n86\t\tnamespace                  k8s.Namespace\n87\t\tkafkaBrokers               string\n88\t\tbranch                     string\n89\t\ttopicPrefix                string\n90\t\tcurrentDateTimeGetter      libtime.CurrentDateTimeGetter\n91\t\tjobTTLSecondsAfterFinished int32\n92\t\tjobKafkaClientCertSecret   string\n93\t\tjobKafkaCaCertSecret       string\n94\t}\n95\t\n96\tfunc (s *jobSpawner) SpawnJob(\n97\t\tctx context.Context,\n98\t\ttask lib.Task,\n99\t\tconfig pkg.AgentConfiguration,\n100\t) (string, error) {\n101\t\tassignee := task.Frontmatter.Assignee().String()\n102\t\tnow := s.currentDateTimeGetter.Now()\n103\t\tjobName := jobNameFromTask(assignee, task.TaskIdentifier, now)\n104\t\n105\t\tenvBuilder, err := s.buildJobEnvBuilder(ctx, task, config)\n106\t\tif err != nil {\n107\t\t\treturn \"\", err\n108\t\t}\n109\t\n110\t\tcontainerBuilder := k8s.NewContainerBuilder()\n111\t\tcontainerBuilder.SetName(k8s.Name(\"agent\"))\n112\t\tcontainerBuilder.SetImage(config.Image)\n113\t\tcontainerBuilder.SetEnvBuilder(envBuilder)\n114\t\tapplyCPUMemoryResources(config, containerBuilder)\n115\t\n116\t\tpodSpecBuilder := k8s.NewPodSpecBuilder()\n117\t\n118\t\tif err := applyVolumeMount(ctx, config, containerBuilder, podSpecBuilder); err != nil {\n119\t\t\treturn \"\", err\n120\t\t}\n121\t\n122\t\tcontainersBuilder := k8s.NewContainersBuilder()\n123\t\tcontainersBuilder.SetContainerBuilders([]k8s.HasBuildContainer{containerBuilder})\n124\t\n125\t\tpodSpecBuilder.SetContainersBuilder(containersBuilder)\n126\t\tpodSpecBuilder.SetRestartPolicy(corev1.RestartPolicyNever)\n127\t\tpodSpecBuilder.SetImagePullSecrets([]string{imagePullSecretName(config)})\n128\t\n129\t\tobjectMetaBuilder := k8s.NewObjectMetaBuilder()\n130\t\tobjectMetaBuilder.SetName(k8s.Name(jobName))\n131\t\tobjectMetaBuilder.SetNamespace(s.namespace)\n132\t\n133\t\tjobBuilder := k8s.NewJobBuilder()\n134\t\tjobBuilder.SetObjectMetaBuild(objectMetaBuilder)\n135\t\tjobBuilder.SetPodSpecBuilder(podSpecBuilder)\n136\t\tjobBuilder.SetBackoffLimit(0)\n137\t\tjobBuilder.SetTTLSecondsAfterFinished(s.jobTTLSecondsAfterFinished)\n138\t\tjobBuilder.SetApp(\"agent\")\n139\t\tjobBuilder.SetComponent(string(task.TaskIdentifier))\n140\t\n141\t\tjob, err := jobBuilder.Build(ctx)\n142\t\tif err != nil {\n143\t\t\treturn \"\", errors.Wrapf(ctx, err, \"build job for task %s\", task.TaskIdentifier)\n144\t\t}\n145\t\n146\t\tapplyTaskIDLabel(task.TaskIdentifier, job)\n147\t\tapplyAssigneeLabel(config.Assignee, job)\n148\t\tapplySecretEnvFrom(config, job)\n149\t\tapplyEphemeralStorage(config, job)\n150\t\ts.applyKafkaCertVolumes(job)\n151\t\tif config.PriorityClassName != \"\" {\n152\t\t\tjob.Spec.Template.Spec.PriorityClassName = config.PriorityClassName\n153\t\t}\n154\t\tapplyActiveDeadlineSeconds(config, jobName, task.TaskIdentifier, job)\n155\t\n156\t\t_, err = s.kubeClient.BatchV1().\n157\t\t\tJobs(s.namespace.String()).\n158\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n159\t\tif err != nil {\n160\t\t\tif k8serrors.IsAlreadyExists(err) {\n161\t\t\t\tglog.V(2).\n162\t\t\t\t\tInfof(\"job %s already exists for task %s, treating as success\", jobName, task.TaskIdentifier)\n163\t\t\t\treturn jobName, nil\n164\t\t\t}\n165\t\t\treturn \"\", errors.Wrapf(\n166\t\t\t\tctx,\n167\t\t\t\terr,\n168\t\t\t\t\"create job %s for task %s failed\",\n169\t\t\t\tjobName,\n170\t\t\t\ttask.TaskIdentifier,\n171\t\t\t)\n172\t\t}\n173\t\tglog.V(2).\n174\t\t\tInfof(\"created job %s for task %s with image %s\", jobName, task.TaskIdentifier, config.Image)\n175\t\treturn jobName, nil\n176\t}\n177\t\n178\tfunc (s *jobSpawner) IsJobActive(\n179\t\tctx context.Context,\n180\t\ttaskIdentifier lib.TaskIdentifier,"}]},"parent_tool_use_id":"chatcmpl-tool-b68d74ad5231f9ea","session_id":"3667b84f-c892-4ca5-8115-a830204bf3b3","uuid":"229eacc0-117d-4a92-8bac-