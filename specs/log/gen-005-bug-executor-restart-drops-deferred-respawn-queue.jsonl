{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-ab0fbc201a10d856","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"time\"\n10\t\n11\t\tlib \"github.com/bborbe/agent\"\n12\t\t\"github.com/bborbe/errors\"\n13\t\tlibk8s \"github.com/bborbe/k8s\"\n14\t\tlibtime \"github.com/bborbe/time\"\n15\t\t\"github.com/golang/glog\"\n16\t\tcorev1 \"k8s.io/api/core/v1\"\n17\t\t\"k8s.io/apimachinery/pkg/labels\"\n18\t\tcorev1listers \"k8s.io/client-go/listers/core/v1\"\n19\t\n20\t\tagentv1 \"github.com/bborbe/agent-task-executor/k8s/apis/agent.benjamin-borbe.de/v1\"\n21\t)\n22\t\n23\t//counterfeiter:generate -o ../mocks/zombie_sweeper.go --fake-name FakeZombieSweeper . ZombieSweeper\n24\t\n25\t// ZombieSweeper is a background goroutine that periodically classifies stuck\n26\t// tasks as zombies and emits failure events. It is the safety net for the\n27\t// informer-driven paths in JobWatcher (which handle the cases k8s notifies us\n28\t// about). The sweeper handles: pods unschedulable beyond a grace window,\n29\t// executor restart losing watch on a Job, and any deadline path the informer\n30\t// misses (Job-condition deferred indefinitely, informer cache drift).\n31\ttype ZombieSweeper interface {\n32\t\t// Run blocks until ctx is cancelled. Each tick (interval sourced from the\n33\t\t// first non-nil ConfigSpec.ZombieSweeperIntervalSeconds across the resolver's\n34\t\t// configs, else DefaultZombieSweeperIntervalSeconds) it calls SweepOnce.\n35\t\tRun(ctx context.Context) error\n36\t\t// SweepOnce performs a single sweep pass. Exposed for unit tests so they\n37\t\t// do not have to manage tickers. Returns an error only on context\n38\t\t// cancellation paths; per-task classification errors are logged.\n39\t\tSweepOnce(ctx context.Context) error\n40\t}\n41\t\n42\t// NewZombieSweeper creates a ZombieSweeper. The JobWatcher is held by reference\n43\t// (not its lister) because the lister is only populated after JobWatcher.Run\n44\t// completes its cache sync; service.Run starts all components concurrently, so\n45\t// extracting the lister at wiring time would capture nil. SweepOnce resolves\n46\t// the lister lazily on every tick and skips the tick if it is not yet ready.\n47\tfunc NewZombieSweeper(\n48\t\tjobWatcher JobWatcher,\n49\t\tnamespace libk8s.Namespace,\n50\t\ttaskStore *TaskStore,\n51\t\tpublisher ResultPublisher,\n52\t\tconfigProvider EventHandlerConfig,\n53\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n54\t) ZombieSweeper {\n55\t\treturn &zombieSweeper{\n56\t\t\tjobWatcher:      jobWatcher,\n57\t\t\tnamespace:       namespace,\n58\t\t\ttaskStore:       taskStore,\n59\t\t\tpublisher:       publisher,\n60\t\t\tconfigProvider:  configProvider,\n61\t\t\tcurrentDateTime: currentDateTime,\n62\t\t}\n63\t}\n64\t\n65\ttype zombieSweeper struct {\n66\t\tjobWatcher      JobWatcher\n67\t\tnamespace       libk8s.Namespace\n68\t\ttaskStore       *TaskStore\n69\t\tpublisher       ResultPublisher\n70\t\tconfigProvider  EventHandlerConfig\n71\t\tcurrentDateTime libtime.CurrentDateTimeGetter\n72\t}\n73\t\n74\tconst (\n75\t\t// podNotScheduledGraceWindow is the age threshold past which a Pending Pod\n76\t\t// with PodScheduled=False is classified pod_not_scheduled. Must exceed\n77\t\t// typical scheduler latency comfortably; 2 minutes is empirically generous.\n78\t\tpodNotScheduledGraceWindow = 2 * time.Minute\n79\t)\n80\t\n81\t// NOTE on \"no recent heartbeat\" from spec DB #9 / AC #6:\n82\t// The spec predicate is `elapsed > deadline AND pod not Running AND no recent\n83\t// heartbeat`. This codebase has NO separate heartbeat channel today — the only\n84\t// liveness signal for a running job is \"is a Pod currently Running?\". Therefore\n85\t// \"no recent heartbeat\" is implemented as \"no Pod in PodRunning phase observed\n86\t// for this task\". If a per-job heartbeat is added later (a follow-up spec),\n87\t// this predicate gets a real check; for now `classify` treats `pod not Running`\n88\t// as covering both halves of the conjunction.\n89\t\n90\tfunc (s *zombieSweeper) Run(ctx context.Context) error {\n91\t\t// Interval is resolved once at startup. CRD changes to ZombieSweeperIntervalSeconds\n92\t\t// take effect only after pod restart. Acceptable because executor pods are short-lived\n93\t\t// relative to CRD reconciliation cycles.\n94\t\tinterval, err := s.resolveSweeperInterval(ctx)\n95\t\tif err != nil {\n96\t\t\treturn errors.Wrapf(ctx, err, \"resolve sweeper interval\")\n97\t\t}\n98\t\tticker := time.NewTicker(interval)\n99\t\tdefer ticker.Stop()\n100\t\tglog.V(2).Infof(\"zombie sweeper started interval=%s\", interval)\n101\t\tfor {\n102\t\t\tselect {\n103\t\t\tcase <-ctx.Done():\n104\t\t\t\treturn nil\n105\t\t\tcase <-ticker.C:\n106\t\t\t\tif err := s.SweepOnce(ctx); err != nil {\n107\t\t\t\t\t// Per-tick failures (transient lister errors, ctx-scoped\n108\t\t\t\t\t// failures from publisher) must NOT kill the sweeper goroutine\n109\t\t\t\t\t// — that would tear down the executor via service.Run. Log and\n110\t\t\t\t\t// continue.\n111\t\t\t\t\tglog.Errorf(\"zombie sweeper tick: %v\", err)\n112\t\t\t\t}\n113\t\t\t}\n114\t\t}\n115\t}\n116\t\n117\tfunc (s *zombieSweeper) SweepOnce(ctx context.Context) error {\n118\t\t// Resolve the Pod lister lazily — JobWatcher.Run populates it only after\n119\t\t// the informer cache has synced, and service.Run starts all components\n120\t\t// concurrently. If the lister is not yet available, skip this tick rather\n121\t\t// than publishing spurious failures.\n122\t\tlister := s.jobWatcher.PodLister()\n123\t\tif lister == nil {\n124\t\t\tglog.V(2).Infof(\"sweep skipped: pod lister not yet synced\")\n125\t\t\treturn nil\n126\t\t}\n127\t\tsnapshot := s.taskStore.Snapshot()\n128\t\tnow := s.currentDateTime.Now().Time()\n129\t\t// Fetch configs ONCE per tick — used by taskDeadline() for every task in\n130\t\t// the snapshot. Avoids N calls into the provider per sweep.\n131\t\tcfgs, err := s.configProvider.Get(ctx)\n132\t\tif err != nil {\n133\t\t\treturn errors.Wrapf(ctx, err, \"list configs\")\n134\t\t}\n135\t\tfor taskID, task := range snapshot {\n136\t\t\tjobName := task.Frontmatter.CurrentJob()\n137\t\t\tif jobName == \"\" {\n138\t\t\t\t// No active job recorded; nothing to sweep.\n139\t\t\t\tcontinue\n140\t\t\t}\n141\t\t\tjobStartedAt, err := task.Frontmatter.JobStartedAt()\n142\t\t\tif err != nil || jobStartedAt.IsZero() {\n143\t\t\t\tglog.V(3).Infof(\n144\t\t\t\t\t\"zombie sweeper: task %s job_started_at unparseable or zero; skipping\",\n145\t\t\t\t\ttaskID,\n146\t\t\t\t)\n147\t\t\t\tcontinue\n148\t\t\t}\n149\t\t\tdeadline := s.taskDeadline(task, cfgs)\n150\t\t\telapsed := now.Sub(jobStartedAt)\n151\t\t\tif elapsed < deadline {\n152\t\t\t\tcontinue\n153\t\t\t}\n154\t\t\treason := s.classify(lister, taskID, now)\n155\t\t\tif reason == \"\" {\n156\t\t\t\tcontinue\n157\t\t\t}\n158\t\t\tif err := s.publisher.PublishFailure(ctx, task, jobName, reason.String()); err != nil {\n159\t\t\t\tglog.Errorf(\n160\t\t\t\t\t\"zombie sweeper: publish failure for task %s (job %s reason %s): %v\",\n161\t\t\t\t\ttaskID, jobName, reason, err,\n162\t\t\t\t)\n163\t\t\t\tcontinue\n164\t\t\t}\n165\t\t\tglog.V(2).Infof(\n166\t\t\t\t\"zombie sweeper: published failure for task %s (job %s reason %s elapsed=%s)\",\n167\t\t\t\ttaskID, jobName, reason, elapsed,\n168\t\t\t)\n169\t\t}\n170\t\treturn nil\n171\t}\n172\t\n173\tfunc (s *zombieSweeper) taskDeadline(task lib.Task, cfgs []agentv1.Config) time.Duration {\n174\t\tassignee := task.Frontmatter.Assignee().String()\n175\t\tfor _, cfg := range cfgs {\n176\t\t\tif cfg.Spec.Assignee == assignee && cfg.Spec.ZombieJobTimeoutSeconds != nil {\n177\t\t\t\treturn time.Duration(*cfg.Spec.ZombieJobTimeoutSeconds) * time.Second\n178\t\t\t}\n179\t\t}\n180\t\treturn time.Duration(agentv1.DefaultZombieJobTimeoutSeconds) * time.Second\n181\t}\n182\t\n183\tfunc (s *zombieSweeper) resolveSweeperInterval(ctx context.Context) (time.Duration, error) {\n184\t\tcfgs, err := s.configProvider.Get(ctx)\n185\t\tif err != nil {\n186\t\t\treturn 0, errors.Wrapf(ctx, err, \"list configs\")\n187\t\t}\n188\t\tfor _, cfg := range cfgs {\n189\t\t\tif cfg.Spec.ZombieSweeperIntervalSeconds != nil {\n190\t\t\t\treturn time.Duration(*cfg.Spec.ZombieSweeperIntervalSeconds) * time.Second, nil\n191\t\t\t}\n192\t\t}\n193\t\treturn time.Duration(agentv1.DefaultZombieSweeperIntervalSeconds) * time.Second, nil\n194\t}\n195\t\n196\t// classify determines whether a past-deadline task is a zombie and which\n197\t// reason applies. Returns \"\" when the task is NOT a zombie (Pod still Running\n198\t// — implicit heartbeat). Inspects Pod state via the shared Pod informer's\n199\t// lister (introduced by prompt 2). Spec Failure-Mode row \"k8s API rate-limit\n200\t// (429)\" mandates: \"Sweeper relies on informer cache (no per-cycle list)\" —\n201\t// we MUST NOT issue API LIST calls here.\n202\tfunc (s *zombieSweeper) classify(\n203\t\tlister corev1listers.PodLister,\n204\t\ttaskID lib.TaskIdentifier,\n205\t\tnow time.Time,\n206\t) ZombieReason {\n207\t\tselector := labels.SelectorFromSet(labels.Set{\n208\t\t\t\"agent.benjamin-borbe.de/task-id\": string(taskID),\n209\t\t})\n210\t\tpods, err := lister.Pods(s.namespace.String()).List(selector)\n211\t\tif err != nil {\n212\t\t\tglog.Errorf(\"zombie sweeper: lister pods for task %s: %v\", taskID, err)\n213\t\t\treturn \"\"\n214\t\t}\n215\t\t// Zero pods AND past-deadline AND a Job was supposed to be running →\n216\t\t// executor lost the watch (Job exists in k8s but Pod GC happened, or the\n217\t\t// Job never created a Pod and was restarted across executor lifetimes).\n218\t\t// \"No recent heartbeat\" reduces to \"no Pod observed\" since this codebase\n219\t\t// has no separate heartbeat channel.\n220\t\tif len(pods) == 0 {\n221\t\t\treturn ZombieReasonExecutorWatchLost\n222\t\t}\n223\t\tfor _, pod := range pods {\n224\t\t\t// Healthy Running — NOT a zombie. A Running pod is the implicit\n225\t\t\t// heartbeat in the current system (no separate heartbeat channel).\n226\t\t\tif pod.Status.Phase == corev1.PodRunning {\n227\t\t\t\treturn \"\"\n228\t\t\t}\n229\t\t\t// Pending past the unschedulable grace window with PodScheduled=False.\n230\t\t\tif pod.Status.Phase == corev1.PodPending {\n231\t\t\t\tage := now.Sub(pod.CreationTimestamp.Time)\n232\t\t\t\tif age > podNotScheduledGraceWindow && hasPodScheduledFalse(pod) {\n233\t\t\t\t\treturn ZombieReasonPodNotScheduled\n234\t\t\t\t}\n235\t\t\t}\n236\t\t}\n237\t\t// Past deadline, no Running pod, no specific Pod-state reason — fall\n238\t\t// back to deadline_exceeded.\n239\t\treturn ZombieReasonDeadlineExceeded\n240\t}\n241\t\n242\t// hasPodScheduledFalse returns true when the Pod has a PodScheduled=False\n243\t// condition (kube-scheduler could not place the pod).\n244\tfunc hasPodScheduledFalse(pod *corev1.Pod) bool {\n245\t\tfor _, c := range pod.Status.Conditions {\n246\t\t\tif c.Type == corev1.PodScheduled && c.Status == corev1.ConditionFalse {\n247\t\t\t\treturn true\n248\t\t\t}\n249\t\t}\n250\t\treturn false\n251\t}\n252\t"}]},"parent_tool_use_id":"chatcmpl-tool-b68d74ad5231f9ea","session_id":"3667b84f-c892-4ca5-8115-a830204bf3b3","uuid":"68157653-b07d-4ab4-99bb-6387826eb1aa","timestamp":"2026-09-03T17:57:28.709Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec 005"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8734e7ca38beb3be","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"sync\"\n9\t\n10\t\tlib \"github.com/bborbe/agent\"\n11\t)\n12\t\n13\t// TaskStore is a thread-safe map from TaskIdentifier to Task.\n14\t// It is populated when the executor spawns a Job and consumed by the job\n15\t// informer when publishing synthetic failure results.\n16\ttype TaskStore struct {\n17\t\tmu    sync.RWMutex\n18\t\ttasks map[lib.TaskIdentifier]lib.Task\n19\t}\n20\t\n21\t// NewTaskStore creates an empty TaskStore.\n22\tfunc NewTaskStore() *TaskStore {\n23\t\treturn &TaskStore{tasks: make(map[lib.TaskIdentifier]lib.Task)}\n24\t}\n25\t\n26\t// Store saves the task for the given identifier (called on job spawn).\n27\tfunc (s *TaskStore) Store(id lib.TaskIdentifier, task lib.Task) {\n28\t\ts.mu.Lock()\n29\t\tdefer s.mu.Unlock()\n30\t\ts.tasks[id] = task\n31\t}\n32\t\n33\t// Load retrieves the task for the given identifier.\n34\tfunc (s *TaskStore) Load(id lib.TaskIdentifier) (lib.Task, bool) {\n35\t\ts.mu.RLock()\n36\t\tdefer s.mu.RUnlock()\n37\t\tt, ok := s.tasks[id]\n38\t\treturn t, ok\n39\t}\n40\t\n41\t// Delete removes the task for the given identifier (called on job termination).\n42\tfunc (s *TaskStore) Delete(id lib.TaskIdentifier) {\n43\t\ts.mu.Lock()\n44\t\tdefer s.mu.Unlock()\n45\t\tdelete(s.tasks, id)\n46\t}\n47\t\n48\t// Snapshot returns a shallow copy of the current task map for read-only iteration.\n49\t// Safe to call concurrently with Store/Delete; the returned map is owned by the caller.\n50\tfunc (s *TaskStore) Snapshot() map[lib.TaskIdentifier]lib.Task {\n51\t\ts.mu.RLock()\n52\t\tdefer s.mu.RUnlock()\n53\t\tout := make(map[lib.TaskIdentifier]lib.Task, len(s.tasks))\n54\t\tfor k, v := range s.tasks {\n55\t\t\tout[k] = v\n56\t\t}\n57\t\treturn out\n58\t}\n59\t"}]},"parent_tool_use_id":"chatcmpl-tool-b68d74ad5231f9ea","session_id":"3667b84f-c892-4ca5-8115-a830204bf3b3","uuid":"d013bce3-323f-4e96-a277-1455059888b1","timestamp":"2026-09-03T17:57:28.710Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec 005"}
