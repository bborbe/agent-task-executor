ctx context.Context, content []byte) (string, error) {\n55\t\ts := string(content)\n56\t\tconst delim = \"---\"\n57\t\tif !strings.HasPrefix(s, delim) {\n58\t\t\treturn \"\", errors.Errorf(ctx, \"no frontmatter delimiter found\")\n59\t\t}\n60\t\trest := strings.TrimPrefix(s, delim)\n61\t\tif strings.HasPrefix(rest, \"\\r\\n\") {\n62\t\t\trest = rest[2:]\n63\t\t} else if strings.HasPrefix(rest, \"\\n\") {\n64\t\t\trest = rest[1:]\n65\t\t}\n66\t\tidx := strings.Index(rest, \"\\n---\")\n67\t\tif idx == -1 {\n68\t\t\treturn \"\", errors.Errorf(ctx, \"frontmatter not closed\")\n69\t\t}\n70\t\treturn rest[:idx], nil\n71\t}\n72\t\n73\tfunc extractBody(content []byte) string {\n74\t\ts := string(content)\n75\t\tconst delim = \"---\"\n76\t\tif !strings.HasPrefix(s, delim) {\n77\t\t\treturn s\n78\t\t}\n79\t\trest := strings.TrimPrefix(s, delim)\n80\t\tif strings.HasPrefix(rest, \"\\r\\n\") {\n81\t\t\trest = rest[2:]\n82\t\t} else if strings.HasPrefix(rest, \"\\n\") {\n83\t\t\trest = rest[1:]\n84\t\t}\n85\t\tidx := strings.Index(rest, \"\\n---\")\n86\t\tif idx == -1 {\n87\t\t\treturn s\n88\t\t}\n89\t\tafter := rest[idx+4:] // skip \"\\n---\"\n90\t\tif strings.HasPrefix(after, \"\\r\\n\") {\n91\t\t\tafter = after[2:]\n92\t\t} else if strings.HasPrefix(after, \"\\n\") {\n93\t\t\tafter = after[1:]\n94\t\t}\n95\t\treturn after\n96\t}\n97\t"}]},"parent_tool_use_id":"chatcmpl-tool-b68d74ad5231f9ea","session_id":"3667b84f-c892-4ca5-8115-a830204bf3b3","uuid":"f188c7b8-5121-4ba0-8801-f86ef3d3ddff","timestamp":"2026-09-03T17:58:28.430Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec 005"}
