{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8a957344f0fa733b","type":"tool_result","content":"430\t\t\t\t\th.deferredRespawns[task.TaskIdentifier] = deferredEntry{\n431\t\t\t\t\t\ttask:       task,\n432\t\t\t\t\t\tconfig:     *config,\n433\t\t\t\t\t\tretryAfter: retryAfter,\n434\t\t\t\t\t}\n435\t\t\t\t\th.deferredMu.Unlock()\n436\t\t\t\t}\n437\t\t\t\treturn true, nil\n438\t\t\t}\n439\t\t}\n440\t\tglog.V(2).Infof(\n441\t\t\t\"task %s: current_job %s no longer active, proceeding to spawn\",\n442\t\t\ttask.TaskIdentifier, currentJob,\n443\t\t)\n444\t\treturn false, nil\n445\t}\n446\t\n447\t// spawnIfNeeded returns (spawned, err): spawned is true iff a new k8s Job was actually launched\n448\t// (i.e. the call reached SpawnJob successfully). All early-return branches (suppression, trigger\n449\t// cap, active job, terminal phase, errors) return spawned=false.\n450\tfunc (h *taskEventHandler) spawnIfNeeded(\n451\t\tctx context.Context,\n452\t\ttask lib.Task,\n453\t\tconfig *pkg.AgentConfiguration,\n454\t) (bool, error) {\n455\t\t// If current_job is set in frontmatter, a prior spawn notification was written\n456\t\t// to the task file. Verify the job is still active; if not, proceed to spawn.\n457\t\tif currentJob := task.Frontmatter.CurrentJob(); currentJob != \"\" {\n458\t\t\tsuppress, err := h.checkActiveCurrentJob(ctx, task, currentJob, config)\n459\t\t\tif err != nil {\n460\t\t\t\treturn false, err\n461\t\t\t}\n462\t\t\tif suppress {\n463\t\t\t\treturn false, nil\n464\t\t\t}\n465\t\t}\n466\t\n467\t\t// Held across the cap check AND the SpawnJob call below, so no other goroutine\n468\t\t// can observe a stale Job count in between. Only taken when a cap is configured:\n469\t\t// an uncapped agent has nothing to serialize, and holding the lock anyway would\n470\t\t// queue its spawns behind each other for no benefit.\n471\t\tif config != nil && config.MaxConcurrentJobs > 0 {\n472\t\t\tdefer h.lockAssigneeSpawn(config.Assignee)()\n473\t\t}\n474\t\n475\t\tactive, err := h.jobSpawner.IsJobActive(ctx, task.TaskIdentifier)\n476\t\tif err != nil {\n477\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n478\t\t\treturn false, errors.Wrapf(ctx, err, \"check active job for task %s\", task.TaskIdentifier)\n479\t\t}\n480\t\tif active {\n481\t\t\tglog.V(3).Infof(\"skip task %s: active job exists\", task.TaskIdentifier)\n482\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_active_job\").Inc()\n483\t\t\treturn false, nil\n484\t\t}\n485\t\n486\t\tcapped, err := h.deferIfAtConcurrencyCap(ctx, task, config)\n487\t\tif err != nil {\n488\t\t\treturn false, err\n489\t\t}\n490\t\tif capped {\n491\t\t\treturn false, nil\n492\t\t}\n493\t\n494\t\t// Scoped trigger budget: evaluates the opt-in cap against the task's current\n495\t\t// phase+ref scope and publishes the counter write for the spawn about to\n496\t\t// happen. Extracted so spawnIfNeeded stays legible; it owns one decision.\n497\t\tcapped, err = h.applyTriggerBudget(ctx, task)\n498\t\tif err != nil {\n499\t\t\treturn false, err\n500\t\t}\n501\t\tif capped {\n502\t\t\treturn false, nil\n503\t\t}\n504\t\n505\t\tjobName, err := h.jobSpawner.SpawnJob(ctx, task, *config)\n506\t\tif err != nil {\n507\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n508\t\t\treturn false, errors.Wrapf(ctx, err, \"spawn job for task %s failed\", task.TaskIdentifier)\n509\t\t}\n510\t\n511\t\th.taskStore.Store(task.TaskIdentifier, task)\n512\t\tif err := h.resultPublisher.PublishSpawnNotification(ctx, task, jobName); err != nil {\n513\t\t\t// Log but don't fail — job is already spawned, spawn notification is best-effort\n514\t\t\tglog.Warningf(\"publish spawn notification for task %s failed (job %s still running): %v\",\n515\t\t\t\ttask.TaskIdentifier, jobName, err)\n516\t\t}\n517\t\n518\t\tglog.V(2).Infof(\n519\t\t\t\"spawned job for task %s (assignee=%s image=%s)\",\n520\t\t\ttask.TaskIdentifier, task.Frontmatter.Assignee(), config.Image,\n521\t\t)\n522\t\tmetrics.TaskEventsTotal.WithLabelValues(\"spawned\").Inc()\n523\t\tmetrics.JobsSpawnedTotal.Inc()\n524\t\treturn true, nil\n525\t}\n526\t\n527\t// deferIfAtConcurrencyCap reports whether the agent is already running its\n528\t// configured maximum number of Jobs, and if so registers the task for a\n529\t// deferred respawn instead of spawning now.\n530\t//\n531\t// Deferring rather than skipping is the whole point. Task publication is\n532\t// edge-triggered on vault file changes; being over the cap produces no such\n533\t// change, so a skipped spawn would never be re-driven and the task would sit\n534\t// at in_progress forever, indistinguishable from work in flight.\n535\tfunc (h *taskEventHandler) deferIfAtConcurrencyCap(\n536\t\tctx context.Context,\n537\t\ttask lib.Task,\n538\t\tconfig *pkg.AgentConfiguration,\n539\t) (bool, error) {\n540\t\tif config == nil || config.MaxConcurrentJobs <= 0 {\n541\t\t\treturn false, nil\n542\t\t}\n543\t\trunning, err := h.jobSpawner.CountActiveJobs(ctx, config.Assignee)\n544\t\tif err != nil {\n545\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n546\t\t\treturn false, errors.Wrapf(ctx, err, \"count active jobs for assignee %s\", config.Assignee)\n547\t\t}\n548\t\tif running < config.MaxConcurrentJobs {\n549\t\t\t// Log the ADMIT decision, not just the deferral. Without this, an\n550\t\t\t// over-cap spawn leaves no trace and overshoot can only be found by\n551\t\t\t// counting Jobs in the cluster by hand — which is how the 2026-08-15\n552\t\t\t// race went unnoticed until 17 Jobs existed against a cap of 1.\n553\t\t\t// Same V(1) rationale as the deferral log below.\n554\t\t\tglog.V(1).Infof(\n555\t\t\t\t\"event=concurrency_admit task=%s assignee=%s running=%d cap=%d\",\n556\t\t\t\ttask.TaskIdentifier, config.Assignee, running, config.MaxConcurrentJobs,\n557\t\t\t)\n558\t\t\treturn false, nil\n559\t\t}\n560\t\t// V(1), not V(0): a capped deferral is an expected steady state and repeats\n561\t\t// once per retry interval per waiting task, so V(0) would be a constant\n562\t\t// stream during any backlog. V(1) is inside the deployed verbosity, so it\n563\t\t// stays visible to an operator looking — unlike the V(3) skip that hid the\n564\t\t// wedge fixed in #12.\n565\t\tglog.V(1).Infof(\n566\t\t\t\"event=concurrency_cap task=%s assignee=%s running=%d cap=%d retry_after=%s\",\n567\t\t\ttask.TaskIdentifier, config.Assignee, running, config.MaxConcurrentJobs,\n568\t\t\tconcurrencyCapRetryDelay,\n569\t\t)\n570\t\tmetrics.TaskEventsTotal.WithLabelValues(\"deferred_concurrency_cap\").Inc()\n571\t\th.deferredMu.Lock()\n572\t\th.deferredRespawns[task.TaskIdentifier] = deferredEntry{\n573\t\t\ttask:       task,\n574\t\t\tconfig:     *config,\n575\t\t\tretryAfter: h.currentDateTime.Now().Time().Add(concurrencyCapRetryDelay),\n576\t\t}\n577\t\th.deferredMu.Unlock()\n578\t\treturn true, nil\n579\t}\n580\t\n581\t// evalDeferredRespawns checks all pending deferred-respawn entries and spawns a job\n582\t// for each entry whose retryAfter has been reached. Entries are removed once processed.\n583\t// The respawn_after_grace_window metric and log line fire ONLY when the call actually\n584\t// results in a spawn (spec 037 AC #6: \"recorded each time the follow-up evaluation\n585\t// results in a spawn\"); evaluations that no-op (active job already, trigger cap hit,\n586\t// terminal phase) do not increment the metric.\n587\tfunc (h *taskEventHandler) evalDeferredRespawns(ctx context.Context) error {\n588\t\tnow := h.currentDateTime.Now().Time()\n589\t\n590\t\th.deferredMu.Lock()\n591\t\tvar ready []deferredEntry\n592\t\tfor taskID, entry := range h.deferredRespawns {\n593\t\t\tif !now.Before(entry.retryAfter) {\n594\t\t\t\tready = append(ready, entry)\n595\t\t\t\tdelete(h.deferredRespawns, taskID)\n596\t\t\t}\n597\t\t}\n598\t\th.deferredMu.Unlock()\n599\t\n600\t\tfor _, entry := range ready {\n601\t\t\tentry := entry // capture for closure\n602\t\t\tspawned, err := h.spawnIfNeeded(ctx, entry.task, &entry.config)\n603\t\t\tif err != nil {\n604\t\t\t\treturn errors.Wrapf(\n605\t\t\t\t\tctx, err, \"deferred respawn for task %s\", entry.task.TaskIdentifier,\n606\t\t\t\t)\n607\t\t\t}\n608\t\t\tif !spawned {\n609\t\t\t\tcontinue\n610\t\t\t}\n611\t\t\tjobStartedAt, _ := entry.task.Frontmatter.JobStartedAt()\n612\t\t\telapsed := now.Sub(jobStartedAt)\n613\t\t\tglog.Infof(\n614\t\t\t\t\"event=respawn_after_grace_window task=%s current_job=%s elapsed=%.0fs\",\n615\t\t\t\tentry.task.TaskIdentifier, entry.task.Frontmatter.CurrentJob(), elapsed.Seconds(),\n616\t\t\t)\n617\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"respawn_after_grace_window\").Inc()\n618\t\t}\n619\t\treturn nil\n620\t}\n621\t\n622\t// removeDeferredEntry removes any pending deferred-respawn entry for the given task.\n623\t// Called from parseAndFilter when a terminal-phase event arrives so no stale spawn fires.\n624\tfunc (h *taskEventHandler) removeDeferredEntry(id lib.TaskIdentifier) {\n625\t\th.deferredMu.Lock()\n626\t\tdelete(h.deferredRespawns, id)\n627\t\th.deferredMu.Unlock()\n628\t}\n629\t\n630\t// EvalDeferredRespawns implements TaskEventHandler.\n631\tfunc (h *taskEventHandler) EvalDeferredRespawns(ctx context.Context) error {\n632\t\treturn h.evalDeferredRespawns(ctx)\n633\t}\n634\t\n635\t// seedDeferredRespawnsFromStore scans the in-memory taskStore for tasks that look\n636\t// like in-flight work (current_job set, phase non-terminal) and adds them to\n637\t// deferredRespawns with retryAfter = job_started_at + defaultRespawnGracePeriod.\n638\t// Called once from RunDeferredRespawnLoop on startup. Idempotent: any entry already\n639\t// present in deferredRespawns is left untouched. This restores deferred state lost\n640\t// when the in-memory map is wiped by an executor restart, so a stuck task does not\n641\t// remain stuck for want of a Kafka event that will never arrive.\n642\tfunc (h *taskEventHandler) seedDeferredRespawnsFromStore() {\n643\t\tsnapshot := h.taskStore.Snapshot()\n644\t\n645\t\th.deferredMu.Lock()\n646\t\tdefer h.deferredMu.Unlock()\n647\t\tfor taskID, task := range snapshot {\n648\t\t\tif _, exists := h.deferredRespawns[taskID]; exists {\n649\t\t\t\tcontinue\n650\t\t\t}\n651\t\t\tcurrentJob := task.Frontmatter.CurrentJob()\n652\t\t\tif currentJob == \"\" {\n653\t\t\t\tcontinue\n654\t\t\t}\n655\t\t\tphase := task.Frontmatter.Phase()\n656\t\t\tif phase != nil && IsTerminal(*phase) {\n657\t\t\t\tcontinue\n658\t\t\t}\n659\t\t\tjobStartedAt, jobStartedErr := task.Frontmatter.JobStartedAt()\n660\t\t\tif jobStartedErr != nil {\n661\t\t\t\tcontinue\n662\t\t\t}\n663\t\t\th.deferredRespawns[taskID] = deferredEntry{\n664\t\t\t\ttask: task,\n665\t\t\t\t// config: the agent configuration is resolved at event time; the seed\n666\t\t\t\t// uses an empty value here. For seeded entries the config is zero-valued;\n667\t\t\t\t// this is acceptable because the next genuine Kafka event for the task\n668\t\t\t\t// will supply the correct config via the event-driven path.\n669\t\t\t\tretryAfter: jobStartedAt.Add(defaultRespawnGracePeriod),\n670\t\t\t}\n671\t\t}\n672\t}\n673\t\n674\t// RunDeferredRespawnLoop implements TaskEventHandler.\n675\tfunc (h *taskEventHandler) RunDeferredRespawnLoop(ctx context.Context) error {\n676\t\t// Startup reconciliation: recover deferred entries lost across an executor\n677\t\t// restart by scanning the in-memory taskStore. See seedDeferredRespawnsFromStore\n678\t\t// for the restart-safety rationale (spec 037 AC #5).\n679\t\th.seedDeferredRespawnsFromStore()\n680\t\n681\t\t// Fire one eval immediately after seeding so that tasks whose grace has\n682\t\t// already elapsed at startup are picked up without waiting for the first tick.\n683\t\tif err := h.evalDeferredRespawns(ctx); err != nil {\n684\t\t\treturn errors.Wrapf(ctx, err, \"deferred respawn loop initial eval\")\n685\t\t}\n686\t\n687\t\tticker := time.NewTicker(deferredRespawnInterval)\n688\t\tdefer ticker.Stop()\n689\t\tfor {\n690\t\t\tselect {\n691\t\t\tcase <-ctx.Done():\n692\t\t\t\treturn nil\n693\t\t\tcase <-ticker.C:\n694\t\t\t\tif err := h.evalDeferredRespawns(ctx); err != nil {\n695\t\t\t\t\treturn errors.Wrapf(ctx, err, \"deferred respawn loop tick\")\n696\t\t\t\t}\n697\t\t\t}\n698\t\t}\n699\t}"}]},"parent_tool_use_id":"chatcmpl-tool-b6d0d8e0bb230096","session_id":"3667b84f-c892-4ca5-8115-a830204bf3b3","uuid":"705744b4-06f7-43eb-adde-86344b2af16a","timestamp":"2026-09-03T18:08:38.266Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 2 reconcile-loop"}
