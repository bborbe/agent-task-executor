{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8dd0517a96453da1","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"os\"\n10\t\t\"regexp\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/bborbe/cqrs/base\"\n14\t\tlibcron \"github.com/bborbe/cron\"\n15\t\t\"github.com/bborbe/errors\"\n16\t\tlibhttp \"github.com/bborbe/http\"\n17\t\tlibk8s \"github.com/bborbe/k8s\"\n18\t\tlibkafka \"github.com/bborbe/kafka\"\n19\t\t\"github.com/bborbe/log\"\n20\t\tlibmetrics \"github.com/bborbe/metrics\"\n21\t\t\"github.com/bborbe/run\"\n22\t\tlibsentry \"github.com/bborbe/sentry\"\n23\t\t\"github.com/bborbe/service\"\n24\t\tlibtime \"github.com/bborbe/time\"\n25\t\t\"github.com/golang/glog\"\n26\t\t\"github.com/gorilla/mux\"\n27\t\t\"github.com/prometheus/client_golang/prometheus/promhttp\"\n28\t\t\"k8s.io/client-go/kubernetes\"\n29\t\t\"k8s.io/client-go/rest\"\n30\t\n31\t\t\"github.com/bborbe/agent-task-executor/pkg\"\n32\t\t\"github.com/bborbe/agent-task-executor/pkg/factory\"\n33\t\t\"github.com/bborbe/agent-task-executor/pkg/handler\"\n34\t\t\"github.com/bborbe/agent-task-executor/pkg/probe\"\n35\t)\n36\t\n37\tfunc main() {\n38\t\tapp := &application{}\n39\t\tos.Exit(service.Main(context.Background(), app, &app.SentryDSN, &app.SentryProxy))\n40\t}\n41\t\n42\ttype application struct {\n43\t\tSentryDSN                  string            `required:\"true\"  arg:\"sentry-dsn\"                     env:\"SENTRY_DSN\"                     usage:\"SentryDSN\"                                                                                                                                                                                                                                                         display:\"length\"`\n44\t\tSentryProxy                string            `required:\"false\" arg:\"sentry-proxy\"                   env:\"SENTRY_PROXY\"                   usage:\"Sentry Proxy\"`\n45\t\tListen                     string            `required:\"true\"  arg:\"listen\"                         env:\"LISTEN\"                         usage:\"address to listen to\"`\n46\t\tKafkaBrokers               string            `required:\"true\"  arg:\"kafka-brokers\"                  env:\"KAFKA_BROKERS\"                  usage:\"comma-separated Kafka broker addresses\"`\n47\t\tBranch                     base.Branch       `required:\"true\"  arg:\"branch\"                         env:\"BRANCH\"                         usage:\"Kafka topic prefix branch (develop/live)\"`\n48\t\tTopicPrefix                base.TopicPrefix  `required:\"false\" arg:\"topic-prefix\"                   env:\"TOPIC_PREFIX\"                   usage:\"Explicit Kafka topic prefix; empty means unprefixed topics\"`\n49\t\tNamespace                  libk8s.Namespace  `required:\"true\"  arg:\"namespace\"                      env:\"NAMESPACE\"                      usage:\"K8s namespace to spawn Jobs in\"`\n50\t\tVaultName                  string            `required:\"true\"  arg:\"vault-name\"                     env:\"VAULT_NAME\"                     usage:\"Obsidian vault name this executor instance serves; Config CRs are resolved by the composed {assignee}-{vaultName} assignee\"`\n51\t\tBuildGitVersion            string            `required:\"false\" arg:\"build-git-version\"              env:\"BUILD_GIT_VERSION\"              usage:\"Build Git version (git describe --tags --always --dirty)\"                                                                                                                                                                                                                           default:\"dev\"`\n52\t\tBuildGitCommit             string            `required:\"false\" arg:\"build-git-commit\"               env:\"BUILD_GIT_COMMIT\"               usage:\"Build Git commit hash\"                                                                                                                                                                                                                                                              default:\"none\"`\n53\t\tBuildDate                  *libtime.DateTime `required:\"false\" arg:\"build-date\"                     env:\"BUILD_DATE\"                     usage:\"Build timestamp (RFC3339)\"`\n54\t\tHealthcheckCronExpression  string            `required:\"true\"  arg:\"healthcheck-cron-expression\"    env:\"HEALTHCHECK_CRON_EXPRESSION\"    usage:\"Cron expression for agent liveness health checks\"                                                                                                                                                                                                                                   default:\"0 0 8 * * 1\"`\n55\t\tJobTTLSecondsAfterFinished int32             `required:\"false\" arg:\"job-ttl-seconds-after-finished\" env:\"JOB_TTL_SECONDS_AFTER_FINISHED\" usage:\"K8s Job TTL after completion (seconds) — completed Job pods are GCed after this delay\"                                                                                                                                                                                              default:\"1800\"`\n56\t\t// JobKafkaClientCertSecret holds the NAME of the K8s Secret carrying the\n57\t\t// Kafka client cert/key — not the cert material itself. The value is a\n58\t\t// resource reference (already public in the Deployment manifest), so no\n59\t\t// display:\"length\" guard is needed.\n60\t\tJobKafkaClientCertSecret string `required:\"false\" arg:\"job-kafka-client-cert-secret\"   env:\"JOB_KAFKA_CLIENT_CERT_SECRET\"   usage:\"Name of the existing K8s secret holding the Kafka client cert/key (keys user.crt/user.key) to mount into spawned Jobs; empty disables cert mounting. Must be a valid K8s Secret name (RFC 1123: lowercase alphanumeric or '-', <=253 chars) or Job creation fails\"`\n61\t\t// JobKafkaCaCertSecret holds the NAME of the K8s Secret carrying the Kafka\n62\t\t// CA cert — not the cert material itself. Same reasoning as\n63\t\t// JobKafkaClientCertSecret: a resource reference, not secret-shaped.\n64\t\tJobKafkaCaCertSecret string `required:\"false\" arg:\"job-kafka-ca-cert-secret\"       env:\"JOB_KAFKA_CA_CERT_SECRET\"       usage:\"Name of the existing K8s secret holding the Kafka CA cert (key ca.crt) to mount into spawned Jobs; empty disables cert mounting. Must be a valid K8s Secret name (RFC 1123: lowercase alphanumeric or '-', <=253 chars) or Job creation fails\"`\n65\t}\n66\t\n67\t// vaultSlugRegexp mirrors the controller's VAULT_NAME validation (pkg/routing):\n68\t// a lowercase letter, then lowercase letters, digits, or hyphens. The composed\n69\t// {assignee}-{vaultName} lookup key depends on a well-formed vault slug — a\n70\t// malformed value would silently never match a Config CR.\n71\tvar vaultSlugRegexp = regexp.MustCompile(`^[a-z][a-z0-9-]*$`)\n72\t\n73\t//nolint:funlen // Initialization sequence; wiring is linear with no branching.\n74\tfunc (a *application) Run(ctx context.Context, sentryClient libsentry.Client) error {\n75\t\tlibmetrics.NewBuildInfoMetrics().SetBuildInfo(a.BuildGitVersion, a.BuildGitCommit, a.BuildDate)\n76\t\tglog.V(1).\n77\t\t\tInfof(\"agent-task-executor started version=%s commit=%s\", a.BuildGitVersion, a.BuildGitCommit)\n78\t\n79\t\tif a.JobTTLSecondsAfterFinished < 0 {\n80\t\t\treturn errors.Errorf(\n81\t\t\t\tctx,\n82\t\t\t\t\"job-ttl-seconds-after-finished must be >= 0 (0 deletes immediately), got %d\",\n83\t\t\t\ta.JobTTLSecondsAfterFinished,\n84\t\t\t)\n85\t\t}\n86\t\tif !vaultSlugRegexp.MatchString(a.VaultName) {\n87\t\t\treturn errors.Errorf(\n88\t\t\t\tctx,\n89\t\t\t\t\"vault-name must match ^[a-z][a-z0-9-]*$ (lowercase letter, then lowercase/digits/hyphens), got %q\",\n90\t\t\t\ta.VaultName,\n91\t\t\t)\n92\t\t}\n93\t\n94\t\tkubeConfig, err := rest.InClusterConfig()\n95\t\tif err != nil {\n96\t\t\treturn errors.Wrapf(ctx, err, \"get in-cluster k8s config\")\n97\t\t}\n98\t\tkubeClient, err := kubernetes.NewForConfig(kubeConfig)\n99\t\tif err != nil {\n100\t\t\treturn errors.Wrapf(ctx, err, \"create k8s client\")\n101\t\t}\n102\t\n103\t\tconnector := factory.CreateK8sConnector(kubeConfig)\n104\t\tif err := connector.SetupCustomResourceDefinition(ctx); err != nil {\n105\t\t\treturn errors.Wrapf(ctx, err, \"setup Config CRD\")\n106\t\t}\n107\t\teventHandlerConfig := factory.CreateEventHandlerConfig()\n108\t\tresourceEventHandler := factory.CreateResourceEventHandlerConfig(\n109\t\t\tctx,\n110\t\t\teventHandlerConfig,\n111\t\t)\n112\t\tresolver := factory.CreateConfigResolver(eventHandlerConfig, a.Branch, a.VaultName)\n113\t\n114\t\tsaramaClient, err := libkafka.CreateSaramaClient(\n115\t\t\tctx,\n116\t\t\tlibkafka.ParseBrokersFromString(a.KafkaBrokers),\n117\t\t)\n118\t\tif err != nil {\n119\t\t\treturn errors.Wrapf(ctx, err, \"create sarama client\")\n120\t\t}\n121\t\tdefer saramaClient.Close()\n122\t\tcurrentDateTimeGetter := libtime.NewCurrentDateTime()\n123\t\tsyncProducer, err := libkafka.NewSyncProducerFromSaramaClient(ctx, saramaClient)\n124\t\tif err != nil {\n125\t\t\treturn errors.Wrapf(ctx, err, \"create kafka sync producer\")\n126\t\t}\n127\t\tdefer syncProducer.Close()\n128\t\n129\t\tresultPublisher := pkg.NewResultPublisher(syncProducer, a.TopicPrefix, currentDateTimeGetter)\n130\t\ttaskStore := pkg.NewTaskStore()\n131\t\tjobWatcher := factory.CreateJobWatcher(kubeClient, a.Namespace, taskStore, resultPublisher)\n132\t\n133\t\tzombieSweeper := factory.CreateZombieSweeper(\n134\t\t\tjobWatcher,\n135\t\t\ta.Namespace,\n136\t\t\ttaskStore,\n137\t\t\tresultPublisher,\n138\t\t\teventHandlerConfig,\n139\t\t\tcurrentDateTimeGetter,\n140\t\t)\n141\t\n142\t\thealthcheckRunner := factory.CreateHealthcheckRunner(\n143\t\t\teventHandlerConfig,\n144\t\t\tsyncProducer,\n145\t\t\ta.TopicPrefix,\n146\t\t\ta.Branch,\n147\t\t)\n148\t\thealthcheckCron := factory.CreateHealthcheckCron(\n149\t\t\tlibcron.Expression(a.HealthcheckCronExpression),\n150\t\t\thealthcheckRunner,\n151\t\t)\n152\t\n153\t\tconsumer, taskEventHandler := factory.CreateConsumer(\n154\t\t\tsaramaClient,\n155\t\t\ta.Branch,\n156\t\t\ta.TopicPrefix,\n157\t\t\tkubeClient,\n158\t\t\ta.Namespace,\n159\t\t\ta.KafkaBrokers,\n160\t\t\tresolver,\n161\t\t\tlog.DefaultSamplerFactory,\n162\t\t\tcurrentDateTimeGetter,\n163\t\t\tresultPublisher,\n164\t\t\ttaskStore,\n165\t\t\ta.JobTTLSecondsAfterFinished,\n166\t\t\ta.JobKafkaClientCertSecret,\n167\t\t\ta.JobKafkaCaCertSecret,\n168\t\t)\n169\t\n170\t\treturn service.Run(\n171\t\t\tctx,\n172\t\t\tfunc(ctx context.Context) error {\n173\t\t\t\treturn connector.Listen(ctx, a.Namespace, resourceEventHandler)\n174\t\t\t},\n175\t\t\tconsumer.Consume,\n176\t\t\ttaskEventHandler.RunDeferredRespawnLoop,\n177\t\t\tjobWatcher.Run,\n178\t\t\tzombieSweeper.Run,\n179\t\t\ta.createHTTPServer(eventHandlerConfig, healthcheckRunner),\n180\t\t\thealthcheckCron.Run,\n181\t\t)\n182\t}\n183\t\n184\tfunc (a *application) createHTTPServer(\n185\t\tconfigProvider pkg.EventHandlerConfig,\n186\t\trunner probe.HealthcheckRunner,\n187\t) run.Func {\n188\t\treturn func(ctx context.Context) error {\n189\t\t\trouter := mux.NewRouter()\n190\t\t\trouter.Path(\"/healthz\").Handler(libhttp.NewPrintHandler(\"OK\"))\n191\t\t\trouter.Path(\"/readiness\").Handler(libhttp.NewPrintHandler(\"OK\"))\n192\t\t\trouter.Path(\"/metrics\").Handler(promhttp.Handler())\n193\t\t\trouter.Path(\"/setloglevel/{level}\").\n194\t\t\t\tHandler(log.NewSetLoglevelHandler(ctx, log.NewLogLevelSetter(2, 5*time.Minute)))\n195\t\t\trouter.Path(\"/gc\").Handler(libhttp.NewGarbageCollectorHandler())\n196\t\n197\t\t\trouter.Path(\"/agents\").\n198\t\t\t\tHandler(handler.NewAgentsHandler(configProvider, os.Getenv(\"AGENTS_AUTH_SECRET\")))\n199\t\t\trouter.Path(\"/healthcheck-trigger\").Handler(\n200\t\t\t\thandler.NewHealthcheckTriggerHandler(runner),\n201\t\t\t)\n202\t\n203\t\t\tglog.V(2).Infof(\"starting http server listen on %s\", a.Listen)\n204\t\t\t// Using libhttp defaults: ReadTimeout=30s, WriteTimeout=30s, IdleTimeout=60s,\n205\t\t\t// ReadHeaderTimeout=10s, MaxHeaderBytes=1MB — appropriate for task-executor API.\n206\t\t\treturn libhttp.NewServer(\n207\t\t\t\ta.Listen,\n208\t\t\t\trouter,\n209\t\t\t).Run(ctx)\n210\t\t}\n211\t}\n212\t"}]},"parent_tool_use_id":"chatcmpl-tool-b6d0d8e0bb230096","session_id":"3667b84f-c892-4ca5-8115-a830204bf3b3","uuid":"16de6fbc-b9fd-439e-b6b6-0eda109753fd","timestamp":"2026-09-03T18:08:42.958Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 2 reconcile-loop"}
