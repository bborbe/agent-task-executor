{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-99307420d04e8f35","type":"tool_result","content":"295\t\t\t\t\t\t\"phase\":    string(domain.TaskPhaseExecution),\n296\t\t\t\t\t\t\"assignee\": \"claude\",\n297\t\t\t\t\t},\n298\t\t\t\t}\n299\t\n300\t\t\t\terr := h.ConsumeMessage(ctx, buildMsg(task))\n301\t\t\t\tExpect(err).To(BeNil())\n302\t\t\t\tExpect(fakeSpawner.SpawnJobCallCount()).To(Equal(1))\n303\t\t\t})\n304\t\n305\t\t\tIt(\"admits exactly MaxConcurrentJobs when spawns arrive concurrently\", func() {\n306\t\t\t\t// Regression for the check-then-act race fixed by the per-assignee\n307\t\t\t\t// spawn lock. In prod on 2026-08-15 a cap of 1 admitted 17 Jobs from\n308\t\t\t\t// 36 concurrent releases, because every caller read the same live Job\n309\t\t\t\t// count before any of them had created its Job.\n310\t\t\t\t//\n311\t\t\t\t// The fake counts like the real cluster: CountActiveJobs reports the\n312\t\t\t\t// Jobs actually created so far. Without the lock the count is stale\n313\t\t\t\t// for every goroutine and this spawns far more than the cap.\n314\t\t\t\tconst concurrent = 10\n315\t\t\t\tvar spawned atomic.Int64\n316\t\t\t\tfakeResolver.ResolveReturns(\n317\t\t\t\t\tpkg.AgentConfiguration{\n318\t\t\t\t\t\tAssignee:          \"claude\",\n319\t\t\t\t\t\tImage:             \"my-image:latest\",\n320\t\t\t\t\t\tMaxConcurrentJobs: 1,\n321\t\t\t\t\t},\n322\t\t\t\t\tnil,\n323\t\t\t\t)\n324\t\t\t\tfakeSpawner.IsJobActiveReturns(false, nil)\n325\t\t\t\tfakeSpawner.CountActiveJobsStub = func(_ context.Context, _ string) (int, error) {\n326\t\t\t\t\t// Widen the count→spawn window deliberately. The real race is a\n327\t\t\t\t\t// sub-millisecond gap between a live API List and the Job CREATE;\n328\t\t\t\t\t// without this delay the unlocked code wins the race often enough\n329\t\t\t\t\t// that the test passes by luck. Under the lock these sleeps\n330\t\t\t\t\t// serialize (10 * 20ms) instead of overlapping, so the delay\n331\t\t\t\t\t// cannot mask a regression — it only makes one visible.\n332\t\t\t\t\ttime.Sleep(20 * time.Millisecond)\n333\t\t\t\t\treturn int(spawned.Load()), nil\n334\t\t\t\t}\n335\t\t\t\tfakeSpawner.SpawnJobStub = func(\n336\t\t\t\t\t_ context.Context,\n337\t\t\t\t\t_ lib.Task,\n338\t\t\t\t\t_ pkg.AgentConfiguration,\n339\t\t\t\t) (string, error) {\n340\t\t\t\t\tspawned.Add(1)\n341\t\t\t\t\treturn \"job-name\", nil\n342\t\t\t\t}\n343\t\n344\t\t\t\tvar wg sync.WaitGroup\n345\t\t\t\tfor i := range concurrent {\n346\t\t\t\t\twg.Add(1)\n347\t\t\t\t\tgo func(i int) {\n348\t\t\t\t\t\tdefer GinkgoRecover()\n349\t\t\t\t\t\tdefer wg.Done()\n350\t\t\t\t\t\ttask := lib.Task{\n351\t\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\n352\t\t\t\t\t\t\t\tfmt.Sprintf(\"tid-cap-concurrent-%d\", i),\n353\t\t\t\t\t\t\t),\n354\t\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n355\t\t\t\t\t\t\t\t\"status\":   \"in_progress\",\n356\t\t\t\t\t\t\t\t\"phase\":    string(domain.TaskPhaseExecution),\n357\t\t\t\t\t\t\t\t\"assignee\": \"claude\",\n358\t\t\t\t\t\t\t},\n359\t\t\t\t\t\t}\n360\t\t\t\t\t\tExpect(h.ConsumeMessage(ctx, buildMsg(task))).To(BeNil())\n361\t\t\t\t\t}(i)\n362\t\t\t\t}\n363\t\t\t\twg.Wait()\n364\t"}]},"parent_tool_use_id":"chatcmpl-tool-9be1dac94caaf56f","session_id":"3667b84f-c892-4ca5-8115-a830204bf3b3","uuid":"fc4e56d6-ab74-4ccc-ac14-f06378410bc5","timestamp":"2026-09-03T18:08:29.290Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt 3 spawn-lock"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8553d709dea930ac","type":"tool_result","content":"35\t\n36\t//counterfeiter:generate -o ../../mocks/job_spawner.go --fake-name FakeJobSpawner . JobSpawner\n37\t\n38\t// JobSpawner creates a K8s Job for a task.\n39\ttype JobSpawner interface {\n40\t\t// SpawnJob creates a K8s Job for the task and returns the job name.\n41\t\t// Returns the job name even when the job already exists (idempotent).\n42\t\tSpawnJob(ctx context.Context, task lib.Task, config pkg.AgentConfiguration) (string, error)\n43\t\t// IsJobActive returns true if an active (not completed/failed) K8s Job exists\n44\t\t// for the given task identifier. Uses the agent.benjamin-borbe.de/task-id\n45\t\t// label set by SpawnJob.\n46\t\tIsJobActive(ctx context.Context, taskIdentifier lib.TaskIdentifier) (bool, error)\n47\t\t// CountActiveJobs returns the number of non-terminal K8s Jobs currently\n48\t\t// running for the given assignee. Uses the agent.benjamin-borbe.de/assignee\n49\t\t// label set by SpawnJob. Jobs spawned before that label existed are not\n50\t\t// counted, so the cap under-counts during the rollout and never over-counts.\n51\t\tCountActiveJobs(ctx context.Context, assignee string) (int, error)\n52\t}\n53\t\n54\t// NewJobSpawner creates a new JobSpawner backed by the K8s batch/v1 API.\n55\t// jobTTLSecondsAfterFinished controls how long completed Job pods survive\n56\t// before Kubernetes' TTL controller garbage-collects them.\n57\t// jobKafkaClientCertSecret and jobKafkaCaCertSecret are the names of K8s secrets\n58\t// to mount into spawned Jobs for Kafka mTLS; empty strings mean no cert mounting.\n59\tfunc NewJobSpawner(\n60\t\tkubeClient kubernetes.Interface,\n61\t\tnamespace k8s.Namespace,\n62\t\tkafkaBrokers string,\n63\t\tbranch string,\n64\t\ttopicPrefix string,"}]},"parent_tool_use_id":"chatcmpl-tool-9be1dac94caaf56f","session_id":"3667b84f-c892-4ca5-8115-a830204bf3b3","uuid":"1415be5d-3fc1-4b73-91dc-66