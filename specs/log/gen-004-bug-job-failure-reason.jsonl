{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-a3bacce40b0e6090","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg_test\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\n10\t\tlib \"github.com/bborbe/agent\"\n11\t\t. \"github.com/onsi/ginkgo/v2\"\n12\t\t. \"github.com/onsi/gomega\"\n13\t\tbatchv1 \"k8s.io/api/batch/v1\"\n14\t\tcorev1 \"k8s.io/api/core/v1\"\n15\t\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"\n16\t\t\"k8s.io/client-go/kubernetes/fake\"\n17\t\n18\t\t\"github.com/bborbe/agent-task-executor/mocks\"\n19\t\t\"github.com/bborbe/agent-task-executor/pkg\"\n20\t)\n21\t\n22\tvar _ = Describe(\"JobWatcher\", func() {\n23\t\tvar (\n24\t\t\tctx            context.Context\n25\t\t\tfakePublisher  *mocks.FakeResultPublisher\n26\t\t\ttaskStore      *pkg.TaskStore\n27\t\t\tfakeKubeClient *fake.Clientset\n28\t\t\twatcher        pkg.JobWatcher\n29\t\t\ttestTask       lib.Task\n30\t\t\ttestTaskID     lib.TaskIdentifier\n31\t\t)\n32\t\n33\t\tBeforeEach(func() {\n34\t\t\tctx = context.Background()\n35\t\t\tfakePublisher = &mocks.FakeResultPublisher{}\n36\t\t\ttaskStore = pkg.NewTaskStore()\n37\t\t\tfakeKubeClient = fake.NewClientset()\n38\t\t\ttestTaskID = lib.TaskIdentifier(\"test-task-uuid-1234\")\n39\t\t\ttestTask = lib.Task{\n40\t\t\t\tTaskIdentifier: testTaskID,\n41\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n42\t\t\t\t\t\"status\":   \"in_progress\",\n43\t\t\t\t\t\"assignee\": \"claude\",\n44\t\t\t\t},\n45\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n46\t\t\t}\n47\t\t\twatcher = pkg.NewJobWatcher(fakeKubeClient, \"test-ns\", taskStore, fakePublisher)\n48\t\t})\n49\t\n50\t\tmakeJob := func(name string, taskID string, conditions ...batchv1.JobCondition) *batchv1.Job {\n51\t\t\tlabels := map[string]string{}\n52\t\t\tif taskID != \"\" {\n53\t\t\t\tlabels[\"agent.benjamin-borbe.de/task-id\"] = taskID\n54\t\t\t}\n55\t\t\tjob := &batchv1.Job{\n56\t\t\t\tObjectMeta: metav1.ObjectMeta{\n57\t\t\t\t\tName:      name,\n58\t\t\t\t\tNamespace: \"test-ns\",\n59\t\t\t\t\tLabels:    labels,\n60\t\t\t\t},\n61\t\t\t\tStatus: batchv1.JobStatus{\n62\t\t\t\t\tConditions: conditions,\n63\t\t\t\t},\n64\t\t\t}\n65\t\t\treturn job\n66\t\t}\n67\t\n68\t\tfailedCondition := func(msg string) batchv1.JobCondition {\n69\t\t\treturn batchv1.JobCondition{\n70\t\t\t\tType:    batchv1.JobFailed,\n71\t\t\t\tStatus:  corev1.ConditionTrue,\n72\t\t\t\tMessage: msg,\n73\t\t\t}\n74\t\t}\n75\t\n76\t\tsucceededCondition := func() batchv1.JobCondition {\n77\t\t\treturn batchv1.JobCondition{\n78\t\t\t\tType:   batchv1.JobComplete,\n79\t\t\t\tStatus: corev1.ConditionTrue,\n80\t\t\t}\n81\t\t}\n82\t\n83\t\tDescribe(\"HandleJob\", func() {\n84\t\t\tIt(\"publishes synthetic failure and deletes job on Failed state\", func() {\n85\t\t\t\tjob := makeJob(\"job-1\", string(testTaskID), failedCondition(\"OOMKilled\"))\n86\t\t\t\t_, err := fakeKubeClient.BatchV1().\n87\t\t\t\t\tJobs(\"test-ns\").\n88\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n89\t\t\t\tExpect(err).To(BeNil())\n90\t\t\t\ttaskStore.Store(testTaskID, testTask)\n91\t\n92\t\t\t\twatcher.HandleJob(ctx, job)\n93\t\n94\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n95\t\t\t\t_, calledTask, calledJobName, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n96\t\t\t\tExpect(string(calledTask.TaskIdentifier)).To(Equal(string(testTaskID)))\n97\t\t\t\tExpect(calledJobName).To(Equal(\"job-1\"))\n98\t\t\t\tExpect(calledReason).To(Equal(\"pod_crash_no_stdout\"))\n99\t\n100\t\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-1\", metav1.GetOptions{})\n101\t\t\t\tExpect(err).To(BeNil())\n102\t\t\t})\n103\t\n104\t\t\tIt(\"does NOT publish synthetic failure for Succeeded job (trusts agent publish)\", func() {\n105\t\t\t\tjob := makeJob(\"job-2\", string(testTaskID), succeededCondition())\n106\t\t\t\t_, err := fakeKubeClient.BatchV1().\n107\t\t\t\t\tJobs(\"test-ns\").\n108\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n109\t\t\t\tExpect(err).To(BeNil())\n110\t\t\t\ttaskStore.Store(testTaskID, testTask)\n111\t\n112\t\t\t\twatcher.HandleJob(ctx, job)\n113\t\n114\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n115\t\t\t\t// task cleaned up from store\n116\t\t\t\t_, ok := taskStore.Load(testTaskID)\n117\t\t\t\tExpect(ok).To(BeFalse())\n118\t\n119\t\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-2\", metav1.GetOptions{})\n120\t\t\t\tExpect(err).To(BeNil())\n121\t\t\t})\n122\t\n123\t\t\tIt(\"skips synthetic failure for Succeeded job when task is not in store\", func() {\n124\t\t\t\tjob := makeJob(\"job-3\", string(testTaskID), succeededCondition())\n125\t\t\t\t_, err := fakeKubeClient.BatchV1().\n126\t\t\t\t\tJobs(\"test-ns\").\n127\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n128\t\t\t\tExpect(err).To(BeNil())\n129\t\t\t\t// intentionally NOT storing task in taskStore\n130\t\n131\t\t\t\twatcher.HandleJob(ctx, job)\n132\t\n133\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n134\t\n135\t\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-3\", metav1.GetOptions{})\n136\t\t\t\tExpect(err).To(BeNil())\n137\t\t\t})\n138\t\n139\t\t\tIt(\"ignores jobs without task-id label\", func() {\n140\t\t\t\tjob := makeJob(\"job-4\", \"\", failedCondition(\"crash\"))\n141\t\t\t\t_, err := fakeKubeClient.BatchV1().\n142\t\t\t\t\tJobs(\"test-ns\").\n143\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n144\t\t\t\tExpect(err).To(BeNil())\n145\t\n146\t\t\t\twatcher.HandleJob(ctx, job)\n147\t\n148\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n149\t\t\t\t// job should NOT be deleted\n150\t\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-4\", metav1.GetOptions{})\n151\t\t\t\tExpect(err).To(BeNil())\n152\t\t\t})\n153\t\n154\t