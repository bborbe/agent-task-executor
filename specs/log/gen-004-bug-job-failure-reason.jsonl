{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-9833fd5a5c5da2fc","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"sync/atomic\"\n10\t\t\"time\"\n11\t\n12\t\tlib \"github.com/bborbe/agent\"\n13\t\t\"github.com/bborbe/errors\"\n14\t\tlibk8s \"github.com/bborbe/k8s\"\n15\t\t\"github.com/golang/glog\"\n16\t\tbatchv1 \"k8s.io/api/batch/v1\"\n17\t\tcorev1 \"k8s.io/api/core/v1\"\n18\t\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"\n19\t\tk8sinformers \"k8s.io/client-go/informers\"\n20\t\t\"k8s.io/client-go/kubernetes\"\n21\t\tcorev1listers \"k8s.io/client-go/listers/core/v1\"\n22\t\t\"k8s.io/client-go/tools/cache\"\n23\t)\n24\t\n25\t//counterfeiter:generate -o ../mocks/job_watcher.go --fake-name FakeJobWatcher . JobWatcher\n26\t\n27\t// JobWatcher watches batch/v1 Jobs and their Pods in the executor's namespace and\n28\t// publishes synthetic failure results for terminal-state objects that belong to\n29\t// spawned tasks.\n30\ttype JobWatcher interface {\n31\t\t// Run starts the Job and Pod informers and blocks until ctx is cancelled.\n32\t\tRun(ctx context.Context) error\n33\t\t// HandleJob processes a single Job (invoked by the informer event handlers\n34\t\t// and by unit tests directly, avoiding the need for a fake informer).\n35\t\tHandleJob(ctx context.Context, job *batchv1.Job)\n36\t\t// HandlePod processes a single Pod (invoked by the Pod informer event handler\n37\t\t// and by unit tests directly).\n38\t\tHandlePod(ctx context.Context, pod *corev1.Pod)\n39\t\t// PodLister returns the Pod lister backed by the shared informer cache, for\n40\t\t// use by the deadline sweeper. The returned lister is safe for concurrent\n41\t\t// read access.\n42\t\tPodLister() corev1listers.PodLister\n43\t}\n44\t\n45\t// NewJobWatcher creates a JobWatcher.\n46\tfunc NewJobWatcher(\n47\t\tkubeClient kubernetes.Interface,\n48\t\tnamespace libk8s.Namespace,\n49\t\ttaskStore *TaskStore,\n50\t\tpublisher ResultPublisher,\n51\t) JobWatcher {\n52\t\treturn &jobWatcher{\n53\t\t\tkubeClient: kubeClient,\n54\t\t\tnamespace:  namespace,\n55\t\t\ttaskStore:  taskStore,\n56\t\t\tpublisher:  publisher,\n57\t\t}\n58\t}\n59\t\n60\ttype jobWatcher struct {\n61\t\tkubeClient kubernetes.Interface\n62\t\tnamespace  libk8s.Namespace\n63\t\ttaskStore  *TaskStore\n64\t\tpublisher  ResultPublisher\n65\t\tpodLister  atomic.Pointer[corev1listers.PodLister]\n66\t}\n67\t\n68\tfunc (w *jobWatcher) Run(ctx context.Context) error {\n69\t\tfactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n70\t\t\tw.kubeClient,\n71\t\t\t5*time.Minute,\n72\t\t\tk8sinformers.WithNamespace(string(w.namespace)),\n73\t\t\tk8sinformers.WithTweakListOptions(func(opts *metav1.ListOptions) {\n74\t\t\t\topts.LabelSelector = \"agent.benjamin-borbe.de/task-id\"\n75\t\t\t}),\n76\t\t)\n77\t\tinformer := factory.Batch().V1().Jobs().Informer()\n78\t\n79\t\t_, err := informer.AddEventHandler(cache.ResourceEventHandlerFuncs{\n80\t\t\tAddFunc: func(obj interface{}) {\n81\t\t\t\tjob, ok := obj.(*batchv1.Job)\n82\t\t\t\tif !ok {\n83\t\t\t\t\treturn\n84\t\t\t\t}\n85\t\t\t\tw.HandleJob(ctx, job)\n86\t\t\t},\n87\t\t\tUpdateFunc: func(_, newObj interface{}) {\n88\t\t\t\tjob, ok := newObj.(*batchv1.Job)\n89\t\t\t\tif !ok {\n90\t\t\t\t\treturn\n91\t\t\t\t}\n92\t\t\t\tw.HandleJob(ctx, job)\n93\t\t\t},\n94\t\t})\n95\t\tif err != nil {\n96\t\t\treturn errors.Wrapf(ctx, err, \"add job informer event handler\")\n97\t\t}\n98\t\n99\t\tpodInformer := factory.Core().V1().Pods().Informer()\n100\t\t_, err = podInformer.AddEventHandler(cache.ResourceEventHandlerFuncs{\n101\t\t\tAddFunc: func(obj interface{}) {\n102\t\t\t\tpod, ok := obj.(*corev1.Pod)\n103\t\t\t\tif !ok {\n104\t\t\t\t\treturn\n105\t\t\t\t}\n106\t\t\t\tw.HandlePod(ctx, pod)\n107\t\t\t},\n108\t\t\tUpdateFunc: func(_, newObj interface{}) {\n109\t\t\t\tpod, ok := newObj.(*corev1.Pod)\n110\t\t\t\tif !ok {\n111\t\t\t\t\treturn\n112\t\t\t\t}\n113\t\t\t\tw.HandlePod(ctx, pod)\n114\t\t\t},\n115\t\t})\n116\t\tif err != nil {\n117\t\t\treturn errors.Wrapf(ctx, err, \"add pod informer event handler\")\n118\t\t}\n119\t\n120\t\tfactory.Start(ctx.Done())\n121\t\tif !cache.WaitForCacheSync(ctx.Done(), informer.HasSynced, podInformer.HasSynced) {\n122\t\t\treturn errors.Errorf(ctx, \"timed out waiting for job/pod informer cache sync\")\n123\t\t}\n124\t\tlister := factory.Core().V1().Pods().Lister()\n125\t\tw.podLister.Store(&lister)\n126\t\tglog.V(2).Infof(\"job and pod informer started in namespace %s\", w.namespace)\n127\t\t<-ctx.Done()\n128\t\treturn nil\n129\t}\n130\t\n131\tfunc (w *jobWatcher) PodLister() corev1listers.PodLister {\n132\t\tlister := w.podLister.Load()\n133\t\tif lister == nil {\n134\t\t\treturn nil\n135\t\t}\n136\t\treturn *lister\n137\t}\n138\t\n139\tfunc (w *jobWatcher) HandleJob(ctx context.Context, job *batchv1.Job) {\n140\t\ttaskIDStr, ok := job.Labels[\"agent.benjamin-borbe.de/task-id\"]\n141\t\tif !ok || taskIDStr == \"\" {\n142\t\t\treturn\n143\t\t}\n144\t\ttaskID := lib.TaskIdentifier(taskIDStr)\n145\t\n146\t\tif IsJobFailed(job) {\n147\t\t\treason := JobFailureReason(job)\n148\t\t\tglog.V(2).Infof(\"job %s/%s failed (task %s): %s\", job.Namespace, job.Name, taskID, reason)\n149\t\t\tw.handleTerminal(ctx, taskID, job, reason, true)\n150\t\t\treturn\n151\t\t}\n152\t\tif IsJobSucceeded(job) {\n153\t\t\t// Succeeded job (exit 0) means the agent's main.Run returned nil, which\n154\t\t\t// implies its result was published to Kafka successfully. Do NOT publish\n155\t\t\t// a synthetic failure — doing so races the real result and triggers an\n156\t\t\t// infinite respawn loop via the vault poll on the controller side.\n157\t\t\tglog.V(2).\n158\t\t\t\tInfof(\"job %s/%s succeeded (task %s): trusting agent publish, no synthetic result\",\n159\t\t\t\t\tjob.Namespace, job.Name, taskID)\n160\t\t\tw.taskStore.Delete(taskID)\n161\t\t}\n162\t}\n163\t\n164\t// handleTerminal publishes a synthetic failure when appropriate. Job cleanup is\n165\t// handled by K8s via TTLSecondsAfterFinished (set on the spawned Job), so the\n166\t// pod/log stays available until TTL expires for debugging.\n167\t// alwaysPublish is true for Failed jobs; for Succeeded jobs it only publishes if\n168\t// the task is still in the TaskStore (agent has not yet published a result).\n169\tfunc (w *jobWatcher) handleTerminal(\n170\t\tctx context.Context,\n171\t\ttaskID lib.TaskIdentifier,\n172\t\tjob *batchv1.Job,\n173\t\treason ZombieReason,\n174\t\talwaysPublish bool,\n175\t) {\n176\t\ttask, ok := w.taskStore.Load(taskID)\n177\t\tif ok {\n178\t\t\tw.publishSyntheticFailure(ctx, taskID, task, job, reason)\n179\t\t\treturn\n180\t\t}\n181\t\tw.logMissingTask(taskID, job, alwaysPublish)\n182\t}\n183\t\n184\tfunc (w *jobWatcher) publishSyntheticFailure(\n185\t\tctx context.Context,\n186\t\ttaskID lib.TaskIdentifier,\n187\t\ttask lib.Task,\n188\t\tjob *batchv1.Job,\n189\t\treason ZombieReason,\n190\t) {\n191\t\tif err := w.publisher.PublishFailure(ctx, task, job.Name, reason.String()); err != nil {\n192\t\t\tglog.Errorf(\"publish synthetic failure for task %s (job %s): %v\", taskID, job.Name, err)\n193\t\t} else {\n194\t\t\tglog.V(2).Infof(\"published synthetic failure for task %s (job %s)\", taskID, job.Name)\n195\t\t}\n196\t\tw.taskStore.Delete(taskID)\n197\t}\n198\t\n199\tfunc (w *jobWatcher) logMissingTask(\n200\t\ttaskID lib.TaskIdentifier,\n201\t\tjob *batchv1.Job,\n202\t\talwaysPublish bool,\n203\t) {\n204\t\tif alwaysPublish {\n205\t\t\t// V(3), not Warning: the Job informer re-delivers an already-handled terminal\n206\t\t\t// Job every ~5 minutes, so a failed Job whose task was already deleted from the\n207\t\t\t// store re-enters this branch repeatedly and the old Warning read as a failure.\n208\t\t\t// The synthetic failure was already published on the first (real) observation.\n209\t\t\tglog.V(3).Infof(\n210\t\t\t\t\"task %s not in task store; job %s/%s failed but cannot publish synthetic failure (no original task content)\",\n211\t\t\t\ttaskID,\n212\t\t\t\tjob.Namespace,\n213\t\t\t\tjob.Name,\n214\t\t\t)\n215\t\t\treturn\n216\t\t}\n217\t\tglog.V(3).Infof(\n218\t\t\t\"task %s not in task store; job %s/%s succeeded — agent likely published result already\",\n219\t\t\ttaskID, job.Namespace, job.Name,\n220\t\t)\n221\t}\n222\t\n223\t// IsJobFailed reports whether the Job carries a true JobFailed condition.\n224\t//\n225\t// Conditions, not the pod counters, are the source of truth: an\n226\t// activeDeadlineSeconds kill sets this condition while leaving\n227\t// .status.failed and .status.active at zero. Any caller deciding whether a\n228\t// Job is still running must use this (see spawner.IsJobActive) — reading the\n229\t// counters alone reports a deadline-killed Job as active forever.\n230\tfunc IsJobFailed(job *batchv1.Job) bool {\n231\t\tfor _, c := range job.Status.Conditions {\n232\t\t\tif c.Type == batchv1.JobFailed && c.Status == corev1.ConditionTrue {\n233\t\t\t\treturn true\n234\t\t\t}\n235\t\t}\n236\t\treturn false\n237\t}\n238\t\n239\t// IsJobSucceeded reports whether the Job carries a true JobComplete condition.\n240\tfunc IsJobSucceeded(job *batchv1.Job) bool {\n241\t\tfor _, c := range job.Status.Conditions {\n242\t\t\tif c.Type == batchv1.JobComplete && c.Status == corev1.ConditionTrue {\n243\t\t\t\treturn true\n244\t\t\t}\n245\t\t}\n246\t\treturn false\n247\t}\n248\t\n249\t// JobFailureReason maps a failed Job's conditions to a ZombieReason. Returns\n250\t// ZombieReasonDeadlineExceeded when any Failed condition has Reason\n251\t// \"DeadlineExceeded\" or \"BackoffLimitExceeded\" (kubelet killed the pod for\n252\t// running past activeDeadlineSeconds or exhausting BackoffLimit). Returns\n253\t// ZombieReasonPodCrashNoStdout for any other Failed condition (the pod\n254\t// terminated non-zero and no AgentResult was observed; the Job-condition\n255\t// informer only fires AFTER terminal state, so absence of an AgentResult is\n256\t// implicit at this point).\n257\tfunc JobFailureReason(job *batchv1.Job) ZombieReason {\n258\t\tfor _, c := range job.Status.Conditions {\n259\t\t\tif c.Type == batchv1.JobFailed && c.Status == corev1.ConditionTrue {\n260\t\t\t\tswitch c.Reason {\n261\t\t\t\tcase \"DeadlineExceeded\", \"BackoffLimitExceeded\":\n262\t\t\t\t\treturn ZombieReasonDeadlineExceeded\n263\t\t\t\t}\n264\t\t\t}\n265\t\t}\n266\t\treturn ZombieReasonPodCrashNoStdout\n267\t}\n268\t\n269\t// HandlePod processes a Pod that has transitioned to a terminal failure state.\n270\t// It publishes a single zombie failure event and returns without deleting the\n271\t// task from the TaskStore — the Job-condition path or the deadline sweeper\n272\t// performs the final delete when terminal state is observed.\n273\tfunc (w *jobWatcher) HandlePod(ctx context.Context, pod *corev1.Pod) {\n274\t\ttaskIDStr, ok := pod.Labels[\"agent.benjamin-borbe.de/task-id\"]\n275\t\tif !ok || taskIDStr == \"\" {\n276\t\t\treturn\n277\t\t}\n278\t\ttaskID := lib.TaskIdentifier(taskIDStr)\n279\t\n280\t\treason := classifyPodFailure(pod)\n281\t\tif reason == \"\" {\n282\t\t\treturn\n283\t\t}\n284\t\n285\t\ttask, ok := w.taskStore.Load(taskID)\n286\t\tif !ok {\n287\t\t\tglog.V(3).Infof(\n288\t\t\t\t\"pod %s/%s (task %s) in %s state but task not in store; sweeper will handle if still in flight\",\n289\t\t\t\tpod.Namespace, pod.Name, taskID, reason,\n290\t\t\t)\n291\t\t\treturn\n292\t\t}\n293\t\n294\t\tjobName := ownerJobName(pod)\n295\t\tif jobName == \"\" {\n296\t\t\tglog.V(2).Infof(\n297\t\t\t\t\"pod %s/%s (task %s) in %s state but has no Job ownerRef; ignoring\",\n298\t\t\t\tpod.Namespace, pod.Name, taskID, reason,\n299\t\t\t)\n300\t\t\treturn\n301\t\t}\n302\t\n303\t\tif err := w.publisher.PublishFailure(ctx, task, jobName, reason.String()); err != nil {\n304\t\t\tglog.Errorf(\n305\t\t\t\t\"publish pod-state failure for task %s (pod %s reason %s): %v\",\n306\t\t\t\ttaskID, pod.Name, reason, err,\n307\t\t\t)\n308\t\t\treturn\n309\t\t}\n310\t\tglog.V(2).Infof(\n311\t\t\t\"published pod-state failure for task %s (pod %s reason %s)\",\n312\t\t\ttaskID, pod.Name, reason,\n313\t\t)\n314\t\t// Do NOT call w.taskStore.Delete here. The pod may transition again (e.g. evicted then\n315\t\t// rescheduled). The Job-condition path or the deadline sweeper performs the final delete\n316\t\t// when terminal state is observed. Dedupe in PublishFailure (prompt 1) prevents\n317\t\t// double-publish for the same job name.\n318\t}\n319\t\n320\t// classifyPodFailure returns a non-empty ZombieReason when the Pod is in a\n321\t// terminal failure state we recognize. Returns \"\" for healthy, pending-without-\n322\t// excessive-delay, and any state we should not act on from the informer path.\n323\t// pod_not_scheduled is deliberately NOT returned here — it requires a grace\n324\t// window the informer cannot evaluate (a freshly created Pod is always briefly\n325\t// Pending before scheduling). The deadline sweeper (separate prompt) owns that\n326\t// classification.\n327\tfunc classifyPodFailure(pod *corev1.Pod) ZombieReason {\n328\t\tfor _, cs := range pod.Status.ContainerStatuses {\n329\t\t\tif cs.State.Waiting != nil {\n330\t\t\t\tswitch cs.State.Waiting.Reason {\n331\t\t\t\tcase \"ImagePullBackOff\", \"ErrImagePull\":\n332\t\t\t\t\treturn ZombieReasonImagePullBackOff\n333\t\t\t\tcase \"CrashLoopBackOff\":\n334\t\t\t\t\t// With BackoffLimit=0 in the spawner, crash-looping pods never\n335\t\t\t\t\t// reach PodFailed phase, so this branch is the only signal that\n336\t\t\t\t\t// classifies them before activeDeadlineSeconds fires.\n337\t\t\t\t\treturn ZombieReasonPodCrashNoStdout\n338\t\t\t\t}\n339\t\t\t}\n340\t\t}\n341\t\tif pod.Status.Reason == \"Evicted\" {\n342\t\t\treturn ZombieReasonPodEvicted\n343\t\t}\n344\t\tif pod.Status.Phase == corev1.PodFailed {\n345\t\t\tfor _, cs := range pod.Status.ContainerStatuses {\n346\t\t\t\tif cs.State.Terminated != nil && cs.State.Terminated.ExitCode != 0 {\n347\t\t\t\t\treturn ZombieReasonPodCrashNoStdout\n348\t\t\t\t}\n349\t\t\t}\n350\t\t}\n351\t\treturn \"\"\n352\t}\n353\t\n354\t// ownerJobName returns the name of the Job that owns the Pod, or \"\" when no\n355\t// Job ownerRef is present.\n356\tfunc ownerJobName(pod *corev1.Pod) string {\n357\t\tfor _, ref := range pod.OwnerReferences {\n358\t\t\tif ref.Kind == \"Job\" {\n359\t\t\t\treturn ref.Name\n360\t\t\t}\n361\t\t}\n362\t\treturn \"\"\n363\t}\n364\t"}]},"parent_tool_use_id":"chatcmpl-tool-b92acd40ad8afc6e","session_id":"199c5f76-0f8a-49af-b453-ab3c6857f2c9","uuid":"3b69340a-c5b0-464c-86bb-4625c92bb9b2","timestamp":"2026-08-31T21:49:28.871Z","subagent_type":"dark-factory:prompt-creator","task_description":"Create prompts for spec 004"}
