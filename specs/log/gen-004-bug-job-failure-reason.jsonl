eeded\",\n245\t\t\t\t\tMessage: \"Job failed due to backoff limit\",\n246\t\t\t\t})\n247\t\t\t\t_, err := fakeKubeClient.BatchV1().\n248\t\t\t\t\tJobs(\"test-ns\").\n249\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n250\t\t\t\tExpect(err).To(BeNil())\n251\t\t\t\ttaskStore.Store(testTaskID, testTask)\n252\t\n253\t\t\t\twatcher.HandleJob(ctx, job)\n254\t\n255\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n256\t\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n257\t\t\t\tExpect(calledReason).To(Equal(\"deadline_exceeded\"))\n258\t\t\t})\n259\t\t})\n260\t\n261\t\tDescribe(\"jobFailureReason mapping\", func() {\n262\t\t\tIt(\"returns deadline_exceeded for DeadlineExceeded\", func() {\n263\t\t\t\tjob := makeJob(\"j\", string(testTaskID), batchv1.JobCondition{\n264\t\t\t\t\tType:   batchv1.JobFailed,\n265\t\t\t\t\tStatus: corev1.ConditionTrue,\n266\t\t\t\t\tReason: \"DeadlineExceeded\",\n267\t\t\t\t})\n268\t\t\t\tExpect(pkg.JobFailureReason(job)).To(Equal(pkg.ZombieReasonDeadlineExceeded))\n269\t\t\t})\n270\t\n271\t\t\tIt(\"returns deadline_exceeded for BackoffLimitExceeded\", func() {\n272\t\t\t\tjob := makeJob(\"j\", string(testTaskID), batchv1.JobCondition{\n273\t\t\t\t\tType:   batchv1.JobFailed,\n274\t\t\t\t\tStatus: corev1.ConditionTrue,\n275\t\t\t\t\tReason: \"BackoffLimitExceeded\",\n276\t\t\t\t})\n277\t\t\t\tExpect(pkg.JobFailureReason(job)).To(Equal(pkg.ZombieReasonDeadlineExceeded))\n278\t\t\t})\n279\t\n280\t\t\tIt(\"returns pod_crash_no_stdout for other Failed condition reasons\", func() {\n281\t\t\t\tjob := makeJob(\"j\", string(testTaskID), batchv1.JobCondition{\n282\t\t\t\t\tType:   batchv1.JobFailed,\n283\t\t\t\t\tStatus: corev1.ConditionTrue,\n284\t\t\t\t\tReason: \"\",\n285\t\t\t\t})\n286\t\t\t\tExpect(pkg.JobFailureReason(job)).To(Equal(pkg.ZombieReasonPodCrashNoStdout))\n287\t\t\t})\n288\t\t})\n289\t\n290\t\tDescribe(\"HandlePod\", func() {\n291\t\t\tmakePod := func(name string, taskID string, phase corev1.PodPhase, containerStatuses []corev1.ContainerStatus, ownerRefs []metav1.OwnerReference, podStatusReason string) *corev1.Pod {\n292\t\t\t\tlabels := map[string]string{}\n293\t\t\t\tif taskID != \"\" {\n294\t\t\t\t\tlabels[\"agent.benjamin-borbe.de/task-id\"] = taskID\n295\t\t\t\t}\n296\t\t\t\tpod := &corev1.Pod{\n297\t\t\t\t\tObjectMeta: metav1.ObjectMeta{\n298\t\t\t\t\t\tName:            name,\n299\t\t\t\t\t\tNamespace:       \"test-ns\",\n300\t\t\t\t\t\tLabels:          labels,\n301\t\t\t\t\t\tOwnerReferences: ownerRefs,\n302\t\t\t\t\t},\n303\t\t\t\t\tStatus: corev1.PodStatus{\n304\t\t\t\t\t\tPhase: phase,\n305\t\t\t\t\t},\n306\t\t\t\t}\n307\t\t\t\tif len(containerStatuses) > 0 {\n308\t\t\t\t\tpod.Status.ContainerStatuses = containerStatuses\n309\t\t\t\t}\n310\t\t\t\tif podStatusReason != \"\" {\n311\t\t\t\t\tpod.Status.Reason = podStatusReason\n312\t\t\t\t}\n313\t\t\t\treturn pod\n314\t\t\t}\n315\t\n316\t\t\tmakeJobOwnerRef := func(name string) []metav1.OwnerReference {\n317\t\t\t\treturn []metav1.OwnerReference{\n318\t\t\t\t\t{\n319\t\t\t\t\t\tKind: \"Job\",\n320\t\t\t\t\t\tName: name,\n321\t\t\t\t\t},\n322\t\t\t\t}\n323\t\t\t}\n324\t\n325\t\t\tIt(\"publishes failure for ImagePullBackOff container\", func() {\n326\t\t\t\tpod := makePod(\n327\t\t\t\t\t\"pod-imgpull\",\n328\t\t\t\t\tstring(testTaskID),\n329\t\t\t\t\tcorev1.PodPending,\n330\t\t\t\t\t[]corev1.ContainerStatus{\n331\t\t\t\t\t\t{\n332\t\t\t\t\t\t\tState: corev1.ContainerState{\n333\t\t\t\t\t\t\t\tWaiting: &corev1.ContainerStateWaiting{\n334\t\t\t\t\t\t\t\t\tReason: \"ImagePullBackOff\",\n335\t\t\t\t\t\t\t\t},\n336\t\t\t\t\t\t\t},\n337\t\t\t\t\t\t},\n338\t\t\t\t\t},\n339\t\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n340\t\t\t\t\t\"\",\n341\t\t\t\t)\n342\t\t\t\ttaskStore.Store(testTaskID, testTask)\n343\t\n344\t\t\t\twatcher.HandlePod(ctx, pod)\n345\t\n346\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n347\t\t\t\t_, _, calledJobName, calledReason := fakePublisher.PublishFailureArgsFor