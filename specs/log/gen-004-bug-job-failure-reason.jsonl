{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-81e1a5d6108a7cb7","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\t// ZombieReason is the closed set of machine-readable reason strings emitted in\n8\t// the ## Failure body section. Operators grep on these values to triage.\n9\t// Adding a new value requires updating this list and the documentation; renaming\n10\t// or removing a value is a breaking change to the on-disk task body contract.\n11\ttype ZombieReason string\n12\t\n13\tconst (\n14\t\tZombieReasonImagePullBackOff  ZombieReason = \"image_pull_backoff\"\n15\t\tZombieReasonPodEvicted        ZombieReason = \"pod_evicted\"\n16\t\tZombieReasonDeadlineExceeded  ZombieReason = \"deadline_exceeded\"\n17\t\tZombieReasonPodNotScheduled   ZombieReason = \"pod_not_scheduled\"\n18\t\tZombieReasonPodCrashNoStdout  ZombieReason = \"pod_crash_no_stdout\"\n19\t\tZombieReasonExecutorWatchLost ZombieReason = \"executor_watch_lost\"\n20\t\tZombieReasonTypeMismatch      ZombieReason = \"type_mismatch\"\n21\t)\n22\t\n23\t// String returns the reason as a string (for use with PublishFailure).\n24\tfunc (r ZombieReason) String() string { return string(r) }\n25\t"}]},"parent_tool_use_id":"chatcmpl-tool-aff04ee2eebc50d8","session_id":"199c5f76-0f8a-49af-b453-ab3c6857f2c9","uuid":"70781481-ea86-496d-b022-ef52ea7f3926","timestamp":"2026-08-31T21:52:53.686Z","subagent_type":"dark-factory:prompt-auditor","task_description":"Audit prompt spec-004"}
