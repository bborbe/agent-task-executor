           string            `required:\"false\" arg:\"sentry-proxy\"                   env:\"SENTRY_PROXY\"                   usage:\"Sentry Proxy\"`\n45\t\tListen                     string            `required:\"true\"  arg:\"listen\"                         env:\"LISTEN\"                         usage:\"address to listen to\"`\n46\t\tKafkaBrokers               string            `required:\"true\"  arg:\"kafka-brokers\"                  env:\"KAFKA_BROKERS\"                  usage:\"comma-separated Kafka broker addresses\"`\n47\t\tBranch                     base.Branch       `required:\"true\"  arg:\"branch\"                         env:\"BRANCH\"                         usage:\"Kafka topic prefix branch (develop/live)\"`\n48\t\tTopicPrefix                base.TopicPrefix  `required:\"false\" arg:\"topic-prefix\"                   env:\"TOPIC_PREFIX\"                   usage:\"Explicit Kafka topic prefix; empty means unprefixed topics\"`\n49\t\tNamespace                  libk8s.Namespace  `required:\"true\"  arg:\"namespace\"                      env:\"NAMESPACE\"                      usage:\"K8s namespace to spawn Jobs in\"`\n50\t\tVaultName                  string            `required:\"true\"  arg:\"vault-name\"                     env:\"VAULT_NAME\"                     usage:\"Obsidian vault name this executor instance serves; Config CRs are resolved by the composed {assignee}-{vaultName} assignee\"`\n51\t\tBuildGitVersion            string            `required:\"false\" arg:\"build-git-version\"              env:\"BUILD_GIT_VERSION\"              usage:\"Build Git version (git describe --tags --always --dirty)\"                                                                                                                                                                                                                           default:\"dev\"`\n52\t\tBuildGitCommit             string            `required:\"false\" arg:\"build-git-commit\"               env:\"BUILD_GIT_COMMIT\"               usage:\"Build Git commit hash\"                                                                                                                                                                                                                                                              default:\"none\"`\n53\t\tBuildDate                  *libtime.DateTime `required:\"false\" arg:\"build-date\"                     env:\"BUILD_DATE\"                     usage:\"Build timestamp (RFC3339)\"`\n54\t\tHealthcheckCronExpression  string            `required:\"true\"  arg:\"healthcheck-cron-expression\"    env:\"HEALTHCHECK_CRON_EXPRESSION\"    usage:\"Cron expression for agent liveness health checks\"                                                                                                                                                                                                                                   default:\"0 0 8 * * 1\"`\n55\t\tJobTTLSecondsAfterFinished int32             `required:\"false\" arg:\"job-ttl-seconds-after-finished\" env:\"JOB_TTL_SECONDS_AFTER_FINISHED\" usage:\"K8s Job TTL after completion (seconds) — completed Job pods are GCed after this delay\"                                                                                                                                                                                              default:\"1800\"`\n56\t\t// JobKafkaClientCertSecret holds the NAME of the K8s Secret carrying the\n57\t\t// Kafka client cert/key — not the cert material itself. The value is a\n58\t\t// resource reference (already public in the Deployment manifest), so no\n59\t\t// display:\"length\" guard is needed.\n60\t\tJobKafkaClientCertSecret string `required:\"false\" arg:\"job-kafka-client-cert-secret\"   env:\"JOB_KAFKA_CLIENT_CERT_SECRET\"   usage:\"Name of the existing K8s secret holding the Kafka client cert/key (keys user.crt/user.key) to mount into spawned Jobs; empty disables