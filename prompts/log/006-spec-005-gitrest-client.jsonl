bActive returns true if an active (not completed/failed) K8s Job exists\n44\t\t// for the given task identifier. Uses the agent.benjamin-borbe.de/task-id\n45\t\t// label set by SpawnJob.\n46\t\tIsJobActive(ctx context.Context, taskIdentifier lib.TaskIdentifier) (bool, error)\n47\t\t// CountActiveJobs returns the number of non-terminal K8s Jobs currently\n48\t\t// running for the given assignee. Uses the agent.benjamin-borbe.de/assignee\n49\t\t// label set by SpawnJob. Jobs spawned before that label existed are not\n50\t\t// counted, so the cap under-counts during the rollout and never over-counts.\n51\t\tCountActiveJobs(ctx context.Context, assignee string) (int, error)\n52\t}\n53\t\n54\t// NewJobSpawner creates a new JobSpawner backed by the K8s batch/v1 API.\n55\t// jobTTLSecondsAfterFinished controls how long completed Job pods survive\n56\t// before Kubernetes' TTL controller garbage-collects them.\n57\t// jobKafkaClientCertSecret and jobKafkaCaCertSecret are the names of K8s secrets\n58\t// to mount into spawned Jobs for Kafka mTLS; empty strings mean no cert mounting.\n59\tfunc NewJobSpawner(\n60\t\tkubeClient kubernetes.Interface,"}]},"parent_tool_use_id":null,"session_id":"ab2e800e-9400-4e49-90cb-78b86646bc3f","uuid":"c96cb83a-8029-48df-83f7-d22a4f26d308","timestamp":"2026-09-03T18:19:45.181Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/spawner/job_spawner.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage spawner\n\nimport (\n\t\"context\"\n\n\tlib \"github.com/bborbe/agent\"\n\t\"github.com/bborbe/errors\"\n\tk8s \"github.com/bborbe/k8s\"\n\tlibtime \"github.com/bborbe/time\"\n\t\"github.com/golang/glog\"\n\t\"gopkg.in/yaml.v3\"\n\tbatchv1 \"k8s.io/api/batch/v1\"\n\tcorev1 \"k8s.io/api/core/v1\"\n\tk8serrors \"k8s.io/apimachinery/pkg/api/errors\"\n\t\"k8s.io/apimachinery/pkg/api/resource\"\n\tmet