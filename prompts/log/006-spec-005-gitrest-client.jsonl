{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-91ab723892bd65a9","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage gitrestclient\n6\t\n7\timport (\n8\t\t\"bytes\"\n9\t\t\"context\"\n10\t\t\"encoding/json\"\n11\t\tstderrors \"errors\"\n12\t\t\"io\"\n13\t\t\"net/http\"\n14\t\t\"net/url\"\n15\t\t\"strings\"\n16\t\t\"time\"\n17\t\n18\t\t\"github.com/bborbe/errors\"\n19\t\n20\t\t\"github.com/bborbe/agent-task-controller/pkg/metrics\"\n21\t)\n22\t\n23\t//counterfeiter:generate -o ../../mocks/git_rest_client.go --fake-name GitRestClient . GitRestClient\n24\t\n25\t// ErrAlreadyExists is returned by PostIfAbsent when the target path is already\n26\t// occupied (git-rest responds 409 Conflict for a create-only write). It is a\n27\t// benign conflict, not a transport failure — callers use errors.Is to treat it\n28\t// as \"already there\" instead of an error worth retrying.\n29\tvar ErrAlreadyExists = stderrors.New(\"file already exists\")\n30\t\n31\t// GitRestClient is the HTTP client for git-rest's /api/v1/files REST API.\n32\t// All paths are relative to the repo root (e.g. \"tasks/foo.md\").\n33\ttype GitRestClient interface {\n34\t\t// Get retrieves the current content of the file at relPath.\n35\t\tGet(ctx context.Context, relPath string) ([]byte, error)\n36\t\t// Post writes content to relPath; git-rest auto-commits and pushes.\n37\t\tPost(ctx context.Context, relPath string, content []byte) error\n38\t\t// PostIfAbsent writes content to relPath only when no file exists there yet;\n39\t\t// git-rest auto-commits and pushes. Returns ErrAlreadyExists (via errors.Is)\n40\t\t// when relPath is already occupied — nothing is written in that case.\n41\t\tPostIfAbsent(ctx context.Context, relPath string, content []byte) error\n42\t\t// Delete removes the file at relPath; git-rest auto-commits and pushes.\n43\t\tDelete(ctx context.Context, relPath string) error\n44\t\t// List returns relative paths matching the single-level glob pattern (e.g. \"tasks/*.md\").\n45\t\tList(ctx context.Context, glob string) ([]string, error)\n46\t\t// IsReady reports whether git-rest's /readiness returns 200.\n47\t\t// Returns (false, nil) when git-rest returns 503 — that is a valid not-ready state, not an error.\n48\t\t// Returns (false, err) only on network failure or unexpected response.\n49\t\tIsReady(ctx context.Context) (bool, error)\n50\t}\n51\t\n52\t// NewGitRestClient creates a GitRestClient targeting the git-rest instance at baseURL.\n53\t// gatewaySecret is the shared secret enforced by git-rest's gateway-secret auth (git-rest spec 004).\n54\t// When gatewaySecret is empty, no auth headers are sent (backward-compat with auth-disabled git-rest).\n55\t// gatewayInitiator is the caller identity logged by git-rest on auth failure;\n56\t// pass a stable, human-readable value (e.g. \"agent-task-controller\").\n57\tfunc NewGitRestClient(\n58\t\tbaseURL, gatewaySecret, gatewayInitiator string,\n59\t\tmetrics metrics.Metrics,\n60\t) GitRestClient {\n61\t\treturn newGitRestClientWithBackoff(\n62\t\t\tbaseURL,\n63\t\t\tgatewaySecret,\n64\t\t\tgatewayInitiator,\n65\t\t\texponentialBackoff,\n66\t\t\tmetrics,\n67\t\t)\n68\t}\n69\t\n70\tfunc newGitRestClientWithBackoff(\n71\t\tbaseURL, gatewaySecret, gatewayInitiator string,\n72\t\tbackoff func(attempt int) time.Duration,\n73\t\tmetrics metrics.Metrics,\n74\t) GitRestClient {\n75\t\treturn &gitRestClient{\n76\t\t\tbaseURL:          strings.TrimRight(baseURL, \"/\"),\n77\t\t\thttpClient:       &http.Client{Timeout: 30 * time.Second},\n78\t\t\tbackoff:          backoff,\n79\t\t\tgatewaySecret:    gatewaySecret,\n80\t\t\tgatewayInitiator: gatewayInitiator,\n81\t\t\tmetrics:          metrics,\n82\t\t}\n83\t}\n84\t\n85\tfunc exponentialBackoff(attempt int) time.Duration {\n86\t\treturn time.Duration(\n87\t\t\t1<<uint(attempt-1),\n88\t\t) * time.Second // #nosec G115 -- attempt is always >= 1 when called\n89\t}\n90\t\n91\ttype gitRestClient struct {\n92\t\tbaseURL          string\n93\t\thttpClient       *http.Client\n94\t\tbackoff          func(attempt int) time.Duration\n95\t\tgatewaySecret    string\n96\t\tgatewayInitiator string\n97\t\tmetrics          metrics.Metrics\n98\t}\n99\t\n100\t// setAuthHeaders sets the gateway-secret auth headers on req when the secret is configured.\n101\t// No-op when gatewaySecret is empty — keeps backward compatibility with auth-disabled git-rest.\n102\t//\n103\t// Header names are part of the git-rest public contract (spec 004) — do NOT alter:\n104\t//\n105\t//\tX-Gateway-Secret   — the shared secret\n106\t//\tX-Gateway-Initator — caller identity (deliberate misspelling, do NOT change to \"Initiator\")\n107\tfunc (g *gitRestClient) setAuthHeaders(req *http.Request) {\n108\t\tif g.gatewaySecret == \"\" {\n109\t\t\treturn\n110\t\t}\n111\t\treq.Header.Set(\"X-Gateway-Secret\", g.gatewaySecret)\n112\t\treq.Header.Set(\"X-Gateway-Initator\", g.gatewayInitiator)\n113\t}\n114\t\n115\t// fileURL builds /api/v1/files/<relPath> with proper percent-escaping so\n116\t// characters like %, space, # in relPath survive the round-trip to git-rest.\n117\tfunc (g *gitRestClient) fileURL(relPath string) string {\n118\t\tsegments := strings.Split(relPath, \"/\")\n119\t\tfor i, s := range segments {\n120\t\t\tsegments[i] = url.PathEscape(s)\n121\t\t}\n122\t\treturn g.baseURL + \"/api/v1/files/\" + strings.Join(segments, \"/\")\n123\t}\n124\t\n125\t// Get retrieves file content from git-rest. Does not retry — reads fail-fast.\n126\tfunc (g *gitRestClient) Get(ctx context.Context, relPath string) ([]byte, error) {\n127\t\treqURL := g.fileURL(relPath)\n128\t\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n129\t\tif err != nil {\n130\t\t\tg.metrics.GitRestCallsTotal(\"get\", \"error\").Inc()\n131\t\t\treturn nil, errors.Wrapf(ctx, err, \"create GET request for %s\", relPath)\n132\t\t}\n133\t\tg.setAuthHeaders(req)\n134\t\tresp, err := g.httpClient.Do(req)\n135\t\tif err != nil {\n136\t\t\tg.metrics.GitRestCallsTotal(\"get\", \"error\").Inc()\n137\t\t\treturn nil, errors.Wrapf(ctx, err, \"GET %s\", relPath)\n138\t\t}\n139\t\tdefer resp.Body.Close()\n140\t\tbody, err := io.ReadAll(io.LimitReader(resp.Body, 10*1024*1024)) // 10 MiB max\n141\t\tif err != nil {\n142\t\t\tg.metrics.GitRestCallsTotal(\"get\", \"error\").Inc()\n143\t\t\treturn nil, errors.Wrapf(ctx, err, \"read GET response body for %s\", relPath)\n144\t\t}\n145\t\tif resp.StatusCode != http.StatusOK {\n146\t\t\tg.metrics.GitRestCallsTotal(\"get\", \"error\").Inc()\n147\t\t\tpreview := string(body)\n148\t\t\tif len(preview) > 100 {\n149\t\t\t\tpreview = preview[:100]\n150\t\t\t}\n151\t\t\treturn nil, errors.Errorf(ctx, \"GET %s returned %d: %s\", relPath, resp.StatusCode, preview)\n152\t\t}\n153\t\tg.metrics.GitRestCallsTotal(\"get\", \"success\").Inc()\n154\t\treturn body, nil\n155\t}\n156\t\n157\t// Post writes content to relPath with retry on 5xx or network errors.\n158\tfunc (g *gitRestClient) Post(ctx context.Context, relPath string, content []byte) error {\n159\t\treturn g.post(ctx, relPath, content, false)\n160\t}\n161\t\n162\t// PostIfAbsent writes content to relPath only when no file exists there yet.\n163\t// git-rest answers 409 Conflict for an occupied path; that is mapped to\n164\t// ErrAlreadyExists (via errors.Is) and is not retried. All other failures share\n165\t// Post's retry behavior.\n166\tfunc (g *gitRestClient) PostIfAbsent(ctx context.Context, relPath string, content []byte) error {\n167\t\treturn g.post(ctx, relPath, content, true)\n168\t}\n169\t\n170\t// post writes content to relPath with retry on 5xx or network errors. When\n171\t// createOnly is true the request carries ?create_only=1 and a 409 Conflict\n172\t// response is returned as ErrAlreadyExists instead of being retried.\n173\tfunc (g *gitRestClient) post(\n174\t\tctx context.Context,\n175\t\trelPath string,\n176\t\tcontent []byte,\n177\t\tcreateOnly bool,\n178\t) error {\n179\t\treqURL := g.fileURL(relPath)\n180\t\tif createOnly {\n181\t\t\treqURL += \"?create_only=1\"\n182\t\t}\n183\t\tvar lastErr error\n184\t\tfor attempt := 0; attempt < 5; attempt++ {\n185\t\t\tselect {\n186\t\t\tcase <-ctx.Done():\n187\t\t\t\treturn errors.Wrapf(ctx, ctx.Err(), \"POST %s cancelled before attempt\", relPath)\n188\t\t\tdefault:\n189\t\t\t}\n190\t\t\tif attempt > 0 {\n191\t\t\t\tg.metrics.KafkaConsumePausedTotal().Inc()\n192\t\t\t\tbackoff := g.backoff(attempt)\n193\t\t\t\tselect {\n194\t\t\t\tcase <-ctx.Done():\n195\t\t\t\t\treturn errors.Wrapf(ctx, ctx.Err(), \"POST %s cancelled during backoff\", relPath)\n196\t\t\t\tcase <-time.After(backoff):\n197\t\t\t\t}\n198\t\t\t}\n199\t\t\treq, err := http.NewRequestWithContext(\n200\t\t\t\tctx,\n201\t\t\t\thttp.MethodPost,\n202\t\t\t\treqURL,\n203\t\t\t\tbytes.NewReader(content),\n204\t\t\t)\n205\t\t\tif err != nil {\n206\t\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"error\").Inc()\n207\t\t\t\tlastErr = errors.Wrapf(ctx, err, \"create POST request for %s\", relPath)\n208\t\t\t\tcontinue\n209\t\t\t}\n210\t\t\treq.Header.Set(\"Content-Type\", \"application/octet-stream\")\n211\t\t\tg.setAuthHeaders(req)\n212\t\t\tresp, err := g.httpClient.Do(req)\n213\t\t\tif err != nil {\n214\t\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"error\").Inc()\n215\t\t\t\tlastErr = errors.Wrapf(ctx, err, \"POST %s attempt %d\", relPath, attempt+1)\n216\t\t\t\tcontinue\n217\t\t\t}\n218\t\t\t_, _ = io.Copy(io.Discard, resp.Body)\n219\t\t\t_ = resp.Body.Close()\n220\t\t\tif resp.StatusCode >= 200 && resp.StatusCode < 300 {\n221\t\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"success\").Inc()\n222\t\t\t\treturn nil\n223\t\t\t}\n224\t\t\tif createOnly && resp.StatusCode == http.StatusConflict {\n225\t\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"error\").Inc()\n226\t\t\t\treturn errors.Wrapf(\n227\t\t\t\t\tctx,\n228\t\t\t\t\tErrAlreadyExists,\n229\t\t\t\t\t\"POST %s create-only: path already exists\",\n230\t\t\t\t\trelPath,\n231\t\t\t\t)\n232\t\t\t}\n233\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"error\").Inc()\n234\t\t\tlastErr = errors.Errorf(\n235\t\t\t\tctx,\n236\t\t\t\t\"POST %s attempt %d returned %d\",\n237\t\t\t\trelPath,\n238\t\t\t\tattempt+1,\n239\t\t\t\tresp.StatusCode,\n240\t\t\t)\n241\t\t}\n242\t\treturn errors.Wrapf(ctx, lastErr, \"POST %s failed after 5 attempts\", relPath)\n243\t}\n244\t\n245\t// Delete removes the file at relPath with retry on 5xx or network errors.\n246\tfunc (g *gitRestClient) Delete(ctx context.Context, relPath string) error {\n247\t\treqURL := g.fileURL(relPath)\n248\t\tvar lastErr error\n249\t\tfor attempt := 0; attempt < 5; attempt++ {\n250\t\t\tselect {\n251\t\t\tcase <-ctx.Done():\n252\t\t\t\treturn errors.Wrapf(ctx, ctx.Err(), \"DELETE %s cancelled before attempt\", relPath)\n253\t\t\tdefault:\n254\t\t\t}\n255\t\t\tif attempt > 0 {\n256\t\t\t\tg.metrics.KafkaConsumePausedTotal().Inc()\n257\t\t\t\tbackoff := g.backoff(attempt)\n258\t\t\t\tselect {\n259\t\t\t\tcase <-ctx.Done():\n260\t\t\t\t\treturn errors.Wrapf(ctx, ctx.Err(), \"DELETE %s cancelled during backoff\", relPath)\n261\t\t\t\tcase <-time.After(backoff):\n262\t\t\t\t}\n263\t\t\t}\n264\t\t\treq, err := http.NewRequestWithContext(ctx, http.MethodDelete, reqURL, nil)\n265\t\t\tif err != nil {\n266\t\t\t\tg.metrics.GitRestCallsTotal(\"delete\", \"error\").Inc()\n267\t\t\t\tlastErr = errors.Wrapf(ctx, err, \"create DELETE request for %s\", relPath)\n268\t\t\t\tcontinue\n269\t\t\t}\n270\t\t\tg.setAuthHeaders(req)\n271\t\t\tresp, err := g.httpClient.Do(req)\n272\t\t\tif err != nil {\n273\t\t\t\tg.metrics.GitRestCallsTotal(\"delete\", \"error\").Inc()\n274\t\t\t\tlastErr = errors.Wrapf(ctx, err, \"DELETE %s attempt %d\", relPath, attempt+1)\n275\t\t\t\tcontinue\n276\t\t\t}\n277\t\t\t_, _ = io.Copy(io.Discard, resp.Body)\n278\t\t\t_ = resp.Body.Close()\n279\t\t\tif resp.StatusCode >= 200 && resp.StatusCode < 300 {\n280\t\t\t\tg.metrics.GitRestCallsTotal(\"delete\", \"success\").Inc()\n281\t\t\t\treturn nil\n282\t\t\t}\n283\t\t\tg.metrics.GitRestCallsTotal(\"delete\", \"error\").Inc()\n284\t\t\tlastErr = errors.Errorf(\n285\t\t\t\tctx,\n286\t\t\t\t\"DELETE %s attempt %d returned %d\",\n287\t\t\t\trelPath,\n288\t\t\t\tattempt+1,\n289\t\t\t\tresp.StatusCode,\n290\t\t\t)\n291\t\t}\n292\t\treturn errors.Wrapf(ctx, lastErr, \"DELETE %s failed after 5 attempts\", relPath)\n293\t}\n294\t\n295\t// List returns paths matching the glob pattern. Does not retry — reads fail-fast.\n296\tfunc (g *gitRestClient) List(ctx context.Context, glob string) ([]string, error) {\n297\t\treqURL := g.baseURL + \"/api/v1/files/\"\n298\t\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n299\t\tif err != nil {\n300\t\t\tg.metrics.GitRestCallsTotal(\"list\", \"error\").Inc()\n301\t\t\treturn nil, errors.Wrapf(ctx, err, \"create LIST request for glob %s\", glob)\n302\t\t}\n303\t\tq := url.Values{}\n304\t\tq.Set(\"glob\", glob)\n305\t\treq.URL.RawQuery = q.Encode()\n306\t\tg.setAuthHeaders(req)\n307\t\tresp, err := g.httpClient.Do(req)\n308\t\tif err != nil {\n309\t\t\tg.metrics.GitRestCallsTotal(\"list\", \"error\").Inc()\n310\t\t\treturn nil, errors.Wrapf(ctx, err, \"LIST glob %s\", glob)\n311\t\t}\n312\t\tdefer resp.Body.Close()\n313\t\tbody, err := io.ReadAll(io.LimitReader(resp.Body, 10*1024*1024)) // 10 MiB max\n314\t\tif err != nil {\n315\t\t\tg.metrics.GitRestCallsTotal(\"list\", \"error\").Inc()\n316\t\t\treturn nil, errors.Wrapf(ctx, err, \"read LIST response body for glob %s\", glob)\n317\t\t}\n318\t\tif resp.StatusCode != http.StatusOK {\n319\t\t\tg.metrics.GitRestCallsTotal(\"list\", \"error\").Inc()\n320\t\t\tpreview := string(body)\n321\t\t\tif len(preview) > 100 {\n322\t\t\t\tpreview = preview[:100]\n323\t\t\t}\n324\t\t\treturn nil, errors.Errorf(\n325\t\t\t\tctx,\n326\t\t\t\t\"LIST glob %s returned %d: %s\",\n327\t\t\t\tglob,\n328\t\t\t\tresp.StatusCode,\n329\t\t\t\tpreview,\n330\t\t\t)\n331\t\t}\n332\t\tvar paths []string\n333\t\tif err := json.Unmarshal(body, &paths); err != nil {\n334\t\t\tg.metrics.GitRestCallsTotal(\"list\", \"error\").Inc()\n335\t\t\treturn nil, errors.Wrapf(ctx, err, \"parse LIST response for glob %s\", glob)\n336\t\t}\n337\t\tg.metrics.GitRestCallsTotal(\"list\", \"success\").Inc()\n338\t\treturn paths, nil\n339\t}\n340\t\n341\t//counterfeiter:generate -o ../../mocks/git_client.go --fake-name GitClient . GitClient\n342\t\n343\t// GitClient is the interface for vault file operations used throughout the controller.\n344\ttype GitClient interface {\n345\t\t// EnsureCloned clones the repo if not present, validates if already cloned.\n346\t\tEnsureCloned(ctx context.Context) error\n347\t\t// Pull runs git pull on the local clone.\n348\t\tPull(ctx context.Context) error\n349\t\t// CommitAndPush stages all changes, creates a commit with the given message, and pushes to the remote.\n350\t\tCommitAndPush(ctx context.Context, message string) error\n351\t\t// AtomicWriteAndCommitPush writes content to absPath and commits+pushes under a single lock.\n352\t\t// Atomicity (no interleaving with other writes) is guaranteed by the implementation:\n353\t\t// - gitClient (local-disk): sync.Mutex around the whole sequence.\n354\t\t// - gitRestGitClientAdapter: relies on per-task serialization (Kafka partitioning by task_id).\n355\t\tAtomicWriteAndCommitPush(\n356\t\t\tctx context.Context,\n357\t\t\tabsPath string,\n358\t\t\tcontent []byte,\n359\t\t\tmessage string,\n360\t\t) error\n361\t\t// AtomicWriteIfAbsentAndCommitPush writes content to absPath only when no file\n362\t\t// exists there yet, then commits+pushes. Returns ErrAlreadyExists (via\n363\t\t// errors.Is) when the path is occupied; nothing is written in that case.\n364\t\tAtomicWriteIfAbsentAndCommitPush(\n365\t\t\tctx context.Context,\n366\t\t\tabsPath string,\n367\t\t\tcontent []byte,\n368\t\t\tmessage string,\n369\t\t) error\n370\t\t// AtomicReadModifyWriteAndCommitPush reads absPath, calls modify on its contents\n371\t\t// to produce new contents, writes the result, and commits+pushes.\n372\t\t// Atomicity (no interleaving with other writes) is guaranteed by the implementation:\n373\t\t// - gitClient (local-disk): sync.Mutex around the whole sequence.\n374\t\t// - gitRestGitClientAdapter: relies on per-task serialization (Kafka partitioning by task_id).\n375\t\t// modify must return the new file bytes or an error.\n376\t\t// If modify returns an error, the file is not written and no commit is made.\n377\t\tAtomicReadModifyWriteAndCommitPush(\n378\t\t\tctx context.Context,\n379\t\t\tabsPath string,\n380\t\t\tmodify func(current []byte) ([]byte, error),\n381\t\t\tmessage string,\n382\t\t) error\n383\t\t// Path returns the local clone path.\n384\t\tPath() string\n385\t\t// ListFiles returns relative file paths under the repo root matching the single-level\n386\t\t// glob pattern (e.g. \"tasks/*.md\"). Paths are relative to the repo root.\n387\t\tListFiles(ctx context.Context, glob string) ([]string, error)\n388\t\t// ReadFile reads the file at relPath (relative to repo root, e.g. \"tasks/foo.md\")\n389\t\t// and returns its content.\n390\t\tReadFile(ctx context.Context, relPath string) ([]byte, error)\n391\t\t// WriteFile writes content to relPath (relative to repo root) on local disk.\n392\t\t// It does NOT commit or push — use AtomicWriteAndCommitPush for that.\n393\t\tWriteFile(ctx context.Context, relPath string, content []byte) error\n394\t}\n395\t\n396\t// IsReady checks git-rest's /readiness endpoint.\n397\tfunc (g *gitRestClient) IsReady(ctx context.Context) (bool, error) {\n398\t\treqURL := g.baseURL + \"/readiness\"\n399\t\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n400\t\tif err != nil {\n401\t\t\tg.metrics.GitRestCallsTotal(\"readiness\", \"error\").Inc()\n402\t\t\treturn false, errors.Wrapf(ctx, err, \"create readiness request\")\n403\t\t}\n404\t\tresp, err := g.httpClient.Do(req)\n405\t\tif err != nil {\n406\t\t\tg.metrics.GitRestCallsTotal(\"readiness\", \"error\").Inc()\n407\t\t\treturn false, errors.Wrapf(ctx, err, \"readiness check\")\n408\t\t}\n409\t\t_, _ = io.Copy(io.Discard, resp.Body)\n410\t\t_ = resp.Body.Close()\n411\t\tswitch resp.StatusCode {\n412\t\tcase http.StatusOK:\n413\t\t\tg.metrics.GitRestCallsTotal(\"readiness\", \"success\").Inc()\n414\t\t\treturn true, nil\n415\t\tcase http.StatusServiceUnavailable:\n416\t\t\tg.metrics.GitRestCallsTotal(\"readiness\", \"success\").Inc()\n417\t\t\treturn false, nil\n418\t\tdefault:\n419\t\t\tg.metrics.GitRestCallsTotal(\"readiness\", \"error\").Inc()\n420\t\t\treturn false, errors.Errorf(ctx, \"readiness returned unexpected status %d\", resp.StatusCode)\n421\t\t}\n422\t}\n423\t"}]},"parent_tool_use_id":null,"session_id":"ab2e800e-9400-4e49-90cb-78b86646bc3f","uuid":"ecbc3cf7-f356-456a-b75a-2543fae30f6b","timestamp":"2026-09-03T18:20:54.187Z","tool_use_result":{"type":"text","file":{"filePath":"/home/node/go/pkg/mod/github.com/bborbe/agent-task-controller@v0.6.6/pkg/gitrestclient/git_rest_client.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage gitrestclient\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\tstderrors \"errors\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/bborbe/errors\"\n\n\t\"github.com/bborbe/agent-task-controller/pkg/metrics\"\n)\n\n//counterfeiter:generate -o ../../mocks/git_rest_client.go --fake-name GitRestClient . GitRestClient\n\n// ErrAlreadyExists is returned by PostIfAbsent when the target path is already\n// occupied (git-rest responds 409 Conflict for a create-only write). It is a\n// benign conflict, not a transport failure — callers use errors.Is to treat it\n// as \"already there\" instead of an error worth retrying.\nvar ErrAlreadyExists = stderrors.New(\"file already exists\")\n\n// GitRestClient is the HTTP client for git-rest's /api/v1/files REST API.\n// All paths are relative to the repo root (e.g. \"tasks/foo.md\").\ntype GitRestClient interface {\n\t// Get retrieves the current content of the file at relPath.\n\tGet(ctx context.Context, relPath string) ([]byte, error)\n\t// Post writes content to relPath; git-rest auto-commits and pushes.\n\tPost(ctx context.Context, relPath string, content []byte) error\n\t// PostIfAbsent writes content to relPath only when no file exists there yet;\n\t// git-rest auto-commits and pushes. Returns ErrAlreadyExists (via errors.Is)\n\t// when relPath is already occupied — nothing is written in that case.\n\tPostIfAbsent(ctx context.Context, relPath string, content []byte) error\n\t// Delete removes the file at relPath; git-rest auto-commits and pushes.\n\tDelete(ctx context.Context, relPath string) error\n\t// List returns relative paths matching the single-level glob pattern (e.g. \"tasks/*.md\").\n\tList(ctx context.Context, glob string) ([]string, error)\n\t// IsReady reports whether git-rest's /readiness returns 200.\n\t// Returns (false, nil) when git-rest returns 503 — that is a valid not-ready state, not an error.\n\t// Returns (false, err) only on network failure or unexpected response.\n\tIsReady(ctx context.Context) (bool, error)\n}\n\n// NewGitRestClient creates a GitRestClient targeting the git-rest instance at baseURL.\n// gatewaySecret is the shared secret enforced by git-rest's gateway-secret auth (git-rest spec 004).\n// When gatewaySecret is empty, no auth headers are sent (backward-compat with auth-disabled git-rest).\n// gatewayInitiator is the caller identity logged by git-rest on auth failure;\n// pass a stable, human-readable value (e.g. \"agent-task-controller\").\nfunc NewGitRestClient(\n\tbaseURL, gatewaySecret, gatewayInitiator string,\n\tmetrics metrics.Metrics,\n) GitRestClient {\n\treturn newGitRestClientWithBackoff(\n\t\tbaseURL,\n\t\tgatewaySecret,\n\t\tgatewayInitiator,\n\t\texponentialBackoff,\n\t\tmetrics,\n\t)\n}\n\nfunc newGitRestClientWithBackoff(\n\tbaseURL, gatewaySecret, gatewayInitiator string,\n\tbackoff func(attempt int) time.Duration,\n\tmetrics metrics.Metrics,\n) GitRestClient {\n\treturn &gitRestClient{\n\t\tbaseURL:          strings.TrimRight(baseURL, \"/\"),\n\t\thttpClient:       &http.Client{Timeout: 30 * time.Second},\n\t\tbackoff:          backoff,\n\t\tgatewaySecret:    gatewaySecret,\n\t\tgatewayInitiator: gatewayInitiator,\n\t\tmetrics:          metrics,\n\t}\n}\n\nfunc exponentialBackoff(attempt int) time.Duration {\n\treturn time.Duration(\n\t\t1<<uint(attempt-1),\n\t) * time.Second // #nosec G115 -- attempt is always >= 1 when called\n}\n\ntype gitRestClient struct {\n\tbaseURL          string\n\thttpClient       *http.Client\n\tbackoff          func(attempt int) time.Duration\n\tgatewaySecret    string\n\tgatewayInitiator string\n\tmetrics          metrics.Metrics\n}\n\n// setAuthHeaders sets the gateway-secret auth headers on req when the secret is configured.\n// No-op when gatewaySecret is empty — keeps backward compatibility with auth-disabled git-rest.\n//\n// Header names are part of the git-rest public contract (spec 004) — do NOT alter:\n//\n//\tX-Gateway-Secret   — the shared secret\n//\tX-Gateway-Initator — caller identity (deliberate misspelling, do NOT change to \"Initiator\")\nfunc (g *gitRestClient) setAuthHeaders(req *http.Request) {\n\tif g.gatewaySecret == \"\" {\n\t\treturn\n\t}\n\treq.Header.Set(\"X-Gateway-Secret\", g.gatewaySecret)\n\treq.Header.Set(\"X-Gateway-Initator\", g.gatewayInitiator)\n}\n\n// fileURL builds /api/v1/files/<relPath> with proper percent-escaping so\n// characters like %, space, # in relPath survive the round-trip to git-rest.\nfunc (g *gitRestClient) fileURL(relPath string) string {\n\tsegments := strings.Split(relPath, \"/\")\n\tfor i, s := range segments {\n\t\tsegments[i] = url.PathEscape(s)\n\t}\n\treturn g.baseURL + \"/api/v1/files/\" + strings.Join(segments, \"/\")\n}\n\n// Get retrieves file content from git-rest. Does not retry — reads fail-fast.\nfunc (g *gitRestClient) Get(ctx context.Context, relPath string) ([]byte, error) {\n\treqURL := g.fileURL(relPath)\n\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n\tif err != nil {\n\t\tg.metrics.GitRestCallsTotal(\"get\", \"error\").Inc()\n\t\treturn nil, errors.Wrapf(ctx, err, \"create GET request for %s\", relPath)\n\t}\n\tg.setAuthHeaders(req)\n\tresp, err := g.httpClient.Do(req)\n\tif err != nil {\n\t\tg.metrics.GitRestCallsTotal(\"get\", \"error\").Inc()\n\t\treturn nil, errors.Wrapf(ctx, err, \"GET %s\", relPath)\n\t}\n\tdefer resp.Body.Close()\n\tbody, err := io.ReadAll(io.LimitReader(resp.Body, 10*1024*1024)) // 10 MiB max\n\tif err != nil {\n\t\tg.metrics.GitRestCallsTotal(\"get\", \"error\").Inc()\n\t\treturn nil, errors.Wrapf(ctx, err, \"read GET response body for %s\", relPath)\n\t}\n\tif resp.StatusCode != http.StatusOK {\n\t\tg.metrics.GitRestCallsTotal(\"get\", \"error\").Inc()\n\t\tpreview := string(body)\n\t\tif len(preview) > 100 {\n\t\t\tpreview = preview[:100]\n\t\t}\n\t\treturn nil, errors.Errorf(ctx, \"GET %s returned %d: %s\", relPath, resp.StatusCode, preview)\n\t}\n\tg.metrics.GitRestCallsTotal(\"get\", \"success\").Inc()\n\treturn body, nil\n}\n\n// Post writes content to relPath with retry on 5xx or network errors.\nfunc (g *gitRestClient) Post(ctx context.Context, relPath string, content []byte) error {\n\treturn g.post(ctx, relPath, content, false)\n}\n\n// PostIfAbsent writes content to relPath only when no file exists there yet.\n// git-rest answers 409 Conflict for an occupied path; that is mapped to\n// ErrAlreadyExists (via errors.Is) and is not retried. All other failures share\n// Post's retry behavior.\nfunc (g *gitRestClient) PostIfAbsent(ctx context.Context, relPath string, content []byte) error {\n\treturn g.post(ctx, relPath, content, true)\n}\n\n// post writes content to relPath with retry on 5xx or network errors. When\n// createOnly is true the request carries ?create_only=1 and a 409 Conflict\n// response is returned as ErrAlreadyExists instead of being retried.\nfunc (g *gitRestClient) post(\n\tctx context.Context,\n\trelPath string,\n\tcontent []byte,\n\tcreateOnly bool,\n) error {\n\treqURL := g.fileURL(relPath)\n\tif createOnly {\n\t\treqURL += \"?create_only=1\"\n\t}\n\tvar lastErr error\n\tfor attempt := 0; attempt < 5; attempt++ {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn errors.Wrapf(ctx, ctx.Err(), \"POST %s cancelled before attempt\", relPath)\n\t\tdefault:\n\t\t}\n\t\tif attempt > 0 {\n\t\t\tg.metrics.KafkaConsumePausedTotal().Inc()\n\t\t\tbackoff := g.backoff(attempt)\n\t\t\tselect {\n\t\t\tcase <-ctx.Done():\n\t\t\t\treturn errors.Wrapf(ctx, ctx.Err(), \"POST %s cancelled during backoff\", relPath)\n\t\t\tcase <-time.After(backoff):\n\t\t\t}\n\t\t}\n\t\treq, err := http.NewRequestWithContext(\n\t\t\tctx,\n\t\t\thttp.MethodPost,\n\t\t\treqURL,\n\t\t\tbytes.NewReader(content),\n\t\t)\n\t\tif err != nil {\n\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"error\").Inc()\n\t\t\tlastErr = errors.Wrapf(ctx, err, \"create POST request for %s\", relPath)\n\t\t\tcontinue\n\t\t}\n\t\treq.Header.Set(\"Content-Type\", \"application/octet-stream\")\n\t\tg.setAuthHeaders(req)\n\t\tresp, err := g.httpClient.Do(req)\n\t\tif err != nil {\n\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"error\").Inc()\n\t\t\tlastErr = errors.Wrapf(ctx, err, \"POST %s attempt %d\", relPath, attempt+1)\n\t\t\tcontinue\n\t\t}\n\t\t_, _ = io.Copy(io.Discard, resp.Body)\n\t\t_ = resp.Body.Close()\n\t\tif resp.StatusCode >= 200 && resp.StatusCode < 300 {\n\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"success\").Inc()\n\t\t\treturn nil\n\t\t}\n\t\tif createOnly && resp.StatusCode == http.StatusConflict {\n\t\t\tg.metrics.GitRestCallsTotal(\"post\", \"error\").Inc()\n\t\t\treturn errors.Wrapf(\n\t\t\t\tctx,\n\t\t\t\tErrAlreadyExists,\n\t\t\t\t\"POST %s create-only: path already exists\",\n\t\t\t\trelPath,\n\t\t\t)\n\t\t}\n\t\tg.metrics.GitRestCallsTotal(\"post\", \"error\").Inc()\n\t\tlastErr = errors.Errorf(\n\t\t\tctx,\n\t\t\t\"POST %s attempt %d returned %d\",\n\t\t\trelPath,\n\t\t\tattempt+1,\n\t\t\tresp.StatusCode,\n\t\t)\n\t}\n\treturn errors.Wrapf(ctx, lastErr, \"POST %s failed after 5 attempts\", relPath)\n}\n\n// Delete removes the file at relPath with retry on 5xx or network errors.\nfunc (g *gitRestClient) Delete(ctx context.Context, relPath string) error {\n\treqURL := g.fileURL(relPath)\n\tvar lastErr error\n\tfor attempt := 0; attempt < 5; attempt++ {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn errors.Wrapf(ctx, ctx.Err(), \"DELETE %s cancelled before attempt\", relPath)\n\t\tdefault:\n\t\t}\n\t\tif attempt > 0 {\n\t\t\tg.metrics.KafkaConsumePausedTotal().Inc()\n\t\t\tbackoff := g.backoff(attempt)\n\t\t\tselect {\n\t\t\tcase <-ctx.Done():\n\t\t\t\treturn errors.Wrapf(ctx, ctx.Err(), \"DELETE %s cancelled during backoff\", relPath)\n\t\t\tcase <-time.After(backoff):\n\t\t\t}\n\t\t}\n\t\treq, err := http.NewRequestWithContext(ctx, http.MethodDelete, reqURL, nil)\n\t\tif err != nil {\n\t\t\tg.metrics.GitRestCallsTotal(\"delete\", \"error\").Inc()\n\t\t\tlastErr = errors.Wrapf(ctx, err, \"create DELETE request for %s\", relPath)\n\t\t\tcontinue\n\t\t}\n\t\tg.setAuthHeaders(req)\n\t\tresp, err := g.httpClient.Do(req)\n\t\tif err != nil {\n\t\t\tg.metrics.GitRestCallsTotal(\"delete\", \"error\").Inc()\n\t\t\tlastErr = errors.Wrapf(ctx, err, \"DELETE %s attempt %d\", relPath, attempt+1)\n\t\t\tcontinue\n\t\t}\n\t\t_, _ = io.Copy(io.Discard, resp.Body)\n\t\t_ = resp.Body.Close()\n\t\tif resp.StatusCode >= 200 && resp.StatusCode < 300 {\n\t\t\tg.metrics.GitRestCallsTotal(\"delete\", \"success\").Inc()\n\t\t\treturn nil\n\t\t}\n\t\tg.metrics.GitRestCallsTotal(\"delete\", \"error\").Inc()\n\t\tlastErr = errors.Errorf(\n\t\t\tctx,\n\t\t\t\"DELETE %s attempt %d returned %d\",\n\t\t\trelPath,\n\t\t\tattempt+1,\n\t\t\tresp.StatusCode,\n\t\t)\n\t}\n\treturn errors.Wrapf(ctx, lastErr, \"DELETE %s failed after 5 attempts\", relPath)\n}\n\n// List returns paths matching the glob pattern. Does not retry — reads fail-fast.\nfunc (g *gitRestClient) List(ctx context.Context, glob string) ([]string, error) {\n\treqURL := g.baseURL + \"/api/v1/files/\"\n\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n\tif err != nil {\n\t\tg.metrics.GitRestCallsTotal(\"list\", \"error\").Inc()\n\t\treturn nil, errors.Wrapf(ctx, err, \"create LIST request for glob %s\", glob)\n\t}\n\tq := url.Values{}\n\tq.Set(\"glob\", glob)\n\treq.URL.RawQuery = q.Encode()\n\tg.setAuthHeaders(req)\n\tresp, err := g.httpClient.Do(req)\n\tif err != nil {\n\t\tg.metrics.GitRestCallsTotal(\"list\", \"error\").Inc()\n\t\treturn nil, errors.Wrapf(ctx, err, \"LIST glob %s\", glob)\n\t}\n\tdefer resp.Body.Close()\n\tbody, err := io.ReadAll(io.LimitReader(resp.Body, 10*1024*1024)) // 10 MiB max\n\tif err != nil {\n\t\tg.metrics.GitRestCallsTotal(\"list\", \"error\").Inc()\n\t\treturn nil, errors.Wrapf(ctx, err, \"read LIST response body for glob %s\", glob)\n\t}\n\tif resp.StatusCode != http.StatusOK {\n\t\tg.metrics.GitRestCallsTotal(\"list\", \"error\").Inc()\n\t\tpreview := string(body)\n\t\tif len(preview) > 100 {\n\t\t\tpreview = preview[:100]\n\t\t}\n\t\treturn nil, errors.Errorf(\n\t\t\tctx,\n\t\t\t\"LIST glob %s returned %d: %s\",\n\t\t\tglob,\n\t\t\tresp.StatusCode,\n\t\t\tpreview,\n\t\t)\n\t}\n\tvar paths []string\n\tif err := json.Unmarshal(body, &paths); err != nil {\n\t\tg.metrics.GitRestCallsTotal(\"list\", \"error\").Inc()\n\t\treturn nil, errors.Wrapf(ctx, err, \"parse LIST response for glob %s\", glob)\n\t}\n\tg.metrics.GitRestCallsTotal(\"list\", \"success\").Inc()\n\treturn paths, nil\n}\n\n//counterfeiter:generate -o ../../mocks/git_client.go --fake-name GitClient . GitClient\n\n// GitClient is the interface for vault file operations used throughout the controller.\ntype GitClient interface {\n\t// EnsureCloned clones the repo if not present, validates if already cloned.\n\tEnsureCloned(ctx context.Context) error\n\t// Pull runs git pull on the local clone.\n\tPull(ctx context.Context) error\n\t// CommitAndPush stages all changes, creates a commit with the given message, and pushes to the remote.\n\tCommitAndPush(ctx context.Context, message string) error\n\t// AtomicWriteAndCommitPush writes content to absPath and commits+pushes under a single lock.\n\t// Atomicity (no interleaving with other writes) is guaranteed by the implementation:\n\t// - gitClient (local-disk): sync.Mutex around the whole sequence.\n\t// - gitRestGitClientAdapter: relies on per-task serialization (Kafka partitioning by task_id).\n\tAtomicWriteAndCommitPush(\n\t\tctx context.Context,\n\t\tabsPath string,\n\t\tcontent []byte,\n\t\tmessage string,\n\t) error\n\t// AtomicWriteIfAbsentAndCommitPush writes content to absPath only when no file\n\t// exists there yet, then commits+pushes. Returns ErrAlreadyExists (via\n\t// errors.Is) when the path is occupied; nothing is written in that case.\n\tAtomicWriteIfAbsentAndCommitPush(\n\t\tctx context.Context,\n\t\tabsPath string,\n\t\tcontent []byte,\n\t\tmessage string,\n\t) error\n\t// AtomicReadModifyWriteAndCommitPush reads absPath, calls modify on its contents\n\t// to produce new contents, writes the result, and commits+pushes.\n\t// Atomicity (no interleaving with other writes) is guaranteed by the implementation:\n\t// - gitClient (local-disk): sync.Mutex around the whole sequence.\n\t// - gitRestGitClientAdapter: relies on per-task serialization (Kafka partitioning by task_id).\n\t// modify must return the new file bytes or an error.\n\t// If modify returns an error, the file is not written and no commit is made.\n\tAtomicReadModifyWriteAndCommitPush(\n\t\tctx context.Context,\n\t\tabsPath string,\n\t\tmodify func(current []byte) ([]byte, error),\n\t\tmessage string,\n\t) error\n\t// Path returns the local clone path.\n\tPath() string\n\t// ListFiles returns relative file paths under the repo root matching the single-level\n\t// glob pattern (e.g. \"tasks/*.md\"). Paths are relative to the repo root.\n\tListFiles(ctx context.Context, glob string) ([]string, error)\n\t// ReadFile reads the file at relPath (relative to repo root, e.g. \"tasks/foo.md\")\n\t// and returns its content.\n\tReadFile(ctx context.Context, relPath string) ([]byte, error)\n\t// WriteFile writes content to relPath (relative to repo root) on local disk.\n\t// It does NOT commit or push — use AtomicWriteAndCommitPush for that.\n\tWriteFile(ctx context.Context, relPath string, content []byte) error\n}\n\n// IsReady checks git-rest's /readiness endpoint.\nfunc (g *gitRestClient) IsReady(ctx context.Context) (bool, error) {\n\treqURL := g.baseURL + \"/readiness\"\n\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n\tif err != nil {\n\t\tg.metrics.GitRestCallsTotal(\"readiness\", \"error\").Inc()\n\t\treturn false, errors.Wrapf(ctx, err, \"create readiness request\")\n\t}\n\tresp, err := g.httpClient.Do(req)\n\tif err != nil {\n\t\tg.metrics.GitRestCallsTotal(\"readiness\", \"error\").Inc()\n\t\treturn false, errors.Wrapf(ctx, err, \"readiness check\")\n\t}\n\t_, _ = io.Copy(io.Discard, resp.Body)\n\t_ = resp.Body.Close()\n\tswitch resp.StatusCode {\n\tcase http.StatusOK:\n\t\tg.metrics.GitRestCallsTotal(\"readiness\", \"success\").Inc()\n\t\treturn true, nil\n\tcase http.StatusServiceUnavailable:\n\t\tg.metrics.GitRestCallsTotal(\"readiness\", \"success\").Inc()\n\t\treturn false, nil\n\tdefault:\n\t\tg.metrics.GitRestCallsTotal(\"readiness\", \"error\").Inc()\n\t\treturn false, errors.Errorf(ctx, \"readiness returned unexpected status %d\", resp.StatusCode)\n\t}\n}\n","numLines":423,"startLine":1,"totalLines":423}}}
