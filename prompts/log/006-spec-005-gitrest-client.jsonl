enjamin-borbe.de/task-id\"] = taskID\n54\t\t\t}\n55\t\t\treturn &batchv1.Job{\n56\t\t\t\tObjectMeta: metav1.ObjectMeta{\n57\t\t\t\t\tName:      name,\n58\t\t\t\t\tNamespace: \"test-ns\",\n59\t\t\t\t\tLabels:    labels,\n60\t\t\t\t},\n61\t\t\t\tStatus: batchv1.JobStatus{\n62\t\t\t\t\tConditions: conditions,\n63\t\t\t\t},\n64\t\t\t}\n65\t\t}\n66\t\n67\t\tbackoffCondition := func() batchv1.JobCondition {\n68\t\t\treturn batchv1.JobCondition{\n69\t\t\t\tType:    batchv1.JobFailed,\n70\t\t\t\tStatus:  corev1.ConditionTrue,\n71\t\t\t\tReason:  \"BackoffLimitExceeded\",\n72\t\t\t\tMessage: \"Job has reached the specified backoff limit\",\n73\t\t\t}\n74\t\t}\n75\t\n76\t\tmakeOwnedTerminatedPod := func(name, jobName, taskID, terminatedReason string, exitCode int32, createdAt string) *corev1.Pod {\n77\t\t\tpod := &corev1.Pod{\n78\t\t\t\tObjectMeta: metav1.ObjectMeta{\n79\t\t\t\t\tName:      name,\n80\t\t\t\t\tNamespace: \"test-ns\",\n81\t\t\t\t\tLabels: map[string]string{\n82\t\t\t\t\t\t\"agent.benjamin-borbe.de/task-id\": taskID,\n83\t\t\t\t\t},\n84\t\t\t\t\tOwnerReferences: []metav1.OwnerReference{\n85\t\t\t\t\t\t{\n86\t\t\t\t\t\t\tKind: \"Job\",\n87\t\t\t\t\t\t\tName: jobName,\n88\t\t\t\t\t\t},\n89\t\t\t\t\t},\n90\t\t\t\t},\n91\t\t\t\tStatus: corev1.PodStatus{\n92\t\t\t\t\tPhase: corev1.PodFailed,\n93\t\t\t\t\tContainerStatuses: []corev1.ContainerStatus{\n94\t\t\t\t\t\t{\n95\t\t\t\t\t\t\tState: corev1.ContainerState{\n96\t\t\t\t\t\t\t\tTerminated: &corev1.ContainerStateTerminated{\n97\t\t\t\t\t\t\t\t\tReason:   terminatedReason,\n98\t\t\t\t\t\t\t\t\tExitCode: exitCode,\n99\t\t\t\t\t\t\t\t},\n100\t\t\t\t\t\t\t},\n101\t\t\t\t\t\t},\n102\t\t\t\t\t},\n103\t\t\t\t},\n104\t\t\t}\n105\t\t\tif createdAt != \"\" {\n106\t\t\t\tt, err := time.Parse(time.RFC3339, createdAt)\n107\t\t\t\tif err != nil {\n108\t\t\t\t\tpanic(err)\n109\t\t\t\t}\n110\t\t\t\tpod.CreationTimestamp = metav1.NewTime(t)\n111\t\t\t}\n112\t\t\treturn pod\n113\t\t}\n114\t\n115\t\tDescribe(\"HandleJob with resolvable pod lister\", func() {\n116\t\t\tIt(\"publishes pod_oom_killed with OOMKilled/137 detail for an OOMKilled pod\", func() {\n117\t\t\t\ttaskStore.Store(testTaskID, testTask)\n118\t\t\t\tjob := makeJob(\"job-oom\", string(testTaskID), backoffCondition())\n119\t\t\t\tsetPodLister(\n120\t\t\t\t\twatcher,\n121\t\t\t\t\tmakeOwnedTerminatedPod(\n122\t\t\t\t\t\t\"pod-oom\",\n123\t\t\t\t\t\t\"job-oom\",\n124\t\t\t\t\t\tstring(testTaskID),\n125\t\t\t\t\t\t\"OOMKilled\",\n126\t\t\t\t\t\t137,\n127\t\t\t\t\t\t\"2026-08-16T00:00:00Z\",\n128\t\t\t\t\t),\n129\t\t\t\t)\n130\t\n131\t\t\t\twatcher.HandleJob(ctx, job)\n132\t\n133\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n134\t\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n135\t\t\t\tExpect(calledReason).To(Equal(\"pod_oom_killed (OOMKilled/137)\"))\n136\t\t\t\tExpect(calledReason).NotTo(ContainSubstring(\"deadline_exceeded\"))\n137\t\t\t})\n138\t\n139\t\t\tIt(\n140\t\t\t\t\"publishes pod_crash_no_stdout with Error/1 detail for a non-OOM terminated pod\",\n141\t\t\t\tfunc() {\n142\t\t\t\t\ttaskStore.Store(testTaskID, testTask)\n143\t\t\t\t\tjob := makeJob(\"job-error\", string(testTaskID), backoffCondition())\n144\t\t\t\t\tsetPodLister(\n145\t\t\t\t\t\twatcher,\n146\t\t\t\t\t\tmakeOwnedTerminatedPod(\n147\t\t\t\t\t\t\t\"pod-error\",\n148\t\t\t\t\t\t\t\"job-error\",\n149\t\t\t\t\t\t\tstring(testTaskID),\n150\t\t\t\t\t\t\t\"Error\",\n151\t\t\t\t\t\t\t1,\n152\t\t\t\t\t\t\t\"2026-08-16T00:00:00Z\",\n153\t\t\t\t\t\t),\n154\t\t\t\t\t)\n155\t\n156\t\t\t\t\twatcher.HandleJob(ctx, job)\n157\t\n158\t\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n159\t\t\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n160\t\t\t\t\tExpect(calledReason).To(Equal(\"pod_crash_no_stdout (Error/1)\"))\n161\t\t\t\t\tExpect(calledReason).NotTo(ContainSubstring(\"deadline_exceeded\"))\n162\t\t\t\t\tExpect(calledReason).NotTo(ContainSubstring(\"pod_oom_killed\"))\n163\t\