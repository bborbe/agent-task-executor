 ok := secret.Data[gitRestGatewaySecretDataKey]\n\tif !ok {\n\t\treturn \"\", errors.Errorf(ctx, \"secret %q lacks data key %q\", secretName, gitRestGatewaySecretDataKey)\n\t}\n\treturn string(value), nil\n}\n"}}],"model":"deepseek-v4-flash","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"ab2e800e-9400-4e49-90cb-78b86646bc3f","uuid":"12204f1b-6c77-4316-97af-f6f17d80e4ee","timestamp":"2026-09-03T18:21:25.877Z"}
