{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-90579aec9ca18513","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage gitrestclient_test\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"errors\"\n10\t\t\"net/http\"\n11\t\t\"net/http/httptest\"\n12\t\t\"time\"\n13\t\n14\t\t. \"github.com/onsi/ginkgo/v2\"\n15\t\t. \"github.com/onsi/gomega\"\n16\t\n17\t\t\"github.com/bborbe/agent-task-controller/pkg/gitrestclient\"\n18\t\t\"github.com/bborbe/agent-task-controller/pkg/metrics\"\n19\t)\n20\t\n21\t// zeroBackoff returns 0 duration so retry tests run instantly.\n22\tfunc zeroBackoff(_ int) time.Duration {\n23\t\treturn 0\n24\t}\n25\t\n26\t// shortBackoff returns 1ms so context-cancellation tests run fast but still enter the select.\n27\tfunc shortBackoff(_ int) time.Duration {\n28\t\treturn time.Millisecond\n29\t}\n30\t\n31\tvar _ = Describe(\"exponentialBackoff\", func() {\n32\t\tIt(\"returns correct doubling sequence\", func() {\n33\t\t\tExpect(gitrestclient.ExponentialBackoff(1)).To(Equal(1 * time.Second))\n34\t\t\tExpect(gitrestclient.ExponentialBackoff(2)).To(Equal(2 * time.Second))\n35\t\t\tExpect(gitrestclient.ExponentialBackoff(3)).To(Equal(4 * time.Second))\n36\t\t\tExpect(gitrestclient.ExponentialBackoff(4)).To(Equal(8 * time.Second))\n37\t\t\tExpect(gitrestclient.ExponentialBackoff(5)).To(Equal(16 * time.Second))\n38\t\t})\n39\t})\n40\t\n41\tvar _ = Describe(\"GitRestClient\", func() {\n42\t\tvar (\n43\t\t\tctx    context.Context\n44\t\t\tserver *httptest.Server\n45\t\t\tclient gitrestclient.GitRestClient\n46\t\t)\n47\t\n48\t\tBeforeEach(func() {\n49\t\t\tctx = context.Background()\n50\t\t})\n51\t\n52\t\tAfterEach(func() {\n53\t\t\tif server != nil {\n54\t\t\t\tserver.Close()\n55\t\t\t}\n56\t\t})\n57\t\n58\t\tDescribe(\"Get\", func() {\n59\t\t\tContext(\"200 response\", func() {\n60\t\t\t\tBeforeEach(func() {\n61\t\t\t\t\tserver = httptest.NewServer(\n62\t\t\t\t\t\thttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n63\t\t\t\t\t\t\tExpect(r.Method).To(Equal(http.MethodGet))\n64\t\t\t\t\t\t\tExpect(r.URL.Path).To(Equal(\"/api/v1/files/tasks/foo.md\"))\n65\t\t\t\t\t\t\tw.WriteHeader(http.StatusOK)\n66\t\t\t\t\t\t\t_, _ = w.Write([]byte(\"---\\nfoo: bar\\n---\\nbody\"))\n67\t\t\t\t\t\t}),\n68\t\t\t\t\t)\n69\t\t\t\t\tclient = gitrestclient.NewGitRestClientForTest(server.URL, \"\", \"\", zeroBackoff)\n70\t\t\t\t})\n71\t\n72\t\t\t\tIt(\"returns the file bytes and nil error\", func() {\n73\t\t\t\t\tcontent, err := client.Get(ctx, \"tasks/foo.md\")\n74\t\t\t\t\tExpect(err).To(BeNil())\n75\t\t\t\t\tExpect(content).To(Equal([]byte(\"---\\nfoo: bar\\n---\\nbody\")))\n76\t\t\t\t})\n77\t\t\t})\n78\t\n79\t\t\tContext(\"404 response\", func() {\n80\t\t\t\tBeforeEach(func() {\n81\t\t\t\t\tserver = httptest.NewServer(\n82\t\t\t\t\t\thttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n83\t\t\t\t\t\t\tw.WriteHeader(http.StatusNotFound)\n84\t\t\t\t\t\t}),\n85\t\t\t\t\t)\n86\t\t\t\t\tclient = gitrestclient.NewGitRestClientForTest(server.URL, \"\", \"\", zeroBackoff)\n87\t\t\t\t})\n88\t\n89\t\t\t\tIt(\"returns a non-nil error\", func() {\n90\t\t\t\t\tcontent, err := client.Get(ctx, \"tasks/missing.md\")\n91\t\t\t\t\tExpect(err).NotTo(BeNil())\n92\t\t\t\t\tExpect(content).To(BeNil())\n93\t\t\t\t})\n94\t\t\t})\n95\t\n96\t\t\tContext(\"network error (stopped server)\", func() {\n97\t\t\t\tBeforeEach(func() {\n98\t\t\t\t\tserver = httptest.NewServer(\n99\t\t\t\t\t\thttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}),\n100\t\t\t\t\t)\n101\t\t\t\t\tclient = gitrestclient.NewGitRestClientForTest(server.URL, \"\", \"\", zeroBackoff)\n102\t\t\t\t\tserver.Close()\n103\t\t\t\t\tserver = nil\n104\t\t\t\t})\n105\t\n106\t\t\t\tIt(\"returns a non-nil error\", func() {\n107\t\t\t\t\tcontent, err := client.Get(ctx, \"tasks/foo.md\")\n108\t\t\t\t\tExpect(err).NotTo(BeNil())\n109\t\t\t\t\tExpect(content).To(BeNil())\n110\t\t\t\t})\n111\t\t\t})\n112\t\n113\t\t\tContext(\"relPath contains percent sign\", func() {\n114\t\t\t\tBeforeEach(func() {\n115\t\t\t\t\tserver = httptest.NewServer(\n116\t\t\t\t\t\thttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n117\t\t\t\t\t\t\t// Reaching this handler at all proves the URL was escaped — before\n118\t\t\t\t\t\t\t// the fix, http.NewRequestWithContext failed with `invalid URL escape \"%er\"`.\n119\t\t\t\t\t\t\t// r.URL.Path is the decoded path; verify it round-trips intact.\n120\t\t\t\t\t\t\tExpect(\n121\t\t\t\t\t\t\t\tr.URL.Path,\n122\t\t\t\t\t\t\t).To(Equal(\"/api/v1/files/24 Tasks/Set up The 5%ers prop firm account.md\"))\n123\t\t\t\t\t\t\tw.WriteHeader(http.StatusOK)\n124\t\t\t\t\t\t\t_, _ = w.Write([]byte(\"ok\"))\n125\t\t\t\t\t\t}),\n126\t\t\t\t\t)\n127\t\t\t\t\tclient = gitrestclient.NewGitRestClientForTest(server.URL, \"\", \"\", zeroBackoff)\n128\t\t\t\t})\n129\t\n130\t\t\t\tIt(\"escapes the path and succeeds\", func() {\n131\t\t\t\t\tcontent, err := client.Get(ctx, \"24 Tasks/Set up The 5%ers prop firm account.md\")\n132\t\t\t\t\tExpect(err).To(BeNil())\n133\t\t\t\t\tExpect(content).To(Equal([]byte(\"ok\")))\n134\t\t\t\t})\n135\t\t\t})\n136\t\t})\n137\t\n138\t\tDescribe(\"NewGitRestClient (public constructor)\", func() {\n139\t\t\tIt(\"returns a non-nil client that can perform requests\", func() {\n140\t\t\t\tserver = httptest.NewServer(\n141\t\t\t\t\thttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n142\t\t\t\t\t\tw.WriteHeader(http.StatusOK)\n143\t\t\t\t\t}),\n144\t\t\t\t)\n145\t\t\t\tc := gitrestclient.NewGitRestClient(server.URL, \"\", \"\", metrics.New())\n146\t\t\t\tExpect(c).NotTo(BeNil())\n147\t\t\t\tready, err := c.IsReady(ctx)\n148\t\t\t\tExpect(err).To(BeNil())\n149\t\t\t\tExpect(ready).To(BeTrue())\n150\t\t\t})\n151\t\t})\n152\t\n153\t\tDescribe(\"Post\", func() {\n154\t\t\tContext(\"success on first attempt\", func() {\n155\t\t\t\tBeforeEach(func() {\n156\t\t\t\t\tserver = httptest.NewServer(\n157\t\t\t\t\t\thttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n158\t\t\t\t\t\t\tExpect(r.Method).To(Equal(http.MethodPost))\n159\t\t\t\t\t\t\tExpect(r.URL.Path).To(Equal(\"/api/v1/files/tasks/new.md\"))\n160\t\t\t\t\t\t\tw.WriteHeader(http.StatusCreated)\n161\t\t\t\t\t\t\t_, _ = w.Write([]byte(`{\"ok\":true}`))\n162\t\t\t\t\t\t}),\n163\t\t\t\t\t)\n164\t\t\t\t\tclient = gitrestclient.NewGitRestClientForTest(server.URL, \"\", \"\", zeroBackoff)\n165\t\t\t\t})\n166\t\n167\t\t\t\tIt(\"returns nil\", func() {\n168\t\t\t\t\terr := client.Post(ctx, \"tasks/new.md\", []byte(\"content\"))\n169\t\t\t\t\tExpect(err).To(BeNil())\n170\t\t\t\t})\n171\t\t\t})\n172\t\n173\t\t\tContext(\"success after 1 retry\", func() {\n174\t\t\t\tvar callCount int\n175\t\n176\t\t\t\tBeforeEach(func() {\n177\t\t\t\t\tcallCount = 0\n178\t\t\t\t\tserver = httptest.NewServer(\n179\t\t\t\t\t\thttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n180\t\t\t\t\t\t\tcallCount++\n181\t\t\t\t\t\t\tif callCount < 2 {\n182\t\t\t\t\t\t\t\tw.WriteHeader(http.StatusServiceUnavailable)\n183\t\t\t\t\t\t\t\treturn\n184\t\t\t\t\t\t\t}\n185\t\t\t\t\t\t\tw.WriteHeader(http.StatusOK)\n186\t\t\t\t\t\t}),\n187\t\t\t\t\t)\n188\t\t\t\t\tclient = gitrestclient.NewGitRestClientForTest(server.URL, \"\", \"\", zeroBackoff)\n189\t\t\t\t})\n190\t\n191\t\t\t\tIt(\"returns nil and makes 2 requests\", func() {\n192\t\t\t\t\terr := client.Post(ctx, \"tasks/new.md\", []byte(\"content\"))\n193\t\t\t\t\tExpect(err).To(BeNil())\n194\t\t\t\t\tExpect(callCount).To(Equal(2))\n195\t\t\t\t})\n196\t\t\t})\n197\t\n198\t\t\tContext(\"fail after 5 attempts\", func() {\n199\t\t\t\tvar callCount int\n200\t\n201\t\t\t\tBeforeEach(func() {\n202\t\t\t\t\tcallCount = 0\n203\t\t\t\t\tserver = httptest.NewServer(\n204\t\t\t\t\t\thttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n205\t\t\t\t\t\t\tcallCount++\n206\t\t\t\t\t\t\tw.WriteHeader(http.StatusServiceUnavailable)\n207\t\t\t\t\t\t}),\n208\t\t\t\t\t)\n209\t\t\t\t\tclient = gitrestclient.NewGitRestClientForTest(server.URL, \"\", \"\", zeroBackoff)\n210\t\t\t\t})\n211\t\n212\t\t\t\tIt(\"returns a non-nil error after 5 requests\", func() {\n213\t\t\t\t\terr := client.Post(ctx, \"tasks/new.md\", []byte(\"content\"))\n214\t\t\t\t\tExpect(err).NotTo(BeNil())\n215\t\t\t\t\tExpect(callCount).To(Equal(5))\n216\t\t\t\t})\n217\t\t\t})\n218\t\n219\t\t\tContext(\"context cancelled during backoff\", func() {\n220\t\t\t\tBeforeEach(func() {\n221\t\t\t\t\tserver = httptest.NewServer(\n222\t\t\t\t\t\thttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n223\t\t\t\t\t\t\tw.WriteHeader(http.StatusServiceUnavailable)\n224\t\t\t\t\t\t}),\n225\t\t\t\t\t)\n226\t\t\t\t\t// shortBackoff so the context.Done() branch is exercised in the select\n227\t\t\t\t\tclient = gitrestclient.NewGitRestClientForTest(server.URL, \"\", \"\", shortBackoff)\n228\t\t\t\t})\n229\t\n230\t\t\t\tIt(\"returns a non-nil error when context is pre-cancelled\", func() {\n231\t\t\t\t\tcancelCtx, cancel := context.WithCancel(ctx)\n232\t\t\t\t\tcancel()\n233\t\t\t\t\terr := client.Post(cancelCtx, \"tasks/new.md\", []byte(\"content\"))\n234\t\t\t\t\tExpect(err).NotTo(BeNil())\n235\t\t\t\t})\n236\t\t\t})\n237\t\t})\n238\t\n239\t\tDescribe(\"PostIfAbsent\", func() {\n240\t\t\tContext(\"create-only success on first attempt\", func() {\n241\t\t\t\tBeforeEach(func() {\n242\t\t\t\t\tserver = httptest.NewServer(\n243\t\t\t\t\t\thttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n244\t\t\t\t\t\t\tExpect(r.Method).To(Equal(http.MethodPost))\n245\t\t\t\t\t\t\tExpect(r.URL.Path).To(Equal(\"/api/v1/files/tasks/new.md\"))\n246\t\t\t\t\t\t\tExpect(r.URL.RawQuery).To(Equal(\"create_only=1\"))\n247\t\t\t\t\t\t\tw.WriteHeader(http.StatusCreated)\n248\t\t\t\t\t\t\t_, _ = w.Write([]byte(`{\"ok\":true}`))\n249\t\t\t\t\t\t}),\n250\t\t\t\t\t)\n251\t\t\t\t\tclient = gitrestclient.N