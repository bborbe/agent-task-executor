mits: agentv1.AgentResourceList{\n\t\t\t\t\t\t\tCPU:              \"1\",\n\t\t\t\t\t\t\tMemory:           \"2Gi\",\n\t\t\t\t\t\t\tEphemeralStorage: \"4Gi\",\n\t\t\t\t\t\t},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t},\n\t\t}\n\t\tconfig, err := resolver.Resolve(ctx, \"claude\")\n\t\tExpect(err).To(BeNil())\n\t\tExpect(config.Assignee).To(Equal(\"claude\"))\n\t\tExpect(config.Image).To(Equal(\"foo/bar:dev\"))\n\t\tExpect(config.Env).To(Equal(map[string]string{\"KEY\": \"val\"}))\n\t\tExpect(config.SecretName).To(Equal(\"my-secret\"))\n\t\tExpect(config.VolumeClaim).To(Equal(\"my-pvc\"))\n\t\tExpect(config.VolumeMountPath).To(Equal(\"/mnt/data\"))\n\t\tExpect(config.Resources).NotTo(BeNil())\n\t\tExpect(config.Resources.Requests.CPU).To(Equal(\"500m\"))\n\t\tExpect(config.Resources.Requests.Memory).To(Equal(\"1Gi\"))\n\t\tExpect(config.Resources.Requests.EphemeralStorage).To(Equal(\"2Gi\"))\n\t\tExpect(config.Resources.Limits.CPU).To(Equal(\"1\"))\n\t\tExpect(config.Resources.Limits.Memory).To(Equal(\"2Gi\"))\n\t\tExpect(config.Resources.Limits.EphemeralStorage).To(Equal(\"4Gi\"))\n\t})\n\n\tIt(\"leaves Resources nil when Spec.Resources is nil\", func() {\n\t\tprovider.items = []agentv1.Config{\n\t\t\t{\n\t\t\t\tSpec: agentv1.ConfigSpec{\n\t\t\t\t\tAssignee:  \"claude\",\n\t\t\t\t\tImage:     \"foo/bar\",\n\t\t\t\t\tHeartbeat: \"30m\",\n\t\t\t\t},\n\t\t\t},\n\t\t}\n\t\tconfig, err := resolver.Resolve(ctx, \"claude\")\n\t\tExpect(err).To(BeNil())\n\t\tExpect(config.Resources).To(BeNil())\n\t})\n\n\tIt(\"returns ErrConfigNotFound when no item matches\", func() {\n\t\tprovider.items = []agentv1.Config{\n\t\t\t{Spec: agentv1.ConfigSpec{Assignee: \"other-agent\", Image: \"img\", Heartbeat: \"1m\"}},\n\t\t}\n\t\t_, err := resolver.Resolve(ctx, \"claude\")\n\t\tExpect(err).NotTo(BeNil())\n\t\tExpect(errors.Is(err, pkg.ErrConfigNotFound)).To(BeTrue())\n\t})\n\n\tIt(\"returns ErrConfigNotFound when store is empty\", func() {\n\t\tprovider.items = []agentv1.Config{}\n\t\t_, err := resolver.Resolve(ctx, \"claude\")\n\t\tExpect(err).NotTo(BeNil())\n\t\tExpect(errors.Is(err, pkg.ErrConfigNotFound)).To(BeTrue())\n\t})\n\n\tIt(\"returns a wrapped error when provider.Get fails\", func() {\n\t\tprovider.err = errors.Errorf(ctx, \"storage unavailable\")\n\t\t_, err := resolver.Resolve(ctx, \"claude\")\n\t\tExpect(err).NotTo(BeNil())\n\t\tExpect(errors.Is(err, pkg.ErrConfigNotFound)).To(BeFalse())\n\t})\n\n\tIt(\n\t\t\"defensively copies env map — mutation after Resolve does not affect returned config\",\n\t\tfunc() {\n\t\t\toriginalEnv := map[string]string{\"KEY\": \"val\"}\n\t\t\tprovider.items = []agentv1.Config{\n\t\t\t\t{\n\t\t\t\t\tSpec: agentv1.ConfigSpec{\n\t\t\t\t\t\tAssignee:  \"claude\",\n\t\t\t\t\t\tImage:     \"img\",\n\t\t\t\t\t\tHeartbeat: \"1m\",\n\t\t\t\t\t\tEnv:       originalEnv,\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t}\n\t\t\tconfig, err := resolver.Resolve(ctx, \"claude\")\n\t\t\tExpect(err).To(BeNil())\n\t\t\toriginalEnv[\"KEY\"] = \"mutated\"\n\t\t\tExpect(config.Env[\"KEY\"]).To(Equal(\"val\"))\n\t\t},\n\t)\n\n\tIt(\"branch tagging: given branch=dev and Image=foo/bar, result has Image==foo/bar:dev\", func() {\n\t\tprovider.items = []agentv1.Config{\n\t\t\t{Spec: agentv1.ConfigSpec{Assignee: \"claude\", Image: \"foo/bar\", Heartbeat: \"1m\"}},\n\t\t}\n\t\tconfig, err := resolver.Resolve(ctx, \"claude\")\n\t\tExpect(err).To(BeNil())\n\t\tExpect(config.Image).To(Equal(\"foo/bar:dev\"))\n\t})\n})\n","numLines":152,"startLine":1,"totalLines":152}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-b9688dbb7ae931ad","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage factory\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\n10\t\t\"github.com/IBM/sarama\"\n11\t\tlib \"github.com/bborbe/agent\"\n12\t\t\"github.com/bborbe/cqrs/base\"\n13\t\tcdb \"github.com/bborbe/cqrs/cdb\"\n14\t\tlibcron \"github.com/bborbe/cron\"\n15\t\tlibk8s \"github.com/bborbe/k8s\"\n16\t\tlibkafka \"github.com/bborbe/kafka\"\n17\t\t\"github.com/bborbe/log\"\n18\t\t\"github.com/bborbe/run\"\n19\t\tlibtime \"github.com/bborbe/time\"\n20\t\t\"k8s.io/client-go/kubernetes\"\n21\t\t\"k8s.io/client-go/rest\"\n22\t\t\"k8s.io/client-go/tools/cache\"\n23\t\n24\t\tpkg \"github.com/bborbe/agent-task-executor/pkg\"\n25\t\t\"github.com/bborbe/agent-task-executor/pkg/handler\"\n26\t\t\"github.com/bborbe/agent-task-executor/pkg/probe\"\n27\t\t\"github.com/bborbe/agent-task-executor/pkg/spawner\"\n28\t)\n29\t\n30\t// CreateJobWatcher creates a JobWatcher that reacts to terminal batch/v1 Job states.\n31\tfunc CreateJobWatcher(\n32\t\tkubeClient kubernetes.Interface,\n33\t\tnamespace libk8s.Namespace,\n34\t\ttaskStore *pkg.TaskStore,\n35\t\tpublisher pkg.ResultPublisher,\n36\t) pkg.JobWatcher {\n37\t\treturn pkg.NewJobWatcher(kubeClient, namespace, taskStore, publisher)\n38\t}\n39\t\n40\t// CreateZombieSweeper creates a deadline sweeper that classifies stuck tasks as\n41\t// zombies and emits failure events via the publisher. Interval and per-task\n42\t// deadline are sourced from the AgentConfig CRD knobs (see ConfigSpec). The\n43\t// sweeper receives the JobWatcher (not its lister) because the lister is\n44\t// populated only after JobWatcher.Run completes its informer cache sync; passing\n45\t// the watcher lets the sweeper resolve the lister lazily on each tick and skip\n46\t// the tick if cache sync has not yet happened (avoids a nil-deref panic at the\n47\t// first tick when service.Run starts all components concurrently).\n48\tfunc CreateZombieSweeper(\n49\t\tjobWatcher pkg.JobWatcher,\n50\t\tnamespace libk8s.Namespace,\n51\t\ttaskStore *pkg.TaskStore,\n52\t\tpublisher pkg.ResultPublisher,\n53\t\tconfigProvider pkg.EventHandlerConfig,\n54\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n55\t) pkg.ZombieSweeper {\n56\t\treturn pkg.NewZombieSweeper(\n57\t\t\tjobWatcher,\n58\t\t\tnamespace,\n59\t\t\ttaskStore,\n60\t\t\tpublisher,\n61\t\t\tconfigProvider,\n62\t\t\tcurrentDateTime,\n63\t\t)\n64\t}\n65\t\n66\t// CreateK8sConnector returns a K8sConnector wired to the given rest.Config.\n67\tfunc CreateK8sConnector(config *rest.Config) pkg.K8sConnector {\n68\t\treturn pkg.NewK8sConnector(config, pkg.DefaultCRDClientBuilder)\n69\t}\n70\t\n71\t// CreateEventHandlerConfig returns an empty in-memory event handler for Config resources.\n72\tfunc CreateEventHandlerConfig() pkg.EventHandlerConfig {\n73\t\treturn pkg.NewEventHandlerConfig()\n74\t}\n75\t\n76\t// CreateResourceEventHandlerConfig adapts an EventHandlerConfig to cache.ResourceEventHandler.\n77\tfunc CreateResourceEventHandlerConfig(\n78\t\tctx context.Context,\n79\t\thandler pkg.EventHandlerConfig,\n80\t) cache.ResourceEventHandler {\n81\t\treturn pkg.NewResourceEventHandlerConfig(ctx, handler)\n82\t}\n83\t\n84\t// CreateConfigResolver returns a ConfigResolver backed by the given store.\n85\tfunc CreateConfigResolver(\n86\t\thandler pkg.EventHandlerConfig,\n87\t\tbranch base.Branch,\n88\t) pkg.ConfigResolver {\n89\t\treturn pkg.NewConfigResolver(handler, branch)\n90\t}\n91\t\n92\t// CreateConsumer wires together all components and returns a Kafka Consumer that\n93\t// reads task events and spawns K8s Jobs for qualifying tasks, along with the\n94\t// TaskEventHandler so callers can wire RunDeferredRespawnLoop.\n95\tfunc CreateConsumer(\n96\t\tsaramaClient sarama.Client,\n97\t\tbranch base.Branch,\n98\t\ttopicPrefix base.TopicPrefix,\n99\t\tkubeClient kubernetes.Interface,\n100\t\tnamespace libk8s.Namespace,\n101\t\tkafkaBrokers string,\n102\t\tresolver pkg.ConfigResolver,\n103\t\tlogSamplerFactory log.SamplerFactory,\n104\t\tcurrentDateTimeGetter libtime.CurrentDateTimeGetter,\n105\t\tresultPublisher pkg.ResultPublisher,\n106\t\ttaskStore *pkg.TaskStore,\n107\t\tjobTTLSecondsAfterFinished int32,\n108\t\tjobKafkaClientCertSecret string,\n109\t\tjobKafkaCaCertSecret string,\n110\t) (libkafka.Consumer, handler.TaskEventHandler) {\n111\t\tjobSpawner := spawner.NewJobSpawner(\n112\t\t\tkubeClient,\n113\t\t\tnamespace,\n114\t\t\tkafkaBrokers,\n115\t\t\tstring(branch),\n116\t\t\tstring(topicPrefix),\n117\t\t\tcurrentDateTimeGetter,\n118\t\t\tjobTTLSecondsAfterFinished,\n119\t\t\tjobKafkaClientCertSecret,\n120\t\t\tjobKafkaCaCertSecret,\n121\t\t)\n122\t\ttaskEventHandler := handler.NewTaskEventHandler(\n123\t\t\tjobSpawner,\n124\t\t\tbranch,\n125\t\t\tresolver,\n126\t\t\tresultPublisher,\n127\t\t\ttaskStore,\n128\t\t\tcurrentDateTimeGetter,\n129\t\t)\n130\t\ttopic := lib.TaskV1SchemaID.EventTopic(topicPrefix)\n131\t\toffsetManager := libkafka.NewSaramaOffsetManager(\n132\t\t\tsaramaClient,\n133\t\t\tlibkafka.Group(\"agent-task-executor\"),\n134\t\t\tlibkafka.OffsetOldest,\n135\t\t\tlibkafka.OffsetOldest,\n136\t\t)\n137\t\treturn libkafka.NewOffsetConsumerHighwaterMarks(\n138\t\t\tsaramaClient,\n139\t\t\ttopic,\n140\t\t\toffsetManager,\n141\t\t\ttaskEventHandler,\n142\t\t\trun.NewTrigger(),\n143\t\t\tlogSamplerFactory,\n144\t\t), taskEventHandler\n145\t}\n146\t\n147\t// CreateHealthcheckRunner creates the healthcheck runner shared between the cron path and the\n148\t// HTTP trigger path. Callers must pass the same instance to both CreateHealthcheckCron and\n149\t// the HTTP handler so probe behavior is identical regardless of invocation path.\n150\tfunc CreateHealthcheckRunner(\n151\t\tconfigProvider pkg.EventHandlerConfig,\n152\t\tsyncProducer libkafka.SyncProducer,\n153\t\ttopicPrefix base.TopicPrefix,\n154\t\tbranch base.Branch,\n155\t) probe.HealthcheckRunner {\n156\t\tsender := cdb.NewCommandObjectSender(syncProducer, topicPrefix, log.DefaultSamplerFactory)\n157\t\tpublisher := probe.NewCommandPublisher(sender)\n158\t\treturn probe.NewHealthcheckRunner(configProvider, publisher, branch)\n159\t}\n160\t\n161\t// CreateHealthcheckCron wraps the given runner in a cron scheduler. Pass the runner returned by\n162\t// CreateHealthcheckRunner so the cron and the HTTP handler share the same instance.\n163\tfunc CreateHealthcheckCron(\n164\t\texpression libcron.Expression,\n165\t\trunner probe.HealthcheckRunner,\n166\t) pkg.CronScheduler {\n167\t\treturn libcron.NewExpressionCron(expression, runner)\n168\t}\n169\t"}]},"parent_tool_use_id":null,"session_id":"5e174ea2-5d7c-48b5-bba1-218273b235ae","uuid":"edab5b4b-91d1-4c5f-abd4-f887c5caadd4","timestamp":"2026-08-26T20:33:47.045Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/factory/factory.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage factory\n\nimport (\n\t\"context\"\n\n\t\"github.com/IBM/sarama\"\n\tlib \"github.com/bborbe/agent\"\n\t\"github.com/bborbe/cqrs/base\"\n\tcdb \"github.com/bborbe/cqrs/cdb\"\n\tlibcron \"github.com/bborbe/cron\"\n\tlibk8s \"github.com/bborbe/k8s\"\n\tlibkafka \"github.com/bborbe/kafka\"\n\t\"github.com/bborbe/log\"\n\t\"github.com/bborbe/run\"\n\tlibtime \"github.com/bborbe/time\"\n\t\"k8s.io/client-go/kubernetes\"\n\t\"k8s.io/client-go/rest\"\n\t\"k8s.io/client-go/tools/cache\"\n\n\tpkg \"github.com/bborbe/agent-task-executor/pkg\"\n\t\"github.com/bborbe/agent-task-executor/pkg/handler\"\n\t\"github.com/bborbe/agent-task-executor/pkg/probe\"\n\t\"github.com/bborbe/agent-task-executor/pkg/spawner\"\n)\n\n// CreateJobWatcher creates a JobWatcher that reacts to terminal batch/v1 Job states.\nfunc CreateJobWatcher(\n\tkubeClient kubernetes.Interface,\n\tnamespace libk8s.Namespace,\n\ttaskStore *pkg.TaskStore,\n\tpublisher pkg.ResultPublisher,\n) pkg.JobWatcher {\n\treturn pkg.NewJobWatcher(kubeClient, namespace, taskStore, publisher)\n}\n\n// CreateZombieSweeper creates a deadline sweeper that classifies stuck tasks as\n// zombies and emits failure events via the publisher. Interval and per-task\n// deadline are sourced from the AgentConfig CRD knobs (see ConfigSpec). The\n// sweeper receives the JobWatcher (not its lister) because the lister is\n// populated only after JobWatcher.Run completes its informer cache sync; passing\n// the watcher lets the sweeper resolve the lister lazily on each tick and skip\n// the tick if cache sync has not yet happened (avoids a nil-deref panic at the\n// first tick when service.Run starts all components concurrently).\nfunc CreateZombieSweeper(\n\tjobWatcher pkg.JobWatcher,\n\tnamespace libk8s.Namespace,\n\ttaskStore *pkg.TaskStore,\n\tpublisher pkg.ResultPublisher,\n\tconfigProvider pkg.EventHandlerConfig,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n) pkg.ZombieSweeper {\n\treturn pkg.NewZombieSweeper(\n\t\tjobWatcher,\n\t\tnamespace,\n\t\ttaskStore,\n\t\tpublisher,\n\t\tconfigProvider,\n\t\tcurrentDateTime,\n\t)\n}\n\n// CreateK8sConnector returns a K8sConnector wired to the given rest.Config.\nfunc CreateK8sConnector(config *rest.Config) pkg.K8sConnector {\n\treturn pkg.NewK8sConnector(config, pkg.DefaultCRDClientBuilder)\n}\n\n// CreateEventHandlerConfig returns an empty in-memory event handler for Config resources.\nfunc CreateEventHandlerConfig() pkg.EventHandlerConfig {\n\treturn pkg.NewEventHandlerConfig()\n}\n\n// CreateResourceEventHandlerConfig adapts an EventHandlerConfig to cache.ResourceEventHandler.\nfunc CreateResourceEventHandlerConfig(\n\tctx context.Context,\n\thandler pkg.EventHandlerConfig,\n) cache.ResourceEventHandler {\n\treturn pkg.NewResourceEventHandlerConfig(ctx, handler)\n}\n\n// CreateConfigResolver returns a ConfigResolver backed by the given store.\nfunc CreateConfigResolver(\n\thandler pkg.EventHandlerConfig,\n\tbranch base.Branch,\n) pkg.ConfigResolver {\n\treturn pkg.NewConfigResolver(handler, branch)\n}\n\n// CreateConsumer wires together all components and returns a Kafka Consumer that\n// reads task events and spawns K8s Jobs for qualifying tasks, along with the\n// TaskEventHandler so callers can wire RunDeferredRespawnLoop.\nfunc CreateConsumer(\n\tsaramaClient sarama.Client,\n\tbranch base.Branch,\n\ttopicPrefix base.TopicPrefix,\n\tkubeClient kubernetes.Interface,\n\tnamespace libk8s.Namespace,\n\tkafkaBrokers string,\n\tresolver pkg.ConfigResolver,\n\tlogSamplerFactory log.SamplerFactory,\n\tcurrentDateTimeGetter libtime.CurrentDateTimeGetter,\n\tresultPublisher pkg.ResultPublisher,\n\ttaskStore *pkg.TaskStore,\n\tjobTTLSecondsAfterFinished int32,\n\tjobKafkaClientCertSecret string,\n\tjobKafkaCaCertSecret string,\n) (libkafka.Consumer, handler.TaskEventHandler) {\n\tjobSpawner := spawner.NewJobSpawner(\n\t\tkubeClient,\n\t\tnamespace,\n\t\tkafkaBrokers,\n\t\tstring(branch),\n\t\tstring(topicPrefix),\n\t\tcurrentDateTimeGetter,\n\t\tjobTTLSecondsAfterFinished,\n\t\tjobKafkaClientCertSecret,\n\t\tjobKafkaCaCertSecret,\n\t)\n\ttaskEventHandler := handler.NewTaskEventHandler(\n\t\tjobSpawner,\n\t\tbranch,\n\t\tresolver,\n\t\tresultPublisher,\n\t\ttaskStore,\n\t\tcurrentDateTimeGetter,\n\t)\n\ttopic := lib.TaskV1SchemaID.EventTopic(topicPrefix)\n\toffsetManager := libkafka.NewSaramaOffsetManager(\n\t\tsaramaClient,\n\t\tlibkafka.Group(\"agent-task-executor\"),\n\t\tlibkafka.OffsetOldest,\n\t\tlibkafka.OffsetOldest,\n\t)\n\treturn libkafka.NewOffsetConsumerHighwaterMarks(\n\t\tsaramaClient,\n\t\ttopic,\n\t\toffsetManager,\n\t\ttaskEventHandler,\n\t\trun.NewTrigger(),\n\t\tlogSamplerFactory,\n\t), taskEventHandler\n}\n\n// CreateHealthcheckRunner creates the healthcheck runner shared between the cron path and the\n// HTTP trigger path. Callers must pass the same instance to both CreateHealthcheckCron and\n// the HTTP handler so probe behavior is identical regardless of invocation path.\nfunc CreateHealthcheckRunner(\n\tconfigProvider pkg.EventHandlerConfig,\n\tsyncProducer libkafka.SyncProducer,\n\ttopicPrefix base.TopicPrefix,\n\tbranch base.Branch,\n) probe.HealthcheckRunner {\n\tsender := cdb.NewCommandObjectSender(syncProducer, topicPrefix, log.DefaultSamplerFactory)\n\tpublisher := probe.NewCommandPublisher(sender)\n\treturn probe.NewHealthcheckRunner(configProvider, publisher, branch)\n}\n\n// CreateHealthcheckCron wraps the given runner in a cron scheduler. Pass the runner returned by\n// CreateHealthcheckRunner so the cron and the HTTP handler share the same instance.\nfunc CreateHealthcheckCron(\n\texpression libcron.Expression,\n\trunner probe.HealthcheckRunner,\n) pkg.CronScheduler {\n\treturn libcron.NewExpressionCron(expression, runner)\n}\n","numLines":169,"startLine":1,"totalLines":169}}}
