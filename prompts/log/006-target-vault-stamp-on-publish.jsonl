{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-828b9b0b46b246af","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg_test\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"encoding/json\"\n10\t\n11\t\t\"github.com/IBM/sarama\"\n12\t\tlib \"github.com/bborbe/agent\"\n13\t\ttaskcmd \"github.com/bborbe/agent/command/task\"\n14\t\t\"github.com/bborbe/cqrs/base\"\n15\t\t\"github.com/bborbe/errors\"\n16\t\tlibkafka \"github.com/bborbe/kafka\"\n17\t\tlibtime \"github.com/bborbe/time\"\n18\t\tlibtimetest \"github.com/bborbe/time/test\"\n19\t\t. \"github.com/onsi/ginkgo/v2\"\n20\t\t. \"github.com/onsi/gomega\"\n21\t\n22\t\t\"github.com/bborbe/agent-task-executor/pkg\"\n23\t)\n24\t\n25\t// capturingSyncProducer implements libkafka.SyncProducer and records sent messages.\n26\ttype capturingSyncProducer struct {\n27\t\tmessages []*sarama.ProducerMessage\n28\t}\n29\t\n30\tfunc (c *capturingSyncProducer) SendMessage(\n31\t\t_ context.Context,\n32\t\tmsg *sarama.ProducerMessage,\n33\t) (int32, int64, error) {\n34\t\tc.messages = append(c.messages, msg)\n35\t\treturn 0, 0, nil\n36\t}\n37\t\n38\tfunc (c *capturingSyncProducer) SendMessages(\n39\t\t_ context.Context,\n40\t\tmsgs []*sarama.ProducerMessage,\n41\t) error {\n42\t\tc.messages = append(c.messages, msgs...)\n43\t\treturn nil\n44\t}\n45\t\n46\tfunc (c *capturingSyncProducer) Close() error { return nil }\n47\t\n48\tvar _ libkafka.SyncProducer = &capturingSyncProducer{}\n49\t\n50\t// failingSyncProducer implements libkafka.SyncProducer and always returns an error.\n51\ttype failingSyncProducer struct {\n52\t\terr error\n53\t}\n54\t\n55\tfunc (f *failingSyncProducer) SendMessage(\n56\t\t_ context.Context,\n57\t\t_ *sarama.ProducerMessage,\n58\t) (int32, int64, error) {\n59\t\treturn 0, 0, f.err\n60\t}\n61\t\n62\tfunc (f *failingSyncProducer) SendMessages(\n63\t\t_ context.Context,\n64\t\t_ []*sarama.ProducerMessage,\n65\t) error {\n66\t\treturn f.err\n67\t}\n68\t\n69\tfunc (f *failingSyncProducer) Close() error { return nil }\n70\t\n71\tvar _ libkafka.SyncProducer = &failingSyncProducer{}\n72\t\n73\t// partialFailingSyncProducer succeeds for the first `successCount` sends, then\n74\t// returns `err` on every subsequent send. Captures all attempted messages\n75\t// (including the ones that failed) so tests can assert exact send counts.\n76\ttype partialFailingSyncProducer struct {\n77\t\tsuccessCount int\n78\t\tcalls        int\n79\t\terr          error\n80\t\tmessages     []*sarama.ProducerMessage\n81\t}\n82\t\n83\tfunc (p *partialFailingSyncProducer) SendMessage(\n84\t\t_ context.Context,\n85\t\tmsg *sarama.ProducerMessage,\n86\t) (int32, int64, error) {\n87\t\tp.calls++\n88\t\tp.messages = append(p.messages, msg)\n89\t\tif p.calls > p.successCount {\n90\t\t\treturn 0, 0, p.err\n91\t\t}\n92\t\treturn 0, 0, nil\n93\t}\n94\t\n95\tfunc (p *partialFailingSyncProducer) SendMessages(\n96\t\t_ context.Context,\n97\t\tmsgs []*sarama.ProducerMessage,\n98\t) error {\n99\t\tp.calls++\n100\t\tp.messages = append(p.messages, msgs...)\n101\t\tif p.calls > p.successCount {\n102\t\t\treturn p.err\n103\t\t}\n104\t\treturn nil\n105\t}\n106\t\n107\tfunc (p *partialFailingSyncProducer) Close() error { return nil }\n108\t\n109\tvar _ libkafka.SyncProducer = &partialFailingSyncProducer{}\n110\t\n111\t// decodeUpdateFrontmatterCommand extracts the operation and UpdateFrontmatterCommand from a captured message.\n112\tfunc decodeUpdateFrontmatterCommand(\n113\t\tmsg *sarama.ProducerMessage,\n114\t) (base.CommandOperation, taskcmd.UpdateFrontmatterCommand) {\n115\t\traw, err := msg.Value.Encode()\n116\t\tExpect(err).NotTo(HaveOccurred())\n117\t\n118\t\tvar command base.Command\n119\t\tExpect(json.Unmarshal(raw, &command)).To(Succeed())\n120\t\n121\t\t// Re-marshal the Event data and unmarshal into UpdateFrontmatterCommand.\n122\t\tdataBytes, err := json.Marshal(command.Data)\n123\t\tExpect(err).NotTo(HaveOccurred())\n124\t\n125\t\tvar cmd taskcmd.UpdateFrontmatterCommand\n126\t\tExpect(json.Unmarshal(dataBytes, &cmd)).To(Succeed())\n127\t\n128\t\treturn command.Operation, cmd\n129\t}\n130\t\n131\t// decodeIncrementFrontmatterCommand extracts the operation and IncrementFrontmatterCommand from a captured message.\n132\tfunc decodeIncrementFrontmatterCommand(\n133\t\tmsg *sarama.ProducerMessage,\n134\t) (base.CommandOperation, taskcmd.IncrementFrontmatterCommand) {\n135\t\traw, err := msg.Value.Encode()\n136\t\tExpect(err).NotTo(HaveOccurred())\n137\t\n138\t\tvar command base.Command\n139\t\tExpect(json.Unmarshal(raw, &command)).To(Succeed())\n140\t\n141\t\tdataBytes, err := json.Marshal(command.Data)\n142\t\tExpect(err).NotTo(HaveOccurred())\n143\t\n144\t\tvar cmd taskcmd.IncrementFrontmatterCommand\n145\t\tExpect(json.Unmarshal(dataBytes, &cmd)).To(Succeed())\n146\t\n147\t\treturn command.Operation, cmd\n148\t}\n149\t\n150\tvar _ = Describe(\"ResultPublisher\", func() {\n151\t\tvar (\n152\t\t\tctx             context.Context\n153\t\t\tpublisher       pkg.ResultPublisher\n154\t\t\tcurrentDateTime libtime.CurrentDateTime\n155\t\t\tproducer        *capturingSyncProducer\n156\t\t)\n157\t\n158\t\tBeforeEach(func() {\n159\t\t\tctx = context.Background()\n160\t\t\tcurrentDateTime = libtime.NewCurrentDateTime()\n161\t\t\tcurrentDateTime.SetNow(libtimetest.ParseDateTime(\"2026-04-18T12:00:00Z\"))\n162\t\t\tproducer = &capturingSyncProducer{}\n163\t\t\tpublisher = pkg.NewResultPublisher(\n164\t\t\t\tproducer,\n165\t\t\t\tbase.TopicPrefix(\"develop\"),\n166\t\t\t\tcurrentDateTime,\n167\t\t\t)\n168\t\t})\n169\t\n170\t\tDescribe(\"PublishSpawnNotification\", func() {\n171\t\t\tIt(\"sends exactly three keys via UpdateFrontmatterCommand\", func() {\n172\t\t\t\ttask := lib.Task{\n173\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-1\"),\n174\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n175\t\t\t\t\t\t\"status\":        \"in_progress\",\n176\t\t\t\t\t\t\"phase\":         \"ai_review\",\n177\t\t\t\t\t\t\"assignee\":      \"claude\",\n178\t\t\t\t\t\t\"trigger_count\": 1,\n179\t\t\t\t\t},\n180\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n181\t\t\t\t}\n182\t\t\t\terr := publisher.PublishSpawnNotification(ctx, task, \"claude-20260418120000\")\n183\t\t\t\tExpect(err).NotTo(HaveOccurred())\n184\t\n185\t\t\t\tExpect(producer.messages).To(HaveLen(1))\n186\t\t\t\toperation, cmd := decodeUpdateFrontmatterCommand(producer.messages[0])\n187\t\n188\t\t\t\tExpect(string(operation)).To(Equal(string(taskcmd.UpdateFrontmatterCommandOperation)))\n189\t\t\t\tExpect(cmd.Updates).To(HaveLen(3))\n190\t\n191\t\t\t\tExpect(cmd.Updates[\"spawn_notification\"]).To(Equal(true))\n192\t\t\t\tExpect(cmd.Updates[\"current_job\"]).To(Equal(\"claude-20260418120000\"))\n193\t\t\t\tExpect(cmd.Updates[\"job_started_at\"]).To(Equal(\"2026-04-18T12:00:00Z\"))\n194\t\n195\t\t\t\t_, hasTriggerCount := cmd.Updates[\"trigger_count\"]\n196\t\t\t\tExpect(hasTriggerCount).To(BeFalse(), \"trigger_count must not be in spawn notification\")\n197\t\t\t\t_, hasStatus := cmd.Updates[\"status\"]\n198\t\t\t\tExpect(hasStatus).To(BeFalse(), \"status must not be in spawn notification\")\n199\t\t\t\t_, hasPhase := cmd.Updates[\"phase\"]\n200\t\t\t\tExpect(hasPhase).To(BeFalse(), \"phase must not be in spawn notification\")\n201\t\t\t})\n202\t\t})\n203\t\n204\t\tDescribe(\"PublishFailure\", func() {\n205\t\t\tIt(\n206\t\t\t\t\"publishes two commands: UpdateFrontmatterCommand clearing current_job with ## Failure body, then IncrementFrontmatterCommand bumping trigger_count\",\n207\t\t\t\tfunc() {\n208\t\t\t\t\ttask := lib.Task{\n209\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-2\"),\n210\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n211\t\t\t\t\t\t\t\"status\":        \"in_progress\",\n212\t\t\t\t\t\t\t\"phase\":         \"ai_review\",\n213\t\t\t\t\t\t\t\"assignee\":      \"claude\",\n214\t\t\t\t\t\t\t\"trigger_count\": 2,\n215\t\t\t\t\t\t},\n216\t\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n217\t\t\t\t\t}\n218\t\t\t\t\terr := publisher.PublishFailure(\n219\t\t\t\t\t\tctx,\n220\t\t\t\t\t\ttask,\n221\t\t\t\t\t\t\"claude-20260418120000\",\n222\t\t\t\t\t\t\"pod OOM killed\",\n223\t\t\t\t\t)\n224\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n225\t\n226\t\t\t\t\tExpect(producer.messages).To(HaveLen(2))\n227\t\n228\t\t\t\t\t// First message: UpdateFrontmatterCommand\n229\t\t\t\t\toperation, updateCmd := decodeUpdateFrontmatterCommand(producer.messages[0])\n230\t\t\t\t\tExpect(\n231\t\t\t\t\t\tstring(operation),\n232\t\t\t\t\t).To(Equal(string(taskcmd.UpdateFrontmatterCommandOperation)))\n233\t\t\t\t\tExpect(updateCmd.Updates).To(HaveLen(1))\n234\t\t\t\t\tExpect(updateCmd.Updates[\"current_job\"]).To(Equal(\"\"))\n235\t\n236\t\t\t\t\t_, hasStatus := updateCmd.Updates[\"status\"]\n237\t\t\t\t\tExpect(hasStatus).To(BeFalse(), \"status must not be in failure update\")\n238\t\t\t\t\t_, hasPhase := updateCmd.Updates[\"phase\"]\n239\t\t\t\t\tExpect(hasPhase).To(BeFalse(), \"phase must not be in failure update\")\n240\t\t\t\t\t_, hasAssignee := updateCmd.Updates[\"assignee\"]\n241\t\t\t\t\tExpect(hasAssignee).To(BeFalse(), \"assignee must not be in failure update\")\n242\t\t\t\t\t_, hasPreviousAssignee := updateCmd.Updates[\"previous_assignee\"]\n243\t\t\t\t\tExpect(\n244\t\t\t\t\t\thasPreviousAssignee,\n245\t\t\t\t\t).To(BeFalse(), \"previous_assignee must not be in failure update\")\n246\t\t\t\t\t_, hasTriggerCount := updateCmd.Updates[\"trigger_count\"]\n247\t\t\t\t\tExpect(hasTriggerCount).To(BeFalse(), \"trigger_count must not be in failure update\")\n248\t\n249\t\t\t\t\tExpect(updateCmd.Body).NotTo(BeNil())\n250\t\t\t\t\tExpect(updateCmd.Body.Heading).To(Equal(\"## Failure\"))\n251\t\t\t\t\tExpect(updateCmd.Body.Section).To(ContainSubstring(\"2026-04-18T12:00:00Z\"))\n252\t\t\t\t\tExpect(updateCmd.Body.Section).To(ContainSubstring(\"claude-20260418120000\"))\n253\t\t\t\t\tExpect(updateCmd.Body.Section).To(ContainSubstring(\"pod OOM killed\"))\n254\t\n255\t\t\t\t\t// Second message: IncrementFrontmatterCommand\n256\t\t\t\t\tincOperation, incCmd := decodeIncrementFrontmatterCommand(producer.messages[1])\n257\t\t\t\t\tExpect(\n258\t\t\t\t\t\tstring(incOperation),\n259\t\t\t\t\t).To(Equal(string(taskcmd.IncrementFrontmatterCommandOperation)))\n260\t\t\t\t\tExpect(string(incCmd.TaskIdentifier)).To(Equal(\"test-task-2\"))\n261\t\t\t\t\tExpect(incCmd.Field).To(Equal(\"trigger_count\"))\n262\t\t\t\t\tExpect(incCmd.Delta).To(Equal(1))\n263\t\t\t\t},\n264\t\t\t)\n265\t\t})\n266\t\n267\t\tDescribe(\"PublishFailure dedupe\", func() {\n268\t\t\tIt(\"suppresses a second call with the same job name\", func() {\n269\t\t\t\ttask := lib.Task{\n270\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-dedupe\"),\n271\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n272\t\t\t\t\t\t\"status\": \"in_progress\",\n273\t\t\t\t\t},\n274\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n275\t\t\t\t}\n276\t\n277\t\t\t\terr := publisher.PublishFailure(ctx, task, \"claude-20260418120000\", \"pod OOM killed\")\n278\t\t\t\tExpect(err).NotTo(HaveOccurred())\n279\t\t\t\tExpect(producer.messages).To(HaveLen(2))\n280\t\n281\t\t\t\terr = publisher.PublishFailure(ctx, task, \"claude-20260418120000\", \"pod OOM killed\")\n282\t\t\t\tExpect(err).NotTo(HaveOccurred())\n283\t\t\t\tExpect(producer.messages).To(HaveLen(2), \"second call should be deduped\")\n284\t\t\t})\n285\t\n286\t\t\tIt(\n287\t\t\t\t\"does NOT record dedupe when increment publish fails, so next cycle retries both messages\",\n288\t\t\t\tfunc() {\n289\t\t\t\t\tpartialProducer := &partialFailingSyncProducer{\n290\t\t\t\t\t\tsuccessCount: 1, // first send (update) succeeds, second (increment) fails\n291\t\t\t\t\t\terr:          errors.New(context.Background(), \"kafka: leader not available\"),\n292\t\t\t\t\t}\n293\t\t\t\t\tpartialPublisher := pkg.NewResultPublisher(\n294\t\t\t\t\t\tpartialProducer,\n295\t\t\t\t\t\tbase.TopicPrefix(\"develop\"),\n296\t\t\t\t\t\tcurrentDateTime,\n297\t\t\t\t\t)\n298\t\n299\t\t\t\t\ttask := lib.Task{\n300\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-partial\"),\n301\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n302\t\t\t\t\t\t\t\"status\": \"in_progress\",\n303\t\t\t\t\t\t},\n304\t\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n305\t\t\t\t\t}\n306\t\n307\t\t\t\t\t// First call: update commits, increment fails — caller sees the increment error.\n308\t\t\t\t\terr := partialPublisher.PublishFailure(\n309\t\t\t\t\t\tctx,\n310\t\t\t\t\t\ttask,\n311\t\t\t\t\t\t\"claude-20260418120000\",\n312\t\t\t\t\t\t\"pod OOM killed\",\n313\t\t\t\t\t)\n314\t\t\t\t\tExpect(err).To(HaveOccurred())\n315\t\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"trigger_count increment\"))\n316\t\t\t\t\tExpect(\n317\t\t\t\t\t\tpartialProducer.messages,\n318\t\t\t\t\t).To(HaveLen(2), \"both update and increment were attempted\")\n319\t\n320\t\t\t\t\t// Second call with the same jobName: dedupe must NOT suppress it,\n321\t\t\t\t\t// because the increment failed last time. The publish is attempted\n322\t\t\t\t\t// again — verified by the producer recording at least one more\n323\t\t\t\t\t// message (this producer's state means the update also fails on\n324\t\t\t\t\t// the retry, but the key invariant is: not deduped to zero sends).\n325\t\t\t\t\terr = partialPublisher.PublishFailure(\n326\t\t\t\t\t\tctx,\n327\t\t\t\t\t\ttask,\n328\t\t\t\t\t\t\"claude-20260418120000\",\n329\t\t\t\t\t\t\"pod OOM killed\",\n330\t\t\t\t\t)\n331\t\t\t\t\tExpect(err).To(HaveOccurred())\n332\t\t\t\t\tExpect(\n333\t\t\t\t\t\tlen(partialProducer.messages),\n334\t\t\t\t\t).To(BeNumerically(\">\", 2), \"second call must re-attempt publishing (not deduped)\")\n335\t\t\t\t},\n336\t\t\t)\n337\t\n338\t\t\tIt(\n339\t\t\t\t\"allows re-send after dedupeTTL expires\",\n340\t\t\t\tfunc() {\n341\t\t\t\t\ttask := lib.Task{\n342\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-ttl\"),\n343\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n344\t\t\t\t\t\t\t\"status\": \"in_progress\",\n345\t\t\t\t\t\t},\n346\t\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n347\t\t\t\t\t}\n348\t\n349\t\t\t\t\terr := publisher.PublishFailure(\n350\t\t\t\t\t\tctx,\n351\t\t\t\t\t\ttask,\n352\t\t\t\t\t\t\"claude-20260418120000\",\n353\t\t\t\t\t\t\"pod OOM killed\",\n354\t\t\t\t\t)\n355\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n356\t\t\t\t\tExpect(producer.messages).To(HaveLen(2))\n357\t\n358\t\t\t\t\t// Advance past dedupeTTL (3600s).\n359\t\t\t\t\tcurrentDateTime.SetNow(libtimetest.ParseDateTime(\"2026-04-18T13:00:01Z\"))\n360\t\n361\t\t\t\t\terr = publisher.PublishFailure(\n362\t\t\t\t\t\tctx,\n363\t\t\t\t\t\ttask,\n364\t\t\t\t\t\t\"claude-20260418120000\",\n365\t\t\t\t\t\t\"pod OOM killed\",\n366\t\t\t\t\t)\n367\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n368\t\t\t\t\tExpect(\n369\t\t\t\t\t\tproducer.messages,\n370\t\t\t\t\t).To(HaveLen(4), \"second call after TTL expiry must publish both messages again\")\n371\t\t\t\t},\n372\t\t\t)\n373\t\n374\t\t\tIt(\n375\t\t\t\t\"does NOT record dedupe when the first (update) publish fails and does not attempt the increment\",\n376\t\t\t\tfunc() {\n377\t\t\t\t\t// successCount: 0 — first send (update) fails immediately.\n378\t\t\t\t\tpartialProducer := &partialFailingSyncProducer{\n379\t\t\t\t\t\tsuccessCount: 0,\n380\t\t\t\t\t\terr:          errors.New(context.Background(), \"kafka: leader not available\"),\n381\t\t\t\t\t}\n382\t\t\t\t\tpartialPublisher := pkg.NewResultPublisher(\n383\t\t\t\t\t\tpartialProducer,\n384\t\t\t\t\t\tbase.TopicPrefix(\"develop\"),\n385\t\t\t\t\t\tcurrentDateTime,\n386\t\t\t\t\t)\n387\t\n388\t\t\t\t\ttask := lib.Task{\n389\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-first-fail\"),\n390\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n391\t\t\t\t\t\t\t\"status\": \"in_progress\",\n392\t\t\t\t\t\t},\n393\t\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n394\t\t\t\t\t}\n395\t\n396\t\t\t\t\terr := partialPublisher.PublishFailure(\n397\t\t\t\t\t\tctx,\n398\t\t\t\t\t\ttask,\n399\t\t\t\t\t\t\"claude-20260418120000\",\n400\t\t\t\t\t\t\"pod OOM killed\",\n401\t\t\t\t\t)\n402\t\t\t\t\tExpect(err).To(HaveOccurred())\n403\t\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"zombie failure update\"))\n404\t\t\t\t\tExpect(\n405\t\t\t\t\t\tpartialProducer.messages,\n406\t\t\t\t\t).To(HaveLen(1), \"only the update was attempted; increment must not run after update fails\")\n407\t\n408\t\t\t\t\t// Verify dedupe was NOT recorded: second call attempts publishing again.\n409\t\t\t\t\terr = partialPublisher.PublishFailure(\n410\t\t\t\t\t\tctx,\n411\t\t\t\t\t\ttask,\n412\t\t\t\t\t\t\"claude-20260418120000\",\n413\t\t\t\t\t\t\"pod OOM killed\",\n414\t\t\t\t\t)\n415\t\t\t\t\tExpect(err).To(HaveOccurred())\n416\t\t\t\t\tExpect(\n417\t\t\t\t\t\tpartialProducer.messages,\n418\t\t\t\t\t).To(HaveLen(2), \"second call re-attempts the update (dedupe was not recorded)\")\n419\t\t\t\t},\n420\t\t\t)\n421\t\t})\n422\t\n423\t\tDescribe(\"PublishTypeMismatchFailure\", func() {\n424\t\t\tIt(\n425\t\t\t\t\"publishes assignee='', previous_assignee=<prior>, current_job='' and Assignee bullet in body\",\n426\t\t\t\tfunc() {\n427\t\t\t\t\ttask := lib.Task{\n428\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-3\"),\n429\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n430\t\t\t\t\t\t\t\"status\":   \"in_progress\",\n431\t\t\t\t\t\t\t\"phase\":    \"planning\",\n432\t\t\t\t\t\t\t\"assignee\": \"agent-pr-reviewer\",\n433\t\t\t\t\t\t},\n434\t\t\t\t\t}\n435\t\t\t\t\terr := publisher.PublishTypeMismatchFailure(\n436\t\t\t\t\t\tctx,\n437\t\t\t\t\t\ttask,\n438\t\t\t\t\t\t`task_type \"healthcheck\" not in effective set [pr-review] of agent \"agent-pr-reviewer\"`,\n439\t\t\t\t\t)\n440\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n441\t\n442\t\t\t\t\tExpect(producer.messages).To(HaveLen(1))\n443\t\t\t\t\toperation, cmd := decodeUpdateFrontmatterCommand(producer.messages[0])\n444\t\n445\t\t\t\t\tExpect(\n446\t\t\t\t\t\tstring(operation),\n447\t\t\t\t\t).To(Equal(string(taskcmd.UpdateFrontmatterCommandOperation)))\n448\t\t\t\t\tExpect(cmd.Updates).To(HaveLen(3))\n449\t\t\t\t\tExpect(cmd.Updates[\"assignee\"]).To(Equal(\"\"))\n450\t\t\t\t\tExpect(cmd.Updates[\"previous_assignee\"]).To(Equal(\"agent-pr-reviewer\"))\n451\t\t\t\t\tExpect(cmd.Updates[\"current_job\"]).To(Equal(\"\"))\n452\t\n453\t\t\t\t\t_, hasStatus := cmd.Updates[\"status\"]\n454\t\t\t\t\tExpect(hasStatus).To(BeFalse(), \"status must not be in type mismatch update\")\n455\t\t\t\t\t_, hasPhase := cmd.Updates[\"phase\"]\n456\t\t\t\t\tExpect(hasPhase).To(BeFalse(), \"phase must not be in type mismatch update\")\n457\t\t\t\t\t_, hasTriggerCount := cmd.Updates[\"trigger_count\"]\n458\t\t\t\t\tExpect(\n459\t\t\t\t\t\thasTriggerCount,\n460\t\t\t\t\t).To(BeFalse(), \"trigger_count must not be in type mismatch update\")\n461\t\n462\t\t\t\t\tExpect(cmd.Body).NotTo(BeNil())\n463\t\t\t\t\tExpect(cmd.Body.Heading).To(Equal(\"## Failure\"))\n464\t\t\t\t\tExpect(cmd.Body.Section).To(ContainSubstring(\"2026-04-18T12:00:00Z\"))\n465\t\t\t\t\tExpect(cmd.Body.Section).To(ContainSubstring(\"agent-pr-reviewer\"))\n466\t\t\t\t\tExpect(cmd.Body.Section).To(ContainSubstring(\"healthcheck\"))\n467\t\t\t\t},\n468\t\t\t)\n469\t\n470\t\t\tIt(\n471\t\t\t\t\"omits previous_assignee when prior assignee is empty\",\n472\t\t\t\tfunc() {\n473\t\t\t\t\ttask := lib.Task{\n474\t\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-empty-assignee\"),\n475\t\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n476\t\t\t\t\t\t\t\"status\":   \"in_progress\",\n477\t\t\t\t\t\t\t\"phase\":    \"planning\",\n478\t\t\t\t\t\t\t\"assignee\": \"\",\n479\t\t\t\t\t\t},\n480\t\t\t\t\t}\n481\t\t\t\t\terr := publisher.PublishTypeMismatchFailure(\n482\t\t\t\t\t\tctx,\n483\t\t\t\t\t\ttask,\n484\t\t\t\t\t\t\"reason=type_mismatch\",\n485\t\t\t\t\t)\n486\t\t\t\t\tExpect(err).NotTo(HaveOccurred())\n487\t\n488\t\t\t\t\tExpect(producer.messages).To(HaveLen(1))\n489\t\t\t\t\t_, cmd := decodeUpdateFrontmatterCommand(producer.messages[0])\n490\t\n491\t\t\t\t\tExpect(cmd.Updates).To(HaveLen(2))\n492\t\t\t\t\tExpect(cmd.Updates[\"assignee\"]).To(Equal(\"\"))\n493\t\t\t\t\tExpect(cmd.Updates[\"current_job\"]).To(Equal(\"\"))\n494\t\n495\t\t\t\t\t_, hasPreviousAssignee := cmd.Updates[\"previous_assignee\"]\n496\t\t\t\t\tExpect(\n497\t\t\t\t\t\thasPreviousAssignee,\n498\t\t\t\t\t).To(BeFalse(), \"previous_assignee must be omitted when prior assignee is empty\")\n499\t\n500\t\t\t\t\tExpect(cmd.Body).NotTo(BeNil())\n501\t\t\t\t\tExpect(cmd.Body.Section).To(ContainSubstring(\"reason=type_mismatch\"))\n502\t\t\t\t},\n503\t\t\t)\n504\t\t})\n505\t\n506\t\tDescribe(\"PublishIncrementTriggerCount\", func() {\n507\t\t\tIt(\"sends IncrementFrontmatterCommand with trigger_count and delta 1\", func() {\n508\t\t\t\ttask := lib.Task{\n509\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-4\"),\n510\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n511\t\t\t\t\t\t\"status\":        \"in_progress\",\n512\t\t\t\t\t\t\"phase\":         \"planning\",\n513\t\t\t\t\t\t\"trigger_count\": 0,\n514\t\t\t\t\t},\n515\t\t\t\t}\n516\t\t\t\terr := publisher.PublishIncrementTriggerCount(ctx, task)\n517\t\t\t\tExpect(err).NotTo(HaveOccurred())\n518\t\n519\t\t\t\tExpect(producer.messages).To(HaveLen(1))\n520\t\t\t\toperation, cmd := decodeIncrementFrontmatterCommand(producer.messages[0])\n521\t\n522\t\t\t\tExpect(\n523\t\t\t\t\tstring(operation),\n524\t\t\t\t).To(Equal(string(taskcmd.IncrementFrontmatterCommandOperation)))\n525\t\t\t\tExpect(string(cmd.TaskIdentifier)).To(Equal(\"test-task-4\"))\n526\t\t\t\tExpect(cmd.Field).To(Equal(\"trigger_count\"))\n527\t\t\t\tExpect(cmd.Delta).To(Equal(1))\n528\t\t\t})\n529\t\n530\t\t\tIt(\"returns error when sender fails\", func() {\n531\t\t\t\tfailingProducer := &failingSyncProducer{\n532\t\t\t\t\terr: errors.New(context.Background(), \"kafka: leader not available\"),\n533\t\t\t\t}\n534\t\t\t\tfailingPublisher := pkg.NewResultPublisher(\n535\t\t\t\t\tfailingProducer,\n536\t\t\t\t\tbase.TopicPrefix(\"develop\"),\n537\t\t\t\t\tcurrentDateTime,\n538\t\t\t\t)\n539\t\n540\t\t\t\ttask := lib.Task{\n541\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-5\"),\n542\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n543\t\t\t\t\t\t\"status\": \"in_progress\",\n544\t\t\t\t\t},\n545\t\t\t\t}\n546\t\t\t\terr := failingPublisher.PublishIncrementTriggerCount(ctx, task)\n547\t\t\t\tExpect(err).To(HaveOccurred())\n548\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"kafka: leader not available\"))\n549\t\t\t})\n550\t\n551\t\t\tIt(\"handles empty task identifier gracefully\", func() {\n552\t\t\t\ttask := lib.Task{\n553\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"\"),\n554\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n555\t\t\t\t\t\t\"status\": \"in_progress\",\n556\t\t\t\t\t},\n557\t\t\t\t}\n558\t\t\t\terr := publisher.PublishIncrementTriggerCount(ctx, task)\n559\t\t\t\tExpect(err).NotTo(HaveOccurred())\n560\t\n561\t\t\t\tExpect(producer.messages).To(HaveLen(1))\n562\t\t\t\t_, cmd := decodeIncrementFrontmatterCommand(producer.messages[0])\n563\t\n564\t\t\t\tExpect(string(cmd.TaskIdentifier)).To(Equal(\"\"))\n565\t\t\t\tExpect(cmd.Field).To(Equal(\"trigger_count\"))\n566\t\t\t\tExpect(cmd.Delta).To(Equal(1))\n567\t\t\t})\n568\t\t})\n569\t\n570\t\tDescribe(\"PublishRaw\", func() {\n571\t\t\tIt(\"returns wrapped error when base.ParseEvent fails\", func() {\n572\t\t\t\t// Pass an invalid JSON string to cause ParseEvent to fail\n573\t\t\t\tinvalidJSON := \"{not valid json\"\n574\t\t\t\terr := publisher.PublishRaw(ctx, taskcmd.UpdateFrontmatterCommandOperation, invalidJSON)\n575\t\t\t\tExpect(err).To(HaveOccurred())\n576\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"parse event for operation\"))\n577\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"update-frontmatter\"))\n578\t\t\t})\n579\t\t})\n580\t})\n581\t"}]},"parent_tool_use_id":null,"session_id":"27c31813-4fbc-4635-b058-58a84dc80d27","uuid":"46888ff3-d149-4b10-b27f-d09a8f73a9f9","timestamp":"2026-09-03T17:20:58.343Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/result_publisher_test.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage pkg_test\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\n\t\"github.com/IBM/sarama\"\n\tlib \"github.com/bborbe/agent\"\n\ttaskcmd \"github.com/bborbe/agent/command/task\"\n\t\"github.com/bborbe/cqrs/base\"\n\t\"github.com/bborbe/errors\"\n\tlibkafka \"github.com/bborbe/kafka\"\n\tlibtime \"github.com/bborbe/time\"\n\tlibtimetest \"github.com/bborbe/time/test\"\n\t. \"github.com/onsi/ginkgo/v2\"\n\t. \"github.com/onsi/gomega\"\n\n\t\"github.com/bborbe/agent-task-executor/pkg\"\n)\n\n// capturingSyncProducer implements libkafka.SyncProducer and records sent messages.\ntype capturingSyncProducer struct {\n\tmessages []*sarama.ProducerMessage\n}\n\nfunc (c *capturingSyncProducer) SendMessage(\n\t_ context.Context,\n\tmsg *sarama.ProducerMessage,\n) (int32, int64, error) {\n\tc.messages = append(c.messages, msg)\n\treturn 0, 0, nil\n}\n\nfunc (c *capturingSyncProducer) SendMessages(\n\t_ context.Context,\n\tmsgs []*sarama.ProducerMessage,\n) error {\n\tc.messages = append(c.messages, msgs...)\n\treturn nil\n}\n\nfunc (c *capturingSyncProducer) Close() error { return nil }\n\nvar _ libkafka.SyncProducer = &capturingSyncProducer{}\n\n// failingSyncProducer implements libkafka.SyncProducer and always returns an error.\ntype failingSyncProducer struct {\n\terr error\n}\n\nfunc (f *failingSyncProducer) SendMessage(\n\t_ context.Context,\n\t_ *sarama.ProducerMessage,\n) (int32, int64, error) {\n\treturn 0, 0, f.err\n}\n\nfunc (f *failingSyncProducer) SendMessages(\n\t_ context.Context,\n\t_ []*sarama.ProducerMessage,\n) error {\n\treturn f.err\n}\n\nfunc (f *failingSyncProducer) Close() error { return nil }\n\nvar _ libkafka.SyncProducer = &failingSyncProducer{}\n\n// partialFailingSyncProducer succeeds for the first `successCount` sends, then\n// returns `err` on every subsequent send. Captures all attempted messages\n// (including the ones that failed) so tests can assert exact send counts.\ntype partialFailingSyncProducer struct {\n\tsuccessCount int\n\tcalls        int\n\terr          error\n\tmessages     []*sarama.ProducerMessage\n}\n\nfunc (p *partialFailingSyncProducer) SendMessage(\n\t_ context.Context,\n\tmsg *sarama.ProducerMessage,\n) (int32, int64, error) {\n\tp.calls++\n\tp.messages = append(p.messages, msg)\n\tif p.calls > p.successCount {\n\t\treturn 0, 0, p.err\n\t}\n\treturn 0, 0, nil\n}\n\nfunc (p *partialFailingSyncProducer) SendMessages(\n\t_ context.Context,\n\tmsgs []*sarama.ProducerMessage,\n) error {\n\tp.calls++\n\tp.messages = append(p.messages, msgs...)\n\tif p.calls > p.successCount {\n\t\treturn p.err\n\t}\n\treturn nil\n}\n\nfunc (p *partialFailingSyncProducer) Close() error { return nil }\n\nvar _ libkafka.SyncProducer = &partialFailingSyncProducer{}\n\n// decodeUpdateFrontmatterCommand extracts the operation and UpdateFrontmatterCommand from a captured message.\nfunc decodeUpdateFrontmatterCommand(\n\tmsg *sarama.ProducerMessage,\n) (base.CommandOperation, taskcmd.UpdateFrontmatterCommand) {\n\traw, err := msg.Value.Encode()\n\tExpect(err).NotTo(HaveOccurred())\n\n\tvar command base.Command\n\tExpect(json.Unmarshal(raw, &command)).To(Succeed())\n\n\t// Re-marshal the Event data and unmarshal into UpdateFrontmatterCommand.\n\tdataBytes, err := json.Marshal(command.Data)\n\tExpect(err).NotTo(HaveOccurred())\n\n\tvar cmd taskcmd.UpdateFrontmatterCommand\n\tExpect(json.Unmarshal(dataBytes, &cmd)).To(Succeed())\n\n\treturn command.Operation, cmd\n}\n\n// decodeIncrementFrontmatterCommand extracts the operation and IncrementFrontmatterCommand from a captured message.\nfunc decodeIncrementFrontmatterCommand(\n\tmsg *sarama.ProducerMessage,\n) (base.CommandOperation, taskcmd.IncrementFrontmatterCommand) {\n\traw, err := msg.Value.Encode()\n\tExpect(err).NotTo(HaveOccurred())\n\n\tvar command base.Command\n\tExpect(json.Unmarshal(raw, &command)).To(Succeed())\n\n\tdataBytes, err := json.Marshal(command.Data)\n\tExpect(err).NotTo(HaveOccurred())\n\n\tvar cmd taskcmd.IncrementFrontmatterCommand\n\tExpect(json.Unmarshal(dataBytes, &cmd)).To(Succeed())\n\n\treturn command.Operation, cmd\n}\n\nvar _ = Describe(\"ResultPublisher\", func() {\n\tvar (\n\t\tctx             context.Context\n\t\tpublisher       pkg.ResultPublisher\n\t\tcurrentDateTime libtime.CurrentDateTime\n\t\tproducer        *capturingSyncProducer\n\t)\n\n\tBeforeEach(func() {\n\t\tctx = context.Background()\n\t\tcurrentDateTime = libtime.NewCurrentDateTime()\n\t\tcurrentDateTime.SetNow(libtimetest.ParseDateTime(\"2026-04-18T12:00:00Z\"))\n\t\tproducer = &capturingSyncProducer{}\n\t\tpublisher = pkg.NewResultPublisher(\n\t\t\tproducer,\n\t\t\tbase.TopicPrefix(\"develop\"),\n\t\t\tcurrentDateTime,\n\t\t)\n\t})\n\n\tDescribe(\"PublishSpawnNotification\", func() {\n\t\tIt(\"sends exactly three keys via UpdateFrontmatterCommand\", func() {\n\t\t\ttask := lib.Task{\n\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-1\"),\n\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n\t\t\t\t\t\"status\":        \"in_progress\",\n\t\t\t\t\t\"phase\":         \"ai_review\",\n\t\t\t\t\t\"assignee\":      \"claude\",\n\t\t\t\t\t\"trigger_count\": 1,\n\t\t\t\t},\n\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n\t\t\t}\n\t\t\terr := publisher.PublishSpawnNotification(ctx, task, \"claude-20260418120000\")\n\t\t\tExpect(err).NotTo(HaveOccurred())\n\n\t\t\tExpect(producer.messages).To(HaveLen(1))\n\t\t\toperation, cmd := decodeUpdateFrontmatterCommand(producer.messages[0])\n\n\t\t\tExpect(string(operation)).To(Equal(string(taskcmd.UpdateFrontmatterCommandOperation)))\n\t\t\tExpect(cmd.Updates).To(HaveLen(3))\n\n\t\t\tExpect(cmd.Updates[\"spawn_notification\"]).To(Equal(true))\n\t\t\tExpect(cmd.Updates[\"current_job\"]).To(Equal(\"claude-20260418120000\"))\n\t\t\tExpect(cmd.Updates[\"job_started_at\"]).To(Equal(\"2026-04-18T12:00:00Z\"))\n\n\t\t\t_, hasTriggerCount := cmd.Updates[\"trigger_count\"]\n\t\t\tExpect(hasTriggerCount).To(BeFalse(), \"trigger_count must not be in spawn notification\")\n\t\t\t_, hasStatus := cmd.Updates[\"status\"]\n\t\t\tExpect(hasStatus).To(BeFalse(), \"status must not be in spawn notification\")\n\t\t\t_, hasPhase := cmd.Updates[\"phase\"]\n\t\t\tExpect(hasPhase).To(BeFalse(), \"phase must not be in spawn notification\")\n\t\t})\n\t})\n\n\tDescribe(\"PublishFailure\", func() {\n\t\tIt(\n\t\t\t\"publishes two commands: UpdateFrontmatterCommand clearing current_job with ## Failure body, then IncrementFrontmatterCommand bumping trigger_count\",\n\t\t\tfunc() {\n\t\t\t\ttask := lib.Task{\n\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-2\"),\n\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n\t\t\t\t\t\t\"status\":        \"in_progress\",\n\t\t\t\t\t\t\"phase\":         \"ai_review\",\n\t\t\t\t\t\t\"assignee\":      \"claude\",\n\t\t\t\t\t\t\"trigger_count\": 2,\n\t\t\t\t\t},\n\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n\t\t\t\t}\n\t\t\t\terr := publisher.PublishFailure(\n\t\t\t\t\tctx,\n\t\t\t\t\ttask,\n\t\t\t\t\t\"claude-20260418120000\",\n\t\t\t\t\t\"pod OOM killed\",\n\t\t\t\t)\n\t\t\t\tExpect(err).NotTo(HaveOccurred())\n\n\t\t\t\tExpect(producer.messages).To(HaveLen(2))\n\n\t\t\t\t// First message: UpdateFrontmatterCommand\n\t\t\t\toperation, updateCmd := decodeUpdateFrontmatterCommand(producer.messages[0])\n\t\t\t\tExpect(\n\t\t\t\t\tstring(operation),\n\t\t\t\t).To(Equal(string(taskcmd.UpdateFrontmatterCommandOperation)))\n\t\t\t\tExpect(updateCmd.Updates).To(HaveLen(1))\n\t\t\t\tExpect(updateCmd.Updates[\"current_job\"]).To(Equal(\"\"))\n\n\t\t\t\t_, hasStatus := updateCmd.Updates[\"status\"]\n\t\t\t\tExpect(hasStatus).To(BeFalse(), \"status must not be in failure update\")\n\t\t\t\t_, hasPhase := updateCmd.Updates[\"phase\"]\n\t\t\t\tExpect(hasPhase).To(BeFalse(), \"phase must not be in failure update\")\n\t\t\t\t_, hasAssignee := updateCmd.Updates[\"assignee\"]\n\t\t\t\tExpect(hasAssignee).To(BeFalse(), \"assignee must not be in failure update\")\n\t\t\t\t_, hasPreviousAssignee := updateCmd.Updates[\"previous_assignee\"]\n\t\t\t\tExpect(\n\t\t\t\t\thasPreviousAssignee,\n\t\t\t\t).To(BeFalse(), \"previous_assignee must not be in failure update\")\n\t\t\t\t_, hasTriggerCount := updateCmd.Updates[\"trigger_count\"]\n\t\t\t\tExpect(hasTriggerCount).To(BeFalse(), \"trigger_count must not be in failure update\")\n\n\t\t\t\tExpect(updateCmd.Body).NotTo(BeNil())\n\t\t\t\tExpect(updateCmd.Body.Heading).To(Equal(\"## Failure\"))\n\t\t\t\tExpect(updateCmd.Body.Section).To(ContainSubstring(\"2026-04-18T12:00:00Z\"))\n\t\t\t\tExpect(updateCmd.Body.Section).To(ContainSubstring(\"claude-20260418120000\"))\n\t\t\t\tExpect(updateCmd.Body.Section).To(ContainSubstring(\"pod OOM killed\"))\n\n\t\t\t\t// Second message: IncrementFrontmatterCommand\n\t\t\t\tincOperation, incCmd := decodeIncrementFrontmatterCommand(producer.messages[1])\n\t\t\t\tExpect(\n\t\t\t\t\tstring(incOperation),\n\t\t\t\t).To(Equal(string(taskcmd.IncrementFrontmatterCommandOperation)))\n\t\t\t\tExpect(string(incCmd.TaskIdentifier)).To(Equal(\"test-task-2\"))\n\t\t\t\tExpect(incCmd.Field).To(Equal(\"trigger_count\"))\n\t\t\t\tExpect(incCmd.Delta).To(Equal(1))\n\t\t\t},\n\t\t)\n\t})\n\n\tDescribe(\"PublishFailure dedupe\", func() {\n\t\tIt(\"suppresses a second call with the same job name\", func() {\n\t\t\ttask := lib.Task{\n\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-dedupe\"),\n\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n\t\t\t\t\t\"status\": \"in_progress\",\n\t\t\t\t},\n\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n\t\t\t}\n\n\t\t\terr := publisher.PublishFailure(ctx, task, \"claude-20260418120000\", \"pod OOM killed\")\n\t\t\tExpect(err).NotTo(HaveOccurred())\n\t\t\tExpect(producer.messages).To(HaveLen(2))\n\n\t\t\terr = publisher.PublishFailure(ctx, task, \"claude-20260418120000\", \"pod OOM killed\")\n\t\t\tExpect(err).NotTo(HaveOccurred())\n\t\t\tExpect(producer.messages).To(HaveLen(2), \"second call should be deduped\")\n\t\t})\n\n\t\tIt(\n\t\t\t\"does NOT record dedupe when increment publish fails, so next cycle retries both messages\",\n\t\t\tfunc() {\n\t\t\t\tpartialProducer := &partialFailingSyncProducer{\n\t\t\t\t\tsuccessCount: 1, // first send (update) succeeds, second (increment) fails\n\t\t\t\t\terr:          errors.New(context.Background(), \"kafka: leader not available\"),\n\t\t\t\t}\n\t\t\t\tpartialPublisher := pkg.NewResultPublisher(\n\t\t\t\t\tpartialProducer,\n\t\t\t\t\tbase.TopicPrefix(\"develop\"),\n\t\t\t\t\tcurrentDateTime,\n\t\t\t\t)\n\n\t\t\t\ttask := lib.Task{\n\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-partial\"),\n\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n\t\t\t\t\t\t\"status\": \"in_progress\",\n\t\t\t\t\t},\n\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n\t\t\t\t}\n\n\t\t\t\t// First call: update commits, increment fails — caller sees the increment error.\n\t\t\t\terr := partialPublisher.PublishFailure(\n\t\t\t\t\tctx,\n\t\t\t\t\ttask,\n\t\t\t\t\t\"claude-20260418120000\",\n\t\t\t\t\t\"pod OOM killed\",\n\t\t\t\t)\n\t\t\t\tExpect(err).To(HaveOccurred())\n\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"trigger_count increment\"))\n\t\t\t\tExpect(\n\t\t\t\t\tpartialProducer.messages,\n\t\t\t\t).To(HaveLen(2), \"both update and increment were attempted\")\n\n\t\t\t\t// Second call with the same jobName: dedupe must NOT suppress it,\n\t\t\t\t// because the increment failed last time. The publish is attempted\n\t\t\t\t// again — verified by the producer recording at least one more\n\t\t\t\t// message (this producer's state means the update also fails on\n\t\t\t\t// the retry, but the key invariant is: not deduped to zero sends).\n\t\t\t\terr = partialPublisher.PublishFailure(\n\t\t\t\t\tctx,\n\t\t\t\t\ttask,\n\t\t\t\t\t\"claude-20260418120000\",\n\t\t\t\t\t\"pod OOM killed\",\n\t\t\t\t)\n\t\t\t\tExpect(err).To(HaveOccurred())\n\t\t\t\tExpect(\n\t\t\t\t\tlen(partialProducer.messages),\n\t\t\t\t).To(BeNumerically(\">\", 2), \"second call must re-attempt publishing (not deduped)\")\n\t\t\t},\n\t\t)\n\n\t\tIt(\n\t\t\t\"allows re-send after dedupeTTL expires\",\n\t\t\tfunc() {\n\t\t\t\ttask := lib.Task{\n\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-ttl\"),\n\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n\t\t\t\t\t\t\"status\": \"in_progress\",\n\t\t\t\t\t},\n\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n\t\t\t\t}\n\n\t\t\t\terr := publisher.PublishFailure(\n\t\t\t\t\tctx,\n\t\t\t\t\ttask,\n\t\t\t\t\t\"claude-20260418120000\",\n\t\t\t\t\t\"pod OOM killed\",\n\t\t\t\t)\n\t\t\t\tExpect(err).NotTo(HaveOccurred())\n\t\t\t\tExpect(producer.messages).To(HaveLen(2))\n\n\t\t\t\t// Advance past dedupeTTL (3600s).\n\t\t\t\tcurrentDateTime.SetNow(libtimetest.ParseDateTime(\"2026-04-18T13:00:01Z\"))\n\n\t\t\t\terr = publisher.PublishFailure(\n\t\t\t\t\tctx,\n\t\t\t\t\ttask,\n\t\t\t\t\t\"claude-20260418120000\",\n\t\t\t\t\t\"pod OOM killed\",\n\t\t\t\t)\n\t\t\t\tExpect(err).NotTo(HaveOccurred())\n\t\t\t\tExpect(\n\t\t\t\t\tproducer.messages,\n\t\t\t\t).To(HaveLen(4), \"second call after TTL expiry must publish both messages again\")\n\t\t\t},\n\t\t)\n\n\t\tIt(\n\t\t\t\"does NOT record dedupe when the first (update) publish fails and does not attempt the increment\",\n\t\t\tfunc() {\n\t\t\t\t// successCount: 0 — first send (update) fails immediately.\n\t\t\t\tpartialProducer := &partialFailingSyncProducer{\n\t\t\t\t\tsuccessCount: 0,\n\t\t\t\t\terr:          errors.New(context.Background(), \"kafka: leader not available\"),\n\t\t\t\t}\n\t\t\t\tpartialPublisher := pkg.NewResultPublisher(\n\t\t\t\t\tpartialProducer,\n\t\t\t\t\tbase.TopicPrefix(\"develop\"),\n\t\t\t\t\tcurrentDateTime,\n\t\t\t\t)\n\n\t\t\t\ttask := lib.Task{\n\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-first-fail\"),\n\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n\t\t\t\t\t\t\"status\": \"in_progress\",\n\t\t\t\t\t},\n\t\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n\t\t\t\t}\n\n\t\t\t\terr := partialPublisher.PublishFailure(\n\t\t\t\t\tctx,\n\t\t\t\t\ttask,\n\t\t\t\t\t\"claude-20260418120000\",\n\t\t\t\t\t\"pod OOM killed\",\n\t\t\t\t)\n\t\t\t\tExpect(err).To(HaveOccurred())\n\t\t\t\tExpect(err.Error()).To(ContainSubstring(\"zombie failure update\"))\n\t\t\t\tExpect(\n\t\t\t\t\tpartialProducer.messages,\n\t\t\t\t).To(HaveLen(1), \"only the update was attempted; increment must not run after update fails\")\n\n\t\t\t\t// Verify dedupe was NOT recorded: second call attempts publishing again.\n\t\t\t\terr = partialPublisher.PublishFailure(\n\t\t\t\t\tctx,\n\t\t\t\t\ttask,\n\t\t\t\t\t\"claude-20260418120000\",\n\t\t\t\t\t\"pod OOM killed\",\n\t\t\t\t)\n\t\t\t\tExpect(err).To(HaveOccurred())\n\t\t\t\tExpect(\n\t\t\t\t\tpartialProducer.messages,\n\t\t\t\t).To(HaveLen(2), \"second call re-attempts the update (dedupe was not recorded)\")\n\t\t\t},\n\t\t)\n\t})\n\n\tDescribe(\"PublishTypeMismatchFailure\", func() {\n\t\tIt(\n\t\t\t\"publishes assignee='', previous_assignee=<prior>, current_job='' and Assignee bullet in body\",\n\t\t\tfunc() {\n\t\t\t\ttask := lib.Task{\n\t\t\t\t\tTaskIdentifier: lib.TaskIdentifier(\"test-task-3\"),\n\t\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n\t\t\t\t\t\t\"status\":   \"in_progress\",\n\t\t\t\t\t\t\"phase\":    \"planning\",\n\t\t\t\t\t\t\"assignee\": \"agent-pr-reviewer\",\n\t\t\t\t\t},\n\t\t\t\t}\n\t\t\t\terr := publisher.PublishTypeMismatchFailure(\n\t\t\t\t\tctx,\n\t\t\t\t\ttask,\n\t\t\t\t\t`task_type \"healthcheck\" not in effective set [pr-review] of agent \"agent-pr-reviewer\"`,\n\t\t\t\t)\n\t\t\t\tExpect(err).NotTo(HaveOccurred())\n\n\t\t\t\tExpect(producer.messages).To(HaveLen(1))\n\t\t\t\toperation, cmd := decodeUpdateFrontmatterCommand(producer.messages[0])\n\n\t\t\t\tExpect(\n\t\t