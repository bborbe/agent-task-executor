tter.Status(),\n299\t\t\t)\n300\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_status\").Inc()\n301\t\t\treturn lib.Task{}, nil, true, nil\n302\t\t}\n303\t\n304\t\tphase := task.Frontmatter.Phase()\n305\t\t// terminal phases must not be spawned again — operator escalation required\n306\t\tif phase != nil && applyPhaseGate(task, *phase) {\n307\t\t\th.removeDeferredEntry(task.TaskIdentifier)\n308\t\t\treturn lib.Task{}, nil, true, nil\n309\t\t}\n310\t\tif phase == nil || !effectiveTriggerPhases(config).Contains(*phase) {\n311\t\t\tglog.V(3).Infof(\"skip task %s with phase %v\", task.TaskIdentifier, phase)\n312\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_phase\").Inc()\n313\t\t\treturn lib.Task{}, nil, true, nil\n314\t\t}\n315\t\n316\t\tstage := task.Frontmatter.Stage()\n317\t\tif stage != string(h.branch) {\n318\t\t\tglog.V(3).Infof(\n319\t\t\t\t\"skip task %s with stage %s (executor branch %s)\",\n320\t\t\t\ttask.TaskIdentifier, stage, h.branch,\n321\t\t\t)\n322\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_stage\").Inc()\n323\t\t\treturn lib.Task{}, nil, true, nil\n324\t\t}\n325\t\n326\t\tif task.Frontmatter.Assignee() == \"\" {\n327\t\t\tglog.V(3).Infof(\"skip task %s with empty assignee\", task.TaskIdentifier)\n328\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_assignee\").Inc()\n329\t\t\treturn lib.Task{}, nil, true, nil\n330\t\t}\n331\t\n332\t\treturn task, config, false, nil\n333\t}\n334\t\n335\t// resolveConfig looks up the agent Config CR for the task's assignee.\n336\t// Returns (nil, false, nil) when assignee is empty (caller handles the empty-assignee path).\n337\t// Returns (nil, true, nil) when the assignee is unknown (ErrConfigNotFound).\n338\t// Returns (nil, false, err) on unexpected resolver errors.\n339\tfunc (h *taskEventHandler) resolveConfig(\n340\t\tctx context.Context,\n341\t\ttask lib.Task,\n342\t) (*pkg.AgentConfiguration, bool, error) {\n343\t\tif task.Frontmatter.Assignee() == \"\" {\n344\t\t\treturn nil,