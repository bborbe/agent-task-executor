{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-b1eaee77ba651090","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage handler_test\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\n10\t\tlib \"github.com/bborbe/agent\"\n11\t\t\"github.com/bborbe/cqrs/base\"\n12\t\t\"github.com/bborbe/errors\"\n13\t\tlibtime \"github.com/bborbe/time\"\n14\t\t\"github.com/bborbe/vault-cli/pkg/domain\"\n15\t\t. \"github.com/onsi/ginkgo/v2\"\n16\t\t. \"github.com/onsi/gomega\"\n17\t\t\"github.com/prometheus/client_golang/prometheus/testutil\"\n18\t\t\"gopkg.in/yaml.v3\"\n19\t\n20\t\t\"github.com/bborbe/agent-task-executor/mocks\"\n21\t\tpkg \"github.com/bborbe/agent-task-executor/pkg\"\n22\t\t\"github.com/bborbe/agent-task-executor/pkg/handler\"\n23\t\t\"github.com/bborbe/agent-task-executor/pkg/metrics\"\n24\t)\n25\t\n26\tvar _ = Describe(\"TaskEventHandler reconcile loop\", func() {\n27\t\tvar (\n28\t\t\tctx                 context.Context\n29\t\t\tfakeSpawner         *mocks.FakeJobSpawner\n30\t\t\tfakeResolver        *mocks.FakeConfigResolver\n31\t\t\tfakeResultPublisher *mocks.FakeResultPublisher\n32\t\t\tfakeGitRestClient   *mocks.FakeGitRestClient\n33\t\t\ttaskStore           *pkg.TaskStore\n34\t\t\tcurrentDateTime     libtime.CurrentDateTime\n35\t\t\th                   handler.TaskEventHandler\n36\t\t)\n37\t\n38\t\t// renderTaskFile serializes a task into the vault markdown shape the\n39\t\t// reconcile loop parses (frontmatter delimited by \"---\", body after).\n40\t\trenderTaskFile := func(task lib.Task) string {\n41\t\t\tfm := make(map[string]any, len(task.Frontmatter)+1)\n42\t\t\tfor k, v := range task.Frontmatter {\n43\t\t\t\tfm[k] = v\n44\t\t\t}\n45\t\t\tfm[\"task_identifier\"] = string(task.TaskIdentifier)\n46\t\t\tout, err := yaml.Marshal(fm)\n47\t\t\tExpect(err).To(BeNil())\n48\t\t\treturn \"---\\n\" + string(out) + \"---\\n# Task body\\n\"\n49\t\t}\n50\t\n51\t\tBeforeEach(func() {\n52\t\t\tctx = context.Background()\n53\t\t\tfakeSpawner = new(mocks.FakeJobSpawner)\n54\t\t\tfakeResolver = &mocks.FakeConfigResolver{}\n55\t\t\tfakeResolver.ResolveReturns(\n56\t\t\t\tpkg.AgentConfiguration{Assignee: \"claude\", Image: \"my-image:latest\"},\n57\t\t\t\tnil,\n58\t\t\t)\n59\t\t\tfakeResultPublisher = &mocks.FakeResultPublisher{}\n60\t\t\tfakeGitRestClient = &mocks.FakeGitRestClient{}\n61\t\t\tfakeGitRestClient.IsReadyReturns(true, nil)\n62\t\t\ttaskStore = pkg.NewTaskStore()\n63\t\t\tcurrentDateTime = libtime.NewCurrentDateTime()\n64\t\t\th = handler.NewTaskEventHandler(\n65\t\t\t\tfakeSpawner,\n66\t\t\t\tbase.Branch(\"prod\"),\n67\t\t\t\tfakeResolver,\n68\t\t\t\tfakeResultPublisher,\n69\t\t\t\ttaskStore,\n70\t\t\t\tcurrentDateTime,\n71\t\t\t\tfakeGitRestClient,\n72\t\t\t\t\"24 Tasks/*.md\",\n73\t\t\t)\n74\t\t})\n75\t\n76\t\t// eligibleTask builds a task that passes every reconcile eligibility gate:\n77\t\t// status in_progress, phase in the default trigger set, assignee set, stage\n78\t\t// matching the executor branch, no current_job key (the shape a concurrency-cap\n79\t\t// deferral leaves in the vault).\n80\t\teligibleTask := func(phase domain.TaskPhase) lib.Task {\n81\t\t\treturn lib.Task{\n82\t\t\t\tTaskIdentifier: \"tid-a\",\n83\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n84\t\t\t\t\t\"status\":   \"in_progress\",\n85\t\t\t\t\t\"phase\":    string(phase),\n86\t\t\t\t\t\"assignee\": \"claude\",\n87\t\t\t\t\t\"stage\":    \"prod\",\n88\t\t\t\t},\n89\t\t\t}\n90\t\t}\n91\t\n92\t\tIt(\"re-drives an eligible task from the vault (AC 1)\", func() {\n93\t\t\tfakeGitRestClient.ListReturns([]string{\"24 Tasks/tid-a.md\"}, nil)\n94\t\t\tfakeGitRestClient.GetReturns(\n95\t\t\t\t[]byte(renderTaskFile(eligibleTask(domain.TaskPhasePlanning))),\n96\t\t\t\tnil,\n97\t\t\t)\n98\t\t\tfakeSpawner.IsJobActiveReturns(false, nil)\n99\t\n100\t\t\tbefore := testutil.ToFloat64(metrics.ReconcileRedrivenTotal)\n101\t\t\terr := h.ReconcileOnce(ctx)\n102\t\t\tExpect(err).To(BeNil())\n103\t\t\tExpect(fakeSpawner.SpawnJobCallCount()).To(Equal(1))\n104\t\t\tExpect(testutil.ToFloat64(metrics.ReconcileRedrivenTotal)).To(Equal(before + 1))\n105\t\t})\n106\t\n107\t\tIt(\"recovers a deferred task after a restart with an empty task store (AC 2)\", func() {\n108\t\t\t// Simulate the post-restart wipe: a fresh empty store, and a vault task in\n109\t\t\t// the shape deferIfAtConcurrencyCap leaves behind — status in_progress,\n110\t\t\t// phase execution, no current_job key — with no Kafka event driving it.\n111\t\t\ttask := eligibleTask(domain.TaskPhaseExecution)\n112\t\t\tfakeGitRestClient.ListReturns([]string{\"24 Tasks/tid-a.md\"}, nil)\n113\t\t\tfakeGitRestClient.GetReturns([]byte(renderTaskFile(task)), nil)\n114\t\t\tfakeSpawner.IsJobActiveReturns(false, nil)\n115\t\n116\t\t\tExpect(taskStore.Snapshot()).To(BeEmpty())\n117\t\n118\t\t\tbefore := testutil.ToFloat64(metrics.ReconcileRedrivenTotal)\n119\t\t\terr := h.ReconcileOnce(ctx)\n120\t\t\tExpect(err).To(BeNil())\n121\t\t\tExpect(fakeSpawner.SpawnJobCallCount()).To(Equal(1))\n122\t\t\tExpect(testutil.ToFloat64(metrics.ReconcileRedrivenTotal)).To(Equal(before + 1))\n123\t\t})\n124\t\n125\t\tDescribeTable(\"skips ineligible tasks — SpawnJob not called (AC 3)\",\n126\t\t\tfunc(task lib.Task, setup func()) {\n127\t\t\t\tif setup != nil {\n128\t\t\t\t\tsetup()\n129\t\t\t\t}\n130\t\t\t\tfakeGitRestClient.ListReturns([]string{\"24 Tasks/tid-a.md\"}, nil)\n131\t\t\t\tfakeGitRestClient.GetReturns([]byte(renderTaskFile(task)), nil)\n132\t\t\t\terr := h.ReconcileOnce(ctx)\n133\t\t\t\tExpect(err).To(BeNil())\n134\t\t\t\tExpect(fakeSpawner.SpawnJobCallCount()).To(Equal(0))\n135\t\t\t},\n136\t\t\tEntry(\"status todo (not in_progress)\", lib.Task{\n137\t\t\t\tTaskIdentifier: \"tid-a\",\n138\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n139\t\t\t\t\t\"status\":   \"todo\",\n140\t\t\t\t\t\"phase\":    string(domain.TaskPhaseExecution),\n141\t\t\t\t\t\"assignee\": \"claude\",\n142\t\t\t\t\t\"stage\":    \"prod\",\n143\t\t\t\t},\n144\t\t\t}, nil),\n145\t\t\tEntry(\"phase todo (not in default trigger set)\", lib.Task{\n146\t\t\t\tTaskIdentifier: \"tid-a\",\n147\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n148\t\t\t\t\t\"status\":   \"in_progress\",\n149\t\t\t\t\t\"phase\":    \"todo\",\n150\t\t\t\t\t\"assignee\": \"claude\",\n151\t\t\t\t\t\"stage\":    \"prod\",\n152\t\t\t\t},\n153\t\t\t}, nil),\n154\t\t\tEntry(\"phase human_review (terminal)\", lib.Task{\n155\t\t\t\tTaskIdentifier: \"tid-a\",\n156\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n157\t\t\t\t\t\"status\":   \"in_progress\",\n158\t\t\t\t\t\"phase\":    string(domain.TaskPhaseHumanReview),\n159\t\t\t\t\t\"assignee\": \"claude\",\n160\t\t\t\t\t\"stage\":    \"prod\",\n161\t\t\t\t},\n162\t\t\t}, nil),\n163\t\t\tEntry(\"empty assignee (assignee key absent)\", lib.Task{\n164\t\t\t\tTaskIdentifier: \"tid-a\",\n165\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n166\t\t\t\t\t\"status\": \"in_progress\",\n167\t\t\t\t\t\"phase\":  string(domain.TaskPhaseExecution),\n168\t\t\t\t\t\"stage\":  \"prod\",\n169\t\t\t\t},\n170\t\t\t}, nil),\n171\t\t\tEntry(\"unresolvable config\", lib.Task{\n172\t\t\t\tTaskIdentifier: \"tid-a\",\n173\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n174\t\t\t\t\t\"status\":   \"in_progress\",\n175\t\t\t\t\t\"phase\":    string(domain.TaskPhaseExecution),\n176\t\t\t\t\t\"assignee\": \"claude\",\n177\t\t\t\t\t\"stage\":    \"prod\",\n178\t\t\t\t},\n179\t\t\t}, func() {\n180\t\t\t\tfakeResolver.ResolveReturns(pkg.AgentConfiguration{}, pkg.ErrConfigNotFound)\n181\t\t\t}),\n182\t\t\tEntry(\"live Job already active\", lib.Task{\n183\t\t\t\tTaskIdentifier: \"tid-a\",\n184\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n185\t\t\t\t\t\"status\":   \"in_progress\",\n186\t\t\t\t\t\"phase\":    string(domain.TaskPhaseExecution),\n187\t\t\t\t\t\"assignee\": \"claude\",\n188\t\t\t\t\t\"stage\":    \"prod\",\n189\t\t\t\t},\n190\t\t\t