{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-ac603a85f909503e","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"time\"\n10\t\n11\t\tlib \"github.com/bborbe/agent\"\n12\t\t\"github.com/bborbe/errors\"\n13\t\tlibk8s \"github.com/bborbe/k8s\"\n14\t\tlibtime \"github.com/bborbe/time\"\n15\t\t\"github.com/golang/glog\"\n16\t\tcorev1 \"k8s.io/api/core/v1\"\n17\t\t\"k8s.io/apimachinery/pkg/labels\"\n18\t\tcorev1listers \"k8s.io/client-go/listers/core/v1\"\n19\t\n20\t\tagentv1 \"github.com/bborbe/agent-task-executor/k8s/apis/agent.benjamin-borbe.de/v1\"\n21\t)\n22\t\n23\t//counterfeiter:generate -o ../mocks/zombie_sweeper.go --fake-name FakeZombieSweeper . ZombieSweeper\n24\t\n25\t// ZombieSweeper is a background goroutine that periodically classifies stuck\n26\t// tasks as zombies and emits failure events. It is the safety net for the\n27\t// informer-driven paths in JobWatcher (which handle the cases k8s notifies us\n28\t// about). The sweeper handles: pods unschedulable beyond a grace window,\n29\t// executor restart losing watch on a Job, and any deadline path the informer\n30\t// misses (Job-condition deferred indefinitely, informer cache drift).\n31\ttype ZombieSweeper interface {\n32\t\t// Run blocks until ctx is cancelled. Each tick (interval sourced from the\n33\t\t// first non-nil ConfigSpec.ZombieSweeperIntervalSeconds across the resolver's\n34\t\t// configs, else DefaultZombieSweeperIntervalSeconds) it calls SweepOnce.\n35\t\tRun(ctx context.Context) error\n36\t\t// SweepOnce performs a single sweep pass. Exposed for unit tests so they\n37\t\t// do not have to manage tickers. Returns an error only on context\n38\t\t// cancellation paths; per-task classification errors are logged.\n39\t\tSweepOnce(ctx context.Context) error\n40\t}\n41\t\n42\t// NewZombieSweeper creates a ZombieSweeper. The JobWatcher is held by reference\n43\t// (not its lister) because the lister is only populated after JobWatcher.Run\n44\t// completes its cache sync; service.Run starts all components concurrently, so\n45\t// extracting the lister at wiring time would capture nil. SweepOnce resolves\n46\t// the lister lazily on every tick and skips the tick if it is not yet ready.\n47\tfunc NewZombieSweeper(\n48\t\tjobWatcher JobWatcher,\n49\t\tnamespace libk8s.Namespace,\n50\t\ttaskStore *TaskStore,\n51\t\tpublisher ResultPublisher,\n52\t\tconfigProvider EventHandlerConfig,\n53\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n54\t) ZombieSweeper {\n55\t\treturn &zombieSweeper{\n56\t\t\tjobWatcher:      jobWatcher,\n57\t\t\tnamespace:       namespace,\n58\t\t\ttaskStore:       taskStore,\n59\t\t\tpublisher:       publisher,\n60\t\t\tconfigProvider:  configProvider,\n61\t\t\tcurrentDateTime: currentDateTime,\n62\t\t}\n63\t}\n64\t\n65\ttype zombieSweeper struct {\n66\t\tjobWatcher      JobWatcher\n67\t\tnamespace       libk8s.Namespace\n68\t\ttaskStore       *TaskStore\n69\t\tpublisher       ResultPublisher\n70\t\tconfigProvider  EventHandlerConfig\n71\t\tcurrentDateTime libtime.CurrentDateTimeGetter\n72\t}\n73\t\n74\tconst (\n75\t\t// podNotScheduledGraceWindow is the age threshold past which a Pending Pod\n76\t\t// with PodScheduled=False is classified pod_not_scheduled. Must exceed\n77\t\t// typical scheduler latency comfortably; 2 minutes is empirically generous.\n78\t\tpodNotScheduledGraceWindow = 2 * time.Minute\n79\t)\n80\t\n81\t// NOTE on \"no recent heartbeat\" from spec DB #9 / AC #6:\n82\t// The spec predicate is `elapsed > deadline AND pod not Running AND no recent\n83\t// heartbeat`. This codebase has NO separate heartbeat channel today — the only\n84\t// liveness signal for a running job is \"is a Pod currently Running?\". Therefore\n85\t// \"no recent heartbeat\" is implemented as \"no Pod in PodRunning phase observed\n86\t// for this task\". If a per-job heartbeat is added later (a follow-up spec),\n87\t// this predicate gets a real check; for now `classify` treats `pod not Running`\n88\t// as covering both halves of the conjunction.\n89\t\n90\tfunc (s *zombieSweeper) Run(ctx context.Context) error {\n91\t\t// Interval is resolved once at startup. CRD changes to ZombieSweeperIntervalSeconds\n92\t\t// take effect only after pod restart. Acceptable because executor pods are short-lived\n93\t\t// relative to CRD reconciliation cycles.\n94\t\tinterval, err := s.resolveSweeperInterval(ctx)\n95\t\tif err != nil {\n96\t\t\treturn errors.Wrapf(ctx, err, \"resolve sweeper interval\")\n97\t\t}\n98\t\tticker := time.NewTicker(interval)\n99\t\tdefer ticker.Stop()\n100\t\tglog.V(2).Infof(\"zombie sweeper started interval=%s\", interval)\n101\t\tfor {\n102\t\t\tselect {\n103\t\t\tcase <-ctx.Done():\n104\t\t\t\treturn nil\n105\t\t\tcase <-ticker.C:\n106\t\t\t\tif err := s.SweepOnce(ctx); err != nil {\n107\t\t\t\t\t// Per-tick failures (transient lister errors, ctx-scoped\n108\t\t\t\t\t// failures from publisher) must NOT kill the sweeper goroutine\n109\t\t\t\t\t// — that would tear down the executor via service.Run. Log and\n110\t\t\t\t\t// continue.\n111\t\t\t\t\tglog.Errorf(\"zombie sweeper tick: %v\", err)\n112\t\t\t\t}\n113\t\t\t}\n114\t\t}\n115\t}\n116\t\n117\tfunc (s *zombieSweeper) SweepOnce(ctx context.Context) error {\n118\t\t// Resolve the Pod lister lazily — JobWatcher.Run populates it only after\n119\t\t// the informer cache has synced, and service.Run starts all components\n120\t\t// concurrently. If the lister is not yet available, skip this tick rather\n121\t\t// than publishing spurious failures.\n122\t\tlister := s.jobWatcher.PodLister()\n123\t\tif lister == nil {\n124\t\t\tglog.V(2).Infof(\"sweep skipped: pod lister not yet synced\")\n125\t\t\treturn nil\n126\t\t}\n127\t\tsnapshot := s.taskStore.Snapshot()\n128\t\tnow := s.currentDateTime.Now().Time()\n129\t\t// Fetch configs ONCE per tick — used by taskDeadline() for every task in\n130\t\t// the snapshot. Avoids N calls into the provider per sweep.\n131\t\tcfgs, err := s.configProvider.Get(ctx)\n132\t\tif err != nil {\n133\t\t\treturn errors.Wrapf(ctx, err, \"list configs\")\n134\t\t}\n135\t\tfor taskID, task := range snapshot {\n136\t\t\tjobName := task.Frontmatter.CurrentJob()\n137\t\t\tif jobName == \"\" {\n138\t\t\t\t// No active job recorded; nothing to sweep.\n139\t\t\t\tcontinue\n140\t\t\t}\n141\t\t\tjobStartedAt, err := task.Frontmatter.JobStartedAt()\n142\t\t\tif err != nil || jobStartedAt.IsZero() {\n143\t\t\t\tglog.V(3).Infof(\n144\t\t\t\t\t\"zombie sweeper: task %s job_started_at unparseable or zero; skipping\",\n145\t\t\t\t\ttaskID,\n146\t\t\t\t)\n147\t\t\t\tcontinue\n148\t\t\t}\n149\t\t\tdeadline := s.taskDeadline(task, cfgs)\n150\t\t\telapsed := now.Sub(jobStartedAt)\n151\t\t\tif elapsed < deadline {\n152\t\t\t\tcontinue\n153\t\t\t}\n154\t\t\treason := s.classify(lister, taskID, now)\n155\t\t\tif reason == \"\" {\n156\t\t\t\tcontinue\n157\t\t\t}\n158\t\t\tif err := s.publisher.PublishFailure(ctx, task, jobName, reason.String()); err != nil {\n159\t\t\t\tglog.Errorf(\n160\t\t\t\t\t\"zombie sweeper: publish failure for task %s (job %s reason %s): %v\",\n161\t\t\t\t\ttaskID, jobName, reason, err,\n162\t\t\t\t)\n163\t\t\t\tcontinue\n164\t\t\t}\n165\t\t\tglog.V(2).Infof(\n166\t\t\t\t\"zombie sweeper: published failure for task %s (job %s reason %s elapsed=%s)\",\n167\t\t\t\ttaskID, jobName, reason, elapsed,\n168\t\t\t)\n169\t\t}\n170\t\treturn nil\n171\t}\n172\t\n173\tfunc (s *zombieSweeper) taskDeadline(task lib.Task, cfgs []agentv1.Config) time.Duration {\n174\t\tassignee := task.Frontmatter.Assignee().String()\n175\t\tfor _, cfg := range cfgs {\n176\t\t\tif cfg.Spec.Assignee == assignee && cfg.Spec.ZombieJobTimeoutSeconds != nil {\n177\t\t\t\treturn time.Duration(*cfg.Spec.ZombieJobTimeoutSeconds) * time.Second\n178\t\t\t}\n179\t\t}\n180\t\treturn time.Duration(agentv1.DefaultZombieJobTimeoutSeconds) * time.Second\n181\t}\n182\t\n183\tfunc (s *zombieSweeper) resolveSweeperInterval(ctx context.Context) (time.Duration, error) {\n184\t\tcfgs, err := s.configProvider.Get(ctx)\n185\t\tif err != nil {\n186\t\t\treturn 0, errors.Wrapf(ctx, err, \"list configs\")\n187\t\t}\n188\t\tfor _, cfg := range cfgs {\n189\t\t\tif cfg.Spec.ZombieSweeperIntervalSeconds != nil {\n190\t\t\t\treturn time.Duration(*cfg.Spec.ZombieSweeperIntervalSeconds) * time.Second, nil\n191\t\t\t}\n192\t\t}\n193\t\treturn time.Duration(agentv1.DefaultZombieSweeperIntervalSeconds) * time.Second, nil\n194\t}\n195\t\n196\t// classify determines whether a past-deadline task is a zombie and which\n197\t// reason applies. Returns \"\" when the task is NOT a zombie (Pod still Running\n198\t// — implicit heartbeat). Inspects Pod state via the shared Pod informer's\n199\t// lister (introduced by prompt 2). Spec Failure-Mode row \"k8s API rate-limit\n200\t// (429)\" mandates: \"Sweeper relies on informer cache (no per-cycle list)\" —\n201\t// we MUST NOT issue API LIST calls here.\n202\tfunc (s *zombieSweeper) classify(\n203\t\tlister corev1listers.PodLister,\n204\t\ttaskID lib.TaskIdentifier,\n205\t\tnow time.Time,\n206\t) ZombieReason {\n207\t\tselector := labels.SelectorFromSet(labels.Set{\n208\t\t\t\"agent.benjamin-borbe.de/task-id\": string(taskID),\n209\t\t})\n210\t\tpods, err := lister.Pods(s.namespace.String()).List(selector)\n211\t\tif err != nil {\n212\t\t\tglog.Errorf(\"zombie sweeper: lister pods for task %s: %v\", taskID, err)\n213\t\t\treturn \"\"\n214\t\t}\n215\t\t// Zero pods AND past-deadline AND a Job was supposed to be running →\n216\t\t// executor lost the watch (Job exists in k8s but Pod GC happened, or the\n217\t\t// Job never created a Pod and was restarted across executor lifetimes).\n218\t\t// \"No recent heartbeat\" reduces to \"no Pod observed\" since this codebase\n219\t\t// has no separate heartbeat channel.\n220\t\tif len(pods) == 0 {\n221\t\t\treturn ZombieReasonExecutorWatchLost\n222\t\t}\n223\t\tfor _, pod := range pods {\n224\t\t\t// Healthy Running — NOT a zombie. A Running pod is the implicit\n225\t\t\t// heartbeat in the current system (no separate heartbeat channel).\n226\t\t\tif pod.Status.Phase == corev1.PodRunning {\n227\t\t\t\treturn \"\"\n228\t\t\t}\n229\t\t\t// Pending past the unschedulable grace window with PodScheduled=False.\n230\t\t\tif pod.Status.Phase == corev1.PodPending {\n231\t\t\t\tage := now.Sub(pod.CreationTimestamp.Time)\n232\t\t\t\tif age > podNotScheduledGraceWindow && hasPodScheduledFalse(pod) {\n233\t\t\t\t\treturn ZombieReasonPodNotScheduled\n234\t\t\t\t}\n235\t\t\t}\n236\t\t}\n237\t\t// Past deadline, no Running pod, no specific Pod-state reason — fall\n238\t\t// back to deadline_exceeded.\n239\t\treturn ZombieReasonDeadlineExceeded\n240\t}\n241\t\n242\t// hasPodScheduledFalse returns true when the Pod has a PodScheduled=False\n243\t// condition (kube-scheduler could not place the pod).\n244\tfunc hasPodScheduledFalse(pod *corev1.Pod) bool {\n245\t\tfor _, c := range pod.Status.Conditions {\n246\t\t\tif c.Type == corev1.PodScheduled && c.Status == corev1.ConditionFalse {\n247\t\t\t\treturn true\n248\t\t\t}\n249\t\t}\n250\t\treturn false\n251\t}\n252\t"}]},"parent_tool_use_id":null,"session_id":"5ba5489b-e40f-49fc-85d7-40747c5d6555","uuid":"2d7c41ed-b6e3-43a3-ad63-57060a957faf","timestamp":"2026-09-03T18:26:22.420Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/zombie_sweeper.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage pkg\n\nimport (\n\t\"context\"\n\t\"time\"\n\n\tlib \"github.com/bborbe/agent\"\n\t\"github.com/bborbe/errors\"\n\tlibk8s \"github.com/bborbe/k8s\"\n\tlibtime \"github.com/bborbe/time\"\n\t\"github.com/golang/glog\"\n\tcorev1 \"k8s.io/api/core/v1\"\n\t\"k8s.io/apimachinery/pkg/labels\"\n\tcorev1listers \"k8s.io/client-go/listers/core/v1\"\n\n\tagentv1 \"github.com/bborbe/agent-task-executor/k8s/apis/agent.benjamin-borbe.de/v1\"\n)\n\n//counterfeiter:generate -o ../mocks/zombie_sweeper.go --fake-name FakeZombieSweeper . ZombieSweeper\n\n// ZombieSweeper is a background goroutine that periodically classifies stuck\n// tasks as zombies and emits failure events. It is the safety net for the\n// informer-driven paths in JobWatcher (which handle the cases k8s notifies us\n// about). The sweeper handles: pods unschedulable beyond a grace window,\n// executor restart losing watch on a Job, and any deadline path the informer\n// misses (Job-condition deferred indefinitely, informer cache drift).\ntype ZombieSweeper interface {\n\t// Run blocks until ctx is cancelled. Each tick (interval sourced from the\n\t// first non-nil ConfigSpec.ZombieSweeperIntervalSeconds across the resolver's\n\t// configs, else DefaultZombieSweeperIntervalSeconds) it calls SweepOnce.\n\tRun(ctx context.Context) error\n\t// SweepOnce performs a single sweep pass. Exposed for unit tests so they\n\t// do not have to manage tickers. Returns an error only on context\n\t// cancellation paths; per-task classification errors are logged.\n\tSweepOnce(ctx context.Context) error\n}\n\n// NewZombieSweeper creates a ZombieSweeper. The JobWatcher is held by reference\n// (not its lister) because the lister is only populated after JobWatcher.Run\n// completes its cache sync; service.Run starts all components concurrently, so\n// extracting the lister at wiring time would capture nil. SweepOnce resolves\n// the lister lazily on every tick and skips the tick if it is not yet ready.\nfunc NewZombieSweeper(\n\tjobWatcher JobWatcher,\n\tnamespace libk8s.Namespace,\n\ttaskStore *TaskStore,\n\tpublisher ResultPublisher,\n\tconfigProvider EventHandlerConfig,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n) ZombieSweeper {\n\treturn &zombieSweeper{\n\t\tjobWatcher:      jobWatcher,\n\t\tnamespace:       namespace,\n\t\ttaskStore:       taskStore,\n\t\tpublisher:       publisher,\n\t\tconfigProvider:  configProvider,\n\t\tcurrentDateTime: currentDateTime,\n\t}\n}\n\ntype zombieSweeper struct {\n\tjobWatcher      JobWatcher\n\tnamespace       libk8s.Namespace\n\ttaskStore       *TaskStore\n\tpublisher       ResultPublisher\n\tconfigProvider  EventHandlerConfig\n\tcurrentDateTime libtime.CurrentDateTimeGetter\n}\n\nconst (\n\t// podNotScheduledGraceWindow is the age threshold past which a Pending Pod\n\t// with PodScheduled=False is classified pod_not_scheduled. Must exceed\n\t// typical scheduler latency comfortably; 2 minutes is empirically generous.\n\tpodNotScheduledGraceWindow = 2 * time.Minute\n)\n\n// NOTE on \"no recent heartbeat\" from spec DB #9 / AC #6:\n// The spec predicate is `elapsed > deadline AND pod not Running AND no recent\n// heartbeat`. This codebase has NO separate heartbeat channel today — the only\n// liveness signal for a running job is \"is a Pod currently Running?\". Therefore\n// \"no recent heartbeat\" is implemented as \"no Pod in PodRunning phase observed\n// for this task\". If a per-job heartbeat is added later (a follow-up spec),\n// this predicate gets a real check; for now `classify` treats `pod not Running`\n// as covering both halves of the conjunction.\n\nfunc (s *zombieSweeper) Run(ctx context.Context) error {\n\t// Interval is resolved once at startup. CRD changes to ZombieSweeperIntervalSeconds\n\t// take effect only after pod restart. Acceptable because executor pods are short-lived\n\t// relative to CRD reconciliation cycles.\n\tinterval, err := s.resolveSweeperInterval(ctx)\n\tif err != nil {\n\t\treturn errors.Wrapf(ctx, err, \"resolve sweeper interval\")\n\t}\n\tticker := time.NewTicker(interval)\n\tdefer ticker.Stop()\n\tglog.V(2).Infof(\"zombie sweeper started interval=%s\", interval)\n\tfor {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn nil\n\t\tcase <-ticker.C:\n\t\t\tif err := s.SweepOnce(ctx); err != nil {\n\t\t\t\t// Per-tick failures (transient lister errors, ctx-scoped\n\t\t\t\t// failures from publisher) must NOT kill the sweeper goroutine\n\t\t\t\t// — that would tear down the executor via service.Run. Log and\n\t\t\t\t// continue.\n\t\t\t\tglog.Errorf(\"zombie sweeper tick: %v\", err)\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunc (s *zombieSweeper) SweepOnce(ctx context.Context) error {\n\t// Resolve the Pod lister lazily — JobWatcher.Run populates it only after\n\t// the informer cache has synced, and service.Run starts all components\n\t// concurrently. If the lister is not yet available, skip this tick rather\n\t// than publishing spurious failures.\n\tlister := s.jobWatcher.PodLister()\n\tif lister == nil {\n\t\tglog.V(2).Infof(\"sweep skipped: pod lister not yet synced\")\n\t\treturn nil\n\t}\n\tsnapshot := s.taskStore.Snapshot()\n\tnow := s.currentDateTime.Now().Time()\n\t// Fetch configs ONCE per tick — used by taskDeadline() for every task in\n\t// the snapshot. Avoids N calls into the provider per sweep.\n\tcfgs, err := s.configProvider.Get(ctx)\n\tif err != nil {\n\t\treturn errors.Wrapf(ctx, err, \"list configs\")\n\t}\n\tfor taskID, task := range snapshot {\n\t\tjobName := task.Frontmatter.CurrentJob()\n\t\tif jobName == \"\" {\n\t\t\t// No active job recorded; nothing to sweep.\n\t\t\tcontinue\n\t\t}\n\t\tjobStartedAt, err := task.Frontmatter.JobStartedAt()\n\t\tif err != nil || jobStartedAt.IsZero() {\n\t\t\tglog.V(3).Infof(\n\t\t\t\t\"zombie sweeper: task %s job_started_at unparseable or zero; skipping\",\n\t\t\t\ttaskID,\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\t\tdeadline := s.taskDeadline(task, cfgs)\n\t\telapsed := now.Sub(jobStartedAt)\n\t\tif elapsed < deadline {\n\t\t\tcontinue\n\t\t}\n\t\treason := s.classify(lister, taskID, now)\n\t\tif reason == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif err := s.publisher.PublishFailure(ctx, task, jobName, reason.String()); err != nil {\n\t\t\tglog.Errorf(\n\t\t\t\t\"zombie sweeper: publish failure for task %s (job %s reason %s): %v\",\n\t\t\t\ttaskID, jobName, reason, err,\n\t\t\t)\n\t\t\tcontinue\n\t\t}\n\t\tglog.V(2).Infof(\n\t\t\t\"zombie sweeper: published failure for task %s (job %s reason %s elapsed=%s)\",\n\t\t\ttaskID, jobName, reason, elapsed,\n\t\t)\n\t}\n\treturn nil\n}\n\nfunc (s *zombieSweeper) taskDeadline(task lib.Task, cfgs []agentv1.Config) time.Duration {\n\tassignee := task.Frontmatter.Assignee().String()\n\tfor _, cfg := range cfgs {\n\t\tif cfg.Spec.Assignee == assignee && cfg.Spec.ZombieJobTimeoutSeconds != nil {\n\t\t\treturn time.Duration(*cfg.Spec.ZombieJobTimeoutSeconds) * time.Second\n\t\t}\n\t}\n\treturn time.Duration(agentv1.DefaultZombieJobTimeoutSeconds) * time.Second\n}\n\nfunc (s *zombieSweeper) resolveSweeperInterval(ctx context.Context) (time.Duration, error) {\n\tcfgs, err := s.configProvider.Get(ctx)\n\tif err != nil {\n\t\treturn 0, errors.Wrapf(ctx, err, \"list configs\")\n\t}\n\tfor _, cfg := range cfgs {\n\t\tif cfg.Spec.ZombieSweeperIntervalSeconds != nil {\n\t\t\treturn time.Duration(*cfg.Spec.ZombieSweeperIntervalSeconds) * time.Second, nil\n\t\t}\n\t}\n\treturn time.Duration(agentv1.DefaultZombieSweeperIntervalSeconds) * time.Second, nil\n}\n\n// classify determines whether a past-deadline task is a zombie and which\n// reason applies. Returns \"\" when the task is NOT a zombie (Pod still Running\n// — implicit heartbeat). Inspects Pod state via the shared Pod informer's\n// lister (introduced by prompt 2). Spec Failure-Mode row \"k8s API rate-limit\n// (429)\" mandates: \"Sweeper relies on informer cache (no per-cycle list)\" —\n// we MUST NOT issue API LIST calls here.\nfunc (s *zombieSweeper) classify(\n\tlister corev1listers.PodLister,\n\ttaskID lib.TaskIdentifier,\n\tnow time.Time,\n) ZombieReason {\n\tselector := labels.SelectorFromSet(labels.Set{\n\t\t\"agent.benjamin-borbe.de/task-id\": string(taskID),\n\t})\n\tpods, err := lister.Pods(s.namespace.String()).List(selector)\n\tif err != nil {\n\t\tglog.Errorf(\"zombie sweeper: lister pods for task %s: %v\", taskID, err)\n\t\treturn \"\"\n\t}\n\t// Zero pods AND past-deadline AND a Job was supposed to be running →\n\t// executor lost the watch (Job exists in k8s but Pod GC happened, or the\n\t// Job never created a Pod and was restarted across executor lifetimes).\n\t// \"No recent heartbeat\" reduces to \"no Pod observed\" since this codebase\n\t// has no separate heartbeat channel.\n\tif len(pods) == 0 {\n\t\treturn ZombieReasonExecutorWatchLost\n\t}\n\tfor _, pod := range pods {\n\t\t// Healthy Running — NOT a zombie. A Running pod is the implicit\n\t\t// heartbeat in the current system (no separate heartbeat channel).\n\t\tif pod.Status.Phase == corev1.PodRunning {\n\t\t\treturn \"\"\n\t\t}\n\t\t// Pending past the unschedulable grace window with PodScheduled=False.\n\t\tif pod.Status.Phase == corev1.PodPending {\n\t\t\tage := now.Sub(pod.CreationTimestamp.Time)\n\t\t\tif age > podNotScheduledGraceWindow && hasPodScheduledFalse(pod) {\n\t\t\t\treturn ZombieReasonPodNotScheduled\n\t\t\t}\n\t\t}\n\t}\n\t// Past deadline, no Running pod, no specific Pod-state reason — fall\n\t// back to deadline_exceeded.\n\treturn ZombieReasonDeadlineExceeded\n}\n\n// hasPodScheduledFalse returns true when the Pod has a PodScheduled=False\n// condition (kube-scheduler could not place the pod).\nfunc hasPodScheduledFalse(pod *corev1.Pod) bool {\n\tfor _, c := range pod.Status.Conditions {\n\t\tif c.Type == corev1.PodScheduled && c.Status == corev1.ConditionFalse {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n","numLines":252,"startLine":1,"totalLines":252}}}
