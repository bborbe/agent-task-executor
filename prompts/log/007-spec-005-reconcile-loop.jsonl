ntHandler so callers can wire RunDeferredRespawnLoop.\n97\tfunc CreateConsumer(\n98\t\tsaramaClient sarama.Client,\n99\t\tbranch base.Branch,\n100\t\ttopicPrefix base.TopicPrefix,\n101\t\tkubeClient kubernetes.Interface,\n102\t\tnamespace libk8s.Namespace,\n103\t\tkafkaBrokers string,\n104\t\tresolver pkg.ConfigResolver,\n105\t\tlogSamplerFactory log.SamplerFactory,\n106\t\tcurrentDateTimeGetter libtime.CurrentDateTimeGetter,\n107\t\tresultPublisher pkg.ResultPublisher,\n108\t\ttaskStore *pkg.TaskStore,\n109\t\tjobTTLSecondsAfterFinished int32,\n110\t\tjobKafkaClientCertSecret string,\n111\t\tjobKafkaCaCertSecret string,\n112\t) (libkafka.Consumer, handler.TaskEventHandler) {\n113\t\tjobSpawner := spawner.NewJobSpawner(\n114\t\t\tkubeClient,\n115\t\t\tnamespace,\n116\t\t\tkafkaBrokers,\n117\t\t\tstring(branch),\n118\t\t\tstring(topicPrefix),\n119\t\t\tcurrentDateTimeGetter,\n120\t\t\tjobTTLSecondsAfterFinished,\n121\t\t\tjobKafkaClientCertSecret,\n122\t\t\tjobKafkaCaCertSecret,\n123\t\t)\n124\t\ttaskEventHandler := handler.NewTaskEventHandler(\n125\t\t\tjobSpawner,\n126\t\t\tbranch,\n127\t\t\tresolver,\n128\t\t\tresultPublisher,\n129\t\t\ttaskStore,\n130\t\t\tcurrentDateTimeGetter,\n131\t\t)\n132\t\ttopic := lib.TaskV1SchemaID.EventTopic(topicPrefix)\n133\t\toffsetManager := libkafka.NewSaramaOffsetManager(\n134\t\t\tsaramaClient,\n135\t\t\tlibkafka.Group(\"agent-task-executor\"),\n136\t\t\tlibkafka.OffsetOldest,\n137\t\t\tlibkafka.OffsetOldest,\n138\t\t)\n139\t\treturn libkafka.NewOffsetConsumerHighwaterMarks(\n140\t\t\tsaramaClient,\n141\t\t\ttopic,\n142\t\t\toffsetManager,\n143\t\t\ttaskEventHandler,\n144\t\t\trun.NewTrigger(),\n145\t\t\tlogSamplerFactory,\n146\t\t), taskEventHandler\n147\t}\n148\t\n149\t// CreateHealthcheckRunner creates the healthcheck runner shared between the cron path and the\n150\t// HTTP trigger path. Callers must pass the same instance to both CreateHealthcheckCron and\n151\t// the HTTP handler so probe behavior is identical regardless of