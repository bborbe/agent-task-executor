{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-a74d875e00a4e804","type":"tool_result","content":"504\t// renderTaskContent serializes task into the markdown form an agent expects:\n505\t// \"---\\n<yaml-frontmatter>---\\n<body>\". When task.Frontmatter is empty, the\n506\t// body is returned unchanged (no empty \"{}\" wrapper).\n507\t//\n508\t// The agent side (lib.ParseMarkdown) reads frontmatter fields like\n509\t// clone_url / ref / base_ref directly from this string — keep the wrapper\n510\t// shape byte-compatible with controller/pkg/result.WriteResult.\n511\tfunc renderTaskContent(ctx context.Context, task lib.Task) (string, error) {\n512\t\tif len(task.Frontmatter) == 0 {\n513\t\t\treturn string(task.Content), nil\n514\t\t}\n515\t\tfmBytes, err := yaml.Marshal(map[string]any(task.Frontmatter))\n516\t\tif err != nil {\n517\t\t\treturn \"\", errors.Wrapf(ctx, err, \"marshal frontmatter for task %s\", task.TaskIdentifier)\n518\t\t}\n519\t\treturn \"---\\n\" + string(fmBytes) + \"---\\n\" + string(task.Content), nil\n520\t}\n521\t"}]},"parent_tool_use_id":null,"session_id":"5ba5489b-e40f-49fc-85d7-40747c5d6555","uuid":"a9a49720-98f6-450b-ae5a-236e1c2a6f79","timestamp":"2026-09-03T18:27:05.124Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/spawner/job_spawner.go","content":"// renderTaskContent serializes task into the markdown form an agent expects:\n// \"---\\n<yaml-frontmatter>---\\n<body>\". When task.Frontmatter is empty, the\n// body is returned unchanged (no empty \"{}\" wrapper).\n//\n// The agent side (lib.ParseMarkdown) reads frontmatter fields like\n// clone_url / ref / base_ref directly from this string — keep the wrapper\n// shape byte-compatible with controller/pkg/result.WriteResult.\nfunc renderTaskContent(ctx context.Context, task lib.Task) (string, error) {\n\tif len(task.Frontmatter) == 0 {\n\t\treturn string(task.Content), nil\n\t}\n\tfmBytes, err := yaml.Marshal(map[string]any(task.Frontmatter))\n\tif err != nil {\n\t\treturn \"\", errors.Wrapf(ctx, err, \"marshal frontmatter for task %s\", task.TaskIdentifier)\n\t}\n\treturn \"---\\n\" + string(fmBytes) + \"---\\n\" + string(task.Content), nil\n}\n","numLines":18,"startLine":504,"totalLines":521}}}
