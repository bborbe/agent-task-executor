{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8d6ef907ba5f8f0a","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage handler\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"encoding/json\"\n10\t\tstderrors \"errors\"\n11\t\t\"fmt\"\n12\t\t\"sync\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/IBM/sarama\"\n16\t\tlib \"github.com/bborbe/agent\"\n17\t\t\"github.com/bborbe/cqrs/base\"\n18\t\t\"github.com/bborbe/errors\"\n19\t\tlibtime \"github.com/bborbe/time\"\n20\t\t\"github.com/bborbe/vault-cli/pkg/domain\"\n21\t\t\"github.com/golang/glog\"\n22\t\n23\t\tpkg \"github.com/bborbe/agent-task-executor/pkg\"\n24\t\t\"github.com/bborbe/agent-task-executor/pkg/metrics\"\n25\t\t\"github.com/bborbe/agent-task-executor/pkg/spawner\"\n26\t)\n27\t\n28\t// defaultTriggerPhases is the fallback phase allow-list when the per-Config Trigger is absent or empty.\n29\tvar defaultTriggerPhases = domain.TaskPhases{\n30\t\tdomain.TaskPhasePlanning,\n31\t\tdomain.TaskPhaseExecution,\n32\t\tdomain.TaskPhaseAIReview,\n33\t}\n34\t\n35\t// defaultTriggerStatuses is the fallback status allow-list when the per-Config Trigger is absent or empty.\n36\tvar defaultTriggerStatuses = domain.TaskStatuses{\n37\t\tdomain.TaskStatusInProgress,\n38\t}\n39\t\n40\t// defaultRespawnGracePeriod is the window after job_started_at during which the executor\n41\t// suppresses respawn when the K8s Job is inactive but no terminal phase has been observed.\n42\t// The window gives the agent's terminal-phase write time to propagate through the vault pipeline.\n43\tconst defaultRespawnGracePeriod = 300 * time.Second\n44\t\n45\t// deferredRespawnInterval is the polling interval for the deferred-respawn reconciliation loop.\n46\t// Must be ≤ 60s to satisfy the R ≤ 60s bound from spec 037 (R = interval + per-tick\n47\t// comparison/spawn overhead; 30 s leaves headroom under the 60 s bound).\n48\tconst deferredRespawnInterval = 30 * time.Second\n49\t\n50\t// concurrencyCapRetryDelay is how long a spawn blocked by MaxConcurrentJobs\n51\t// waits before being re-evaluated. Short relative to a Job's runtime (a\n52\t// github-update-go Job measured 11-15 minutes uncontended on 2026-08-10), so a\n53\t// freed slot is picked up promptly without busy-polling the API server.\n54\tconst concurrencyCapRetryDelay = 60 * time.Second\n55\t\n56\t// deferredEntry tracks a task whose respawn was suppressed by the grace window.\n57\t// The executor re-evaluates it once retryAfter is reached.\n58\ttype deferredEntry struct {\n59\t\ttask       lib.Task\n60\t\tconfig     pkg.AgentConfiguration\n61\t\tretryAfter time.Time\n62\t}\n63\t\n64\t// terminalPhases is the set of phases that must never trigger a new spawn.\n65\t// Extending this set requires a follow-up spec if vault-cli adds new terminal phases.\n66\tvar terminalPhases = map[domain.TaskPhase]struct{}{\n67\t\tdomain.TaskPhaseHumanReview: {},\n68\t\tdomain.TaskPhaseDone:        {},\n69\t}\n70\t\n71\t// knownPhases contains all phase constants exported by vault-cli v0.64.3.\n72\t// Values outside this set trigger enum-drift logging (event=unknown_phase).\n73\tvar knownPhases = map[domain.TaskPhase]struct{}{\n74\t\tdomain.TaskPhaseTodo:        {},\n75\t\tdomain.TaskPhasePlanning:    {},\n76\t\tdomain.TaskPhaseExecution:   {}, // canonical (was TaskPhaseInProgress)\n77\t\tdomain.TaskPhaseInProgress:  {}, // legacy alias — still a known phase string\n78\t\tdomain.TaskPhaseAIReview:    {},\n79\t\tdomain.TaskPhaseHumanReview: {},\n80\t\tdomain.TaskPhaseDone:        {},\n81\t}\n82\t\n83\t// IsTerminal reports whether the given phase is in the terminal set.\n84\t// Tasks at a terminal phase must not be re-spawned; operator intervention is required.\n85\tfunc IsTerminal(phase domain.TaskPhase) bool {\n86\t\t_, ok := terminalPhases[phase]\n87\t\treturn ok\n88\t}\n89\t\n90\t// applyPhaseGate emits metrics/logs for terminal and unknown phases.\n91\t// Returns true when the task must be skipped (terminal phase suppressed).\n92\tfunc applyPhaseGate(task lib.Task, phase domain.TaskPhase) bool {\n93\t\tif IsTerminal(phase) {\n94\t\t\tglog.Infof(\"event=spawn_suppressed phase=%s task=%s\", phase, task.TaskIdentifier)\n95\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"spawn_suppressed_terminal_phase\").Inc()\n96\t\t\treturn true\n97\t\t}\n98\t\tif _, inKnown := knownPhases[phase]; !inKnown {\n99\t\t\tglog.Infof(\"event=unknown_phase phase=%s task=%s\", phase, task.TaskIdentifier)\n100\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"unknown_phase\").Inc()\n101\t\t}\n102\t\treturn false\n103\t}\n104\t\n105\t//counterfeiter:generate -o ../../mocks/task_event_handler.go --fake-name FakeTaskEventHandler . TaskEventHandler\n106\t\n107\t// TaskEventHandler processes task event messages from Kafka and manages deferred respawns.\n108\ttype TaskEventHandler interface {\n109\t\tConsumeMessage(ctx context.Context, msg *sarama.ConsumerMessage) error\n110\t\t// EvalDeferredRespawns evaluates all pending deferred-respawn entries immediately.\n111\t\t// Called by RunDeferredRespawnLoop on each tick; also callable directly in tests.\n112\t\tEvalDeferredRespawns(ctx context.Context) error\n113\t\t// RunDeferredRespawnLoop polls evalDeferredRespawns every deferredRespawnInterval\n114\t\t// until ctx is cancelled. Must be run alongside the Kafka consumer.\n115\t\tRunDeferredRespawnLoop(ctx context.Context) error\n116\t}\n117\t\n118\t// NewTaskEventHandler creates a new TaskEventHandler.\n119\tfunc NewTaskEventHandler(\n120\t\tjobSpawner spawner.JobSpawner,\n121\t\tbranch base.Branch,\n122\t\tresolver pkg.ConfigResolver,\n123\t\tresultPublisher pkg.ResultPublisher,\n124\t\ttaskStore *pkg.TaskStore,\n125\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n126\t) TaskEventHandler {\n127\t\treturn &taskEventHandler{\n128\t\t\tjobSpawner:       jobSpawner,\n129\t\t\tbranch:           branch,\n130\t\t\tresolver:         resolver,\n131\t\t\tresultPublisher:  resultPublisher,\n132\t\t\ttaskStore:        taskStore,\n133\t\t\tcurrentDateTime:  currentDateTime,\n134\t\t\tdeferredRespawns: make(map[lib.TaskIdentifier]deferredEntry),\n135\t\t\tspawnLocks:       make(map[string]*sync.Mutex),\n136\t\t}\n137\t}\n138\t\n139\ttype taskEventHandler struct {\n140\t\tjobSpawner       spawner.JobSpawner\n141\t\tbranch           base.Branch\n142\t\tresolver         pkg.ConfigResolver\n143\t\tresultPublisher  pkg.ResultPublisher\n144\t\ttaskStore        *pkg.TaskStore\n145\t\tcurrentDateTime  libtime.CurrentDateTimeGetter\n146\t\tdeferredMu       sync.Mutex\n147\t\tdeferredRespawns map[lib.TaskIdentifier]deferredEntry\n148\t\tspawnLocksMu     sync.Mutex\n149\t\tspawnLocks       map[string]*sync.Mutex\n150\t}\n151\t\n152\t// lockAssigneeSpawn serializes the count-then-spawn sequence for one assignee and\n153\t// returns the unlock func. It is the mutual exclusion that makes MaxConcurrentJobs\n154\t// an actual cap rather than an advisory hint.\n155\t//\n156\t// Without it the cap is a check-then-act race: spawnIfNeeded is reached from two\n157\t// goroutines — the Kafka consumer (consumer.Consume) and the deferred-respawn loop\n158\t// (RunDeferredRespawnLoop), both started by service.Run in main.go — and each reads\n159\t// the same live Job count before either has created its Job, so both conclude they\n160\t// are under the cap. Measured in prod on 2026-08-15 with cap=1: 36 tasks released at\n161\t// once admitted 17 Jobs, 15 released admitted 15. Every over-cap Job is then rejected\n162\t// by the agent's ResourceQuota, loops on FailedCreate and burns its full\n163\t// activeDeadlineSeconds while merely queued, before being killed without ever running.\n164\t//\n165\t// Per-assignee rather than global: a fleet-wide lock would make one agent's spawn\n166\t// latency everyone's. Serializing per assignee costs nothing — spawns are rare\n167\t// against Job runtimes measured in the 11-15 minute range.\n168\t//\n169\t// WARNING: correct only while the executor runs replicas: 1 (verified in quant dev\n170\t// and prod). Scaling to 2 reinstates the race across processes and requires a lease\n171\t// or leader election instead.\n172\tfunc (h *taskEventHandler) lockAssigneeSpawn(assignee string) func() {\n173\t\th.spawnLocksMu.Lock()\n174\t\tmu, ok := h.spawnLocks[assignee]\n175\t\tif !ok {\n176\t\t\tmu = &sync.Mutex{}\n177\t\t\th.spawnLocks[assignee] = mu\n178\t\t}\n179\t\th.spawnLocksMu.Unlock()\n180\t\n181\t\tmu.Lock()\n182\t\treturn mu.Unlock\n183\t}\n184\t\n185\t// cleanupTerminalTask clears in-flight state when a task has reached a terminal\n186\t// status (completed/aborted). taskStore.Delete stops the job informer from emitting\n187\t// a spurious synthetic failure after the agent published success. removeDeferredEntry\n188\t// cancels any pending grace-window respawn — the terminal event is skipped by the\n189\t// status filter in parseAndFilter BEFORE reaching the terminal-phase gate that would\n190\t// otherwise clear the entry, so without this a deferred entry created during the grace\n191\t// window fires ~300s later and respawns a job for an already-done task (the \"path C\"\n192\t// respawn observed on dev 2026-07-13 for probe 095c58d7).\n193\tfunc (h *taskEventHandler) cleanupTerminalTask(task lib.Task) {\n194\t\tstatus := string(task.Frontmatter.Status())\n195\t\tif status != \"completed\" && status != \"aborted\" {\n196\t\t\treturn\n197\t\t}\n198\t\th.taskStore.Delete(task.TaskIdentifier)\n199\t\th.removeDeferredEntry(task.TaskIdentifier)\n200\t\tglog.V(3).\n201\t\t\tInfof(\"task %s %s: cleared task store + deferred respawn\", task.TaskIdentifier, status)\n202\t}\n203\t\n204\tfunc (h *taskEventHandler) ConsumeMessage(ctx context.Context, msg *sarama.ConsumerMessage) error {\n205\t\ttask, config, skip, err := h.parseAndFilter(ctx, msg)\n206\t\tif err != nil {\n207\t\t\treturn err\n208\t\t}\n209\t\tif skip {\n210\t\t\treturn nil\n211\t\t}\n212\t\t_, err = h.spawnIfNeeded(ctx, task, config)\n213\t\treturn err\n214\t}\n215\t\n216\t// parseAndFilter unmarshals the message and applies all pre-spawn filter checks.\n217\t// Returns (task, config, true, nil) when the message should be silently skipped.\n218\t// Returns (task, config, false, nil) when the task qualifies for spawning.\n219\t// Returns (_, _, false, err) when an unexpected error occurred.\n220\tfunc (h *taskEventHandler) parseAndFilter(\n221\t\tctx context.Context,\n222\t\tmsg *sarama.ConsumerMessage,\n223\t) (lib.Task, *pkg.AgentConfiguration, bool, error) {\n224\t\tif len(msg.Value) == 0 {\n225\t\t\tglog.V(3).Infof(\"skip empty message at offset %d\", msg.Offset)\n226\t\t\treturn lib.Task{}, nil, true, nil\n227\t\t}\n228\t\n229\t\tvar task lib.Task\n230\t\tif err := json.Unmarshal(msg.Value, &task); err != nil {\n231\t\t\tglog.Warningf(\"failed to unmarshal task event at offset %d: %v\", msg.Offset, err)\n232\t\t\treturn lib.Task{}, nil, true, nil\n233\t\t}\n234\t\n235\t\tif task.TaskIdentifier == \"\" {\n236\t\t\tglog.Warningf(\"task event at offset %d has empty TaskIdentifier, skipping\", msg.Offset)\n237\t\t\treturn lib.Task{}, nil, true, nil\n238\t\t}\n239\t\n240\t\th.cleanupTerminalTask(task)\n241\t\n242\t\t// Resolve the per-agent Config before the status/phase checks so both filters\n243\t\t// can use the per-Config trigger. Skip lookup when assignee is empty.\n244\t\tconfig, skip, err := h.resolveConfig(ctx, task)\n245\t\tif err != nil {\n246\t\t\treturn lib.Task{}, nil, false, err\n247\t\t}\n248\t\tif skip {\n249\t\t\treturn lib.Task{}, nil, true, nil\n250\t\t}\n251\t\n252\t\t// Type filter: effective set = {cfg.TaskType} ∪ cfg.TaskTypes.\n253\t\t// Skipped when the effective set is empty (agent has no task types configured).\n254\t\tif mismatch := taskTypeMismatchReason(task, config); mismatch != \"\" {\n255\t\t\tif err := h.resultPublisher.PublishTypeMismatchFailure(ctx, task, mismatch); err != nil {\n256\t\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n257\t\t\t\treturn lib.Task{}, nil, false, errors.Wrapf(\n258\t\t\t\t\tctx, err, \"publish type mismatch failure for task %s\", task.TaskIdentifier,\n259\t\t\t\t)\n260\t\t\t}\n261\t\t\tglog.V(2).Infof(\"type mismatch: %s (task %s)\", mismatch, task.TaskIdentifier)\n262\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"type_mismatch\").Inc()\n263\t\t\treturn lib.Task{}, nil, true, nil\n264\t\t}\n265\t\n266\t\tif !effectiveTriggerStatuses(config).Contains(task.Frontmatter.Status()) {\n267\t\t\tglog.V(3).Infof(\n268\t\t\t\t\"skip task %s with status %s\", task.TaskIdentifier, task.Frontmatter.Status(),\n269\t\t\t)\n270\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_status\").Inc()\n271\t\t\treturn lib.Task{}, nil, true, nil\n272\t\t}\n273\t\n274\t\tphase := task.Frontmatter.Phase()\n275\t\t// terminal phases must not be spawned again — operator escalation required\n276\t\tif phase != nil && applyPhaseGate(task, *phase) {\n277\t\t\th.removeDeferredEntry(task.TaskIdentifier)\n278\t\t\treturn lib.Task{}, nil, true, nil\n279\t\t}\n280\t\tif phase == nil || !effectiveTriggerPhases(config).Contains(*phase) {\n281\t\t\tglog.V(3).Infof(\"skip task %s with phase %v\", task.TaskIdentifier, phase)\n282\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_phase\").Inc()\n283\t\t\treturn lib.Task{}, nil, true, nil\n284\t\t}\n285\t\n286\t\tstage := task.Frontmatter.Stage()\n287\t\tif stage != string(h.branch) {\n288\t\t\tglog.V(3).Infof(\n289\t\t\t\t\"skip task %s with stage %s (executor branch %s)\",\n290\t\t\t\ttask.TaskIdentifier, stage, h.branch,\n291\t\t\t)\n292\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_stage\").Inc()\n293\t\t\treturn lib.Task{}, nil, true, nil\n294\t\t}\n295\t\n296\t\tif task.Frontmatter.Assignee() == \"\" {\n297\t\t\tglog.V(3).Infof(\"skip task %s with empty assignee\", task.TaskIdentifier)\n298\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_assignee\").Inc()\n299\t\t\treturn lib.Task{}, nil, true, nil\n300\t\t}\n301\t\n302\t\treturn task, config, false, nil\n303\t}\n304\t\n305\t// resolveConfig looks up the agent Config CR for the task's assignee.\n306\t// Returns (nil, false, nil) when assignee is empty (caller handles the empty-assignee path).\n307\t// Returns (nil, true, nil) when the assignee is unknown (ErrConfigNotFound).\n308\t// Returns (nil, false, err) on unexpected resolver errors.\n309\tfunc (h *taskEventHandler) resolveConfig(\n310\t\tctx context.Context,\n311\t\ttask lib.Task,\n312\t) (*pkg.AgentConfiguration, bool, error) {\n313\t\tif task.Frontmatter.Assignee() == \"\" {\n314\t\t\treturn nil, false, nil\n315\t\t}\n316\t\tresolved, err := h.resolver.Resolve(ctx, string(task.Frontmatter.Assignee()))\n317\t\tif err != nil {\n318\t\t\tif stderrors.Is(err, pkg.ErrConfigNotFound) {\n319\t\t\t\tglog.Warningf(\n320\t\t\t\t\t\"skip task %s: unknown assignee %s\",\n321\t\t\t\t\ttask.TaskIdentifier,\n322\t\t\t\t\ttask.Frontmatter.Assignee(),\n323\t\t\t\t)\n324\t\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_unknown_assignee\").Inc()\n325\t\t\t\treturn nil, true, nil\n326\t\t\t}\n327\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n328\t\t\treturn nil, false, errors.Wrapf(\n329\t\t\t\tctx,\n330\t\t\t\terr,\n331\t\t\t\t\"resolve agent config for task %s\",\n332\t\t\t\ttask.TaskIdentifier,\n333\t\t\t)\n334\t\t}\n335\t\treturn &resolved, false, nil\n336\t}\n337\t\n338\t// taskTypeMismatchReason returns a non-empty reason string when the task's task_type is not in the\n339\t// agent's effective type set. Returns \"\" when the filter passes (match or effective set is empty).\n340\tfunc taskTypeMismatchReason(task lib.Task, cfg *pkg.AgentConfiguration) string {\n341\t\tif cfg == nil {\n342\t\t\treturn \"\"\n343\t\t}\n344\t\teffectiveTypes := pkg.EffectiveTaskTypes(cfg.TaskType, cfg.TaskTypes)\n345\t\tif len(effectiveTypes) == 0 {\n346\t\t\treturn \"\"\n347\t\t}\n348\t\ttaskType := task.Frontmatter.TaskType()\n349\t\tif pkg.TaskTypeInSet(string(taskType), effectiveTypes) {\n350\t\t\treturn \"\"\n351\t\t}\n352\t\tif taskType == \"\" {\n353\t\t\treturn fmt.Sprintf(\n354\t\t\t\t\"task has no task_type; agent %q accepts %v\",\n355\t\t\t\tcfg.Assignee,\n356\t\t\t\teffectiveTypes,\n357\t\t\t)\n358\t\t}\n359\t\treturn fmt.Sprintf(\n360\t\t\t\"task_type %q not in effective set %v of agent %q\",\n361\t\t\ttaskType, effectiveTypes, cfg.Assignee,\n362\t\t)\n363\t}\n364\t\n365\t// effectiveTriggerPhases returns the phase allow-list from the Config trigger,\n366\t// falling back to defaultTriggerPhases when Trigger is absent or the list is empty.\n367\tfunc effectiveTriggerPhases(cfg *pkg.AgentConfiguration) domain.TaskPhases {\n368\t\tif cfg == nil || cfg.Trigger == nil || len(cfg.Trigger.Phases) == 0 {\n369\t\t\treturn defaultTriggerPhases\n370\t\t}\n371\t\treturn cfg.Trigger.Phases\n372\t}\n373\t\n374\t// effectiveTriggerStatuses returns the status allow-list from the Config trigger,\n375\t// falling back to defaultTriggerStatuses when Trigger is absent or the list is empty.\n376\tfunc effectiveTriggerStatuses(cfg *pkg.AgentConfiguration) domain.TaskStatuses {\n377\t\tif cfg == nil || cfg.Trigger == nil || len(cfg.Trigger.Statuses) == 0 {\n378\t\t\treturn defaultTriggerStatuses\n379\t\t}\n380\t\treturn cfg.Trigger.Statuses\n381\t}\n382\t\n383\t// checkActiveCurrentJob verifies whether spawn must be suppressed due to current_job state.\n384\t// Returns (true, nil) when the spawn must be suppressed (job still active or inside grace window).\n385\t// Returns (false, nil) when spawn may proceed. Returns (false, err) on unexpected errors.\n386\tfunc (h *taskEventHandler) checkActiveCurrentJob(\n387\t\tctx context.Context,\n388\t\ttask lib.Task,\n389\t\tcurrentJob string,\n390\t\tconfig *pkg.AgentConfiguration,\n391\t) (bool, error) {\n392\t\tactive, err := h.jobSpawner.IsJobActive(ctx, task.TaskIdentifier)\n393\t\tif err != nil {\n394\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n395\t\t\treturn false, errors.Wrapf(\n396\t\t\t\tctx,\n397\t\t\t\terr,\n398\t\t\t\t\"check current_job active for task %s\",\n399\t\t\t\ttask.TaskIdentifier,\n400\t\t\t)\n401\t\t}\n402\t\tif active {\n403\t\t\tglog.V(3).Infof(\n404\t\t\t\t\"skip task %s: current_job %s still active (from frontmatter)\",\n405\t\t\t\ttask.TaskIdentifier, currentJob,\n406\t\t\t)\n407\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_active_job\").Inc()\n408\t\t\treturn true, nil\n409\t\t}\n410\t\t// Grace window: suppress respawn while the agent's terminal-phase write propagates.\n411\t\t// Treat missing or unparseable job_started_at as elapsed (preserves legacy-task behavior).\n412\t\tjobStartedAt, parseErr := task.Frontmatter.JobStartedAt()\n413\t\tif parseErr != nil {\n414\t\t\tglog.Warningf(\n415\t\t\t\t\"task %s: failed to parse job_started_at: %v; treating grace period as elapsed\",\n416\t\t\t\ttask.TaskIdentifier, parseErr,\n417\t\t\t)\n418\t\t}\n419\t\tif parseErr == nil && !jobStartedAt.IsZero() {\n420\t\t\telapsed := h.currentDateTime.Now().Time().Sub(jobStartedAt)\n421\t\t\tif elapsed < defaultRespawnGracePeriod {\n422\t\t\t\tglog.Infof(\n423\t\t\t\t\t\"event=respawn_grace_window task=%s current_job=%s elapsed=%.0fs\",\n424\t\t\t\t\ttask.TaskIdentifier, currentJob, elapsed.Seconds(),\n425\t\t\t\t)\n426\t\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"respawn_grace_window\").Inc()\n427\t\t\t\tif config != nil {\n428\t\t\t\t\tretryAfter := jobStartedAt.Add(defaultRespawnGracePeriod)\n429\t\t\t\t\th.deferredMu.Lock()\n430\t\t\t\t\th.deferredRespawns[task.TaskIdentifier] = deferredEntry{\n431\t\t\t\t\t\ttask:       task,\n432\t\t\t\t\t\tconfig:     *config,\n433\t\t\t\t\t\tretryAfter: retryAfter,\n434\t\t\t\t\t}\n435\t\t\t\t\th.deferredMu.Unlock()\n436\t\t\t\t}\n437\t\t\t\treturn true, nil\n438\t\t\t}\n439\t\t}\n440\t\tglog.V(2).Infof(\n441\t\t\t\"task %s: current_job %s no longer active, proceeding to spawn\",\n442\t\t\ttask.TaskIdentifier, currentJob,\n443\t\t)\n444\t\treturn false, nil\n445\t}\n446\t\n447\t// spawnIfNeeded returns (spawned, err): spawned is true iff a new k8s Job was actually launched\n448\t// (i.e. the call reached SpawnJob successfully). All early-return branches (suppression, trigger\n449\t// cap, active job, terminal phase, errors) return spawned=false.\n450\tfunc (h *taskEventHandler) spawnIfNeeded(\n451\t\tctx context.Context,\n452\t\ttask lib.Task,\n453\t\tconfig *pkg.AgentConfiguration,\n454\t) (bool, error) {\n455\t\t// If current_job is set in frontmatter, a prior spawn notification was written\n456\t\t// to the task file. Verify the job is still active; if not, proceed to spawn.\n457\t\tif currentJob := task.Frontmatter.CurrentJob(); currentJob != \"\" {\n458\t\t\tsuppress, err := h.checkActiveCurrentJob(ctx, task, currentJob, config)\n459\t\t\tif err != nil {\n460\t\t\t\treturn false, err\n461\t\t\t}\n462\t\t\tif suppress {\n463\t\t\t\treturn false, nil\n464\t\t\t}\n465\t\t}\n466\t\n467\t\t// Held across the cap check AND the SpawnJob call below, so no other goroutine\n468\t\t// can observe a stale Job count in between. Only taken when a cap is configured:\n469\t\t// an uncapped agent has nothing to serialize, and holding the lock anyway would\n470\t\t// queue its spawns behind each other for no benefit.\n471\t\tif config != nil && config.MaxConcurrentJobs > 0 {\n472\t\t\tdefer h.lockAssigneeSpawn(config.Assignee)()\n473\t\t}\n474\t\n475\t\tactive, err := h.jobSpawner.IsJobActive(ctx, task.TaskIdentifier)\n476\t\tif err != nil {\n477\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n478\t\t\treturn false, errors.Wrapf(ctx, err, \"check active job for task %s\", task.TaskIdentifier)\n479\t\t}\n480\t\tif active {\n481\t\t\tglog.V(3).Infof(\"skip task %s: active job exists\", task.TaskIdentifier)\n482\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_active_job\").Inc()\n483\t\t\treturn false, nil\n484\t\t}\n485\t\n486\t\tcapped, err := h.deferIfAtConcurrencyCap(ctx, task, config)\n487\t\tif err != nil {\n488\t\t\treturn false, err\n489\t\t}\n490\t\tif capped {\n491\t\t\treturn false, nil\n492\t\t}\n493\t\n494\t\t// Scoped trigger budget: evaluates the opt-in cap against the task's current\n495\t\t// phase+ref scope and publishes the counter write for the spawn about to\n496\t\t// happen. Extracted so spawnIfNeeded stays legible; it owns one decision.\n497\t\tcapped, err = h.applyTriggerBudget(ctx, task)\n498\t\tif err != nil {\n499\t\t\treturn false, err\n500\t\t}\n501\t\tif capped {\n502\t\t\treturn false, nil\n503\t\t}\n504\t\n505\t\tjobName, err := h.jobSpawner.SpawnJob(ctx, task, *config)\n506\t\tif err != nil {\n507\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n508\t\t\treturn false, errors.Wrapf(ctx, err, \"spawn job for task %s failed\", task.TaskIdentifier)\n509\t\t}\n510\t\n511\t\th.taskStore.Store(task.TaskIdentifier, task)\n512\t\tif err := h.resultPublisher.PublishSpawnNotification(ctx, task, jobName); err != nil {\n513\t\t\t// Log but don't fail — job is already spawned, spawn notification is best-effort\n514\t\t\tglog.Warningf(\"publish spawn notification for task %s failed (job %s still running): %v\",\n515\t\t\t\ttask.TaskIdentifier, jobName, err)\n516\t\t}\n517\t\n518\t\tglog.V(2).Infof(\n519\t\t\t\"spawned job for task %s (assignee=%s image=%s)\",\n520\t\t\ttask.TaskIdentifier, task.Frontmatter.Assignee(), config.Image,\n521\t\t)\n522\t\tmetrics.TaskEventsTotal.WithLabelValues(\"spawned\").Inc()\n523\t\tmetrics.JobsSpawnedTotal.Inc()\n524\t\treturn true, nil\n525\t}\n526\t\n527\t// deferIfAtConcurrencyCap reports whether the agent is already running its\n528\t// configured maximum number of Jobs, and if so registers the task for a\n529\t// deferred respawn instead of spawning now.\n530\t//\n531\t// Deferring rather than skipping is the whole point. Task publication is\n532\t// edge-triggered on vault file changes; being over the cap produces no such\n533\t// change, so a skipped spawn would never be re-driven and the task would sit\n534\t// at in_progress forever, indistinguishable from work in flight.\n535\tfunc (h *taskEventHandler) deferIfAtConcurrencyCap(\n536\t\tctx context.Context,\n537\t\ttask lib.Task,\n538\t\tconfig *pkg.AgentConfiguration,\n539\t) (bool, error) {\n540\t\tif config == nil || config.MaxConcurrentJobs <= 0 {\n541\t\t\treturn false, nil\n542\t\t}\n543\t\trunning, err := h.jobSpawner.CountActiveJobs(ctx, config.Assignee)\n544\t\tif err != nil {\n545\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n546\t\t\treturn false, errors.Wrapf(ctx, err, \"count active jobs for assignee %s\", config.Assignee)\n547\t\t}\n548\t\tif running < config.MaxConcurrentJobs {\n549\t\t\t// Log the ADMIT decision, not just the deferral. Without this, an\n550\t\t\t// over-cap spawn leaves no trace and overshoot can only be found by\n551\t\t\t// counting Jobs in the cluster by hand — which is how the 2026-08-15\n552\t\t\t// race went unnoticed until 17 Jobs existed against a cap of 1.\n553\t\t\t// Same V(1) rationale as the deferral log below.\n554\t\t\tglog.V(1).Infof(\n555\t\t\t\t\"event=concurrency_admit task=%s assignee=%s running=%d cap=%d\",\n556\t\t\t\ttask.TaskIdentifier, config.Assignee, running, config.MaxConcurrentJobs,\n557\t\t\t)\n558\t\t\treturn false, nil\n559\t\t}\n560\t\t// V(1), not V(0): a capped deferral is an expected steady state and repeats\n561\t\t// once per retry interval per waiting task, so V(0) would be a constant\n562\t\t// stream during any backlog. V(1) is inside the deployed verbosity, so it\n563\t\t// stays visible to an operator looking — unlike the V(3) skip that hid the\n564\t\t// wedge fixed in #12.\n565\t\tglog.V(1).Infof(\n566\t\t\t\"event=concurrency_cap task=%s assignee=%s running=%d cap=%d retry_after=%s\",\n567\t\t\ttask.TaskIdentifier, config.Assignee, running, config.MaxConcurrentJobs,\n568\t\t\tconcurrencyCapRetryDelay,\n569\t\t)\n570\t\tmetrics.TaskEventsTotal.WithLabelValues(\"deferred_concurrency_cap\").Inc()\n571\t\th.deferredMu.Lock()\n572\t\th.deferredRespawns[task.TaskIdentifier] = deferredEntry{\n573\t\t\ttask:       task,\n574\t\t\tconfig:     *config,\n575\t\t\tretryAfter: h.currentDateTime.Now().Time().Add(concurrencyCapRetryDelay),\n576\t\t}\n577\t\th.deferredMu.Unlock()\n578\t\treturn true, nil\n579\t}\n580\t\n581\t// evalDeferredRespawns checks all pending deferred-respawn entries and spawns a job\n582\t// for each entry whose retryAfter has been reached. Entries are removed once processed.\n583\t// The respawn_after_grace_window metric and log line fire ONLY when the call actually\n584\t// results in a spawn (spec 037 AC #6: \"recorded each time the follow-up evaluation\n585\t// results in a spawn\"); evaluations that no-op (active job already, trigger cap hit,\n586\t// terminal phase) do not increment the metric.\n587\tfunc (h *taskEventHandler) evalDeferredRespawns(ctx context.Context) error {\n588\t\tnow := h.currentDateTime.Now().Time()\n589\t\n590\t\th.deferredMu.Lock()\n591\t\tvar ready []deferredEntry\n592\t\tfor taskID, entry := range h.deferredRespawns {\n593\t\t\tif !now.Before(entry.retryAfter) {\n594\t\t\t\tready = append(ready, entry)\n595\t\t\t\tdelete(h.deferredRespawns, taskID)\n596\t\t\t}\n597\t\t}\n598\t\th.deferredMu.Unlock()\n599\t\n600\t\tfor _, entry := range ready {\n601\t\t\tentry := entry // capture for closure\n602\t\t\tspawned, err := h.spawnIfNeeded(ctx, entry.task, &entry.config)\n603\t\t\tif err != nil {\n604\t\t\t\treturn errors.Wrapf(\n605\t\t\t\t\tctx, err, \"deferred respawn for task %s\", entry.task.TaskIdentifier,\n606\t\t\t\t)\n607\t\t\t}\n608\t\t\tif !spawned {\n609\t\t\t\tcontinue\n610\t\t\t}\n611\t\t\tjobStartedAt, _ := entry.task.Frontmatter.JobStartedAt()\n612\t\t\telapsed := now.Sub(jobStartedAt)\n613\t\t\tglog.Infof(\n614\t\t\t\t\"event=respawn_after_grace_window task=%s current_job=%s elapsed=%.0fs\",\n615\t\t\t\tentry.task.TaskIdentifier, entry.task.Frontmatter.CurrentJob(), elapsed.Seconds(),\n616\t\t\t)\n617\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"respawn_after_grace_window\").Inc()\n618\t\t}\n619\t\treturn nil\n620\t}\n621\t\n622\t// removeDeferredEntry removes any pending deferred-respawn entry for the given task.\n623\t// Called from parseAndFilter when a terminal-phase event arrives so no stale spawn fires.\n624\tfunc (h *taskEventHandler) removeDeferredEntry(id lib.TaskIdentifier) {\n625\t\th.deferredMu.Lock()\n626\t\tdelete(h.deferredRespawns, id)\n627\t\th.deferredMu.Unlock()\n628\t}\n629\t\n630\t// EvalDeferredRespawns implements TaskEventHandler.\n631\tfunc (h *taskEventHandler) EvalDeferredRespawns(ctx context.Context) error {\n632\t\treturn h.evalDeferredRespawns(ctx)\n633\t}\n634\t\n635\t// seedDeferredRespawnsFromStore scans the in-memory taskStore for tasks that look\n636\t// like in-flight work (current_job set, phase non-terminal) and adds them to\n637\t// deferredRespawns with retryAfter = job_started_at + defaultRespawnGracePeriod.\n638\t// Called once from RunDeferredRespawnLoop on startup. Idempotent: any entry already\n639\t// present in deferredRespawns is left untouched. This restores deferred state lost\n640\t// when the in-memory map is wiped by an executor restart, so a stuck task does not\n641\t// remain stuck for want of a Kafka event that will never arrive.\n642\tfunc (h *taskEventHandler) seedDeferredRespawnsFromStore() {\n643\t\tsnapshot := h.taskStore.Snapshot()\n644\t\n645\t\th.deferredMu.Lock()\n646\t\tdefer h.deferredMu.Unlock()\n647\t\tfor taskID, task := range snapshot {\n648\t\t\tif _, exists := h.deferredRespawns[taskID]; exists {\n649\t\t\t\tcontinue\n650\t\t\t}\n651\t\t\tcurrentJob := task.Frontmatter.CurrentJob()\n652\t\t\tif currentJob == \"\" {\n653\t\t\t\tcontinue\n654\t\t\t}\n655\t\t\tphase := task.Frontmatter.Phase()\n656\t\t\tif phase != nil && IsTerminal(*phase) {\n657\t\t\t\tcontinue\n658\t\t\t}\n659\t\t\tjobStartedAt, jobStartedErr := task.Frontmatter.JobStartedAt()\n660\t\t\tif jobStartedErr != nil {\n661\t\t\t\tcontinue\n662\t\t\t}\n663\t\t\th.deferredRespawns[taskID] = deferredEntry{\n664\t\t\t\ttask: task,\n665\t\t\t\t// config: the agent configuration is resolved at event time; the seed\n666\t\t\t\t// uses an empty value here. For seeded entries the config is zero-valued;\n667\t\t\t\t// this is acceptable because the next genuine Kafka event for the task\n668\t\t\t\t// will supply the correct config via the event-driven path.\n669\t\t\t\tretryAfter: jobStartedAt.Add(defaultRespawnGracePeriod),\n670\t\t\t}\n671\t\t}\n672\t}\n673\t\n674\t// RunDeferredRespawnLoop implements TaskEventHandler.\n675\tfunc (h *taskEventHandler) RunDeferredRespawnLoop(ctx context.Context) error {\n676\t\t// Startup reconciliation: recover deferred entries lost across an executor\n677\t\t// restart by scanning the in-memory taskStore. See seedDeferredRespawnsFromStore\n678\t\t// for the restart-safety rationale (spec 037 AC #5).\n679\t\th.seedDeferredRespawnsFromStore()\n680\t\n681\t\t// Fire one eval immediately after seeding so that tasks whose grace has\n682\t\t// already elapsed at startup are picked up without waiting for the first tick.\n683\t\tif err := h.evalDeferredRespawns(ctx); err != nil {\n684\t\t\treturn errors.Wrapf(ctx, err, \"deferred respawn loop initial eval\")\n685\t\t}\n686\t\n687\t\tticker := time.NewTicker(deferredRespawnInterval)\n688\t\tdefer ticker.Stop()\n689\t\tfor {\n690\t\t\tselect {\n691\t\t\tcase <-ctx.Done():\n692\t\t\t\treturn nil\n693\t\t\tcase <-ticker.C:\n694\t\t\t\tif err := h.evalDeferredRespawns(ctx); err != nil {\n695\t\t\t\t\treturn errors.Wrapf(ctx, err, \"deferred respawn loop tick\")\n696\t\t\t\t}\n697\t\t\t}\n698\t\t}\n699\t}\n700\t\n701\t// triggerScopeRefLen is how much of the ref is kept in a scope key. A short prefix\n702\t// is enough to distinguish commits while keeping the frontmatter value readable in\n703\t// the task file, where an operator has to be able to eyeball it.\n704\tconst triggerScopeRefLen = 8\n705\t\n706\t// triggerScope keys the spawn budget to the work being attempted rather than to the\n707\t// task's whole lifetime.\n708\t//\n709\t// A re-dispatch that represents real progress — a new lifecycle phase, or a new\n710\t// commit on the target repo — produces a different scope and earns a fresh budget.\n711\t// A deterministic failure retried against the same phase and the same ref keeps the\n712\t// same scope and burns the budget down. That difference is what lets the cap run by\n713\t// default instead of opt-in.\n714\t//\n715\t// Phase comes from the normalizing accessor, so a phase alias does not split a scope\n716\t// and silently hand out a second budget. ref is absent on human-authored tasks\n717\t// (it is written by the agents that clone a repo, alongside clone_url and base_ref);\n718\t// those tasks scope on phase alone, which is the correct degradation — there is no\n719\t// commit for them to make progress against.\n720\tfunc triggerScope(fm lib.TaskFrontmatter) string {\n721\t\tvar phase string\n722\t\tif p := fm.Phase(); p != nil {\n723\t\t\tphase = string(*p)\n724\t\t}\n725\t\tref, _ := fm.String(\"ref\")\n726\t\tif len(ref) > triggerScopeRefLen {\n727\t\t\tref = ref[:triggerScopeRefLen]\n728\t\t}\n729\t\treturn phase + \":\" + ref\n730\t}\n731\t\n732\t// applyTriggerBudget evaluates the scoped trigger cap for one spawn decision and,\n733\t// when the spawn may proceed, publishes exactly one counter write recording it.\n734\t// Returns capped=true when the cap is reached and the spawn must be skipped.\n735\t//\n736\t// The cap stays OPT-IN: an absent max_triggers still means no cap.\n737\t//\n738\t// Scoping does not make it safe to default on, which was the original plan for\n739\t// this change. A recurring task is exactly the case v0.7.1 protected after the\n740\t// 2026-08-27 prod incident (Daily Sentry Triage: the lib default-3 fallback\n741\t// stripped assignee on the 3rd trigger and silently killed the re-dispatch loop),\n742\t// and such a task is NOT repo-backed — it carries no ref and sits at a stable\n743\t// phase, so its scope is a constant. The counter would accrue across re-dispatches\n744\t// exactly as before and the cap would fire at 3, re-creating the incident.\n745\t// Scoping only helps where the scope actually moves.\n746\t//\n747\t// What scoping DOES fix is the opt-in cap's correctness: a task that opts in no\n748\t// longer burns its budget across unrelated attempts, so an operator can set a\n749\t// tight max_triggers without it leaking into the next phase or the next commit.\n750\tfunc (h *taskEventHandler) applyTriggerBudget(\n751\t\tctx context.Context,\n752\t\ttask lib.Task,\n753\t) (bool, error) {\n754\t\tcurrentScope := triggerScope(task.Frontmatter)\n755\t\tstoredScope, hasScope := task.Frontmatter.String(\"trigger_scope\")\n756\t\n757\t\t// An ABSENT scope is not a CHANGED scope. Every task in flight today predates\n758\t\t// this field, so treating absent as changed would hand each of them a free\n759\t\t// budget reset on the first event after deploy — including one already looping\n760\t\t// at cap, which would resume for another N. Absent means \"adopt the current\n761\t\t// scope, keep the count\".\n762\t\tscopeChanged := hasScope && storedScope != currentScope\n763\t\n764\t\t_, optedIn := task.Frontmatter[\"max_triggers\"]\n765\t\tif optedIn && !scopeChanged &&\n766\t\t\ttask.Frontmatter.TriggerCount() >= task.Frontmatter.MaxTriggers() {\n767\t\t\tglog.V(2).Infof(\"skip task %s: trigger_count %d >= max_triggers %d in scope %q\",\n768\t\t\t\ttask.TaskIdentifier,\n769\t\t\t\ttask.Frontmatter.TriggerCount(),\n770\t\t\t\ttask.Frontmatter.MaxTriggers(),\n771\t\t\t\tcurrentScope,\n772\t\t\t)\n773\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_trigger_cap\").Inc()\n774\t\t\treturn true, nil\n775\t\t}\n776\t\n777\t\t// Exactly one publish per spawn in every branch. Splitting \"write the scope\"\n778\t\t// and \"count the spawn\" into two commands would emit two writes for one spawn\n779\t\t// and let them interleave with a concurrent write.\n780\t\tcount, useScopeWrite := triggerBudgetWrite(task.Frontmatter, scopeChanged, hasScope)\n781\t\tif !useScopeWrite {\n782\t\t\tif err := h.resultPublisher.PublishIncrementTriggerCount(ctx, task); err != nil {\n783\t\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n784\t\t\t\treturn false, errors.Wrapf(\n785\t\t\t\t\tctx, err, \"publish increment trigger_count for task %s\", task.TaskIdentifier,\n786\t\t\t\t)\n787\t\t\t}\n788\t\t\treturn false, nil\n789\t\t}\n790\t\n791\t\tglog.V(2).Infof(\"task %s: trigger scope %q -> %q, trigger_count -> %d\",\n792\t\t\ttask.TaskIdentifier, storedScope, currentScope, count,\n793\t\t)\n794\t\tif err := h.resultPublisher.PublishSetTriggerScope(ctx, task, currentScope, count); err != nil {\n795\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n796\t\t\treturn false, errors.Wrapf(\n797\t\t\t\tctx, err, \"publish set trigger scope for task %s\", task.TaskIdentifier,\n798\t\t\t)\n799\t\t}\n800\t\treturn false, nil\n801\t}\n802\t\n803\t// triggerBudgetWrite decides which counter write a spawn needs. useScopeWrite\n804\t// reports whether the scope itself must be persisted alongside the count.\n805\t//\n806\t//   - scope changed: fresh budget at 1, counting the spawn about to happen.\n807\t//   - scope absent: adopt at count+1 — carry the existing attempts forward rather\n808\t//     than resetting, so the migration to this field grants nobody a free budget.\n809\t//   - scope unchanged: no scope write; the ordinary increment path applies.\n810\tfunc triggerBudgetWrite(\n811\t\tfm lib.TaskFrontmatter,\n812\t\tscopeChanged bool,\n813\t\thasScope bool,\n814\t) (int, bool) {\n815\t\tswitch {\n816\t\tcase scopeChanged:\n817\t\t\treturn 1, true\n818\t\tcase !hasScope:\n819\t\t\treturn fm.TriggerCount() + 1, true\n820\t\tdefault:\n821\t\t\treturn 0, false\n822\t\t}\n823\t}\n824\t"}]},"parent_tool_use_id":null,"session_id":"5ba5489b-e40f-49fc-85d7-40747c5d6555","uuid":"5131b546-702f-4774-bf03-57907a7813ba","timestamp":"2026-09-03T18:26:19.211Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/handler/task_event_handler.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage handler\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\tstderrors \"errors\"\n\t\"fmt\"\n\t\"sync\"\n\t\"time\"\n\n\t\"github.com/IBM/sarama\"\n\tlib \"github.com/bborbe/agent\"\n\t\"github.com/bborbe/cqrs/base\"\n\t\"github.com/bborbe/errors\"\n\tlibtime \"github.com/bborbe/time\"\n\t\"github.com/bborbe/vault-cli/pkg/domain\"\n\t\"github.com/golang/glog\"\n\n\tpkg \"github.com/bborbe/agent-task-executor/pkg\"\n\t\"github.com/bborbe/agent-task-executor/pkg/metrics\"\n\t\"github.com/bborbe/agent-task-executor/pkg/spawner\"\n)\n\n// defaultTriggerPhases is the fallback phase allow-list when the per-Config Trigger is absent or empty.\nvar defaultTriggerPhases = domain.TaskPhases{\n\tdomain.TaskPhasePlanning,\n\tdomain.TaskPhaseExecution,\n\tdomain.TaskPhaseAIReview,\n}\n\n// defaultTriggerStatuses is the fallback status allow-list when the per-Config Trigger is absent or empty.\nvar defaultTriggerStatuses = domain.TaskStatuses{\n\tdomain.TaskStatusInProgress,\n}\n\n// defaultRespawnGracePeriod is the window after job_started_at during which the executor\n// suppresses respawn when the K8s Job is inactive but no terminal phase has been observed.\n// The window gives the agent's terminal-phase write time to propagate through the vault pipeline.\nconst defaultRespawnGracePeriod = 300 * time.Second\n\n// deferredRespawnInterval is the polling interval for the deferred-respawn reconciliation loop.\n// Must be ≤ 60s to satisfy the R ≤ 60s bound from spec 037 (R = interval + per-tick\n// comparison/spawn overhead; 30 s leaves headroom under the 60 s bound).\nconst deferredRespawnInterval = 30 * time.Second\n\n// concurrencyCapRetryDelay is how long a spawn blocked by MaxConcurrentJobs\n// waits before being re-evaluated. Short relative to a Job's runtime (a\n// github-update-go Job measured 11-15 minutes uncontended on 2026-08-10), so a\n// freed slot is picked up promptly without busy-polling the API server.\nconst concurrencyCapRetryDelay = 60 * time.Second\n\n// deferredEntry tracks a task whose respawn was suppressed by the grace window.\n// The executor re-evaluates it once retryAfter is reached.\ntype deferredEntry struct {\n\ttask       lib.Task\n\tconfig     pkg.AgentConfiguration\n\tretryAfter time.Time\n}\n\n// terminalPhases is the set of phases that must never trigger a new spawn.\n// Extending this set requires a follow-up spec if vault-cli adds new terminal phases.\nvar terminalPhases = map[domain.TaskPhase]struct{}{\n\tdomain.TaskPhaseHumanReview: {},\n\tdomain.TaskPhaseDone:        {},\n}\n\n// knownPhases contains all phase constants exported by vault-cli v0.64.3.\n// Values outside this set trigger enum-drift logging (event=unknown_phase).\nvar knownPhases = map[domain.TaskPhase]struct{}{\n\tdomain.TaskPhaseTodo:        {},\n\tdomain.TaskPhasePlanning:    {},\n\tdomain.TaskPhaseExecution:   {}, // canonical (was TaskPhaseInProgress)\n\tdomain.TaskPhaseInProgress:  {}, // legacy alias — still a known phase string\n\tdomain.TaskPhaseAIReview:    {},\n\tdomain.TaskPhaseHumanReview: {},\n\tdomain.TaskPhaseDone:        {},\n}\n\n// IsTerminal reports whether the given phase is in the terminal set.\n// Tasks at a terminal phase must not be re-spawned; operator intervention is required.\nfunc IsTerminal(phase domain.TaskPhase) bool {\n\t_, ok := terminalPhases[phase]\n\treturn ok\n}\n\n// applyPhaseGate emits metrics/logs for terminal and unknown phases.\n// Returns true when the task must be skipped (terminal phase suppressed).\nfunc applyPhaseGate(task lib.Task, phase domain.TaskPhase) bool {\n\tif IsTerminal(phase) {\n\t\tglog.Infof(\"event=spawn_suppressed phase=%s task=%s\", phase, task.TaskIdentifier)\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"spawn_suppressed_terminal_phase\").Inc()\n\t\treturn true\n\t}\n\tif _, inKnown := knownPhases[phase]; !inKnown {\n\t\tglog.Infof(\"event=unknown_phase phase=%s task=%s\", phase, task.TaskIdentifier)\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"unknown_phase\").Inc()\n\t}\n\treturn false\n}\n\n//counterfeiter:generate -o ../../mocks/task_event_handler.go --fake-name FakeTaskEventHandler . TaskEventHandler\n\n// TaskEventHandler processes task event messages from Kafka and manages deferred respawns.\ntype TaskEventHandler interface {\n\tConsumeMessage(ctx context.Context, msg *sarama.ConsumerMessage) error\n\t// EvalDeferredRespawns evaluates all pending deferred-respawn entries immediately.\n\t// Called by RunDeferredRespawnLoop on each tick; also callable directly in tests.\n\tEvalDeferredRespawns(ctx context.Context) error\n\t// RunDeferredRespawnLoop polls evalDeferredRespawns every deferredRespawnInterval\n\t// until ctx is cancelled. Must be run alongside the Kafka consumer.\n\tRunDeferredRespawnLoop(ctx context.Context) error\n}\n\n// NewTaskEventHandler creates a new TaskEventHandler.\nfunc NewTaskEventHandler(\n\tjobSpawner spawner.JobSpawner,\n\tbranch base.Branch,\n\tresolver pkg.ConfigResolver,\n\tresultPublisher pkg.ResultPublisher,\n\ttaskStore *pkg.TaskStore,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n) TaskEventHandler {\n\treturn &taskEventHandler{\n\t\tjobSpawner:       jobSpawner,\n\t\tbranch:           branch,\n\t\tresolver:         resolver,\n\t\tresultPublisher:  resultPublisher,\n\t\ttaskStore:        taskStore,\n\t\tcurrentDateTime:  currentDateTime,\n\t\tdeferredRespawns: make(map[lib.TaskIdentifier]deferredEntry),\n\t\tspawnLocks:       make(map[string]*sync.Mutex),\n\t}\n}\n\ntype taskEventHandler struct {\n\tjobSpawner       spawner.JobSpawner\n\tbranch           base.Branch\n\tresolver         pkg.ConfigResolver\n\tresultPublisher  pkg.ResultPublisher\n\ttaskStore        *pkg.TaskStore\n\tcurrentDateTime  libtime.CurrentDateTimeGetter\n\tdeferredMu       sync.Mutex\n\tdeferredRespawns map[lib.TaskIdentifier]deferredEntry\n\tspawnLocksMu     sync.Mutex\n\tspawnLocks       map[string]*sync.Mutex\n}\n\n// lockAssigneeSpawn serializes the count-then-spawn sequence for one assignee and\n// returns the unlock func. It is the mutual exclusion that makes MaxConcurrentJobs\n// an actual cap rather than an advisory hint.\n//\n// Without it the cap is a check-then-act race: spawnIfNeeded is reached from two\n// goroutines — the Kafka consumer (consumer.Consume) and the deferred-respawn loop\n// (RunDeferredRespawnLoop), both started by service.Run in main.go — and each reads\n// the same live Job count before either has created its Job, so both conclude they\n// are under the cap. Measured in prod on 2026-08-15 with cap=1: 36 tasks released at\n// once admitted 17 Jobs, 15 released admitted 15. Every over-cap Job is then rejected\n// by the agent's ResourceQuota, loops on FailedCreate and burns its full\n// activeDeadlineSeconds while merely queued, before being killed without ever running.\n//\n// Per-assignee rather than global: a fleet-wide lock would make one agent's spawn\n// latency everyone's. Serializing per assignee costs nothing — spawns are rare\n// against Job runtimes measured in the 11-15 minute range.\n//\n// WARNING: correct only while the executor runs replicas: 1 (verified in quant dev\n// and prod). Scaling to 2 reinstates the race across processes and requires a lease\n// or leader election instead.\nfunc (h *taskEventHandler) lockAssigneeSpawn(assignee string) func() {\n\th.spawnLocksMu.Lock()\n\tmu, ok := h.spawnLocks[assignee]\n\tif !ok {\n\t\tmu = &sync.Mutex{}\n\t\th.spawnLocks[assignee] = mu\n\t}\n\th.spawnLocksMu.Unlock()\n\n\tmu.Lock()\n\treturn mu.Unlock\n}\n\n// cleanupTerminalTask clears in-flight state when a task has reached a terminal\n// status (completed/aborted). taskStore.Delete stops the job informer from emitting\n// a spurious synthetic failure after the agent published success. removeDeferredEntry\n// cancels any pending grace-window respawn — the terminal event is skipped by the\n// status filter in parseAndFilter BEFORE reaching the terminal-phase gate that would\n// otherwise clear the entry, so without this a deferred entry created during the grace\n// window fires ~300s later and respawns a job for an already-done task (the \"path C\"\n// respawn observed on dev 2026-07-13 for probe 095c58d7).\nfunc (h *taskEventHandler) cleanupTerminalTask(task lib.Task) {\n\tstatus := string(task.Frontmatter.Status())\n\tif status != \"completed\" && status != \"aborted\" {\n\t\treturn\n\t}\n\th.taskStore.Delete(task.TaskIdentifier)\n\th.removeDeferredEntry(task.TaskIdentifier)\n\tglog.V(3).\n\t\tInfof(\"task %s %s: cleared task store + deferred respawn\", task.TaskIdentifier, status)\n}\n\nfunc (h *taskEventHandler) ConsumeMessage(ctx context.Context, msg *sarama.ConsumerMessage) error {\n\ttask, config, skip, err := h.parseAndFilter(ctx, msg)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif skip {\n\t\treturn nil\n\t}\n\t_, err = h.spawnIfNeeded(ctx, task, config)\n\treturn err\n}\n\n// parseAndFilter unmarshals the message and applies all pre-spawn filter checks.\n// Returns (task, config, true, nil) when the message should be silently skipped.\n// Returns (task, config, false, nil) when the task qualifies for spawning.\n// Returns (_, _, false, err) when an unexpected error occurred.\nfunc (h *taskEventHandler) parseAndFilter(\n\tctx context.Context,\n\tmsg *sarama.ConsumerMessage,\n) (lib.Task, *pkg.AgentConfiguration, bool, error) {\n\tif len(msg.Value) == 0 {\n\t\tglog.V(3).Infof(\"skip empty message at offset %d\", msg.Offset)\n\t\treturn lib.Task{}, nil, true, nil\n\t}\n\n\tvar task lib.Task\n\tif err := json.Unmarshal(msg.Value, &task); err != nil {\n\t\tglog.Warningf(\"failed to unmarshal task event at offset %d: %v\", msg.Offset, err)\n\t\treturn lib.Task{}, nil, true, nil\n\t}\n\n\tif task.TaskIdentifier == \"\" {\n\t\tglog.Warningf(\"task event at offset %d has empty TaskIdentifier, skipping\", msg.Offset)\n\t\treturn lib.Task{}, nil, true, nil\n\t}\n\n\th.cleanupTerminalTask(task)\n\n\t// Resolve the per-agent Config before the status/phase checks so both filters\n\t// can use the per-Config trigger. Skip lookup when assignee is empty.\n\tconfig, skip, err := h.resolveConfig(ctx, task)\n\tif err != nil {\n\t\treturn lib.Task{}, nil, false, err\n\t}\n\tif skip {\n\t\treturn lib.Task{}, nil, true, nil\n\t}\n\n\t// Type filter: effective set = {cfg.TaskType} ∪ cfg.TaskTypes.\n\t// Skipped when the effective set is empty (agent has no task types configured).\n\tif mismatch := taskTypeMismatchReason(task, config); mismatch != \"\" {\n\t\tif err := h.resultPublisher.PublishTypeMismatchFailure(ctx, task, mismatch); err != nil {\n\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n\t\t\treturn lib.Task{}, nil, false, errors.Wrapf(\n\t\t\t\tctx, err, \"publish type mismatch failure for task %s\", task.TaskIdentifier,\n\t\t\t)\n\t\t}\n\t\tglog.V(2).Infof(\"type mismatch: %s (task %s)\", mismatch, task.TaskIdentifier)\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"type_mismatch\").Inc()\n\t\treturn lib.Task{}, nil, true, nil\n\t}\n\n\tif !effectiveTriggerStatuses(config).Contains(task.Frontmatter.Status()) {\n\t\tglog.V(3).Infof(\n\t\t\t\"skip task %s with status %s\", task.TaskIdentifier, task.Frontmatter.Status(),\n\t\t)\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_status\").Inc()\n\t\treturn lib.Task{}, nil, true, nil\n\t}\n\n\tphase := task.Frontmatter.Phase()\n\t// terminal phases must not be spawned again — operator escalation required\n\tif phase != nil && applyPhaseGate(task, *phase) {\n\t\th.removeDeferredEntry(task.TaskIdentifier)\n\t\treturn lib.Task{}, nil, true, nil\n\t}\n\tif phase == nil || !effectiveTriggerPhases(config).Contains(*phase) {\n\t\tglog.V(3).Infof(\"skip task %s with phase %v\", task.TaskIdentifier, phase)\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_phase\").Inc()\n\t\treturn lib.Task{}, nil, true, nil\n\t}\n\n\tstage := task.Frontmatter.Stage()\n\tif stage != string(h.branch) {\n\t\tglog.V(3).Infof(\n\t\t\t\"skip task %s with stage %s (executor branch %s)\",\n\t\t\ttask.TaskIdentifier, stage, h.branch,\n\t\t)\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_stage\").Inc()\n\t\treturn lib.Task{}, nil, true, nil\n\t}\n\n\tif task.Frontmatter.Assignee() == \"\" {\n\t\tglog.V(3).Infof(\"skip task %s with empty assignee\", task.TaskIdentifier)\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_assignee\").Inc()\n\t\treturn lib.Task{}, nil, true, nil\n\t}\n\n\treturn task, config, false, nil\n}\n\n// resolveConfig looks up the agent Config CR for the task's assignee.\n// Returns (nil, false, nil) when assignee is empty (caller handles the empty-assignee path).\n// Returns (nil, true, nil) when the assignee is unknown (ErrConfigNotFound).\n// Returns (nil, false, err) on unexpected resolver errors.\nfunc (h *taskEventHandler) resolveConfig(\n\tctx context.Context,\n\ttask lib.Task,\n) (*pkg.AgentConfiguration, bool, error) {\n\tif task.Frontmatter.Assignee() == \"\" {\n\t\treturn nil, false, nil\n\t}\n\tresolved, err := h.resolver.Resolve(ctx, string(task.Frontmatter.Assignee()))\n\tif err != nil {\n\t\tif stderrors.Is(err, pkg.ErrConfigNotFound) {\n\t\t\tglog.Warningf(\n\t\t\t\t\"skip task %s: unknown assignee %s\",\n\t\t\t\ttask.TaskIdentifier,\n\t\t\t\ttask.Frontmatter.Assignee(),\n\t\t\t)\n\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_unknown_assignee\").Inc()\n\t\t\treturn nil, true, nil\n\t\t}\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n\t\treturn nil, false, errors.Wrapf(\n\t\t\tctx,\n\t\t\terr,\n\t\t\t\"resolve agent config for task %s\",\n\t\t\ttask.TaskIdentifier,\n\t\t)\n\t}\n\treturn &resolved, false, nil\n}\n\n// taskTypeMismatchReason returns a non-empty reason string when the task's task_type is not in the\n// agent's effective type set. Returns \"\" when the filter passes (match or effective set is empty).\nfunc taskTypeMismatchReason(task lib.Task, cfg *pkg.AgentConfiguration) string {\n\tif cfg == nil {\n\t\treturn \"\"\n\t}\n\teffectiveTypes := pkg.EffectiveTaskTypes(cfg.TaskType, cfg.TaskTypes)\n\tif len(effectiveTypes) == 0 {\n\t\treturn \"\"\n\t}\n\ttaskType := task.Frontmatter.TaskType()\n\tif pkg.TaskTypeInSet(string(taskType), effectiveTypes) {\n\t\treturn \"\"\n\t}\n\tif taskType == \"\" {\n\t\treturn fmt.Sprintf(\n\t\t\t\"task has no task_type; agent %q accepts %v\",\n\t\t\tcfg.Assignee,\n\t\t\teffectiveTypes,\n\t\t)\n\t}\n\treturn fmt.Sprintf(\n\t\t\"task_type %q not in effective set %v of agent %q\",\n\t\ttaskType, effectiveTypes, cfg.Assignee,\n\t)\n}\n\n// effectiveTriggerPhases returns the phase allow-list from the Config trigger,\n// falling back to defaultTriggerPhases when Trigger is absent or the list is empty.\nfunc effectiveTriggerPhases(cfg *pkg.AgentConfiguration) domain.TaskPhases {\n\tif cfg == nil || cfg.Trigger == nil || len(cfg.Trigger.Phases) == 0 {\n\t\treturn defaultTriggerPhases\n\t}\n\treturn cfg.Trigger.Phases\n}\n\n// effectiveTriggerStatuses returns the status allow-list from the Config trigger,\n// falling back to defaultTriggerStatuses when Trigger is absent or the list is empty.\nfunc effectiveTriggerStatuses(cfg *pkg.AgentConfiguration) domain.TaskStatuses {\n\tif cfg == nil || cfg.Trigger == nil || len(cfg.Trigger.Statuses) == 0 {\n\t\treturn defaultTriggerStatuses\n\t}\n\treturn cfg.Trigger.Statuses\n}\n\n// checkActiveCurrentJob verifies whether spawn must be suppressed due to current_job state.\n// Returns (true, nil) when the spawn must be suppressed (job still active or inside grace window).\n// Returns (false, nil) when spawn may proceed. Returns (false, err) on unexpected errors.\nfunc (h *taskEventHandler) checkActiveCurrentJob(\n\tctx context.Context,\n\ttask lib.Task,\n\tcurrentJob string,\n\tconfig *pkg.AgentConfiguration,\n) (bool, error) {\n\tactive, err := h.jobSpawner.IsJobActive(ctx, task.TaskIdentifier)\n\tif err != nil {\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n\t\treturn false, errors.Wrapf(\n\t\t\tctx,\n\t\t\terr,\n\t\t\t\"check current_job active for task %s\",\n\t\t\ttask.TaskIdentifier,\n\t\t)\n\t}\n\tif active {\n\t\tglog.V(3).Infof(\n\t\t\t\"skip task %s: current_job %s still active (from frontmatter)\",\n\t\t\ttask.TaskIdentifier, currentJob,\n\t\t)\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_active_job\").Inc()\n\t\treturn true, nil\n\t}\n\t// Grace window: suppress respawn while the agent's terminal-phase write propagates.\n\t// Treat missing or unparseable job_started_at as elapsed (preserves legacy-task behavior).\n\tjobStartedAt, parseErr := task.Frontmatter.JobStartedAt()\n\tif parseErr != nil {\n\t\tglog.Warningf(\n\t\t\t\"task %s: failed to parse job_started_at: %v; treating grace period as elapsed\",\n\t\t\ttask.TaskIdentifier, parseErr,\n\t\t)\n\t}\n\tif parseErr == nil && !jobStartedAt.IsZero() {\n\t\telapsed := h.currentDateTime.Now().Time().Sub(jobStartedAt)\n\t\tif elapsed < defaultRespawnGracePeriod {\n\t\t\tglog.Infof(\n\t\t\t\t\"event=respawn_grace_window task=%s current_job=%s elapsed=%.0fs\",\n\t\t\t\ttask.TaskIdentifier, currentJob, elapsed.Seconds(),\n\t\t\t)\n\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"respawn_grace_window\").Inc()\n\t\t\tif config != nil {\n\t\t\t\tretryAfter := jobStartedAt.Add(defaultRespawnGracePeriod)\n\t\t\t\th.deferredMu.Lock()\n\t\t\t\th.deferredRespawns[task.TaskIdentifier] = deferredEntry{\n\t\t\t\t\ttask:       task,\n\t\t\t\t\tconfig:     *config,\n\t\t\t\t\tretryAfter: retryAfter,\n\t\t\t\t}\n\t\t\t\th.deferredMu.Unlock()\n\t\t\t}\n\t\t\treturn true, nil\n\t\t}\n\t}\n\tglog.V(2).Infof(\n\t\t\"task %s: current_job %s no longer active, proceeding to spawn\",\n\t\ttask.TaskIdentifier, currentJob,\n\t)\n\treturn false, nil\n}\n\n// spawnIfNeeded returns (spawned, err): spawned is true iff a new k8s Job was actually launched\n// (i.e. the call reached SpawnJob successfully). All early-return branches (suppression, trigger\n// cap, active job, terminal phase, errors) return spawned=false.\nfunc (h *taskEventHandler) spawnIfNeeded(\n\tctx context.Context,\n\ttask lib.Task,\n\tconfig *pkg.AgentConfiguration,\n) (bool, error) {\n\t// If current_job is set in frontmatter, a prior spawn notification was written\n\t// to the task file. Verify the job is still active; if not, proceed to spawn.\n\tif currentJob := task.Frontmatter.CurrentJob(); currentJob != \"\" {\n\t\tsuppress, err := h.checkActiveCurrentJob(ctx, task, currentJob, config)\n\t\tif err != nil {\n\t\t\treturn false, err\n\t\t}\n\t\tif suppress {\n\t\t\treturn false, nil\n\t\t}\n\t}\n\n\t// Held across the cap check AND the SpawnJob call below, so no other goroutine\n\t// can observe a stale Job count in between. Only taken when a cap is configured:\n\t// an uncapped agent has nothing to serialize, and holding the lock anyway would\n\t// queue its spawns behind each other for no benefit.\n\tif config != nil && config.MaxConcurrentJobs > 0 {\n\t\tdefer h.lockAssigneeSpawn(config.Assignee)()\n\t}\n\n\tactive, err := h.jobSpawner.IsJobActive(ctx, task.TaskIdentifier)\n\tif err != nil {\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n\t\treturn false, errors.Wrapf(ctx, err, \"check active job for task %s\", task.TaskIdentifier)\n\t}\n\tif active {\n\t\tglog.V(3).Infof(\"skip task %s: active job exists\", task.TaskIdentifier)\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_active_job\").Inc()\n\t\treturn false, nil\n\t}\n\n\tcapped, err := h.deferIfAtConcurrencyCap(ctx, task, config)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif capped {\n\t\treturn false, nil\n\t}\n\n\t// Scoped trigger budget: evaluates the opt-in cap against the task's current\n\t// phase+ref scope and publishes the counter write for the spawn about to\n\t// happen. Extracted so spawnIfNeeded stays legible; it owns one decision.\n\tcapped, err = h.applyTriggerBudget(ctx, task)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif capped {\n\t\treturn false, nil\n\t}\n\n\tjobName, err := h.jobSpawner.SpawnJob(ctx, task, *config)\n\tif err != nil {\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n\t\treturn false, errors.Wrapf(ctx, err, \"spawn job for task %s failed\", task.TaskIdentifier)\n\t}\n\n\th.taskStore.Store(task.TaskIdentifier, task)\n\tif err := h.resultPublisher.PublishSpawnNotification(ctx, task, jobName); err != nil {\n\t\t// Log but don't fail — job is already spawned, spawn notification is best-effort\n\t\tglog.Warningf(\"publish spawn notification for task %s failed (job %s still running): %v\",\n\t\t\ttask.TaskIdentifier, jobName, err)\n\t}\n\n\tglog.V(2).Infof(\n\t\t\"spawned job for task %s (assignee=%s image=%s)\",\n\t\ttask.TaskIdentifier, task.Frontmatter.Assignee(), config.Image,\n\t)\n\tmetrics.TaskEventsTotal.WithLabelValues(\"spawned\").Inc()\n\tmetrics.JobsSpawnedTotal.Inc()\n\treturn true, nil\n}\n\n// deferIfAtConcurrencyCap reports whether the agent is already running its\n// configured maximum number of Jobs, and if so registers the task for a\n// deferred respawn instead of spawning now.\n//\n// Deferring rather than skipping is the whole point. Task publication is\n// edge-triggered on vault file changes; being over the cap produces no such\n// change, so a skipped spawn would never be re-driven and the task would sit\n// at in_progress forever, indistinguishable from work in flight.\nfunc (h *taskEventHandler) deferIfAtConcurrencyCap(\n\tctx context.Context,\n\ttask lib.Task,\n\tconfig *pkg.AgentConfiguration,\n) (bool, error) {\n\tif config == nil || config.MaxConcurrentJobs <= 0 {\n\t\treturn false, nil\n\t}\n\trunning, err := h.jobSpawner.CountActiveJobs(ctx, config.Assignee)\n\tif err != nil {\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n\t\treturn false, errors.Wrapf(ctx, err, \"count active jobs for assignee %s\", config.Assignee)\n\t}\n\tif running < config.MaxConcurrentJobs {\n\t\t// Log the ADMIT decision, not just the deferral. Without this, an\n\t\t// over-cap spawn leaves no trace and overshoot can only be found by\n\t\t// counting Jobs in the cluster by hand — which is how the 2026-08-15\n\t\t// race went unnoticed until 17 Jobs existed against a cap of 1.\n\t\t// Same V(1) rationale as the deferral log below.\n\t\tglog.V(1).Infof(\n\t\t\t\"event=concurrency_admit task=%s assignee=%s running=%d cap=%d\",\n\t\t\ttask.TaskIdentifier, config.Assignee, running, config.MaxConcurrentJobs,\n\t\t)\n\t\treturn false, nil\n\t}\n\t// V(1), not V(0): a capped deferral is an expected steady state and repeats\n\t// once per retry interval per waiting task, so V(0) would be a constant\n\t// stream during any backlog. V(1) is inside the deployed verbosity, so it\n\t// stays visible to an operator looking — unlike the V(3) skip that hid the\n\t// wedge fixed in #12.\n\tglog.V(1).Infof(\n\t\t\"event=concurrency_cap task=%s assignee=%s running=%d cap=%d retry_after=%s\",\n\t\ttask.TaskIdentifier, config.Assignee, running, config.MaxConcurrentJobs,\n\t\tconcurrencyCapRetryDelay,\n\t)\n\tmetrics.TaskEventsTotal.WithLabelValues(\"deferred_concurrency_cap\").Inc()\n\th.deferredMu.Lock()\n\th.deferredRespawns[task.TaskIdentifier] = deferredEntry{\n\t\ttask:       task,\n\t\tconfig:     *config,\n\t\tretryAfter: h.currentDateTime.Now().Time().Add(concurrencyCapRetryDelay),\n\t}\n\th.deferredMu.Unlock()\n\treturn true, nil\n}\n\n// evalDeferredRespawns checks all pending deferred-respawn entries and spawns a job\n// for each entry whose retryAfter has been reached. Entries are removed once processed.\n// The respawn_after_grace_window metric and log line fire ONLY when the call actually\n// results in a spawn (spec 037 AC #6: \"recorded each time the follow-up evaluation\n// results in a spawn\"); evaluations that no-op (active job already, trigger cap hit,\n// terminal phase) do not increment the metric.\nfunc (h *taskEventHandler) evalDeferredRespawns(ctx context.Context) error {\n\tnow := h.currentDateTime.Now().Time()\n\n\th.deferredMu.Lock()\n\tvar ready []deferredEntry\n\tfor taskID, entry := range h.deferredRespawns {\n\t\tif !now.Before(entry.retryAfter) {\n\t\t\tready = append(ready, entry)\n\t\t\tdelete(h.deferredRespawns, taskID)\n\t\t}\n\t}\n\th.deferredMu.Unlock()\n\n\tfor _, entry := range ready {\n\t\tentry := entry // capture for closure\n\t\tspawned, err := h.spawnIfNeeded(ctx, entry.task, &entry.config)\n\t\tif err != nil {\n\t\t\treturn errors.Wrapf(\n\t\t\t\tctx, err, \"deferred respawn for task %s\", entry.task.TaskIdentifier,\n\t\t\t)\n\t\t}\n\t\tif !spawned {\n\t\t\tcontinue\n\t\t}\n\t\tjobStartedAt, _ := entry.task.Frontmatter.JobStartedAt()\n\t\telapsed := now.Sub(jobStartedAt)\n\t\tglog.Infof(\n\t\t\t\"event=respawn_after_grace_window task=%s current_job=%s elapsed=%.0fs\",\n\t\t\tentry.task.TaskIdentifier, entry.task.Frontmatter.CurrentJob(), elapsed.Seconds(),\n\t\t)\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"respawn_after_grace_window\").Inc()\n\t}\n\treturn nil\n}\n\n// removeDeferredEntry removes any pending deferred-respawn entry for the given task.\n// Called from parseAndFilter when a terminal-phase event arrives so no stale spawn fires.\nfunc (h *taskEventHandler) removeDeferredEntry(id lib.TaskIdentifier) {\n\th.deferredMu.Lock()\n\tdelete(h.deferredRespawns, id)\n\th.deferredMu.Unlock()\n}\n\n// EvalDeferredRespawns implements TaskEventHandler.\nfunc (h *taskEventHandler) EvalDeferredRespawns(ctx context.Context) error {\n\treturn h.evalDeferredRespawns(ctx)\n}\n\n// seedDeferredRespawnsFromStore scans the in-memory taskStore for tasks that look\n// like in-flight work (current_job set, phase non-terminal) and adds them to\n// deferredRespawns with retryAfter = job_started_at + defaultRespawnGracePeriod.\n// Called once from RunDeferredRespawnLoop on startup. Idempotent: any entry already\n// present in deferredRespawns is left untouched. This restores deferred state lost\n// when the in-memory map is wiped by an executor restart, so a stuck task does not\n// remain stuck for want of a Kafka event that will never arrive.\nfunc (h *taskEventHandler) seedDeferredRespawnsFromStore() {\n\tsnapshot := h.taskStore.Snapshot()\n\n\th.deferredMu.Lock()\n\tdefer h.deferredMu.Unlock()\n\tfor taskID, task := range snapshot {\n\t\tif _, exists := h.deferredRespawns[taskID]; exists {\n\t\t\tcontinue\n\t\t}\n\t\tcurrentJob := task.Frontmatter.CurrentJob()\n\t\tif currentJob == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tphase := task.Frontmatter.Phase()\n\t\tif phase != nil && IsTerminal(*phase) {\n\t\t\tcontinue\n\t\t}\n\t\tjobStartedAt, jobStartedErr := task.Frontmatter.JobStartedAt()\n\t\tif jobStartedErr != nil {\n\t\t\tcontinue\n\t\t}\n\t\th.deferredRespawns[taskID] = deferredEntry{\n\t\t\ttask: task,\n\t\t\t// config: the agent configuration is resolved at event time; the seed\n\t\t\t// uses an empty value here. For seeded entries the config is zero-valued;\n\t\t\t// this is acceptable because the next genuine Kafka event for the task\n\t\t\t// will supply the correct config via the event-driven path.\n\t\t\tretryAfter: jobStartedAt.Add(defaultRespawnGracePeriod),\n\t\t}\n\t}\n}\n\n// RunDeferredRespawnLoop implements TaskEventHandler.\nfunc (h *taskEventHandler) RunDeferredRespawnLoop(ctx context.Context) error {\n\t// Startup reconciliation: recover deferred entries lost across an executor\n\t// restart by scanning the in-memory taskStore. See seedDeferredRespawnsFromStore\n\t// for the restart-safety rationale (spec 037 AC #5).\n\th.seedDeferredRespawnsFromStore()\n\n\t// Fire one eval immediately after seeding so that tasks whose grace has\n\t// already elapsed at startup are picked up without waiting for the first tick.\n\tif err := h.evalDeferredRespawns(ctx); err != nil {\n\t\treturn errors.Wrapf(ctx, err, \"deferred respawn loop initial eval\")\n\t}\n\n\tticker := time.NewTicker(deferredRespawnInterval)\n\tdefer ticker.Stop()\n\tfor {\n\t\tselect {\n\t\tcase <-ctx.Done():\n\t\t\treturn nil\n\t\tcase <-ticker.C:\n\t\t\tif err := h.evalDeferredRespawns(ctx); err != nil {\n\t\t\t\treturn errors.Wrapf(ctx, err, \"deferred respawn loop tick\")\n\t\t\t}\n\t\t}\n\t}\n}\n\n// triggerScopeRefLen is how much of the ref is kept in a scope key. A short prefix\n// is enough to distinguish commits while keeping the frontmatter value readable in\n// the task file, where an operator has to be able to eyeball it.\nconst triggerScopeRefLen = 8\n\n// triggerScope keys the spawn budget to the work being attempted rather than to the\n// task's whole lifetime.\n//\n// A re-dispatch that represents real progress — a new lifecycle phase, or a new\n// commit on the target repo — produces a different scope and earns a fresh budget.\n// A deterministic failure retried against the same phase and the same ref keeps the\n// same scope and burns the budget down. That difference is what lets the cap run by\n// default instead of opt-in.\n//\n// Phase comes from the normalizing accessor, so a phase alias does not split a scope\n// and silently hand out a second budget. ref is absent on human-authored tasks\n// (it is written by the agents that clone a repo, alongside clone_url and base_ref);\n// those tasks scope on phase alone, which is the correct degradation — there is no\n// commit for them to make progress against.\nfunc triggerScope(fm lib.TaskFrontmatter) string {\n\tvar phase string\n\tif p := fm.Phase(); p != nil {\n\t\tphase = string(*p)\n\t}\n\tref, _ := fm.String(\"ref\")\n\tif len(ref) > triggerScopeRefLen {\n\t\tref = ref[:triggerScopeRefLen]\n\t}\n\treturn phase + \":\" + ref\n}\n\n// applyTriggerBudget evaluates the scoped trigger cap for one spawn decision and,\n// when the spawn may proceed, publishes exactly one counter write recording it.\n// Returns capped=true when the cap is reached and the spawn must be skipped.\n//\n// The cap stays OPT-IN: an absent max_triggers still means no cap.\n//\n// Scoping does not make it safe to default on, which was the original plan for\n// this change. A recurring task is exactly the case v0.7.1 protected after the\n// 2026-08-27 prod incident (Daily Sentry Triage: the lib default-3 fallback\n// stripped assignee on the 3rd trigger and silently killed the re-dispatch loop),\n// and such a task is NOT repo-backed — it carries no ref and sits at a stable\n// phase, so its scope is a constant. The counter would accrue across re-dispatches\n// exactly as before and the cap would fire at 3, re-creating the incident.\n// Scoping only helps where the scope actually moves.\n//\n// What scoping DOES fix is the opt-in cap's correctness: a task that opts in no\n// longer burns its budget across unrelated attempts, so an operator can set a\n// tight max_triggers without it leaking into the next phase or the next commit.\nfunc (h *taskEventHandler) applyTriggerBudget(\n\tctx context.Context,\n\ttask lib.Task,\n) (bool, error) {\n\tcurrentScope := triggerScope(task.Frontmatter)\n\tstoredScope, hasScope := task.Frontmatter.String(\"trigger_scope\")\n\n\t// An ABSENT scope is not a CHANGED scope. Every task in flight today predates\n\t// this field, so treating absent as changed would hand each of them a free\n\t// budget reset on the first event after deploy — including one already looping\n\t// at cap, which would resume for another N. Absent means \"adopt the current\n\t// scope, keep the count\".\n\tscopeChanged := hasScope && storedScope != currentScope\n\n\t_, optedIn := task.Frontmatter[\"max_triggers\"]\n\tif optedIn && !scopeChanged &&\n\t\ttask.Frontmatter.TriggerCount() >= task.Frontmatter.MaxTriggers() {\n\t\tglog.V(2).Infof(\"skip task %s: trigger_count %d >= max_triggers %d in scope %q\",\n\t\t\ttask.TaskIdentifier,\n\t\t\ttask.Frontmatter.TriggerCount(),\n\t\t\ttask.Frontmatter.MaxTriggers(),\n\t\t\tcurrentScope,\n\t\t)\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"skipped_trigger_cap\").Inc()\n\t\treturn true, nil\n\t}\n\n\t// Exactly one publish per spawn in every branch. Splitting \"write the scope\"\n\t// and \"count the spawn\" into two commands would emit two writes for one spawn\n\t// and let them interleave with a concurrent write.\n\tcount, useScopeWrite := triggerBudgetWrite(task.Frontmatter, scopeChanged, hasScope)\n\tif !useScopeWrite {\n\t\tif err := h.resultPublisher.PublishIncrementTriggerCount(ctx, task); err != nil {\n\t\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n\t\t\treturn false, errors.Wrapf(\n\t\t\t\tctx, err, \"publish increment trigger_count for task %s\", task.TaskIdentifier,\n\t\t\t)\n\t\t}\n\t\treturn false, nil\n\t}\n\n\tglog.V(2).Infof(\"task %s: trigger scope %q -> %q, trigger_count -> %d\",\n\t\ttask.TaskIdentifier, storedScope, currentScope, count,\n\t)\n\tif err := h.resultPublisher.PublishSetTriggerScope(ctx, task, currentScope, count); err != nil {\n\t\tmetrics.TaskEventsTotal.WithLabelValues(\"error\").Inc()\n\t\treturn false, errors.Wrapf(\n\t\t\tctx, err, \"publish set trigger scope for task %s\", task.TaskIdentifier,\n\t\t)\n\t}\n\treturn false, nil\n}\n\n// triggerBudgetWrite decides which counter write a spawn needs. useScopeWrite\n// reports whether the scope itself must be persisted alongside the count.\n//\n//   - scope changed: fresh budget at 1, counting the spawn about to happen.\n//   - scope absent: adopt at count+1 — carry the existing attempts forward rather\n//     than resetting, so the migration to this field grants nobody a free budget.\n//   - scope unchanged: no scope write; the ordinary increment path applies.\nfunc triggerBudgetWrite(\n\tfm lib.TaskFrontmatter,\n\tscopeChanged bool,\n\thasScope bool,\n) (int, bool) {\n\tswitch {\n\tcase scopeChanged:\n\t\treturn 1, true\n\tcase !hasScope:\n\t\treturn fm.TriggerCount() + 1, true\n\tdefault:\n\t\treturn 0, false\n\t}\n}\n","numLines":824,"startLine":1,"totalLines":824}}}
