 of the existing K8s secret holding the git-rest gateway secret (data key gateway-secret); empty disables gateway auth\"`\n76\t\t// TaskGlob is the git-rest single-level glob selecting the vault task files\n77\t\t// the reconcile loop evaluates, relative to the repo root. Consumed by the\n78\t\t// reconcile loop in the follow-up prompt.\n79\t\tTaskGlob string `required:\"false\" arg:\"task-glob\"                      env:\"TASK_GLOB\"                      usage:\"git-rest glob selecting vault task files to reconcile\"                                                                                                                                                                                                                              default:\"24 Tasks/*.md\"`\n80\t}\n81\t\n82\t// vaultSlugRegexp mirrors the controller's VAULT_NAME validation (pkg/routing):\n83\t// a lowercase letter, then lowercase letters, digits, or hyphens. The composed\n84\t// {assignee}-{vaultName} lookup key depends on a well-formed vault slug — a\n85\t// malformed value would silently never match a Config CR.\n86\tvar vaultSlugRegexp = regexp.MustCompile(`^[a-z][a-z0-9-]*$`)\n87\t\n88\t//nolint:funlen // Initialization sequence; wiring is linear with no branching.\n89\tfunc (a *application) Run(ctx context.Context, sentryClient libsentry.Client) error {\n90\t\tlibmetrics.NewBuildInfoMetrics().SetBuildInfo(a.BuildGitVersion, a.BuildGitCommit, a.BuildDate)\n91\t\tglog.V(1).\n92\t\t\tInfof(\"agent-task-executor started version=%s commit=%s\", a.BuildGitVersion, a.BuildGitCommit)\n93\t\n94\t\tif a.JobTTLSecondsAfterFinished < 0 {\n95\t\t\treturn errors.Errorf(\n96\t\t\t\tctx,\n97\t\t\t\t\"job-ttl-seconds-after-finished must be >= 0 (0 deletes immediately), got %d\",\n98\t\t\t\ta.JobTTLSecondsAfterFinished,\n99\t\t\t)\n100\t\t}\n101\t\tif !vaultSlugRegexp.MatchString(a.VaultName) {\n102\t\t\treturn errors.Errorf(\n103\t\t\t\tctx,\n104\t\t\t\t\"vault-name must match ^[a-z][a-z0-9-]*$ (lowercase letter, then lowercase/digits/hyphens), got %q\",\n105\t\t\t\ta.VaultName,\n106\t\t\t)\n107\t\t}\n108\t\n109\t\tkubeConfig, err := rest.InClusterConfig()\n110\t\tif err != nil {\n111\t\t\treturn errors.Wrapf(ctx, err, \"get in-cluster k8s config\")\n112\t\t}\n113\t\tkubeClient, err := kubernetes.NewForConfig(kubeConfig)\n114\t\tif err != nil {\n115\t\t\treturn errors.Wrapf(ctx, err, \"create k8s client\")\n116\t\t}\n117\t\n118\t\tconnector := factory.CreateK8sConnector(kubeConfig)\n119\t\tif err := connector.SetupCustomResourceDefinition(ctx); err != nil {\n120\t\t\treturn errors.Wrapf(ctx, err, \"setup Config CRD\")\n121\t\t}\n122\t\teventHandlerConfig := factory.CreateEventHandlerConfig()\n123\t\tresourceEventHandler := factory.CreateResourceEventHandlerConfig(\n124\t\t\tctx,\n125\t\t\teventHandlerConfig,\n126\t\t)\n127\t\tresolver := factory.CreateConfigResolver(eventHandlerConfig, a.Branch, a.VaultName)\n128\t\n129\t\tsaramaClient, err := libkafka.CreateSaramaClient(\n130\t\t\tctx,\n131\t\t\tlibkafka.ParseBrokersFromString(a.KafkaBrokers),\n132\t\t)\n133\t\tif err != nil {\n134\t\t\treturn errors.Wrapf(ctx, err, \"create sarama client\")\n135\t\t}\n136\t\tdefer saramaClient.Close()\n137\t\tcurrentDateTimeGetter := libtime.NewCurrentDateTime()\n138\t\tsyncProducer, err := libkafka.NewSyncProducerFromSaramaClient(ctx, saramaClient)\n139\t\tif err != nil {\n140\t\t\treturn errors.Wrapf(ctx, err, \"create kafka sync producer\")\n141\t\t}\n142\t\tdefer syncProducer.Close()\n143\t\n144\t\tresultPublisher := pkg.NewResultPublisher(syncProducer, a.TopicPrefix, currentDateTimeGetter)\n145\t\ttaskStore := pkg.NewTaskStore()\n146\t\tjobWatcher := factory.CreateJobWatcher(kubeClient, a.Namespace, taskStore, resultPublisher)\n147\t\n148\t\tzombieSweeper := factory.CreateZombieSweeper(\n149\t\t\tjobWatcher,\n150\t\t\ta.Namespace,\n151\t\t\ttaskStore,\n152\t\t\tresultPublisher,\n153\t\t\teventHandlerConfig,\n154\t\t\tcurrentDateTimeGetter,\n155\t\t)\n156\t\n157\t\thealthcheckRunner := factory.CreateHealthcheckRunner(\n158\t\t\teventHandlerConfig,\n159\t\t\tsyncProducer,\n160\t\t\ta.TopicPrefix,\n161\t\t\ta.Branch,\n162\t\t)\n163\t\thealthcheckCron := factory.CreateHealthcheckCron(\n164\t\t\tlibcron.Expression(a.HealthcheckCronExpression),\n165\t\t\thealthcheckRunner,\n166\t\t)\n167\t\n168\t\tconsumer, taskEventHandler := factory.CreateConsumer(\n169\t\t\tsaramaClient,\n170\t\t\ta.Branch,\n171\t\t\ta.TopicPrefix,\n172\t\t\tkubeClient,\n173\t\t\ta.Namespace,\n174\t\t\ta.KafkaBrokers,\n175\t\t\tresolver,\n176\t\t\tlog.DefaultSamplerFactory,\n177\t\t\tcurrentDateTimeGetter,\n178\t\t\tresultPublisher,\n179\t\t\ttaskStore,\n180\t\t\ta.JobTTLSecondsAfterFinished,\n181\t\t\ta.JobKafkaClientCertSecret,\n182\t\t\ta.JobKafkaCaCertSecret,\n183\t\t)\n184\t\n185\t\treturn service.Run(\n186\t\t\tctx,\n187\t\t\tfunc(ctx context.Context) error {\n188\t\t\t\treturn connector.Listen(ctx, a.Namespace, resourceEventHandler)\n189\t\t\t},\n190\t\t\tconsumer.Consume,\n191\t\t\ttaskEventHandler.RunDeferredRespawnLoop,\n192\t\t\tjobWatcher.Run,\n193\t\t\tzombieSweeper.Run,\n194\t\t\ta.createHTTPServer(eventHandlerConfig, healthcheckRunner),\n195\t\t\thealthcheckCron.Run,\n196\t\t)\n197\t}\n198\t\n199\tfunc (a *application) createHTTPServer(\n200\t\tconfigProvider pkg.EventHandlerConfig,\n201\t\trunner probe.HealthcheckRunner,\n202\t) run.Func {\n203\t\treturn func(ctx context.Context) error {\n204\t\t\trouter := mux.NewRouter()\n205\t\t\trouter.Path(\"/healthz\").Handler(libhttp.NewPrintHandler(\"OK\"))\n206\t\t\trouter.Path(\"/readiness\").Handler(libhttp.NewPrintHandler(\"OK\"))\n207\t\t\trouter.Path(\"/metrics\").Handler(promhttp.Handler())\n208\t\t\trouter.Path(\"/setloglevel/{level}\").\n209\t\t\t\tHandler(log.NewSetLoglevelHandler(ctx, log.NewLogLevelSetter(2, 5*time.Minute)))\n210\t\t\trouter.Path(\"/gc\").Handler(libhttp.NewGarbageCollectorHandler())\n211\t\n212\t\t\trouter.Path(\"/agents\").\n213\t\t\t\tHandler(handler.NewAgentsHandler(configProvider, os.