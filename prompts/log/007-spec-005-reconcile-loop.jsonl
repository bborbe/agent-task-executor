y secret %q\", secretName)\n43\t\t}\n44\t\tvalue, ok := secret.Data[gitRestGatewaySecretDataKey]\n45\t\tif !ok {\n46\t\t\treturn \"\", errors.Errorf(\n47\t\t\t\tctx,\n48\t\t\t\t\"secret %q lacks data key %q\",\n49\t\t\t\tsecretName,\n50\t\t\t\tgitRestGatewaySecretDataKey,\n51\t\t\t)\n52\t\t}\n53\t\treturn string(value), nil\n54\t}\n55\t"}]},"parent_tool_use_id":null,"session_id":"5ba5489b-e40f-49fc-85d7-40747c5d6555","uuid":"a8db4a62-2e07-4d1e-abd6-071fea8e08a2","timestamp":"2026-09-03T18:26:30.847Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/gitrest_gateway_secret.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage pkg\n\nimport (\n\t\"context\"\n\n\t\"github.com/bborbe/errors\"\n\tlibk8s \"github.com/bborbe/k8s\"\n\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"\n\t\"k8s.io/client-go/kubernetes\"\n)\n\n// gitRestGatewaySecretDataKey is the data key inside the referenced K8s Secret\n// that holds the git-rest gateway secret value. Matches the controller chart's\n// `gateway-secret` data key (the Secret git-rest and the controller share).\nconst gitRestGatewaySecretDataKey = \"gateway-secret\"\n\n// ReadGitRestGatewaySecret returns the git-rest gateway secret value from the\n// named K8s Secret, or \"\" when secretName is empty (gateway auth disabled).\n// The value is read once at startup and held in memory only — it is never\n// logged, never embedded in the image, and never in env (spec 005 Security;\n// the env var GITREST_GATEWAY_SECRET references the secret by NAME, matching\n// the JobKafkaClientCertSecret pattern). Returns an error when the Secret is\n// missing or lacks the gateway-secret data key, so a misconfigured deployment\n// fails loudly at startup instead of silently sending no auth header.\nfunc ReadGitRestGatewaySecret(\n\tctx context.Context,\n\tkubeClient kubernetes.Interface,\n\tnamespace libk8s.Namespace,\n\tsecretName string,\n) (string, error) {\n\tif secretName == \"\" {\n\t\treturn \"\", nil\n\t}\n\tsecret, err := kubeClient.CoreV1().\n\t\tSecrets(namespace.String()).\n\t\tGet(ctx, secretName, metav1.GetOptions{})\n\tif err != nil {\n\t\treturn \"\", errors.Wrapf(ctx, err, \"get git-rest gateway secret %q\", secretName)\n\t}\n\tvalue, ok := secret.Data[gitRestGatewaySecretDataKey]\n\tif !ok {\n\t\treturn \"\", errors.Errorf(\n\t\t\tctx,\n\t\t\t\"secret %q lacks data key %q\",\n\t\t\tsecretName,\n\t\t\tgitRestGatewaySecretDataKey,\n\t\t)\n\t}\n\treturn string(value), nil\n}\n","numLines":55,"startLine":1,"totalLines":55}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-ae0ca5fdef60c947","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage gitrestclient\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"encoding/json\"\n10\t\t\"io\"\n11\t\t\"net/http\"\n12\t\t\"net/url\"\n13\t\t\"strings\"\n14\t\t\"time\"\n15\t\n16\t\t\"github.com/bborbe/errors\"\n17\t)\n18\t\n19\t//counterfeiter:generate -o ../../mocks/git_rest_client.go --fake-name FakeGitRestClient . GitRestClient\n20\t\n21\t// GitRestClient is the HTTP client for git-rest's /api/v1/files REST API.\n22\t// All paths are relative to the repo root (e.g. \"tasks/foo.md\"). The executor\n23\t// uses only the read surface (List/Get/IsReady) — it never writes vault files\n24\t// through git-rest (spec 005 Security).\n25\ttype GitRestClient interface {\n26\t\t// Get retrieves the current content of the file at relPath.\n27\t\tGet(ctx context.Context, relPath string) ([]byte, error)\n28\t\t// List returns relative paths matching the single-level glob pattern (e.g. \"tasks/*.md\").\n29\t\tList(ctx context.Context, glob string) ([]string, error)\n30\t\t// IsReady reports whether git-rest's /readiness returns 200.\n31\t\t// Returns (false, nil) when git-rest returns 503 — that is a valid not-ready state, not an error.\n32\t\t// Returns (false, err) only on network failure or unexpected response.\n33\t\tIsReady(ctx context.Context) (bool, error)\n34\t}\n35\t\n36\t// NewGitRestClient creates a GitRestClient targeting the git-rest instance at\n37\t// baseURL. gatewaySecret is the shared secret enforced by git-rest's\n38\t// gateway-secret auth; when empty, no auth headers are sent (backward-compat\n39\t// with auth-disabled git-rest). gatewayInitiator is the caller identity logged\n40\t// by git-rest on auth failure (pass a stable value, e.g. \"agent-task-executor\").\n41\tfunc NewGitRestClient(baseURL, gatewaySecret, gatewayInitiator string) GitRestClient {\n42\t\treturn &gitRestClient{\n43\t\t\tbaseURL:          strings.TrimRight(baseURL, \"/\"),\n44\t\t\thttpClient:       &http.Client{Timeout: 30 * time.Second},\n45\t\t\tgatewaySecret:    gatewaySecret,\n46\t\t\tgatewayInitiator: gatewayInitiator,\n47\t\t}\n48\t}\n49\t\n50\ttype gitRestClient struct {\n51\t\tbaseURL          string\n52\t\thttpClient       *http.Client\n53\t\tgatewaySecret    string\n54\t\tgatewayInitiator string\n55\t}\n56\t\n57\t// setAuthHeaders sets the gateway-secret auth headers on req when the secret is configured.\n58\t// No-op when gatewaySecret is empty — keeps backward compatibility with auth-disabled git-rest.\n59\t//\n60\t// Header names are part of the git-rest public contract (spec 004) — do NOT alter:\n61\t//\n62\t//\tX-Gateway-Secret   — the shared secret\n63\t//\tX-Gateway-Initator — caller identity (deliberate misspelling, do NOT change to \"Initiator\")\n64\tfunc (g *gitRestClient) setAuthHeaders(req *http.Request) {\n65\t\tif g.gatewaySecret == \"\" {\n66\t\t\treturn\n67\t\t}\n68\t\treq.Header.Set(\"X-Gateway-Secret\", g.gatewaySecret)\n69\t\treq.Header.Set(\"X-Gateway-Initator\", g.gatewayInitiator)\n70\t}\n71\t\n72\t// fileURL builds /api/v1/files/<relPath> with proper percent-escaping so\n73\t// characters like %, space, # in relPath survive the round-trip to git-rest.\n74\tfunc (g *gitRestClient) fileURL(relPath string) string {\n75\t\tsegments := strings.Split(relPath, \"/\")\n76\t\tfor i, s := range segments {\n77\t\t\tsegments[i] = url.PathEscape(s)\n78\t\t}\n79\t\treturn g.baseURL + \"/api/v1/files/\" + strings.Join(segments, \"/\")\n80\t}\n81\t\n82\t// Get retrieves file content from git-rest. Does not retry — reads fail-fast.\n83\tfunc (g *gitRestClient) Get(ctx context.Context, relPath string) ([]byte, error) {\n84\t\treqURL := g.fileURL(relPath)\n85\t\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n86\t\tif err != nil {\n87\t\t\treturn nil, errors.Wrapf(ctx, err, \"create GET request for %s\", relPath)\n88\t\t}\n89\t\tg.setAuthHeaders(req)\n90\t\tresp, err := g.httpClient.Do(req)\n91\t\tif err != nil {\n92\t\t\treturn nil, errors.Wrapf(ctx, err, \"GET %s\", relPath)\n93\t\t}\n94\t\tdefer resp.Body.Close()\n95\t\tbody, err := io.ReadAll(io.LimitReader(resp.Body, 10*1024*1024)) // 10 MiB max\n96\t\tif err != nil {\n97\t\t\treturn nil, errors.Wrapf(ctx, err, \"read GET response body for %s\", relPath)\n98\t\t}\n99\t\tif resp.StatusCode != http.StatusOK {\n100\t\t\tpreview := string(body)\n101\t\t\tif len(preview) > 100 {\n102\t\t\t\tpreview = preview[:100]\n103\t\t\t}\n104\t\t\treturn nil, errors.Errorf(ctx, \"GET %s returned %d: %s\", relPath, resp.StatusCode, preview)\n105\t\t}\n106\t\treturn body, nil\n107\t}\n108\t\n109\t// List returns paths matching the glob pattern. Does not retry — reads fail-fast.\n110\tfunc (g *gitRestClient) List(ctx context.Context, glob string) ([]string, error) {\n111\t\treqURL := g.baseURL + \"/api/v1/files/\"\n112\t\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n113\t\tif err != nil {\n114\t\t\treturn nil, errors.Wrapf(ctx, err, \"create LIST request for glob %s\", glob)\n115\t\t}\n116\t\tq := url.Values{}\n117\t\tq.Set(\"glob\", glob)\n118\t\treq.URL.RawQuery = q.Encode()\n119\t\tg.setAuthHeaders(req)\n120\t\tresp, err := g.httpClient.Do(req)\n121\t\tif err != nil {\n122\t\t\treturn nil, errors.Wrapf(ctx, err, \"LIST glob %s\", glob)\n123\t\t}\n124\t\tdefer resp.Body.Close()\n125\t\tbody, err := io.ReadAll(io.LimitReader(resp.Body, 10*1024*1024)) // 10 MiB max\n126\t\tif err != nil {\n127\t\t\treturn nil, errors.Wrapf(ctx, err, \"read LIST response body for glob %s\", glob)\n128\t\t}\n129\t\tif resp.StatusCode != http.StatusOK {\n130\t\t\tpreview := string(body)\n131\t\t\tif len(preview) > 100 {\n132\t\t\t\tpreview = preview[:100]\n133\t\t\t}\n134\t\t\treturn nil, errors.Errorf(\n135\t\t\t\tctx,\n136\t\t\t\t\"LIST glob %s returned %d: %s\",\n137\t\t\t\tglob,\n138\t\t\t\tresp.StatusCode,\n139\t\t\t\tpreview,\n140\t\t\t)\n141\t\t}\n142\t\tvar paths []string\n143\t\tif err := json.Unmarshal(body, &paths); err != nil {\n144\t\t\treturn nil, errors.Wrapf(ctx, err, \"parse LIST response for glob %s\", glob)\n145\t\t}\n146\t\treturn paths, nil\n147\t}\n148\t\n149\t// IsReady checks git-rest's /readiness endpoint.\n150\tfunc (g *gitRestClient) IsReady(ctx context.Context) (bool, error) {\n151\t\treqURL := g.baseURL + \"/readiness\"\n152\t\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n153\t\tif err != nil {\n154\t\t\treturn false, errors.Wrapf(ctx, err, \"create readiness request\")\n155\t\t}\n156\t\tresp, err := g.httpClient.Do(req)\n157\t\tif err != nil {\n158\t\t\treturn false, errors.Wrapf(ctx, err, \"readiness check\")\n159\t\t}\n160\t\t_, _ = io.Copy(io.Discard, resp.Body)\n161\t\t_ = resp.Body.Close()\n162\t\tswitch resp.StatusCode {\n163\t\tcase http.StatusOK:\n164\t\t\treturn true, nil\n165\t\tcase http.StatusServiceUnavailable:\n166\t\t\treturn false, nil\n167\t\tdefault:\n168\t\t\treturn false, errors.Errorf(ctx, \"readiness returned unexpected status %d\", resp.StatusCode)\n169\t\t}\n170\t}\n171\t"}]},"parent_tool_use_id":null,"session_id":"5ba5489b-e40f-49fc-85d7-40747c5d6555","uuid":"39102deb-8435-427e-8104-524e772224b6","timestamp":"2026-09-03T18:26:30.848Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/gitrestclient/git_rest_client.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage gitrestclient\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"io\"\n\t\"net/http\"\n\t\"net/url\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/bborbe/errors\"\n)\n\n//counterfeiter:generate -o ../../mocks/git_rest_client.go --fake-name FakeGitRestClient . GitRestClient\n\n// GitRestClient is the HTTP client for git-rest's /api/v1/files REST API.\n// All paths are relative to the repo root (e.g. \"tasks/foo.md\"). The executor\n// uses only the read surface (List/Get/IsReady) — it never writes vault files\n// through git-rest (spec 005 Security).\ntype GitRestClient interface {\n\t// Get retrieves the current content of the file at relPath.\n\tGet(ctx context.Context, relPath string) ([]byte, error)\n\t// List returns relative paths matching the single-level glob pattern (e.g. \"tasks/*.md\").\n\tList(ctx context.Context, glob string) ([]string, error)\n\t// IsReady reports whether git-rest's /readiness returns 200.\n\t// Returns (false, nil) when git-rest returns 503 — that is a valid not-ready state, not an error.\n\t// Returns (false, err) only on network failure or unexpected response.\n\tIsReady(ctx context.Context) (bool, error)\n}\n\n// NewGitRestClient creates a GitRestClient targeting the git-rest instance at\n// baseURL. gatewaySecret is the shared secret enforced by git-rest's\n// gateway-secret auth; when empty, no auth headers are sent (backward-compat\n// with auth-disabled git-rest). gatewayInitiator is the caller identity logged\n// by git-rest on auth failure (pass a stable value, e.g. \"agent-task-executor\").\nfunc NewGitRestClient(baseURL, gatewaySecret, gatewayInitiator string) GitRestClient {\n\treturn &gitRestClient{\n\t\tbaseURL:          strings.TrimRight(baseURL, \"/\"),\n\t\thttpClient:       &http.Client{Timeout: 30 * time.Second},\n\t\tgatewaySecret:    gatewaySecret,\n\t\tgatewayInitiator: gatewayInitiator,\n\t}\n}\n\ntype gitRestClient struct {\n\tbaseURL          string\n\thttpClient       *http.Client\n\tgatewaySecret    string\n\tgatewayInitiator string\n}\n\n// setAuthHeaders sets the gateway-secret auth headers on req when the secret is configured.\n// No-op when gatewaySecret is empty — keeps backward compatibility with auth-disabled git-rest.\n//\n// Header names are part of the git-rest public contract (spec 004) — do NOT alter:\n//\n//\tX-Gateway-Secret   — the shared secret\n//\tX-Gateway-Initator — caller identity (deliberate misspelling, do NOT change to \"Initiator\")\nfunc (g *gitRestClient) setAuthHeaders(req *http.Request) {\n\tif g.gatewaySecret == \"\" {\n\t\treturn\n\t}\n\treq.Header.Set(\"X-Gateway-Secret\", g.gatewaySecret)\n\treq.Header.Set(\"X-Gateway-Initator\", g.gatewayInitiator)\n}\n\n// fileURL builds /api/v1/files/<relPath> with proper percent-escaping so\n// characters like %, space, # in relPath survive the round-trip to git-rest.\nfunc (g *gitRestClient) fileURL(relPath string) string {\n\tsegments := strings.Split(relPath, \"/\")\n\tfor i, s := range segments {\n\t\tsegments[i] = url.PathEscape(s)\n\t}\n\treturn g.baseURL + \"/api/v1/files/\" + strings.Join(segments, \"/\")\n}\n\n// Get retrieves file content from git-rest. Does not retry — reads fail-fast.\nfunc (g *gitRestClient) Get(ctx context.Context, relPath string) ([]byte, error) {\n\treqURL := g.fileURL(relPath)\n\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n\tif err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"create GET request for %s\", relPath)\n\t}\n\tg.setAuthHeaders(req)\n\tresp, err := g.httpClient.Do(req)\n\tif err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"GET %s\", relPath)\n\t}\n\tdefer resp.Body.Close()\n\tbody, err := io.ReadAll(io.LimitReader(resp.Body, 10*1024*1024)) // 10 MiB max\n\tif err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"read GET response body for %s\", relPath)\n\t}\n\tif resp.StatusCode != http.StatusOK {\n\t\tpreview := string(body)\n\t\tif len(preview) > 100 {\n\t\t\tpreview = preview[:100]\n\t\t}\n\t\treturn nil, errors.Errorf(ctx, \"GET %s returned %d: %s\", relPath, resp.StatusCode, preview)\n\t}\n\treturn body, nil\n}\n\n// List returns paths matching the glob pattern. Does not retry — reads fail-fast.\nfunc (g *gitRestClient) List(ctx context.Context, glob string) ([]string, error) {\n\treqURL := g.baseURL + \"/api/v1/files/\"\n\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n\tif err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"create LIST request for glob %s\", glob)\n\t}\n\tq := url.Values{}\n\tq.Set(\"glob\", glob)\n\treq.URL.RawQuery = q.Encode()\n\tg.setAuthHeaders(req)\n\tresp, err := g.httpClient.Do(req)\n\tif err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"LIST glob %s\", glob)\n\t}\n\tdefer resp.Body.Close()\n\tbody, err := io.ReadAll(io.LimitReader(resp.Body, 10*1024*1024)) // 10 MiB max\n\tif err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"read LIST response body for glob %s\", glob)\n\t}\n\tif resp.StatusCode != http.StatusOK {\n\t\tpreview := string(body)\n\t\tif len(preview) > 100 {\n\t\t\tpreview = preview[:100]\n\t\t}\n\t\treturn nil, errors.Errorf(\n\t\t\tctx,\n\t\t\t\"LIST glob %s returned %d: %s\",\n\t\t\tglob,\n\t\t\tresp.StatusCode,\n\t\t\tpreview,\n\t\t)\n\t}\n\tvar paths []string\n\tif err := json.Unmarshal(body, &paths); err != nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"parse LIST response for glob %s\", glob)\n\t}\n\treturn paths, nil\n}\n\n// IsReady checks git-rest's /readiness endpoint.\nfunc (g *gitRestClient) IsReady(ctx context.Context) (bool, error) {\n\treqURL := g.baseURL + \"/readiness\"\n\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)\n\tif err != nil {\n\t\treturn false, errors.Wrapf(ctx, err, \"create readiness request\")\n\t}\n\tresp, err := g.httpClient.Do(req)\n\tif err != nil {\n\t\treturn false, errors.Wrapf(ctx, err, \"readiness check\")\n\t}\n\t_, _ = io.Copy(io.Discard, resp.Body)\n\t_ = resp.Body.Close()\n\tswitch resp.StatusCode {\n\tcase http.StatusOK:\n\t\treturn true, nil\n\tcase http.StatusServiceUnavailable:\n\t\treturn false, nil\n\tdefault:\n\t\treturn false, errors.Errorf(ctx, \"readiness returned unexpected status %d\", resp.StatusCode)\n\t}\n}\n","numLines":171,"startLine":1,"totalLines":171}}}
