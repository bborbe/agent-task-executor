{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8ffc0bc0cee38d03","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg_test\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"time\"\n10\t\n11\t\tlib \"github.com/bborbe/agent\"\n12\t\tlibtime \"github.com/bborbe/time\"\n13\t\tlibtimetest \"github.com/bborbe/time/test\"\n14\t\t. \"github.com/onsi/ginkgo/v2\"\n15\t\t. \"github.com/onsi/gomega\"\n16\t\tcorev1 \"k8s.io/api/core/v1\"\n17\t\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"\n18\t\tk8sinformers \"k8s.io/client-go/informers\"\n19\t\t\"k8s.io/client-go/kubernetes/fake\"\n20\t\n21\t\tagentv1 \"github.com/bborbe/agent-task-executor/k8s/apis/agent.benjamin-borbe.de/v1\"\n22\t\t\"github.com/bborbe/agent-task-executor/mocks\"\n23\t\t\"github.com/bborbe/agent-task-executor/pkg\"\n24\t)\n25\t\n26\tvar _ = Describe(\"ZombieSweeper\", func() {\n27\t\tvar (\n28\t\t\tctx                context.Context\n29\t\t\tfakePublisher      *mocks.FakeResultPublisher\n30\t\t\ttaskStore          *pkg.TaskStore\n31\t\t\teventHandlerConfig pkg.EventHandlerConfig\n32\t\t\tcurrentDateTime    libtime.CurrentDateTime\n33\t\t)\n34\t\n35\t\tBeforeEach(func() {\n36\t\t\tctx = context.Background()\n37\t\t\tfakePublisher = &mocks.FakeResultPublisher{}\n38\t\t\ttaskStore = pkg.NewTaskStore()\n39\t\t\teventHandlerConfig = pkg.NewEventHandlerConfig()\n40\t\t\tcurrentDateTime = libtime.NewCurrentDateTime()\n41\t\t\t// Default \"now\" for tests: 2026-06-01T12:00:00Z\n42\t\t\tcurrentDateTime.SetNow(libtimetest.ParseDateTime(\"2026-06-01T12:00:00Z\"))\n43\t\t})\n44\t\n45\t\tmakeTask := func(id string, assignee string, currentJob string, jobStartedAt string) lib.Task {\n46\t\t\tfm := lib.TaskFrontmatter{\n47\t\t\t\t\"status\":   \"in_progress\",\n48\t\t\t\t\"assignee\": assignee,\n49\t\t\t}\n50\t\t\tif currentJob != \"\" {\n51\t\t\t\tfm[\"current_job\"] = currentJob\n52\t\t\t}\n53\t\t\tif jobStartedAt != \"\" {\n54\t\t\t\tfm[\"job_started_at\"] = jobStartedAt\n55\t\t\t}\n56\t\t\treturn lib.Task{\n57\t\t\t\tTaskIdentifier: lib.TaskIdentifier(id),\n58\t\t\t\tFrontmatter:    fm,\n59\t\t\t\tContent:        lib.TaskContent(\"do the work\"),\n60\t\t\t}\n61\t\t}\n62\t\n63\t\t// makePodWithCreation creates a pod with a specific CreationTimestamp offset from \"now\"\n64\t\t// (which is set by currentDateTime to 2026-06-01T12:00:00Z).\n65\t\tmakePod := func(name, namespace, taskID string, phase corev1.PodPhase, creationAge time.Duration, conditions ...corev1.PodCondition) *corev1.Pod {\n66\t\t\treturn &corev1.Pod{\n67\t\t\t\tObjectMeta: metav1.ObjectMeta{\n68\t\t\t\t\tName:      name,\n69\t\t\t\t\tNamespace: namespace,\n70\t\t\t\t\tLabels: map[string]string{\n71\t\t\t\t\t\t\"agent.benjamin-borbe.de/task-id\": taskID,\n72\t\t\t\t\t},\n73\t\t\t\t\tCreationTimestamp: metav1.Time{\n74\t\t\t\t\t\t// currentDateTime is 2026-06-01T12:00:00Z, subtract age to get creation time\n75\t\t\t\t\t\tTime: time.Date(2026, 6, 1, 12, 0, 0, 0, time.UTC).Add(-creationAge),\n76\t\t\t\t\t},\n77\t\t\t\t},\n78\t\t\t\tStatus: corev1.PodStatus{\n79\t\t\t\t\tPhase:      phase,\n80\t\t\t\t\tConditions: conditions,\n81\t\t\t\t},\n82\t\t\t}\n83\t\t}\n84\t\n85\t\tpodScheduledFalseCondition := func() corev1.PodCondition {\n86\t\t\treturn corev1.PodCondition{\n87\t\t\t\tType:   corev1.PodScheduled,\n88\t\t\t\tStatus: corev1.ConditionFalse,\n89\t\t\t\tReason: \"Unschedulable\",\n90\t\t\t}\n91\t\t}\n92\t\n93\t\tptrInt32 := func(v int32) *int32 { return &v }\n94\t\n95\t\tDescribe(\"SweepOnce\", func() {\n96\t\t\t// 6a: deadline-exceeded-and-not-running → zombie (deadline_exceeded)\n97\t\t\tContext(\"deadline exceeded with failed pod\", func() {\n98\t\t\t\tIt(\"publishes failure with deadline_exceeded\", func() {\n99\t\t\t\t\ttaskID := lib.TaskIdentifier(\"task-6a-deadline-exceeded\")\n100\t\t\t\t\t// job_started_at = 11:30:00Z, elapsed = 30min at 12:00:00Z\n101\t\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:30:00Z\")\n102\t\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"job-1\", ts.Format(time.RFC3339))\n103\t\t\t\t\ttaskStore.Store(taskID, task)\n104\t\n105\t\t\t\t\t// Config: deadline = 60s\n106\t\t\t\t\tcfg := agentv1.Config{\n107\t\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n108\t\t\t\t\t\tSpec: agentv1.ConfigSpec{\n109\t\t\t\t\t\t\tAssignee:                \"agent-a\",\n110\t\t\t\t\t\t\tZombieJobTimeoutSeconds: ptrInt32(60),\n111\t\t\t\t\t\t},\n112\t\t\t\t\t}\n113\t\t\t\t\t_ = eventHandlerConfig.OnAdd(ctx, cfg)\n114\t\n115\t\t\t\t\tfakeClient := fake.NewSimpleClientset()\n116\t\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n117\t\t\t\t\t\tfakeClient,\n118\t\t\t\t\t\t0,\n119\t\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n120\t\t\t\t\t)\n121\t\t\t\t\tpodInformer := informerFactory.Core().V1().Pods().Informer()\n122\t\t\t\t\t_ = podInformer.GetIndexer().\n123\t\t\t\t\t\tAdd(makePod(\"pod-failed\", \"test-ns\", string(taskID), corev1.PodFailed, 0))\n124\t\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n125\t\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n126\t\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n127\t\n128\t\t\t\t\tsweeper := pkg.NewZombieSweeper(\n129\t\t\t\t\t\tfakeJobWatcher,\n130\t\t\t\t\t\t\"test-ns\",\n131\t\t\t\t\t\ttaskStore,\n132\t\t\t\t\t\tfakePublisher,\n133\t\t\t\t\t\teventHandlerConfig,\n134\t\t\t\t\t\tcurrentDateTime,\n135\t\t\t\t\t)\n136\t\n137\t\t\t\t\terr := sweeper.SweepOnce(ctx)\n138\t\t\t\t\tExpect(err).To(BeNil())\n139\t\n140\t\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n141\t\t\t\t\t_, calledTask, calledJobName, calledReason := fakePublisher.PublishFailureArgsForCall(\n142\t\t\t\t\t\t0,\n143\t\t\t\t\t)\n144\t\t\t\t\tExpect(string(calledTask.TaskIdentifier)).To(Equal(string(taskID)))\n145\t\t\t\t\tExpect(calledJobName).To(Equal(\"job-1\"))\n146\t\t\t\t\tExpect(calledReason).To(Equal(\"deadline_exceeded\"))\n147\t\t\t\t})\n148\t\t\t})\n149\t\n150\t\t\t// 6b: deadline-exceeded-but-running → NOT zombie\n151\t\t\tContext(\"deadline exceeded but pod is Running\", func() {\n152\t\t\t\tIt(\"skips publish when pod is Running\", func() {\n153\t\t\t\t\ttaskID := lib.TaskIdentifier(\"task-6b-running\")\n154\t\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:30:00Z\")\n155\t\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"job-1\", ts.Format(time.RFC3339))\n156\t\t\t\t\ttaskStore.Store(taskID, task)\n157\t\n158\t\t\t\t\tcfg := agentv1.Config{\n159\t\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n160\t\t\t\t\t\tSpec: agentv1.ConfigSpec{\n161\t\t\t\t\t\t\tAssignee:                \"agent-a\",\n162\t\t\t\t\t\t\tZombieJobTimeoutSeconds: ptrInt32(60),\n163\t\t\t\t\t\t},\n164\t\t\t\t\t}\n165\t\t\t\t\t_ = eventHandlerConfig.OnAdd(ctx, cfg)\n166\t\n167\t\t\t\t\tfakeClient := fake.NewSimpleClientset()\n168\t\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n169\t\t\t\t\t\tfakeClient,\n170\t\t\t\t\t\t0,\n171\t\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n172\t\t\t\t\t)\n173\t\t\t\t\tpodInformer := informerFactory.Core().V1().Pods().Informer()\n174\t\t\t\t\t_ = podInformer.GetIndexer().\n175\t\t\t\t\t\tAdd(makePod(\"pod-running\", \"test-ns\", string(taskID), corev1.PodRunning, 0))\n176\t\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n177\t\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n178\t\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n179\t\n180\t\t\t\t\tsweeper := pkg.NewZombieSweeper(\n181\t\t\t\t\t\tfakeJobWatcher,\n182\t\t\t\t\t\t\"test-ns\",\n183\t\t\t\t\t\ttaskStore,\n184\t\t\t\t\t\tfakePublisher,\n185\t\t\t\t\t\teventHandlerConfig,\n186\t\t\t\t\t\tcurrentDateTime,\n187\t\t\t\t\t)\n188\t\n189\t\t\t\t\terr := sweeper.SweepOnce(ctx)\n190\t\t\t\t\tExpect(err).To(BeNil())\n191\t\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n192\t\t\t\t})\n193\t\t\t})\n194\t\n195\t\t\t// 6c: under-deadline → NOT zombie\n196\t\t\tContext(\"elapsed time is under deadline\", func() {\n197\t\t\t\tIt(\"skips publish when elapsed < deadline\", func() {\n198\t\t\t\t\ttaskID := lib.TaskIdentifier(\"task-6c-under-deadline\")\n199\t\t\t\t\t// job_started_at = 11:59:30Z, elapsed = 30s at 12:00:00Z < deadline of 60s\n200\t\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:59:30Z\")\n201\t\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"job-1\", ts.Format(time.RFC3339))\n202\t\t\t\t\ttaskStore.Store(taskID, task)\n203\t\n204\t\t\t\t\tcfg := agentv1.Config{\n205\t\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n206\t\t\t\t\t\tSpec: agentv1.ConfigSpec{\n207\t\t\t\t\t\t\tAssignee:                \"agent-a\",\n208\t\t\t\t\t\t\tZombieJobTimeoutSeconds: ptrInt32(60),\n209\t\t\t\t\t\t},\n210\t\t\t\t\t}\n211\t\t\t\t\t_ = eventHandlerConfig.OnAdd(ctx, cfg)\n212\t\n213\t\t\t\t\tfakeClient := fake.NewSimpleClientset()\n214\t\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n215\t\t\t\t\t\tfakeClient,\n216\t\t\t\t\t\t0,\n217\t\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n218\t\t\t\t\t)\n219\t\t\t\t\tpodInformer := informerFactory.Core().V1().Pods().Informer()\n220\t\t\t\t\t_ = podInformer.GetIndexer().\n221\t\t\t\t\t\tAdd(makePod(\"pod-failed\", \"test-ns\", string(taskID), corev1.PodFailed, 0))\n222\t\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n223\t\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n224\t\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n225\t\n226\t\t\t\t\tsweeper := pkg.NewZombieSweeper(\n227\t\t\t\t\t\tfakeJobWatcher,\n228\t\t\t\t\t\t\"test-ns\",\n229\t\t\t\t\t\ttaskStore,\n230\t\t\t\t\t\tfakePublisher,\n231\t\t\t\t\t\teventHandlerConfig,\n232\t\t\t\t\t\tcurrentDateTime,\n233\t\t\t\t\t)\n234\t\n235\t\t\t\t\terr := sweeper.SweepOnce(ctx)\n236\t\t\t\t\tExpect(err).To(BeNil())\n237\t\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n238\t\t\t\t})\n239\t\t\t})\n240\t\n241\t\t\t// 6d: watch-lost → executor_watch_lost\n242\t\t\tContext(\"no pods found for task past deadline\", func() {\n243\t\t\t\tIt(\"publishes failure with executor_watch_lost\", func() {\n244\t\t\t\t\ttaskID := lib.TaskIdentifier(\"task-6d-watch-lost\")\n245\t\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:30:00Z\")\n246\t\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"job-1\", ts.Format(time.RFC3339))\n247\t\t\t\t\ttaskStore.Store(taskID, task)\n248\t\n249\t\t\t\t\tcfg := agentv1.Config{\n250\t\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n251\t\t\t\t\t\tSpec: agentv1.ConfigSpec{\n252\t\t\t\t\t\t\tAssignee:                \"agent-a\",\n253\t\t\t\t\t\t\tZombieJobTimeoutSeconds: ptrInt32(60),\n254\t\t\t\t\t\t},\n255\t\t\t\t\t}\n256\t\t\t\t\t_ = eventHandlerConfig.OnAdd(ctx, cfg)\n257\t\n258\t\t\t\t\t// Empty fake client — no pods at all\n259\t\t\t\t\tfakeClient := fake.NewSimpleClientset()\n260\t\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n261\t\t\t\t\t\tfakeClient,\n262\t\t\t\t\t\t0,\n263\t\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n264\t\t\t\t\t)\n265\t\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n266\t\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n267\t\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n268\t\n269\t\t\t\t\tsweeper := pkg.NewZombieSweeper(\n270\t\t\t\t\t\tfakeJobWatcher,\n271\t\t\t\t\t\t\"test-ns\",\n272\t\t\t\t\t\ttaskStore,\n273\t\t\t\t\t\tfakePublisher,\n274\t\t\t\t\t\teventHandlerConfig,\n275\t\t\t\t\t\tcurrentDateTime,\n276\t\t\t\t\t)\n277\t\n278\t\t\t\t\terr := sweeper.SweepOnce(ctx)\n279\t\t\t\t\tExpect(err).To(BeNil())\n280\t\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n281\t\t\t\t\t_, calledTask, calledJobName, calledReason := fakePublisher.PublishFailureArgsForCall(\n282\t\t\t\t\t\t0,\n283\t\t\t\t\t)\n284\t\t\t\t\tExpect(string(calledTask.TaskIdentifier)).To(Equal(string(taskID)))\n285\t\t\t\t\tExpect(calledJobName).To(Equal(\"job-1\"))\n286\t\t\t\t\tExpect(calledReason).To(Equal(\"executor_watch_lost\"))\n287\t\t\t\t})\n288\t\t\t})\n289\t\n290\t\t\t// 6e: pod_not_scheduled\n291\t\t\tContext(\"pod is Pending past grace window with PodScheduled=False\", func() {\n292\t\t\t\tIt(\"publishes failure with pod_not_scheduled\", func() {\n293\t\t\t\t\ttaskID := lib.TaskIdentifier(\"task-6e-pod-not-scheduled\")\n294\t\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:30:00Z\")\n295\t\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"job-1\", ts.Format(time.RFC3339))\n296\t\t\t\t\ttaskStore.Store(taskID, task)\n297\t\n298\t\t\t\t\tcfg := agentv1.Config{\n299\t\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n300\t\t\t\t\t\tSpec: agentv1.ConfigSpec{\n301\t\t\t\t\t\t\tAssignee:                \"agent-a\",\n302\t\t\t\t\t\t\tZombieJobTimeoutSeconds: ptrInt32(60),\n303\t\t\t\t\t\t},\n304\t\t\t\t\t}\n305\t\t\t\t\t_ = eventHandlerConfig.OnAdd(ctx, cfg)\n306\t\n307\t\t\t\t\tfakeClient := fake.NewSimpleClientset()\n308\t\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n309\t\t\t\t\t\tfakeClient,\n310\t\t\t\t\t\t0,\n311\t\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n312\t\t\t\t\t)\n313\t\t\t\t\tpodInformer := informerFactory.Core().V1().Pods().Informer()\n314\t\t\t\t\t// Pod created 5 minutes ago (exceeds 2min grace window), Pending, PodScheduled=False\n315\t\t\t\t\t_ = podInformer.GetIndexer().\n316\t\t\t\t\t\tAdd(makePod(\"pod-unschedulable\", \"test-ns\", string(taskID), corev1.PodPending, 5*time.Minute, podScheduledFalseCondition()))\n317\t\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n318\t\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n319\t\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n320\t\n321\t\t\t\t\tsweeper := pkg.NewZombieSweeper(\n322\t\t\t\t\t\tfakeJobWatcher,\n323\t\t\t\t\t\t\"test-ns\",\n324\t\t\t\t\t\ttaskStore,\n325\t\t\t\t\t\tfakePublisher,\n326\t\t\t\t\t\teventHandlerConfig,\n327\t\t\t\t\t\tcurrentDateTime,\n328\t\t\t\t\t)\n329\t\n330\t\t\t\t\terr := sweeper.SweepOnce(ctx)\n331\t\t\t\t\tExpect(err).To(BeNil())\n332\t\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n333\t\t\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n334\t\t\t\t\tExpect(calledReason).To(Equal(\"pod_not_scheduled\"))\n335\t\t\t\t})\n336\t\t\t})\n337\t\n338\t\t\t// 6f: interval default — indirectly verified: SweepOnce uses the default interval\n339\t\t\t// when no config is set. The 6c test (under-deadline) implicitly uses the default\n340\t\t\t// interval via the sweeper. We add an explicit test that exercises the default\n341\t\t\t// path through the interval resolver by using a task with no matching config.\n342\t\t\tContext(\n343\t\t\t\t\"interval default: task with no matching config uses 1800s default deadline\",\n344\t\t\t\tfunc() {\n345\t\t\t\t\tIt(\n346\t\t\t\t\t\t\"does not publish failure when elapsed (29min) < default deadline (1800s)\",\n347\t\t\t\t\t\tfunc() {\n348\t\t\t\t\t\t\ttaskID := lib.TaskIdentifier(\"task-6f-default-deadline\")\n349\t\t\t\t\t\t\t// job_started_at = 11:31:00Z, elapsed = 29min, default deadline = 1800s (30min)\n350\t\t\t\t\t\t\t// elapsed < deadline → no publish\n351\t\t\t\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:31:00Z\")\n352\t\t\t\t\t\t\ttask := makeTask(\n353\t\t\t\t\t\t\t\tstring(taskID),\n354\t\t\t\t\t\t\t\t\"agent-no-config\",\n355\t\t\t\t\t\t\t\t\"job-1\",\n356\t\t\t\t\t\t\t\tts.Format(time.RFC3339),\n357\t\t\t\t\t\t\t)\n358\t\t\t\t\t\t\ttaskStore.Store(taskID, task)\n359\t\n360\t\t\t\t\t\t\t// No config added — uses default deadline of 1800s\n361\t\t\t\t\t\t\tfakeClient := fake.NewSimpleClientset()\n362\t\t\t\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n363\t\t\t\t\t\t\t\tfakeClient,\n364\t\t\t\t\t\t\t\t0,\n365\t\t\t\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n366\t\t\t\t\t\t\t)\n367\t\t\t\t\t\t\tpodInformer := informerFactory.Core().V1().Pods().Informer()\n368\t\t\t\t\t\t\t_ = podInformer.GetIndexer().\n369\t\t\t\t\t\t\t\tAdd(makePod(\"pod-failed\", \"test-ns\", string(taskID), corev1.PodFailed, 0))\n370\t\t\t\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n371\t\t\t\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n372\t\t\t\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n373\t\n374\t\t\t\t\t\t\tsweeper := pkg.NewZombieSweeper(\n375\t\t\t\t\t\t\t\tfakeJobWatcher,\n376\t\t\t\t\t\t\t\t\"test-ns\",\n377\t\t\t\t\t\t\t\ttaskStore,\n378\t\t\t\t\t\t\t\tfakePublisher,\n379\t\t\t\t\t\t\t\teventHandlerConfig,\n380\t\t\t\t\t\t\t\tcurrentDateTime,\n381\t\t\t\t\t\t\t)\n382\t\n383\t\t\t\t\t\t\terr := sweeper.SweepOnce(ctx)\n384\t\t\t\t\t\t\tExpect(err).To(BeNil())\n385\t\t\t\t\t\t\t// elapsed (29min) < default deadline (30min) → no zombie\n386\t\t\t\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n387\t\t\t\t\t\t},\n388\t\t\t\t\t)\n389\t\t\t\t},\n390\t\t\t)\n391\t\n392\t\t\t// 6g: interval override — tested via 6a-6e which use configs with specific timeouts\n393\t\t\t// 6h: deadline default — verified by 6f (uses default when no config matches)\n394\t\n395\t\t\tContext(\"task with no current_job is skipped\", func() {\n396\t\t\t\tIt(\"skips tasks without a current_job set\", func() {\n397\t\t\t\t\ttaskID := lib.TaskIdentifier(\"task-no-job\")\n398\t\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"\", \"\")\n399\t\t\t\t\ttaskStore.Store(taskID, task)\n400\t\n401\t\t\t\t\tfakeClient := fake.NewSimpleClientset()\n402\t\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n403\t\t\t\t\t\tfakeClient,\n404\t\t\t\t\t\t0,\n405\t\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n406\t\t\t\t\t)\n407\t\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n408\t\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n409\t\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n410\t\n411\t\t\t\t\tsweeper := pkg.NewZombieSweeper(\n412\t\t\t\t\t\tfakeJobWatcher,\n413\t\t\t\t\t\t\"test-ns\",\n414\t\t\t\t\t\ttaskStore,\n415\t\t\t\t\t\tfakePublisher,\n416\t\t\t\t\t\teventHandlerConfig,\n417\t\t\t\t\t\tcurrentDateTime,\n418\t\t\t\t\t)\n419\t\n420\t\t\t\t\terr := sweeper.SweepOnce(ctx)\n421\t\t\t\t\tExpect(err).To(BeNil())\n422\t\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n423\t\t\t\t})\n424\t\t\t})\n425\t\n426\t\t\tContext(\"task with unparseable job_started_at is skipped\", func() {\n427\t\t\t\tIt(\"skips tasks with malformed job_started_at\", func() {\n428\t\t\t\t\ttaskID := lib.TaskIdentifier(\"task-bad-time\")\n429\t\t\t\t\tfm := lib.TaskFrontmatter{\n430\t\t\t\t\t\t\"status\":         \"in_progress\",\n431\t\t\t\t\t\t\"assignee\":       \"agent-a\",\n432\t\t\t\t\t\t\"current_job\":    \"job-1\",\n433\t\t\t\t\t\t\"job_started_at\": \"not-a-valid-timestamp\",\n434\t\t\t\t\t}\n435\t\t\t\t\ttask := lib.Task{\n436\t\t\t\t\t\tTaskIdentifier: taskID,\n437\t\t\t\t\t\tFrontmatter:    fm,\n438\t\t\t\t\t\tContent:        lib.TaskContent(\"do the work\"),\n439\t\t\t\t\t}\n440\t\t\t\t\ttaskStore.Store(taskID, task)\n441\t\n442\t\t\t\t\tfakeClient := fake.NewSimpleClientset()\n443\t\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n444\t\t\t\t\t\tfakeClient,\n445\t\t\t\t\t\t0,\n446\t\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n447\t\t\t\t\t)\n448\t\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n449\t\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n450\t\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n451\t\n452\t\t\t\t\tsweeper := pkg.NewZombieSweeper(\n453\t\t\t\t\t\tfakeJobWatcher,\n454\t\t\t\t\t\t\"test-ns\",\n455\t\t\t\t\t\ttaskStore,\n456\t\t\t\t\t\tfakePublisher,\n457\t\t\t\t\t\teventHandlerConfig,\n458\t\t\t\t\t\tcurrentDateTime,\n459\t\t\t\t\t)\n460\t\n461\t\t\t\t\terr := sweeper.SweepOnce(ctx)\n462\t\t\t\t\tExpect(err).To(BeNil())\n463\t\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n464\t\t\t\t})\n465\t\t\t})\n466\t\n467\t\t\t// Per-task publish errors must NOT abort the sweep — every past-deadline\n468\t\t\t// task must get a PublishFailure attempt even when an earlier one fails.\n469\t\t\t// Guards the regression where a single broken publisher.PublishFailure\n470\t\t\t// (e.g. transient kafka error for one task's UUID) would skip the rest.\n471\t\t\tContext(\"multiple tasks with one publish failure mid-loop\", func() {\n472\t\t\t\tIt(\n473\t\t\t\t\t\"calls PublishFailure for every task and continues past per-task errors\",\n474\t\t\t\t\tfunc() {\n475\t\t\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:30:00Z\")\n476\t\t\t\t\t\ttasks := []lib.TaskIdentifier{\n477\t\t\t\t\t\t\t\"task-multi-1\",\n478\t\t\t\t\t\t\t\"task-multi-2\",\n479\t\t\t\t\t\t\t\"task-multi-3\",\n480\t\t\t\t\t\t}\n481\t\t\t\t\t\tfor _, id := range tasks {\n482\t\t\t\t\t\t\ttask := makeTask(\n483\t\t\t\t\t\t\t\tstring(id),\n484\t\t\t\t\t\t\t\t\"agent-a\",\n485\t\t\t\t\t\t\t\t\"job-\"+string(id),\n486\t\t\t\t\t\t\t\tts.Format(time.RFC3339),\n487\t\t\t\t\t\t\t)\n488\t\t\t\t\t\t\ttaskStore.Store(id, task)\n489\t\t\t\t\t\t}\n490\t\n491\t\t\t\t\t\tcfg := agentv1.Config{\n492\t\t\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n493\t\t\t\t\t\t\tSpec: agentv1.ConfigSpec{\n494\t\t\t\t\t\t\t\tAssignee:                \"agent-a\",\n495\t\t\t\t\t\t\t\tZombieJobTimeoutSeconds: ptrInt32(60),\n496\t\t\t\t\t\t\t},\n497\t\t\t\t\t\t}\n498\t\t\t\t\t\t_ = eventHandlerConfig.OnAdd(ctx, cfg)\n499\t\n500\t\t\t\t\t\t// Empty pod lister — all tasks classify as executor_watch_lost.\n501\t\t\t\t\t\tfakeClient := fake.NewSimpleClientset()\n502\t\t\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n503\t\t\t\t\t\t\tfakeClient,\n504\t\t\t\t\t\t\t0,\n505\t\t\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n506\t\t\t\t\t\t)\n507\t\t\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n508\t\t\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n509\t\t\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n510\t\n511\t\t\t\t\t\t// Snapshot iterates a map → non-deterministic order. Fail\n512\t\t\t\t\t\t// the second call regardless of which task lands there;\n513\t\t\t\t\t\t// the assertion (call count == 3) covers the loop-continue\n514\t\t\t\t\t\t// invariant without depending on order.\n515\t\t\t\t\t\tfakePublisher.PublishFailureStub = func(\n516\t\t\t\t\t\t\t_ context.Context,\n517\t\t\t\t\t\t\t_ lib.Task,\n518\t\t\t\t\t\t\t_ string,\n519\t\t\t\t\t\t\t_ string,\n520\t\t\t\t\t\t) error {\n521\t\t\t\t\t\t\tif fakePublisher.PublishFailureCallCount() == 2 {\n522\t\t\t\t\t\t\t\treturn context.Canceled\n523\t\t\t\t\t\t\t}\n524\t\t\t\t\t\t\treturn nil\n525\t\t\t\t\t\t}\n526\t\n527\t\t\t\t\t\tsweeper := pkg.NewZombieSweeper(\n528\t\t\t\t\t\t\tfakeJobWatcher,\n529\t\t\t\t\t\t\t\"test-ns\",\n530\t\t\t\t\t\t\ttaskStore,\n531\t\t\t\t\t\t\tfakePublisher,\n532\t\t\t\t\t\t\teventHandlerConfig,\n533\t\t\t\t\t\t\tcurrentDateTime,\n534\t\t\t\t\t\t)\n535\t\n536\t\t\t\t\t\terr := sweeper.SweepOnce(ctx)\n537\t\t\t\t\t\tExpect(err).To(BeNil())\n538\t\t\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(3))\n539\t\t\t\t\t},\n540\t\t\t\t)\n541\t\t\t})\n542\t\n543\t\t\t// Pod lister not yet synced — sweeper must skip the tick without\n544\t\t\t// publishing failures. Guards the regression where service.Run starts\n545\t\t\t// the sweeper before JobWatcher.Run finishes WaitForCacheSync.\n546\t\t\tContext(\"pod lister is nil (JobWatcher not yet synced)\", func() {\n547\t\t\t\tIt(\"skips the tick without publishing failures\", func() {\n548\t\t\t\t\ttaskID := lib.TaskIdentifier(\"task-lister-nil\")\n549\t\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:30:00Z\")\n550\t\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"job-1\", ts.Format(time.RFC3339))\n551\t\t\t\t\ttaskStore.Store(taskID, task)\n552\t\n553\t\t\t\t\tcfg := agentv1.Config{\n554\t\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n555\t\t\t\t\t\tSpec: agentv1.ConfigSpec{\n556\t\t\t\t\t\t\tAssignee:                \"agent-a\",\n557\t\t\t\t\t\t\tZombieJobTimeoutSeconds: ptrInt32(60),\n558\t\t\t\t\t\t},\n559\t\t\t\t\t}\n560\t\t\t\t\t_ = eventHandlerConfig.OnAdd(ctx, cfg)\n561\t\n562\t\t\t\t\t// FakeJobWatcher returns a nil PodLister by default — simulates\n563\t\t\t\t\t// the pre-cache-sync state.\n564\t\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n565\t\n566\t\t\t\t\tsweeper := pkg.NewZombieSweeper(\n567\t\t\t\t\t\tfakeJobWatcher,\n568\t\t\t\t\t\t\"test-ns\",\n569\t\t\t\t\t\ttaskStore,\n570\t\t\t\t\t\tfakePublisher,\n571\t\t\t\t\t\teventHandlerConfig,\n572\t\t\t\t\t\tcurrentDateTime,\n573\t\t\t\t\t)\n574\t\n575\t\t\t\t\terr := sweeper.SweepOnce(ctx)\n576\t\t\t\t\tExpect(err).To(BeNil())\n577\t\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n578\t\t\t\t})\n579\t\t\t})\n580\t\t})\n581\t})\n582\t"}]},"parent_tool_use_id":null,"session_id":"66607f9a-fb74-4a6f-9e0e-f3ec5b2597d7","uuid":"391734bf-0344-4f31-95d9-8e6d1082936e","timestamp":"2026-08-31T22:03:39.465Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/zombie_sweeper_test.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage pkg_test\n\nimport (\n\t\"context\"\n\t\"time\"\n\n\tlib \"github.com/bborbe/agent\"\n\tlibtime \"github.com/bborbe/time\"\n\tlibtimetest \"github.com/bborbe/time/test\"\n\t. \"github.com/onsi/ginkgo/v2\"\n\t. \"github.com/onsi/gomega\"\n\tcorev1 \"k8s.io/api/core/v1\"\n\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"\n\tk8sinformers \"k8s.io/client-go/informers\"\n\t\"k8s.io/client-go/kubernetes/fake\"\n\n\tagentv1 \"github.com/bborbe/agent-task-executor/k8s/apis/agent.benjamin-borbe.de/v1\"\n\t\"github.com/bborbe/agent-task-executor/mocks\"\n\t\"github.com/bborbe/agent-task-executor/pkg\"\n)\n\nvar _ = Describe(\"ZombieSweeper\", func() {\n\tvar (\n\t\tctx                context.Context\n\t\tfakePublisher      *mocks.FakeResultPublisher\n\t\ttaskStore          *pkg.TaskStore\n\t\teventHandlerConfig pkg.EventHandlerConfig\n\t\tcurrentDateTime    libtime.CurrentDateTime\n\t)\n\n\tBeforeEach(func() {\n\t\tctx = context.Background()\n\t\tfakePublisher = &mocks.FakeResultPublisher{}\n\t\ttaskStore = pkg.NewTaskStore()\n\t\teventHandlerConfig = pkg.NewEventHandlerConfig()\n\t\tcurrentDateTime = libtime.NewCurrentDateTime()\n\t\t// Default \"now\" for tests: 2026-06-01T12:00:00Z\n\t\tcurrentDateTime.SetNow(libtimetest.ParseDateTime(\"2026-06-01T12:00:00Z\"))\n\t})\n\n\tmakeTask := func(id string, assignee string, currentJob string, jobStartedAt string) lib.Task {\n\t\tfm := lib.TaskFrontmatter{\n\t\t\t\"status\":   \"in_progress\",\n\t\t\t\"assignee\": assignee,\n\t\t}\n\t\tif currentJob != \"\" {\n\t\t\tfm[\"current_job\"] = currentJob\n\t\t}\n\t\tif jobStartedAt != \"\" {\n\t\t\tfm[\"job_started_at\"] = jobStartedAt\n\t\t}\n\t\treturn lib.Task{\n\t\t\tTaskIdentifier: lib.TaskIdentifier(id),\n\t\t\tFrontmatter:    fm,\n\t\t\tContent:        lib.TaskContent(\"do the work\"),\n\t\t}\n\t}\n\n\t// makePodWithCreation creates a pod with a specific CreationTimestamp offset from \"now\"\n\t// (which is set by currentDateTime to 2026-06-01T12:00:00Z).\n\tmakePod := func(name, namespace, taskID string, phase corev1.PodPhase, creationAge time.Duration, conditions ...corev1.PodCondition) *corev1.Pod {\n\t\treturn &corev1.Pod{\n\t\t\tObjectMeta: metav1.ObjectMeta{\n\t\t\t\tName:      name,\n\t\t\t\tNamespace: namespace,\n\t\t\t\tLabels: map[string]string{\n\t\t\t\t\t\"agent.benjamin-borbe.de/task-id\": taskID,\n\t\t\t\t},\n\t\t\t\tCreationTimestamp: metav1.Time{\n\t\t\t\t\t// currentDateTime is 2026-06-01T12:00:00Z, subtract age to get creation time\n\t\t\t\t\tTime: time.Date(2026, 6, 1, 12, 0, 0, 0, time.UTC).Add(-creationAge),\n\t\t\t\t},\n\t\t\t},\n\t\t\tStatus: corev1.PodStatus{\n\t\t\t\tPhase:      phase,\n\t\t\t\tConditions: conditions,\n\t\t\t},\n\t\t}\n\t}\n\n\tpodScheduledFalseCondition := func() corev1.PodCondition {\n\t\treturn corev1.PodCondition{\n\t\t\tType:   corev1.PodScheduled,\n\t\t\tStatus: corev1.ConditionFalse,\n\t\t\tReason: \"Unschedulable\",\n\t\t}\n\t}\n\n\tptrInt32 := func(v int32) *int32 { return &v }\n\n\tDescribe(\"SweepOnce\", func() {\n\t\t// 6a: deadline-exceeded-and-not-running → zombie (deadline_exceeded)\n\t\tContext(\"deadline exceeded with failed pod\", func() {\n\t\t\tIt(\"publishes failure with deadline_exceeded\", func() {\n\t\t\t\ttaskID := lib.TaskIdentifier(\"task-6a-deadline-exceeded\")\n\t\t\t\t// job_started_at = 11:30:00Z, elapsed = 30min at 12:00:00Z\n\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:30:00Z\")\n\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"job-1\", ts.Format(time.RFC3339))\n\t\t\t\ttaskStore.Store(taskID, task)\n\n\t\t\t\t// Config: deadline = 60s\n\t\t\t\tcfg := agentv1.Config{\n\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n\t\t\t\t\tSpec: agentv1.ConfigSpec{\n\t\t\t\t\t\tAssignee:                \"agent-a\",\n\t\t\t\t\t\tZombieJobTimeoutSeconds: ptrInt32(60),\n\t\t\t\t\t},\n\t\t\t\t}\n\t\t\t\t_ = eventHandlerConfig.OnAdd(ctx, cfg)\n\n\t\t\t\tfakeClient := fake.NewSimpleClientset()\n\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n\t\t\t\t\tfakeClient,\n\t\t\t\t\t0,\n\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n\t\t\t\t)\n\t\t\t\tpodInformer := informerFactory.Core().V1().Pods().Informer()\n\t\t\t\t_ = podInformer.GetIndexer().\n\t\t\t\t\tAdd(makePod(\"pod-failed\", \"test-ns\", string(taskID), corev1.PodFailed, 0))\n\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n\n\t\t\t\tsweeper := pkg.NewZombieSweeper(\n\t\t\t\t\tfakeJobWatcher,\n\t\t\t\t\t\"test-ns\",\n\t\t\t\t\ttaskStore,\n\t\t\t\t\tfakePublisher,\n\t\t\t\t\teventHandlerConfig,\n\t\t\t\t\tcurrentDateTime,\n\t\t\t\t)\n\n\t\t\t\terr := sweeper.SweepOnce(ctx)\n\t\t\t\tExpect(err).To(BeNil())\n\n\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n\t\t\t\t_, calledTask, calledJobName, calledReason := fakePublisher.PublishFailureArgsForCall(\n\t\t\t\t\t0,\n\t\t\t\t)\n\t\t\t\tExpect(string(calledTask.TaskIdentifier)).To(Equal(string(taskID)))\n\t\t\t\tExpect(calledJobName).To(Equal(\"job-1\"))\n\t\t\t\tExpect(calledReason).To(Equal(\"deadline_exceeded\"))\n\t\t\t})\n\t\t})\n\n\t\t// 6b: deadline-exceeded-but-running → NOT zombie\n\t\tContext(\"deadline exceeded but pod is Running\", func() {\n\t\t\tIt(\"skips publish when pod is Running\", func() {\n\t\t\t\ttaskID := lib.TaskIdentifier(\"task-6b-running\")\n\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:30:00Z\")\n\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"job-1\", ts.Format(time.RFC3339))\n\t\t\t\ttaskStore.Store(taskID, task)\n\n\t\t\t\tcfg := agentv1.Config{\n\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n\t\t\t\t\tSpec: agentv1.ConfigSpec{\n\t\t\t\t\t\tAssignee:                \"agent-a\",\n\t\t\t\t\t\tZombieJobTimeoutSeconds: ptrInt32(60),\n\t\t\t\t\t},\n\t\t\t\t}\n\t\t\t\t_ = eventHandlerConfig.OnAdd(ctx, cfg)\n\n\t\t\t\tfakeClient := fake.NewSimpleClientset()\n\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n\t\t\t\t\tfakeClient,\n\t\t\t\t\t0,\n\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n\t\t\t\t)\n\t\t\t\tpodInformer := informerFactory.Core().V1().Pods().Informer()\n\t\t\t\t_ = podInformer.GetIndexer().\n\t\t\t\t\tAdd(makePod(\"pod-running\", \"test-ns\", string(taskID), corev1.PodRunning, 0))\n\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n\n\t\t\t\tsweeper := pkg.NewZombieSweeper(\n\t\t\t\t\tfakeJobWatcher,\n\t\t\t\t\t\"test-ns\",\n\t\t\t\t\ttaskStore,\n\t\t\t\t\tfakePublisher,\n\t\t\t\t\teventHandlerConfig,\n\t\t\t\t\tcurrentDateTime,\n\t\t\t\t)\n\n\t\t\t\terr := sweeper.SweepOnce(ctx)\n\t\t\t\tExpect(err).To(BeNil())\n\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\t\t\t})\n\t\t})\n\n\t\t// 6c: under-deadline → NOT zombie\n\t\tContext(\"elapsed time is under deadline\", func() {\n\t\t\tIt(\"skips publish when elapsed < deadline\", func() {\n\t\t\t\ttaskID := lib.TaskIdentifier(\"task-6c-under-deadline\")\n\t\t\t\t// job_started_at = 11:59:30Z, elapsed = 30s at 12:00:00Z < deadline of 60s\n\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:59:30Z\")\n\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"job-1\", ts.Format(time.RFC3339))\n\t\t\t\ttaskStore.Store(taskID, task)\n\n\t\t\t\tcfg := agentv1.Config{\n\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n\t\t\t\t\tSpec: agentv1.ConfigSpec{\n\t\t\t\t\t\tAssignee:                \"agent-a\",\n\t\t\t\t\t\tZombieJobTimeoutSeconds: ptrInt32(60),\n\t\t\t\t\t},\n\t\t\t\t}\n\t\t\t\t_ = eventHandlerConfig.OnAdd(ctx, cfg)\n\n\t\t\t\tfakeClient := fake.NewSimpleClientset()\n\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n\t\t\t\t\tfakeClient,\n\t\t\t\t\t0,\n\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n\t\t\t\t)\n\t\t\t\tpodInformer := informerFactory.Core().V1().Pods().Informer()\n\t\t\t\t_ = podInformer.GetIndexer().\n\t\t\t\t\tAdd(makePod(\"pod-failed\", \"test-ns\", string(taskID), corev1.PodFailed, 0))\n\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n\n\t\t\t\tsweeper := pkg.NewZombieSweeper(\n\t\t\t\t\tfakeJobWatcher,\n\t\t\t\t\t\"test-ns\",\n\t\t\t\t\ttaskStore,\n\t\t\t\t\tfakePublisher,\n\t\t\t\t\teventHandlerConfig,\n\t\t\t\t\tcurrentDateTime,\n\t\t\t\t)\n\n\t\t\t\terr := sweeper.SweepOnce(ctx)\n\t\t\t\tExpect(err).To(BeNil())\n\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\t\t\t})\n\t\t})\n\n\t\t// 6d: watch-lost → executor_watch_lost\n\t\tContext(\"no pods found for task past deadline\", func() {\n\t\t\tIt(\"publishes failure with executor_watch_lost\", func() {\n\t\t\t\ttaskID := lib.TaskIdentifier(\"task-6d-watch-lost\")\n\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:30:00Z\")\n\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"job-1\", ts.Format(time.RFC3339))\n\t\t\t\ttaskStore.Store(taskID, task)\n\n\t\t\t\tcfg := agentv1.Config{\n\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n\t\t\t\t\tSpec: agentv1.ConfigSpec{\n\t\t\t\t\t\tAssignee:                \"agent-a\",\n\t\t\t\t\t\tZombieJobTimeoutSeconds: ptrInt32(60),\n\t\t\t\t\t},\n\t\t\t\t}\n\t\t\t\t_ = eventHandlerConfig.OnAdd(ctx, cfg)\n\n\t\t\t\t// Empty fake client — no pods at all\n\t\t\t\tfakeClient := fake.NewSimpleClientset()\n\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n\t\t\t\t\tfakeClient,\n\t\t\t\t\t0,\n\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n\t\t\t\t)\n\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n\n\t\t\t\tsweeper := pkg.NewZombieSweeper(\n\t\t\t\t\tfakeJobWatcher,\n\t\t\t\t\t\"test-ns\",\n\t\t\t\t\ttaskStore,\n\t\t\t\t\tfakePublisher,\n\t\t\t\t\teventHandlerConfig,\n\t\t\t\t\tcurrentDateTime,\n\t\t\t\t)\n\n\t\t\t\terr := sweeper.SweepOnce(ctx)\n\t\t\t\tExpect(err).To(BeNil())\n\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n\t\t\t\t_, calledTask, calledJobName, calledReason := fakePublisher.PublishFailureArgsForCall(\n\t\t\t\t\t0,\n\t\t\t\t)\n\t\t\t\tExpect(string(calledTask.TaskIdentifier)).To(Equal(string(taskID)))\n\t\t\t\tExpect(calledJobName).To(Equal(\"job-1\"))\n\t\t\t\tExpect(calledReason).To(Equal(\"executor_watch_lost\"))\n\t\t\t})\n\t\t})\n\n\t\t// 6e: pod_not_scheduled\n\t\tContext(\"pod is Pending past grace window with PodScheduled=False\", func() {\n\t\t\tIt(\"publishes failure with pod_not_scheduled\", func() {\n\t\t\t\ttaskID := lib.TaskIdentifier(\"task-6e-pod-not-scheduled\")\n\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:30:00Z\")\n\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"job-1\", ts.Format(time.RFC3339))\n\t\t\t\ttaskStore.Store(taskID, task)\n\n\t\t\t\tcfg := agentv1.Config{\n\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n\t\t\t\t\tSpec: agentv1.ConfigSpec{\n\t\t\t\t\t\tAssignee:                \"agent-a\",\n\t\t\t\t\t\tZombieJobTimeoutSeconds: ptrInt32(60),\n\t\t\t\t\t},\n\t\t\t\t}\n\t\t\t\t_ = eventHandlerConfig.OnAdd(ctx, cfg)\n\n\t\t\t\tfakeClient := fake.NewSimpleClientset()\n\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n\t\t\t\t\tfakeClient,\n\t\t\t\t\t0,\n\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n\t\t\t\t)\n\t\t\t\tpodInformer := informerFactory.Core().V1().Pods().Informer()\n\t\t\t\t// Pod created 5 minutes ago (exceeds 2min grace window), Pending, PodScheduled=False\n\t\t\t\t_ = podInformer.GetIndexer().\n\t\t\t\t\tAdd(makePod(\"pod-unschedulable\", \"test-ns\", string(taskID), corev1.PodPending, 5*time.Minute, podScheduledFalseCondition()))\n\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n\n\t\t\t\tsweeper := pkg.NewZombieSweeper(\n\t\t\t\t\tfakeJobWatcher,\n\t\t\t\t\t\"test-ns\",\n\t\t\t\t\ttaskStore,\n\t\t\t\t\tfakePublisher,\n\t\t\t\t\teventHandlerConfig,\n\t\t\t\t\tcurrentDateTime,\n\t\t\t\t)\n\n\t\t\t\terr := sweeper.SweepOnce(ctx)\n\t\t\t\tExpect(err).To(BeNil())\n\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n\t\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n\t\t\t\tExpect(calledReason).To(Equal(\"pod_not_scheduled\"))\n\t\t\t})\n\t\t})\n\n\t\t// 6f: interval default — indirectly verified: SweepOnce uses the default interval\n\t\t// when no config is set. The 6c test (under-deadline) implicitly uses the default\n\t\t// interval via the sweeper. We add an explicit test that exercises the default\n\t\t// path through the interval resolver by using a task with no matching config.\n\t\tContext(\n\t\t\t\"interval default: task with no matching config uses 1800s default deadline\",\n\t\t\tfunc() {\n\t\t\t\tIt(\n\t\t\t\t\t\"does not publish failure when elapsed (29min) < default deadline (1800s)\",\n\t\t\t\t\tfunc() {\n\t\t\t\t\t\ttaskID := lib.TaskIdentifier(\"task-6f-default-deadline\")\n\t\t\t\t\t\t// job_started_at = 11:31:00Z, elapsed = 29min, default deadline = 1800s (30min)\n\t\t\t\t\t\t// elapsed < deadline → no publish\n\t\t\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:31:00Z\")\n\t\t\t\t\t\ttask := makeTask(\n\t\t\t\t\t\t\tstring(taskID),\n\t\t\t\t\t\t\t\"agent-no-config\",\n\t\t\t\t\t\t\t\"job-1\",\n\t\t\t\t\t\t\tts.Format(time.RFC3339),\n\t\t\t\t\t\t)\n\t\t\t\t\t\ttaskStore.Store(taskID, task)\n\n\t\t\t\t\t\t// No config added — uses default deadline of 1800s\n\t\t\t\t\t\tfakeClient := fake.NewSimpleClientset()\n\t\t\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n\t\t\t\t\t\t\tfakeClient,\n\t\t\t\t\t\t\t0,\n\t\t\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n\t\t\t\t\t\t)\n\t\t\t\t\t\tpodInformer := informerFactory.Core().V1().Pods().Informer()\n\t\t\t\t\t\t_ = podInformer.GetIndexer().\n\t\t\t\t\t\t\tAdd(makePod(\"pod-failed\", \"test-ns\", string(taskID), corev1.PodFailed, 0))\n\t\t\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n\t\t\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n\t\t\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n\n\t\t\t\t\t\tsweeper := pkg.NewZombieSweeper(\n\t\t\t\t\t\t\tfakeJobWatcher,\n\t\t\t\t\t\t\t\"test-ns\",\n\t\t\t\t\t\t\ttaskStore,\n\t\t\t\t\t\t\tfakePublisher,\n\t\t\t\t\t\t\teventHandlerConfig,\n\t\t\t\t\t\t\tcurrentDateTime,\n\t\t\t\t\t\t)\n\n\t\t\t\t\t\terr := sweeper.SweepOnce(ctx)\n\t\t\t\t\t\tExpect(err).To(BeNil())\n\t\t\t\t\t\t// elapsed (29min) < default deadline (30min) → no zombie\n\t\t\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\t\t\t\t\t},\n\t\t\t\t)\n\t\t\t},\n\t\t)\n\n\t\t// 6g: interval override — tested via 6a-6e which use configs with specific timeouts\n\t\t// 6h: deadline default — verified by 6f (uses default when no config matches)\n\n\t\tContext(\"task with no current_job is skipped\", func() {\n\t\t\tIt(\"skips tasks without a current_job set\", func() {\n\t\t\t\ttaskID := lib.TaskIdentifier(\"task-no-job\")\n\t\t\t\ttask := makeTask(string(taskID), \"agent-a\", \"\", \"\")\n\t\t\t\ttaskStore.Store(taskID, task)\n\n\t\t\t\tfakeClient := fake.NewSimpleClientset()\n\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n\t\t\t\t\tfakeClient,\n\t\t\t\t\t0,\n\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n\t\t\t\t)\n\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n\n\t\t\t\tsweeper := pkg.NewZombieSweeper(\n\t\t\t\t\tfakeJobWatcher,\n\t\t\t\t\t\"test-ns\",\n\t\t\t\t\ttaskStore,\n\t\t\t\t\tfakePublisher,\n\t\t\t\t\teventHandlerConfig,\n\t\t\t\t\tcurrentDateTime,\n\t\t\t\t)\n\n\t\t\t\terr := sweeper.SweepOnce(ctx)\n\t\t\t\tExpect(err).To(BeNil())\n\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\t\t\t})\n\t\t})\n\n\t\tContext(\"task with unparseable job_started_at is skipped\", func() {\n\t\t\tIt(\"skips tasks with malformed job_started_at\", func() {\n\t\t\t\ttaskID := lib.TaskIdentifier(\"task-bad-time\")\n\t\t\t\tfm := lib.TaskFrontmatter{\n\t\t\t\t\t\"status\":         \"in_progress\",\n\t\t\t\t\t\"assignee\":       \"agent-a\",\n\t\t\t\t\t\"current_job\":    \"job-1\",\n\t\t\t\t\t\"job_started_at\": \"not-a-valid-timestamp\",\n\t\t\t\t}\n\t\t\t\ttask := lib.Task{\n\t\t\t\t\tTaskIdentifier: taskID,\n\t\t\t\t\tFrontmatter:    fm,\n\t\t\t\t\tContent:        lib.TaskContent(\"do the work\"),\n\t\t\t\t}\n\t\t\t\ttaskStore.Store(taskID, task)\n\n\t\t\t\tfakeClient := fake.NewSimpleClientset()\n\t\t\t\tinformerFactory := k8sinformers.NewSharedInformerFactoryWithOptions(\n\t\t\t\t\tfakeClient,\n\t\t\t\t\t0,\n\t\t\t\t\tk8sinformers.WithNamespace(\"test-ns\"),\n\t\t\t\t)\n\t\t\t\tpodLister := informerFactory.Core().V1().Pods().Lister()\n\t\t\t\tfakeJobWatcher := &mocks.FakeJobWatcher{}\n\t\t\t\tfakeJobWatcher.PodListerReturns(podLister)\n\n\t\t\t\tsweeper := pkg.NewZombieSweeper(\n\t\t\t\t\tfakeJobWatcher,\n\t\t\t\t\t\"test-ns\",\n\t\t\t\t\ttaskStore,\n\t\t\t\t\tfakePublisher,\n\t\t\t\t\teventHandlerConfig,\n\t\t\t\t\tcurrentDateTime,\n\t\t\t\t)\n\n\t\t\t\terr := sweeper.SweepOnce(ctx)\n\t\t\t\tExpect(err).To(BeNil())\n\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\t\t\t})\n\t\t})\n\n\t\t// Per-task publish errors must NOT abort the sweep — every past-deadline\n\t\t// task must get a PublishFailure attempt even when an earlier one fails.\n\t\t// Guards the regression where a single broken publisher.PublishFailure\n\t\t// (e.g. transient kafka error for one task's UUID) would skip the rest.\n\t\tContext(\"multiple tasks with one publish failure mid-loop\", func() {\n\t\t\tIt(\n\t\t\t\t\"calls PublishFailure for every task and continues past per-task errors\",\n\t\t\t\tfunc() {\n\t\t\t\t\tts := libtimetest.ParseDateTime(\"2026-06-01T11:30:00Z\")\n\t\t\t\t\ttasks := []lib.TaskIdentifier{\n\t\t\t\t\t\t\"task-multi-1\",\n\t\t\t\t\t\t\"task-multi-2\",\n\t\t\t\t\t\t\"task-multi-3\",\n\t\t\t\t\t}\n\t\t\t\t\tfor _, id := range tasks {\n\t\t\t\t\t\ttask := makeTask(\n\t\t\t\t\t\t\tstring(id),\n\t\t\t\t\t\t\t\"agent-a\",\n\t\t\t\t\t\t\t\"job-\"+string(id),\n\t\t\t\t\t\t\tts.Format(time.RFC3339),\n\t\t\t\t\t\t)\n\t\t\t\t\t\ttaskStore.Store(id, task)\n\t\t\t\t\t}\n\n\t\t\t\t\tcfg := agentv1.Config{\n\t\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Name: \"cfg-a\"},\n\t\t\t\t\t\tSpec: agentv