t inspecting the pod.\nfunc (w *jobWatcher) backoffFailureReason(job *batchv1.Job, base ZombieReason) string {\n\tterminatedReason, exitCode, ok := w.terminalPodDetail(job)\n\tif !ok {\n\t\treturn base.String()\n\t}\n\tif terminatedReason == \"OOMKilled\" {\n\t\treturn fmt.Sprintf(\"%s (%s/%d)\", ZombieReasonPodOOMKilled, terminatedReason, exitCode)\n\t}\n\treturn fmt.Sprintf(\"%s (%s/%d)\", base.String(), terminatedReason, exitCode)\n}"}}],"model":"deepseek-v4-flash","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"66607f9a-fb74-4a6f-9e0e-f3ec5b2597d7","uuid":"1f12336d-9439-4e52-9e79-36acdef1ab0c","timestamp":"2026-08-31T22:04:49.522Z"}
