{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-ac03a50a2cb0cc7b","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg_test\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\n10\t\tlib \"github.com/bborbe/agent\"\n11\t\t. \"github.com/onsi/ginkgo/v2\"\n12\t\t. \"github.com/onsi/gomega\"\n13\t\tbatchv1 \"k8s.io/api/batch/v1\"\n14\t\tcorev1 \"k8s.io/api/core/v1\"\n15\t\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"\n16\t\t\"k8s.io/client-go/kubernetes/fake\"\n17\t\n18\t\t\"github.com/bborbe/agent-task-executor/mocks\"\n19\t\t\"github.com/bborbe/agent-task-executor/pkg\"\n20\t)\n21\t\n22\tvar _ = Describe(\"JobWatcher\", func() {\n23\t\tvar (\n24\t\t\tctx            context.Context\n25\t\t\tfakePublisher  *mocks.FakeResultPublisher\n26\t\t\ttaskStore      *pkg.TaskStore\n27\t\t\tfakeKubeClient *fake.Clientset\n28\t\t\twatcher        pkg.JobWatcher\n29\t\t\ttestTask       lib.Task\n30\t\t\ttestTaskID     lib.TaskIdentifier\n31\t\t)\n32\t\n33\t\tBeforeEach(func() {\n34\t\t\tctx = context.Background()\n35\t\t\tfakePublisher = &mocks.FakeResultPublisher{}\n36\t\t\ttaskStore = pkg.NewTaskStore()\n37\t\t\tfakeKubeClient = fake.NewClientset()\n38\t\t\ttestTaskID = lib.TaskIdentifier(\"test-task-uuid-1234\")\n39\t\t\ttestTask = lib.Task{\n40\t\t\t\tTaskIdentifier: testTaskID,\n41\t\t\t\tFrontmatter: lib.TaskFrontmatter{\n42\t\t\t\t\t\"status\":   \"in_progress\",\n43\t\t\t\t\t\"assignee\": \"claude\",\n44\t\t\t\t},\n45\t\t\t\tContent: lib.TaskContent(\"do the work\"),\n46\t\t\t}\n47\t\t\twatcher = pkg.NewJobWatcher(fakeKubeClient, \"test-ns\", taskStore, fakePublisher)\n48\t\t})\n49\t\n50\t\tmakeJob := func(name string, taskID string, conditions ...batchv1.JobCondition) *batchv1.Job {\n51\t\t\tlabels := map[string]string{}\n52\t\t\tif taskID != \"\" {\n53\t\t\t\tlabels[\"agent.benjamin-borbe.de/task-id\"] = taskID\n54\t\t\t}\n55\t\t\tjob := &batchv1.Job{\n56\t\t\t\tObjectMeta: metav1.ObjectMeta{\n57\t\t\t\t\tName:      name,\n58\t\t\t\t\tNamespace: \"test-ns\",\n59\t\t\t\t\tLabels:    labels,\n60\t\t\t\t},\n61\t\t\t\tStatus: batchv1.JobStatus{\n62\t\t\t\t\tConditions: conditions,\n63\t\t\t\t},\n64\t\t\t}\n65\t\t\treturn job\n66\t\t}\n67\t\n68\t\tfailedCondition := func(msg string) batchv1.JobCondition {\n69\t\t\treturn batchv1.JobCondition{\n70\t\t\t\tType:    batchv1.JobFailed,\n71\t\t\t\tStatus:  corev1.ConditionTrue,\n72\t\t\t\tMessage: msg,\n73\t\t\t}\n74\t\t}\n75\t\n76\t\tsucceededCondition := func() batchv1.JobCondition {\n77\t\t\treturn batchv1.JobCondition{\n78\t\t\t\tType:   batchv1.JobComplete,\n79\t\t\t\tStatus: corev1.ConditionTrue,\n80\t\t\t}\n81\t\t}\n82\t\n83\t\tDescribe(\"HandleJob\", func() {\n84\t\t\tIt(\"publishes synthetic failure and deletes job on Failed state\", func() {\n85\t\t\t\tjob := makeJob(\"job-1\", string(testTaskID), failedCondition(\"OOMKilled\"))\n86\t\t\t\t_, err := fakeKubeClient.BatchV1().\n87\t\t\t\t\tJobs(\"test-ns\").\n88\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n89\t\t\t\tExpect(err).To(BeNil())\n90\t\t\t\ttaskStore.Store(testTaskID, testTask)\n91\t\n92\t\t\t\twatcher.HandleJob(ctx, job)\n93\t\n94\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n95\t\t\t\t_, calledTask, calledJobName, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n96\t\t\t\tExpect(string(calledTask.TaskIdentifier)).To(Equal(string(testTaskID)))\n97\t\t\t\tExpect(calledJobName).To(Equal(\"job-1\"))\n98\t\t\t\tExpect(calledReason).To(Equal(\"pod_crash_no_stdout\"))\n99\t\n100\t\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-1\", metav1.GetOptions{})\n101\t\t\t\tExpect(err).To(BeNil())\n102\t\t\t})\n103\t\n104\t\t\tIt(\"does NOT publish synthetic failure for Succeeded job (trusts agent publish)\", func() {\n105\t\t\t\tjob := makeJob(\"job-2\", string(testTaskID), succeededCondition())\n106\t\t\t\t_, err := fakeKubeClient.BatchV1().\n107\t\t\t\t\tJobs(\"test-ns\").\n108\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n109\t\t\t\tExpect(err).To(BeNil())\n110\t\t\t\ttaskStore.Store(testTaskID, testTask)\n111\t\n112\t\t\t\twatcher.HandleJob(ctx, job)\n113\t\n114\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n115\t\t\t\t// task cleaned up from store\n116\t\t\t\t_, ok := taskStore.Load(testTaskID)\n117\t\t\t\tExpect(ok).To(BeFalse())\n118\t\n119\t\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-2\", metav1.GetOptions{})\n120\t\t\t\tExpect(err).To(BeNil())\n121\t\t\t})\n122\t\n123\t\t\tIt(\"skips synthetic failure for Succeeded job when task is not in store\", func() {\n124\t\t\t\tjob := makeJob(\"job-3\", string(testTaskID), succeededCondition())\n125\t\t\t\t_, err := fakeKubeClient.BatchV1().\n126\t\t\t\t\tJobs(\"test-ns\").\n127\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n128\t\t\t\tExpect(err).To(BeNil())\n129\t\t\t\t// intentionally NOT storing task in taskStore\n130\t\n131\t\t\t\twatcher.HandleJob(ctx, job)\n132\t\n133\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n134\t\n135\t\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-3\", metav1.GetOptions{})\n136\t\t\t\tExpect(err).To(BeNil())\n137\t\t\t})\n138\t\n139\t\t\tIt(\"ignores jobs without task-id label\", func() {\n140\t\t\t\tjob := makeJob(\"job-4\", \"\", failedCondition(\"crash\"))\n141\t\t\t\t_, err := fakeKubeClient.BatchV1().\n142\t\t\t\t\tJobs(\"test-ns\").\n143\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n144\t\t\t\tExpect(err).To(BeNil())\n145\t\n146\t\t\t\twatcher.HandleJob(ctx, job)\n147\t\n148\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n149\t\t\t\t// job should NOT be deleted\n150\t\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-4\", metav1.GetOptions{})\n151\t\t\t\tExpect(err).To(BeNil())\n152\t\t\t})\n153\t\n154\t\t\tIt(\"keeps Failed job (TTL cleanup) when task is not in taskStore\", func() {\n155\t\t\t\tjob := makeJob(\"job-5\", string(testTaskID), failedCondition(\"evicted\"))\n156\t\t\t\t_, err := fakeKubeClient.BatchV1().\n157\t\t\t\t\tJobs(\"test-ns\").\n158\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n159\t\t\t\tExpect(err).To(BeNil())\n160\t\t\t\t// intentionally NOT storing task in taskStore\n161\t\n162\t\t\t\twatcher.HandleJob(ctx, job)\n163\t\n164\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n165\t\n166\t\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-5\", metav1.GetOptions{})\n167\t\t\t\tExpect(err).To(BeNil())\n168\t\t\t})\n169\t\n170\t\t\tIt(\"removes task from taskStore after handling terminal job\", func() {\n171\t\t\t\tjob := makeJob(\"job-6\", string(testTaskID), failedCondition(\"crash\"))\n172\t\t\t\t_, err := fakeKubeClient.BatchV1().\n173\t\t\t\t\tJobs(\"test-ns\").\n174\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n175\t\t\t\tExpect(err).To(BeNil())\n176\t\t\t\ttaskStore.Store(testTaskID, testTask)\n177\t\n178\t\t\t\twatcher.HandleJob(ctx, job)\n179\t\n180\t\t\t\t_, ok := taskStore.Load(testTaskID)\n181\t\t\t\tExpect(ok).To(BeFalse())\n182\t\t\t})\n183\t\n184\t\t\tIt(\"ignores jobs that are neither failed nor succeeded\", func() {\n185\t\t\t\tjob := makeJob(\"job-8\", string(testTaskID))\n186\t\t\t\t_, err := fakeKubeClient.BatchV1().\n187\t\t\t\t\tJobs(\"test-ns\").\n188\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n189\t\t\t\tExpect(err).To(BeNil())\n190\t\t\t\ttaskStore.Store(testTaskID, testTask)\n191\t\n192\t\t\t\twatcher.HandleJob(ctx, job)\n193\t\n194\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n195\t\t\t\t// job still exists (not terminal)\n196\t\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-8\", metav1.GetOptions{})\n197\t\t\t\tExpect(err).To(BeNil())\n198\t\t\t})\n199\t\n200\t\t\tIt(\"uses pod_crash_no_stdout when condition has no message\", func() {\n201\t\t\t\tjob := makeJob(\"job-7\", string(testTaskID), batchv1.JobCondition{\n202\t\t\t\t\tType:   batchv1.JobFailed,\n203\t\t\t\t\tStatus: corev1.ConditionTrue,\n204\t\t\t\t})\n205\t\t\t\t_, err := fakeKubeClient.BatchV1().\n206\t\t\t\t\tJobs(\"test-ns\").\n207\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n208\t\t\t\tExpect(err).To(BeNil())\n209\t\t\t\ttaskStore.Store(testTaskID, testTask)\n210\t\n211\t\t\t\twatcher.HandleJob(ctx, job)\n212\t\n213\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n214\t\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n215\t\t\t\tExpect(calledReason).To(Equal(\"pod_crash_no_stdout\"))\n216\t\t\t})\n217\t\t})\n218\t\n219\t\tDescribe(\"HandleJob with DeadlineExceeded\", func() {\n220\t\t\tIt(\"maps DeadlineExceeded job condition to deadline_exceeded\", func() {\n221\t\t\t\tjob := makeJob(\"job-deadline\", string(testTaskID), batchv1.JobCondition{\n222\t\t\t\t\tType:    batchv1.JobFailed,\n223\t\t\t\t\tStatus:  corev1.ConditionTrue,\n224\t\t\t\t\tReason:  \"DeadlineExceeded\",\n225\t\t\t\t\tMessage: \"Job was active longer than specified deadline\",\n226\t\t\t\t})\n227\t\t\t\t_, err := fakeKubeClient.BatchV1().\n228\t\t\t\t\tJobs(\"test-ns\").\n229\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n230\t\t\t\tExpect(err).To(BeNil())\n231\t\t\t\ttaskStore.Store(testTaskID, testTask)\n232\t\n233\t\t\t\twatcher.HandleJob(ctx, job)\n234\t\n235\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n236\t\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n237\t\t\t\tExpect(calledReason).To(Equal(\"deadline_exceeded\"))\n238\t\t\t})\n239\t\n240\t\t\tIt(\"maps BackoffLimitExceeded job condition to deadline_exceeded\", func() {\n241\t\t\t\tjob := makeJob(\"job-backoff\", string(testTaskID), batchv1.JobCondition{\n242\t\t\t\t\tType:    batchv1.JobFailed,\n243\t\t\t\t\tStatus:  corev1.ConditionTrue,\n244\t\t\t\t\tReason:  \"BackoffLimitExceeded\",\n245\t\t\t\t\tMessage: \"Job failed due to backoff limit\",\n246\t\t\t\t})\n247\t\t\t\t_, err := fakeKubeClient.BatchV1().\n248\t\t\t\t\tJobs(\"test-ns\").\n249\t\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n250\t\t\t\tExpect(err).To(BeNil())\n251\t\t\t\ttaskStore.Store(testTaskID, testTask)\n252\t\n253\t\t\t\twatcher.HandleJob(ctx, job)\n254\t\n255\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n256\t\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n257\t\t\t\tExpect(calledReason).To(Equal(\"deadline_exceeded\"))\n258\t\t\t})\n259\t\t})\n260\t\n261\t\tDescribe(\"jobFailureReason mapping\", func() {\n262\t\t\tIt(\"returns deadline_exceeded for DeadlineExceeded\", func() {\n263\t\t\t\tjob := makeJob(\"j\", string(testTaskID), batchv1.JobCondition{\n264\t\t\t\t\tType:   batchv1.JobFailed,\n265\t\t\t\t\tStatus: corev1.ConditionTrue,\n266\t\t\t\t\tReason: \"DeadlineExceeded\",\n267\t\t\t\t})\n268\t\t\t\tExpect(pkg.JobFailureReason(job)).To(Equal(pkg.ZombieReasonDeadlineExceeded))\n269\t\t\t})\n270\t\n271\t\t\tIt(\"returns deadline_exceeded for BackoffLimitExceeded\", func() {\n272\t\t\t\tjob := makeJob(\"j\", string(testTaskID), batchv1.JobCondition{\n273\t\t\t\t\tType:   batchv1.JobFailed,\n274\t\t\t\t\tStatus: corev1.ConditionTrue,\n275\t\t\t\t\tReason: \"BackoffLimitExceeded\",\n276\t\t\t\t})\n277\t\t\t\tExpect(pkg.JobFailureReason(job)).To(Equal(pkg.ZombieReasonDeadlineExceeded))\n278\t\t\t})\n279\t\n280\t\t\tIt(\"returns pod_crash_no_stdout for other Failed condition reasons\", func() {\n281\t\t\t\tjob := makeJob(\"j\", string(testTaskID), batchv1.JobCondition{\n282\t\t\t\t\tType:   batchv1.JobFailed,\n283\t\t\t\t\tStatus: corev1.ConditionTrue,\n284\t\t\t\t\tReason: \"\",\n285\t\t\t\t})\n286\t\t\t\tExpect(pkg.JobFailureReason(job)).To(Equal(pkg.ZombieReasonPodCrashNoStdout))\n287\t\t\t})\n288\t\t})\n289\t\n290\t\tDescribe(\"HandlePod\", func() {\n291\t\t\tmakePod := func(name string, taskID string, phase corev1.PodPhase, containerStatuses []corev1.ContainerStatus, ownerRefs []metav1.OwnerReference, podStatusReason string) *corev1.Pod {\n292\t\t\t\tlabels := map[string]string{}\n293\t\t\t\tif taskID != \"\" {\n294\t\t\t\t\tlabels[\"agent.benjamin-borbe.de/task-id\"] = taskID\n295\t\t\t\t}\n296\t\t\t\tpod := &corev1.Pod{\n297\t\t\t\t\tObjectMeta: metav1.ObjectMeta{\n298\t\t\t\t\t\tName:            name,\n299\t\t\t\t\t\tNamespace:       \"test-ns\",\n300\t\t\t\t\t\tLabels:          labels,\n301\t\t\t\t\t\tOwnerReferences: ownerRefs,\n302\t\t\t\t\t},\n303\t\t\t\t\tStatus: corev1.PodStatus{\n304\t\t\t\t\t\tPhase: phase,\n305\t\t\t\t\t},\n306\t\t\t\t}\n307\t\t\t\tif len(containerStatuses) > 0 {\n308\t\t\t\t\tpod.Status.ContainerStatuses = containerStatuses\n309\t\t\t\t}\n310\t\t\t\tif podStatusReason != \"\" {\n311\t\t\t\t\tpod.Status.Reason = podStatusReason\n312\t\t\t\t}\n313\t\t\t\treturn pod\n314\t\t\t}\n315\t\n316\t\t\tmakeJobOwnerRef := func(name string) []metav1.OwnerReference {\n317\t\t\t\treturn []metav1.OwnerReference{\n318\t\t\t\t\t{\n319\t\t\t\t\t\tKind: \"Job\",\n320\t\t\t\t\t\tName: name,\n321\t\t\t\t\t},\n322\t\t\t\t}\n323\t\t\t}\n324\t\n325\t\t\tIt(\"publishes failure for ImagePullBackOff container\", func() {\n326\t\t\t\tpod := makePod(\n327\t\t\t\t\t\"pod-imgpull\",\n328\t\t\t\t\tstring(testTaskID),\n329\t\t\t\t\tcorev1.PodPending,\n330\t\t\t\t\t[]corev1.ContainerStatus{\n331\t\t\t\t\t\t{\n332\t\t\t\t\t\t\tState: corev1.ContainerState{\n333\t\t\t\t\t\t\t\tWaiting: &corev1.ContainerStateWaiting{\n334\t\t\t\t\t\t\t\t\tReason: \"ImagePullBackOff\",\n335\t\t\t\t\t\t\t\t},\n336\t\t\t\t\t\t\t},\n337\t\t\t\t\t\t},\n338\t\t\t\t\t},\n339\t\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n340\t\t\t\t\t\"\",\n341\t\t\t\t)\n342\t\t\t\ttaskStore.Store(testTaskID, testTask)\n343\t\n344\t\t\t\twatcher.HandlePod(ctx, pod)\n345\t\n346\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n347\t\t\t\t_, _, calledJobName, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n348\t\t\t\tExpect(calledJobName).To(Equal(\"my-job\"))\n349\t\t\t\tExpect(calledReason).To(Equal(\"image_pull_backoff\"))\n350\t\t\t})\n351\t\n352\t\t\tIt(\"publishes failure for ErrImagePull container\", func() {\n353\t\t\t\tpod := makePod(\n354\t\t\t\t\t\"pod-errimg\",\n355\t\t\t\t\tstring(testTaskID),\n356\t\t\t\t\tcorev1.PodPending,\n357\t\t\t\t\t[]corev1.ContainerStatus{\n358\t\t\t\t\t\t{\n359\t\t\t\t\t\t\tState: corev1.ContainerState{\n360\t\t\t\t\t\t\t\tWaiting: &corev1.ContainerStateWaiting{\n361\t\t\t\t\t\t\t\t\tReason: \"ErrImagePull\",\n362\t\t\t\t\t\t\t\t},\n363\t\t\t\t\t\t\t},\n364\t\t\t\t\t\t},\n365\t\t\t\t\t},\n366\t\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n367\t\t\t\t\t\"\",\n368\t\t\t\t)\n369\t\t\t\ttaskStore.Store(testTaskID, testTask)\n370\t\n371\t\t\t\twatcher.HandlePod(ctx, pod)\n372\t\n373\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n374\t\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n375\t\t\t\tExpect(calledReason).To(Equal(\"image_pull_backoff\"))\n376\t\t\t})\n377\t\n378\t\t\tIt(\"publishes failure for CrashLoopBackOff container\", func() {\n379\t\t\t\tpod := makePod(\n380\t\t\t\t\t\"pod-crashloop\",\n381\t\t\t\t\tstring(testTaskID),\n382\t\t\t\t\tcorev1.PodPending,\n383\t\t\t\t\t[]corev1.ContainerStatus{\n384\t\t\t\t\t\t{\n385\t\t\t\t\t\t\tState: corev1.ContainerState{\n386\t\t\t\t\t\t\t\tWaiting: &corev1.ContainerStateWaiting{\n387\t\t\t\t\t\t\t\t\tReason: \"CrashLoopBackOff\",\n388\t\t\t\t\t\t\t\t},\n389\t\t\t\t\t\t\t},\n390\t\t\t\t\t\t},\n391\t\t\t\t\t},\n392\t\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n393\t\t\t\t\t\"\",\n394\t\t\t\t)\n395\t\t\t\ttaskStore.Store(testTaskID, testTask)\n396\t\n397\t\t\t\twatcher.HandlePod(ctx, pod)\n398\t\n399\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n400\t\t\t\t_, _, calledJobName, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n401\t\t\t\tExpect(calledJobName).To(Equal(\"my-job\"))\n402\t\t\t\tExpect(calledReason).To(Equal(\"pod_crash_no_stdout\"))\n403\t\t\t})\n404\t\n405\t\t\tIt(\"publishes failure for Evicted pod\", func() {\n406\t\t\t\tpod := makePod(\n407\t\t\t\t\t\"pod-evicted\",\n408\t\t\t\t\tstring(testTaskID),\n409\t\t\t\t\tcorev1.PodPending,\n410\t\t\t\t\tnil,\n411\t\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n412\t\t\t\t\t\"Evicted\",\n413\t\t\t\t)\n414\t\t\t\ttaskStore.Store(testTaskID, testTask)\n415\t\n416\t\t\t\twatcher.HandlePod(ctx, pod)\n417\t\n418\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n419\t\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n420\t\t\t\tExpect(calledReason).To(Equal(\"pod_evicted\"))\n421\t\t\t})\n422\t\n423\t\t\tIt(\"publishes failure for PodFailed with non-zero exit code\", func() {\n424\t\t\t\tpod := makePod(\n425\t\t\t\t\t\"pod-crash\",\n426\t\t\t\t\tstring(testTaskID),\n427\t\t\t\t\tcorev1.PodFailed,\n428\t\t\t\t\t[]corev1.ContainerStatus{\n429\t\t\t\t\t\t{\n430\t\t\t\t\t\t\tState: corev1.ContainerState{\n431\t\t\t\t\t\t\t\tTerminated: &corev1.ContainerStateTerminated{\n432\t\t\t\t\t\t\t\t\tExitCode: 137,\n433\t\t\t\t\t\t\t\t},\n434\t\t\t\t\t\t\t},\n435\t\t\t\t\t\t},\n436\t\t\t\t\t},\n437\t\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n438\t\t\t\t\t\"\",\n439\t\t\t\t)\n440\t\t\t\ttaskStore.Store(testTaskID, testTask)\n441\t\n442\t\t\t\twatcher.HandlePod(ctx, pod)\n443\t\n444\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n445\t\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n446\t\t\t\tExpect(calledReason).To(Equal(\"pod_crash_no_stdout\"))\n447\t\t\t})\n448\t\n449\t\t\tIt(\"does NOT publish failure for healthy Running pod\", func() {\n450\t\t\t\tpod := makePod(\n451\t\t\t\t\t\"pod-running\",\n452\t\t\t\t\tstring(testTaskID),\n453\t\t\t\t\tcorev1.PodRunning,\n454\t\t\t\t\tnil,\n455\t\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n456\t\t\t\t\t\"\",\n457\t\t\t\t)\n458\t\t\t\ttaskStore.Store(testTaskID, testTask)\n459\t\n460\t\t\t\twatcher.HandlePod(ctx, pod)\n461\t\n462\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n463\t\t\t})\n464\t\n465\t\t\tIt(\"does NOT publish failure when task is not in store\", func() {\n466\t\t\t\tpod := makePod(\n467\t\t\t\t\t\"pod-imgpull\",\n468\t\t\t\t\tstring(testTaskID),\n469\t\t\t\t\tcorev1.PodPending,\n470\t\t\t\t\t[]corev1.ContainerStatus{\n471\t\t\t\t\t\t{\n472\t\t\t\t\t\t\tState: corev1.ContainerState{\n473\t\t\t\t\t\t\t\tWaiting: &corev1.ContainerStateWaiting{\n474\t\t\t\t\t\t\t\t\tReason: \"ImagePullBackOff\",\n475\t\t\t\t\t\t\t\t},\n476\t\t\t\t\t\t\t},\n477\t\t\t\t\t\t},\n478\t\t\t\t\t},\n479\t\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n480\t\t\t\t\t\"\",\n481\t\t\t\t)\n482\t\n483\t\t\t\twatcher.HandlePod(ctx, pod)\n484\t\n485\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n486\t\t\t})\n487\t\n488\t\t\tIt(\"does NOT publish failure when pod has no Job ownerRef\", func() {\n489\t\t\t\tpod := makePod(\n490\t\t\t\t\t\"pod-noowner\",\n491\t\t\t\t\tstring(testTaskID),\n492\t\t\t\t\tcorev1.PodPending,\n493\t\t\t\t\t[]corev1.ContainerStatus{\n494\t\t\t\t\t\t{\n495\t\t\t\t\t\t\tState: corev1.ContainerState{\n496\t\t\t\t\t\t\t\tWaiting: &corev1.ContainerStateWaiting{\n497\t\t\t\t\t\t\t\t\tReason: \"ImagePullBackOff\",\n498\t\t\t\t\t\t\t\t},\n499\t\t\t\t\t\t\t},\n500\t\t\t\t\t\t},\n501\t\t\t\t\t},\n502\t\t\t\t\tnil,\n503\t\t\t\t\t\"\",\n504\t\t\t\t)\n505\t\t\t\ttaskStore.Store(testTaskID, testTask)\n506\t\n507\t\t\t\twatcher.HandlePod(ctx, pod)\n508\t\n509\t\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n510\t\t\t})\n511\t\t})\n512\t})\n513\t"}]},"parent_tool_use_id":null,"session_id":"66607f9a-fb74-4a6f-9e0e-f3ec5b2597d7","uuid":"291b403c-b43c-4ef0-ab0d-5d362322dcd2","timestamp":"2026-08-31T22:03:37.920Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/job_watcher_test.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage pkg_test\n\nimport (\n\t\"context\"\n\n\tlib \"github.com/bborbe/agent\"\n\t. \"github.com/onsi/ginkgo/v2\"\n\t. \"github.com/onsi/gomega\"\n\tbatchv1 \"k8s.io/api/batch/v1\"\n\tcorev1 \"k8s.io/api/core/v1\"\n\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"\n\t\"k8s.io/client-go/kubernetes/fake\"\n\n\t\"github.com/bborbe/agent-task-executor/mocks\"\n\t\"github.com/bborbe/agent-task-executor/pkg\"\n)\n\nvar _ = Describe(\"JobWatcher\", func() {\n\tvar (\n\t\tctx            context.Context\n\t\tfakePublisher  *mocks.FakeResultPublisher\n\t\ttaskStore      *pkg.TaskStore\n\t\tfakeKubeClient *fake.Clientset\n\t\twatcher        pkg.JobWatcher\n\t\ttestTask       lib.Task\n\t\ttestTaskID     lib.TaskIdentifier\n\t)\n\n\tBeforeEach(func() {\n\t\tctx = context.Background()\n\t\tfakePublisher = &mocks.FakeResultPublisher{}\n\t\ttaskStore = pkg.NewTaskStore()\n\t\tfakeKubeClient = fake.NewClientset()\n\t\ttestTaskID = lib.TaskIdentifier(\"test-task-uuid-1234\")\n\t\ttestTask = lib.Task{\n\t\t\tTaskIdentifier: testTaskID,\n\t\t\tFrontmatter: lib.TaskFrontmatter{\n\t\t\t\t\"status\":   \"in_progress\",\n\t\t\t\t\"assignee\": \"claude\",\n\t\t\t},\n\t\t\tContent: lib.TaskContent(\"do the work\"),\n\t\t}\n\t\twatcher = pkg.NewJobWatcher(fakeKubeClient, \"test-ns\", taskStore, fakePublisher)\n\t})\n\n\tmakeJob := func(name string, taskID string, conditions ...batchv1.JobCondition) *batchv1.Job {\n\t\tlabels := map[string]string{}\n\t\tif taskID != \"\" {\n\t\t\tlabels[\"agent.benjamin-borbe.de/task-id\"] = taskID\n\t\t}\n\t\tjob := &batchv1.Job{\n\t\t\tObjectMeta: metav1.ObjectMeta{\n\t\t\t\tName:      name,\n\t\t\t\tNamespace: \"test-ns\",\n\t\t\t\tLabels:    labels,\n\t\t\t},\n\t\t\tStatus: batchv1.JobStatus{\n\t\t\t\tConditions: conditions,\n\t\t\t},\n\t\t}\n\t\treturn job\n\t}\n\n\tfailedCondition := func(msg string) batchv1.JobCondition {\n\t\treturn batchv1.JobCondition{\n\t\t\tType:    batchv1.JobFailed,\n\t\t\tStatus:  corev1.ConditionTrue,\n\t\t\tMessage: msg,\n\t\t}\n\t}\n\n\tsucceededCondition := func() batchv1.JobCondition {\n\t\treturn batchv1.JobCondition{\n\t\t\tType:   batchv1.JobComplete,\n\t\t\tStatus: corev1.ConditionTrue,\n\t\t}\n\t}\n\n\tDescribe(\"HandleJob\", func() {\n\t\tIt(\"publishes synthetic failure and deletes job on Failed state\", func() {\n\t\t\tjob := makeJob(\"job-1\", string(testTaskID), failedCondition(\"OOMKilled\"))\n\t\t\t_, err := fakeKubeClient.BatchV1().\n\t\t\t\tJobs(\"test-ns\").\n\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandleJob(ctx, job)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n\t\t\t_, calledTask, calledJobName, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n\t\t\tExpect(string(calledTask.TaskIdentifier)).To(Equal(string(testTaskID)))\n\t\t\tExpect(calledJobName).To(Equal(\"job-1\"))\n\t\t\tExpect(calledReason).To(Equal(\"pod_crash_no_stdout\"))\n\n\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-1\", metav1.GetOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t})\n\n\t\tIt(\"does NOT publish synthetic failure for Succeeded job (trusts agent publish)\", func() {\n\t\t\tjob := makeJob(\"job-2\", string(testTaskID), succeededCondition())\n\t\t\t_, err := fakeKubeClient.BatchV1().\n\t\t\t\tJobs(\"test-ns\").\n\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandleJob(ctx, job)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\t\t\t// task cleaned up from store\n\t\t\t_, ok := taskStore.Load(testTaskID)\n\t\t\tExpect(ok).To(BeFalse())\n\n\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-2\", metav1.GetOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t})\n\n\t\tIt(\"skips synthetic failure for Succeeded job when task is not in store\", func() {\n\t\t\tjob := makeJob(\"job-3\", string(testTaskID), succeededCondition())\n\t\t\t_, err := fakeKubeClient.BatchV1().\n\t\t\t\tJobs(\"test-ns\").\n\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t\t// intentionally NOT storing task in taskStore\n\n\t\t\twatcher.HandleJob(ctx, job)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\n\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-3\", metav1.GetOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t})\n\n\t\tIt(\"ignores jobs without task-id label\", func() {\n\t\t\tjob := makeJob(\"job-4\", \"\", failedCondition(\"crash\"))\n\t\t\t_, err := fakeKubeClient.BatchV1().\n\t\t\t\tJobs(\"test-ns\").\n\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n\t\t\tExpect(err).To(BeNil())\n\n\t\t\twatcher.HandleJob(ctx, job)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\t\t\t// job should NOT be deleted\n\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-4\", metav1.GetOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t})\n\n\t\tIt(\"keeps Failed job (TTL cleanup) when task is not in taskStore\", func() {\n\t\t\tjob := makeJob(\"job-5\", string(testTaskID), failedCondition(\"evicted\"))\n\t\t\t_, err := fakeKubeClient.BatchV1().\n\t\t\t\tJobs(\"test-ns\").\n\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t\t// intentionally NOT storing task in taskStore\n\n\t\t\twatcher.HandleJob(ctx, job)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\n\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-5\", metav1.GetOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t})\n\n\t\tIt(\"removes task from taskStore after handling terminal job\", func() {\n\t\t\tjob := makeJob(\"job-6\", string(testTaskID), failedCondition(\"crash\"))\n\t\t\t_, err := fakeKubeClient.BatchV1().\n\t\t\t\tJobs(\"test-ns\").\n\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandleJob(ctx, job)\n\n\t\t\t_, ok := taskStore.Load(testTaskID)\n\t\t\tExpect(ok).To(BeFalse())\n\t\t})\n\n\t\tIt(\"ignores jobs that are neither failed nor succeeded\", func() {\n\t\t\tjob := makeJob(\"job-8\", string(testTaskID))\n\t\t\t_, err := fakeKubeClient.BatchV1().\n\t\t\t\tJobs(\"test-ns\").\n\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandleJob(ctx, job)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\t\t\t// job still exists (not terminal)\n\t\t\t_, err = fakeKubeClient.BatchV1().Jobs(\"test-ns\").Get(ctx, \"job-8\", metav1.GetOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t})\n\n\t\tIt(\"uses pod_crash_no_stdout when condition has no message\", func() {\n\t\t\tjob := makeJob(\"job-7\", string(testTaskID), batchv1.JobCondition{\n\t\t\t\tType:   batchv1.JobFailed,\n\t\t\t\tStatus: corev1.ConditionTrue,\n\t\t\t})\n\t\t\t_, err := fakeKubeClient.BatchV1().\n\t\t\t\tJobs(\"test-ns\").\n\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandleJob(ctx, job)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n\t\t\tExpect(calledReason).To(Equal(\"pod_crash_no_stdout\"))\n\t\t})\n\t})\n\n\tDescribe(\"HandleJob with DeadlineExceeded\", func() {\n\t\tIt(\"maps DeadlineExceeded job condition to deadline_exceeded\", func() {\n\t\t\tjob := makeJob(\"job-deadline\", string(testTaskID), batchv1.JobCondition{\n\t\t\t\tType:    batchv1.JobFailed,\n\t\t\t\tStatus:  corev1.ConditionTrue,\n\t\t\t\tReason:  \"DeadlineExceeded\",\n\t\t\t\tMessage: \"Job was active longer than specified deadline\",\n\t\t\t})\n\t\t\t_, err := fakeKubeClient.BatchV1().\n\t\t\t\tJobs(\"test-ns\").\n\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandleJob(ctx, job)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n\t\t\tExpect(calledReason).To(Equal(\"deadline_exceeded\"))\n\t\t})\n\n\t\tIt(\"maps BackoffLimitExceeded job condition to deadline_exceeded\", func() {\n\t\t\tjob := makeJob(\"job-backoff\", string(testTaskID), batchv1.JobCondition{\n\t\t\t\tType:    batchv1.JobFailed,\n\t\t\t\tStatus:  corev1.ConditionTrue,\n\t\t\t\tReason:  \"BackoffLimitExceeded\",\n\t\t\t\tMessage: \"Job failed due to backoff limit\",\n\t\t\t})\n\t\t\t_, err := fakeKubeClient.BatchV1().\n\t\t\t\tJobs(\"test-ns\").\n\t\t\t\tCreate(ctx, job, metav1.CreateOptions{})\n\t\t\tExpect(err).To(BeNil())\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandleJob(ctx, job)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n\t\t\tExpect(calledReason).To(Equal(\"deadline_exceeded\"))\n\t\t})\n\t})\n\n\tDescribe(\"jobFailureReason mapping\", func() {\n\t\tIt(\"returns deadline_exceeded for DeadlineExceeded\", func() {\n\t\t\tjob := makeJob(\"j\", string(testTaskID), batchv1.JobCondition{\n\t\t\t\tType:   batchv1.JobFailed,\n\t\t\t\tStatus: corev1.ConditionTrue,\n\t\t\t\tReason: \"DeadlineExceeded\",\n\t\t\t})\n\t\t\tExpect(pkg.JobFailureReason(job)).To(Equal(pkg.ZombieReasonDeadlineExceeded))\n\t\t})\n\n\t\tIt(\"returns deadline_exceeded for BackoffLimitExceeded\", func() {\n\t\t\tjob := makeJob(\"j\", string(testTaskID), batchv1.JobCondition{\n\t\t\t\tType:   batchv1.JobFailed,\n\t\t\t\tStatus: corev1.ConditionTrue,\n\t\t\t\tReason: \"BackoffLimitExceeded\",\n\t\t\t})\n\t\t\tExpect(pkg.JobFailureReason(job)).To(Equal(pkg.ZombieReasonDeadlineExceeded))\n\t\t})\n\n\t\tIt(\"returns pod_crash_no_stdout for other Failed condition reasons\", func() {\n\t\t\tjob := makeJob(\"j\", string(testTaskID), batchv1.JobCondition{\n\t\t\t\tType:   batchv1.JobFailed,\n\t\t\t\tStatus: corev1.ConditionTrue,\n\t\t\t\tReason: \"\",\n\t\t\t})\n\t\t\tExpect(pkg.JobFailureReason(job)).To(Equal(pkg.ZombieReasonPodCrashNoStdout))\n\t\t})\n\t})\n\n\tDescribe(\"HandlePod\", func() {\n\t\tmakePod := func(name string, taskID string, phase corev1.PodPhase, containerStatuses []corev1.ContainerStatus, ownerRefs []metav1.OwnerReference, podStatusReason string) *corev1.Pod {\n\t\t\tlabels := map[string]string{}\n\t\t\tif taskID != \"\" {\n\t\t\t\tlabels[\"agent.benjamin-borbe.de/task-id\"] = taskID\n\t\t\t}\n\t\t\tpod := &corev1.Pod{\n\t\t\t\tObjectMeta: metav1.ObjectMeta{\n\t\t\t\t\tName:            name,\n\t\t\t\t\tNamespace:       \"test-ns\",\n\t\t\t\t\tLabels:          labels,\n\t\t\t\t\tOwnerReferences: ownerRefs,\n\t\t\t\t},\n\t\t\t\tStatus: corev1.PodStatus{\n\t\t\t\t\tPhase: phase,\n\t\t\t\t},\n\t\t\t}\n\t\t\tif len(containerStatuses) > 0 {\n\t\t\t\tpod.Status.ContainerStatuses = containerStatuses\n\t\t\t}\n\t\t\tif podStatusReason != \"\" {\n\t\t\t\tpod.Status.Reason = podStatusReason\n\t\t\t}\n\t\t\treturn pod\n\t\t}\n\n\t\tmakeJobOwnerRef := func(name string) []metav1.OwnerReference {\n\t\t\treturn []metav1.OwnerReference{\n\t\t\t\t{\n\t\t\t\t\tKind: \"Job\",\n\t\t\t\t\tName: name,\n\t\t\t\t},\n\t\t\t}\n\t\t}\n\n\t\tIt(\"publishes failure for ImagePullBackOff container\", func() {\n\t\t\tpod := makePod(\n\t\t\t\t\"pod-imgpull\",\n\t\t\t\tstring(testTaskID),\n\t\t\t\tcorev1.PodPending,\n\t\t\t\t[]corev1.ContainerStatus{\n\t\t\t\t\t{\n\t\t\t\t\t\tState: corev1.ContainerState{\n\t\t\t\t\t\t\tWaiting: &corev1.ContainerStateWaiting{\n\t\t\t\t\t\t\t\tReason: \"ImagePullBackOff\",\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n\t\t\t\t\"\",\n\t\t\t)\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandlePod(ctx, pod)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n\t\t\t_, _, calledJobName, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n\t\t\tExpect(calledJobName).To(Equal(\"my-job\"))\n\t\t\tExpect(calledReason).To(Equal(\"image_pull_backoff\"))\n\t\t})\n\n\t\tIt(\"publishes failure for ErrImagePull container\", func() {\n\t\t\tpod := makePod(\n\t\t\t\t\"pod-errimg\",\n\t\t\t\tstring(testTaskID),\n\t\t\t\tcorev1.PodPending,\n\t\t\t\t[]corev1.ContainerStatus{\n\t\t\t\t\t{\n\t\t\t\t\t\tState: corev1.ContainerState{\n\t\t\t\t\t\t\tWaiting: &corev1.ContainerStateWaiting{\n\t\t\t\t\t\t\t\tReason: \"ErrImagePull\",\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n\t\t\t\t\"\",\n\t\t\t)\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandlePod(ctx, pod)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n\t\t\tExpect(calledReason).To(Equal(\"image_pull_backoff\"))\n\t\t})\n\n\t\tIt(\"publishes failure for CrashLoopBackOff container\", func() {\n\t\t\tpod := makePod(\n\t\t\t\t\"pod-crashloop\",\n\t\t\t\tstring(testTaskID),\n\t\t\t\tcorev1.PodPending,\n\t\t\t\t[]corev1.ContainerStatus{\n\t\t\t\t\t{\n\t\t\t\t\t\tState: corev1.ContainerState{\n\t\t\t\t\t\t\tWaiting: &corev1.ContainerStateWaiting{\n\t\t\t\t\t\t\t\tReason: \"CrashLoopBackOff\",\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n\t\t\t\t\"\",\n\t\t\t)\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandlePod(ctx, pod)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n\t\t\t_, _, calledJobName, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n\t\t\tExpect(calledJobName).To(Equal(\"my-job\"))\n\t\t\tExpect(calledReason).To(Equal(\"pod_crash_no_stdout\"))\n\t\t})\n\n\t\tIt(\"publishes failure for Evicted pod\", func() {\n\t\t\tpod := makePod(\n\t\t\t\t\"pod-evicted\",\n\t\t\t\tstring(testTaskID),\n\t\t\t\tcorev1.PodPending,\n\t\t\t\tnil,\n\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n\t\t\t\t\"Evicted\",\n\t\t\t)\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandlePod(ctx, pod)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n\t\t\tExpect(calledReason).To(Equal(\"pod_evicted\"))\n\t\t})\n\n\t\tIt(\"publishes failure for PodFailed with non-zero exit code\", func() {\n\t\t\tpod := makePod(\n\t\t\t\t\"pod-crash\",\n\t\t\t\tstring(testTaskID),\n\t\t\t\tcorev1.PodFailed,\n\t\t\t\t[]corev1.ContainerStatus{\n\t\t\t\t\t{\n\t\t\t\t\t\tState: corev1.ContainerState{\n\t\t\t\t\t\t\tTerminated: &corev1.ContainerStateTerminated{\n\t\t\t\t\t\t\t\tExitCode: 137,\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n\t\t\t\t\"\",\n\t\t\t)\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandlePod(ctx, pod)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(1))\n\t\t\t_, _, _, calledReason := fakePublisher.PublishFailureArgsForCall(0)\n\t\t\tExpect(calledReason).To(Equal(\"pod_crash_no_stdout\"))\n\t\t})\n\n\t\tIt(\"does NOT publish failure for healthy Running pod\", func() {\n\t\t\tpod := makePod(\n\t\t\t\t\"pod-running\",\n\t\t\t\tstring(testTaskID),\n\t\t\t\tcorev1.PodRunning,\n\t\t\t\tnil,\n\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n\t\t\t\t\"\",\n\t\t\t)\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandlePod(ctx, pod)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\t\t})\n\n\t\tIt(\"does NOT publish failure when task is not in store\", func() {\n\t\t\tpod := makePod(\n\t\t\t\t\"pod-imgpull\",\n\t\t\t\tstring(testTaskID),\n\t\t\t\tcorev1.PodPending,\n\t\t\t\t[]corev1.ContainerStatus{\n\t\t\t\t\t{\n\t\t\t\t\t\tState: corev1.ContainerState{\n\t\t\t\t\t\t\tWaiting: &corev1.ContainerStateWaiting{\n\t\t\t\t\t\t\t\tReason: \"ImagePullBackOff\",\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t\tmakeJobOwnerRef(\"my-job\"),\n\t\t\t\t\"\",\n\t\t\t)\n\n\t\t\twatcher.HandlePod(ctx, pod)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\t\t})\n\n\t\tIt(\"does NOT publish failure when pod has no Job ownerRef\", func() {\n\t\t\tpod := makePod(\n\t\t\t\t\"pod-noowner\",\n\t\t\t\tstring(testTaskID),\n\t\t\t\tcorev1.PodPending,\n\t\t\t\t[]corev1.ContainerStatus{\n\t\t\t\t\t{\n\t\t\t\t\t\tState: corev1.ContainerState{\n\t\t\t\t\t\t\tWaiting: &corev1.ContainerStateWaiting{\n\t\t\t\t\t\t\t\tReason: \"ImagePullBackOff\",\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t},\n\t\t\t\t\t},\n\t\t\t\t},\n\t\t\t\tnil,\n\t\t\t\t\"\",\n\t\t\t)\n\t\t\ttaskStore.Store(testTaskID, testTask)\n\n\t\t\twatcher.HandlePod(ctx, pod)\n\n\t\t\tExpect(fakePublisher.PublishFailureCallCount()).To(Equal(0))\n\t\t})\n\t})\n})\n","numLines":513,"startLine":1,"totalLines":513}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-bd44573bf05aeac7","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"fmt\"\n10\t\t\"sync\"\n11\t\t\"time\"\n12\t\n13\t\tlib \"github.com/bborbe/agent\"\n14\t\ttaskcmd \"github.com/bborbe/agent/command/task\"\n15\t\t\"github.com/bborbe/cqrs/base\"\n16\t\tcdb \"github.com/bborbe/cqrs/cdb\"\n17\t\tcqrsiam \"github.com/bborbe/cqrs/iam\"\n18\t\t\"github.com/bborbe/errors\"\n19\t\tlibkafka \"github.com/bborbe/kafka\"\n20\t\t\"github.com/bborbe/log\"\n21\t\tlibtime \"github.com/bborbe/time\"\n22\t\t\"github.com/golang/glog\"\n23\t)\n24\t\n25\tconst (\n26\t\tdedupeCapacity = 1024\n27\t\tdedupeTTL      = 3600 * time.Second\n28\t)\n29\t\n30\t//counterfeiter:generate -o ../mocks/result_publisher.go --fake-name FakeResultPublisher . ResultPublisher\n31\t\n32\t// ResultPublisher publishes agent-task-v1-request commands to Kafka so the\n33\t// controller writes them to the vault task file.\n34\ttype ResultPublisher interface {\n35\t\t// PublishSpawnNotification publishes current_job, job_started_at, and\n36\t\t// spawn_notification without touching any other frontmatter keys.\n37\t\tPublishSpawnNotification(ctx context.Context, task lib.Task, jobName string) error\n38\t\t// PublishFailure publishes a zombie failure: clears current_job and atomically\n39\t\t// bumps trigger_count by 1 via a paired IncrementFrontmatterCommand. Leaves\n40\t\t// phase, status, and assignee untouched so the existing trigger_count retry\n41\t\t// cap (applyTriggerCap in task/controller/pkg/result/result_writer.go) handles\n42\t\t// eventual operator-inbox escalation. Idempotent per current_job via a TTL'd\n43\t\t// LRU; concurrent classifications for the same job emit one event.\n44\t\tPublishFailure(ctx context.Context, task lib.Task, jobName string, reason string) error\n45\t\t// PublishIncrementTriggerCount sends an IncrementFrontmatterCommand that atomically\n46\t\t// increments trigger_count by 1. Must complete before SpawnJob is called.\n47\t\tPublishIncrementTriggerCount(ctx context.Context, task lib.Task) error\n48\t\t// PublishSetTriggerScope sends an UpdateFrontmatterCommand that records a\n49\t\t// trigger_scope and sets trigger_count to count, in one atomic write. Called\n50\t\t// instead of PublishIncrementTriggerCount in the two cases where the scope\n51\t\t// itself has to be written:\n52\t\t//\n53\t\t//   - the scope CHANGED (count 1): a re-dispatch against a new phase or a new\n54\t\t//     ref starts from a fresh budget, counting the spawn about to happen.\n55\t\t//   - the scope was ABSENT (count = existing trigger_count + 1): the task\n56\t\t//     predates the field and adopts the current scope WITHOUT a budget reset.\n57\t\t//     Absent must not be treated as changed — every task in flight today has no\n58\t\t//     trigger_scope, so resetting on absence would hand each of them a free\n59\t\t//     budget on the first event after deploy, including one already at cap.\n60\t\t//\n61\t\t// This is an UpdateFrontmatterCommand rather than a result publish on purpose.\n62\t\t// trigger_count is controller-owned: the result writer's ownership guard\n63\t\t// (MergeFrontmatter in task/controller) discards any incoming counter value, so\n64\t\t// a reset routed through a result payload would be silently dropped. The atomic\n65\t\t// frontmatter commands take a different path (buildUpdateModifyFn), which applies\n66\t\t// Updates directly to the on-disk frontmatter — an explicit, intentional write\n67\t\t// rather than a stale spawn-time snapshot.\n68\t\tPublishSetTriggerScope(ctx context.Context, task lib.Task, scope string, count int) error\n69\t\t// PublishTypeMismatchFailure publishes a synthetic failure when the task's task_type\n70\t\t// is not in the agent's effective type set. Clears assignee and current_job so the\n71\t\t// task surfaces in the operator inbox via assignee==\"\" filter. Does not bump\n72\t\t// trigger_count or retry_count.\n73\t\tPublishTypeMismatchFailure(ctx context.Context, task lib.Task, reason string) error\n74\t\t// PublishRaw publishes a raw payload for testing error paths.\n75\t\tPublishRaw(ctx context.Context, operation base.CommandOperation, payload interface{}) error\n76\t}\n77\t\n78\t// NewResultPublisher creates a ResultPublisher.\n79\tfunc NewResultPublisher(\n80\t\tsyncProducer libkafka.SyncProducer,\n81\t\ttopicPrefix base.TopicPrefix,\n82\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n83\t) ResultPublisher {\n84\t\treturn &resultPublisher{\n85\t\t\tcommandObjectSender: cdb.NewCommandObjectSender(\n86\t\t\t\tsyncProducer,\n87\t\t\t\ttopicPrefix,\n88\t\t\t\tlog.DefaultSamplerFactory,\n89\t\t\t),\n90\t\t\tcurrentDateTime: currentDateTime,\n91\t\t\tdedupe:          newDedupe(dedupeCapacity, currentDateTime),\n92\t\t}\n93\t}\n94\t\n95\t// ttlDedupe implements a minimal TTL'd LRU with RWMutex for publish-layer dedupe.\n96\t// The eviction order is tracked via a separate []string so map lookups never\n97\t// hold stale slice indices after the oldest entry is shifted out.\n98\ttype ttlDedupe struct {\n99\t\tmu       sync.RWMutex\n100\t\tcapacity int\n101\t\tttl      time.Duration\n102\t\torder    []string             // insertion order; index 0 is oldest\n103\t\tseen     map[string]time.Time // jobName -> insertion ts; existence = \"in dedupe window\"\n104\t\tnow      libtime.CurrentDateTimeGetter\n105\t}\n106\t\n107\tfunc newDedupe(capacity int, now libtime.CurrentDateTimeGetter) *ttlDedupe {\n108\t\treturn &ttlDedupe{\n109\t\t\tcapacity: capacity,\n110\t\t\tttl:      dedupeTTL,\n111\t\t\torder:    make([]string, 0, capacity),\n112\t\t\tseen:     make(map[string]time.Time, capacity),\n113\t\t\tnow:      now,\n114\t\t}\n115\t}\n116\t\n117\t// checkDedupe returns true if a non-expired entry exists for jobName.\n118\t// No mutation occurs.\n119\tfunc (d *ttlDedupe) checkDedupe(jobName string) bool {\n120\t\td.mu.RLock()\n121\t\tdefer d.mu.RUnlock()\n122\t\tts, ok := d.seen[jobName]\n123\t\tif !ok {\n124\t\t\treturn false\n125\t\t}\n126\t\treturn d.now.Now().Time().Sub(ts) < d.ttl\n127\t}\n128\t\n129\t// recordDedupe inserts or refreshes the entry for jobName with the current timestamp.\n130\t// Evicts the oldest entry if at capacity.\n131\tfunc (d *ttlDedupe) recordDedupe(jobName string) {\n132\t\td.mu.Lock()\n133\t\tdefer d.mu.Unlock()\n134\t\tnow := d.now.Now().Time()\n135\t\tif _, ok := d.seen[jobName]; ok {\n136\t\t\td.seen[jobName] = now // refresh ts\n137\t\t\treturn\n138\t\t}\n139\t\tif len(d.order) >= d.capacity {\n140\t\t\toldest := d.order[0]\n141\t\t\td.order = d.order[1:]\n142\t\t\tdelete(d.seen, oldest)\n143\t\t}\n144\t\td.order = append(d.order, jobName)\n145\t\td.seen[jobName] = now\n146\t}\n147\t\n148\t// resultPublisher implements ResultPublisher by sending CQRS command objects to Kafka.\n149\ttype resultPublisher struct {\n150\t\tcommandObjectSender cdb.CommandObjectSender\n151\t\tcurrentDateTime     libtime.CurrentDateTimeGetter\n152\t\tdedupe              *ttlDedupe\n153\t}\n154\t\n155\tfunc (p *resultPublisher) PublishSpawnNotification(\n156\t\tctx context.Context,\n157\t\ttask lib.Task,\n158\t\tjobName string,\n159\t) error {\n160\t\tcmd := taskcmd.UpdateFrontmatterCommand{\n161\t\t\tTaskIdentifier: task.TaskIdentifier,\n162\t\t\tUpdates: lib.TaskFrontmatter{\n163\t\t\t\t\"spawn_notification\": true,\n164\t\t\t\t\"current_job\":        jobName,\n165\t\t\t\t\"job_started_at\":     p.currentDateTime.Now().UTC().Format(\"2006-01-02T15:04:05Z07:00\"),\n166\t\t\t},\n167\t\t}\n168\t\treturn p.publishRaw(ctx, taskcmd.UpdateFrontmatterCommandOperation, cmd)\n169\t}\n170\t\n171\tfunc (p *resultPublisher) PublishFailure(\n172\t\tctx context.Context,\n173\t\ttask lib.Task,\n174\t\tjobName string,\n175\t\treason string,\n176\t) error {\n177\t\tif p.dedupe.checkDedupe(jobName) {\n178\t\t\tglog.V(2).Infof(\"event=zombie_dedupe job=%s task=%s\", jobName, task.TaskIdentifier)\n179\t\t\treturn nil\n180\t\t}\n181\t\n182\t\tnow := p.currentDateTime.Now().UTC().Format(time.RFC3339)\n183\t\tsection := fmt.Sprintf(\n184\t\t\t\"## Failure\\n\\n- **Timestamp:** %s\\n- **Job:** %s\\n- **Reason:** %s\\n\",\n185\t\t\tnow,\n186\t\t\tjobName,\n187\t\t\treason,\n188\t\t)\n189\t\tupdateCmd := taskcmd.UpdateFrontmatterCommand{\n190\t\t\tTaskIdentifier: task.TaskIdentifier,\n191\t\t\tUpdates: lib.TaskFrontmatter{\n192\t\t\t\t\"current_job\": \"\",\n193\t\t\t},\n194\t\t\tBody: &taskcmd.BodySection{\n195\t\t\t\tHeading: \"## Failure\",\n196\t\t\t\tSection: section,\n197\t\t\t},\n198\t\t}\n199\t\tif err := p.publishRaw(ctx, taskcmd.UpdateFrontmatterCommandOperation, updateCmd); err != nil {\n200\t\t\treturn errors.Wrapf(\n201\t\t\t\tctx,\n202\t\t\t\terr,\n203\t\t\t\t\"publish zombie failure update for task %s\",\n204\t\t\t\ttask.TaskIdentifier,\n205\t\t\t)\n206\t\t}\n207\t\n208\t\tincrementCmd := taskcmd.IncrementFrontmatterCommand{\n209\t\t\tTaskIdentifier: task.TaskIdentifier,\n210\t\t\tField:          \"trigger_count\",\n211\t\t\tDelta:          1,\n212\t\t}\n213\t\tif err := p.publishRaw(ctx, taskcmd.IncrementFrontmatterCommandOperation, incrementCmd); err != nil {\n214\t\t\treturn errors.Wrapf(\n215\t\t\t\tctx,\n216\t\t\t\terr,\n217\t\t\t\t\"publish zombie failure trigger_count increment for task %s\",\n218\t\t\t\ttask.TaskIdentifier,\n219\t\t\t)\n220\t\t}\n221\t\n222\t\t// Record dedupe only after BOTH publishes succeed. If the increment fails,\n223\t\t// the next cycle re-sends both messages — the duplicate current_job=\"\"\n224\t\t// write is idempotent (writing empty to already-empty is a no-op visually),\n225\t\t// and the retry allows trigger_count to eventually bump so the retry cap\n226\t\t// (applyTriggerCap in result_writer.go) fires.\n227\t\tp.dedupe.recordDedupe(jobName)\n228\t\n229\t\treturn nil\n230\t}\n231\t\n232\tfunc (p *resultPublisher) PublishIncrementTriggerCount(ctx context.Context, task lib.Task) error {\n233\t\tcmd := taskcmd.IncrementFrontmatterCommand{\n234\t\t\tTaskIdentifier: task.TaskIdentifier,\n235\t\t\tField:          \"trigger_count\",\n236\t\t\tDelta:          1,\n237\t\t}\n238\t\treturn p.publishRaw(ctx, taskcmd.IncrementFrontmatterCommandOperation, cmd)\n239\t}\n240\t\n241\tfunc (p *resultPublisher) PublishSetTriggerScope(\n242\t\tctx context.Context,\n243\t\ttask lib.Task,\n244\t\tscope string,\n245\t\tcount int,\n246\t) error {\n247\t\tcmd := taskcmd.UpdateFrontmatterCommand{\n248\t\t\tTaskIdentifier: task.TaskIdentifier,\n249\t\t\tUpdates: lib.TaskFrontmatter{\n250\t\t\t\t\"trigger_scope\": scope,\n251\t\t\t\t// Never 0: this cycle is about to spawn, and that spawn must be counted\n252\t\t\t\t// in the same write. Writing 0 and relying on a follow-up increment\n253\t\t\t\t// would need two publishes for one spawn, which can interleave.\n254\t\t\t\t\"trigger_count\": count,\n255\t\t\t},\n256\t\t}\n257\t\tif err := p.publishRaw(ctx, taskcmd.UpdateFrontmatterCommandOperation, cmd); err != nil {\n258\t\t\treturn errors.Wrapf(\n259\t\t\t\tctx,\n260\t\t\t\terr,\n261\t\t\t\t\"publish set trigger scope for task %s\",\n262\t\t\t\ttask.TaskIdentifier,\n263\t\t\t)\n264\t\t}\n265\t\treturn nil\n266\t}\n267\t\n268\tfunc (p *resultPublisher) PublishTypeMismatchFailure(\n269\t\tctx context.Context,\n270\t\ttask lib.Task,\n271\t\treason string,\n272\t) error {\n273\t\tnow := p.currentDateTime.Now().UTC().Format(time.RFC3339)\n274\t\tpriorAssignee := string(task.Frontmatter.Assignee())\n275\t\tsection := fmt.Sprintf(\n276\t\t\t\"## Failure\\n\\n- **Timestamp:** %s\\n- **Assignee:** %s\\n- **Reason:** %s\\n\",\n277\t\t\tnow,\n278\t\t\tpriorAssignee,\n279\t\t\treason,\n280\t\t)\n281\t\n282\t\tupdates := lib.TaskFrontmatter{\n283\t\t\t\"assignee\":    \"\",\n284\t\t\t\"current_job\": \"\",\n285\t\t}\n286\t\tif priorAssignee != \"\" {\n287\t\t\tupdates[\"previous_assignee\"] = priorAssignee\n288\t\t}\n289\t\n290\t\tcmd := taskcmd.UpdateFrontmatterCommand{\n291\t\t\tTaskIdentifier: task.TaskIdentifier,\n292\t\t\tUpdates:        updates,\n293\t\t\tBody: &taskcmd.BodySection{\n294\t\t\t\tHeading: \"## Failure\",\n295\t\t\t\tSection: section,\n296\t\t\t},\n297\t\t}\n298\t\tif err := p.publishRaw(ctx, taskcmd.UpdateFrontmatterCommandOperation, cmd); err != nil {\n299\t\t\treturn errors.Wrapf(\n300\t\t\t\tctx,\n301\t\t\t\terr,\n302\t\t\t\t\"publish type mismatch failure for task %s\",\n303\t\t\t\ttask.TaskIdentifier,\n304\t\t\t)\n305\t\t}\n306\t\treturn nil\n307\t}\n308\t\n309\tfunc (p *resultPublisher) publishRaw(\n310\t\tctx context.Context,\n311\t\toperation base.CommandOperation,\n312\t\tpayload interface{},\n313\t) error {\n314\t\tevent, err := base.ParseEvent(ctx, payload)\n315\t\tif err != nil {\n316\t\t\treturn errors.Wrapf(ctx, err, \"parse event for operation %s\", operation)\n317\t\t}\n318\t\n319\t\trequestIDCh := make(chan base.RequestID, 1)\n320\t\trequestIDCh <- base.NewRequestID()\n321\t\tcommandCreator := base.NewCommandCreator(requestIDCh)\n322\t\tcommandObject := cdb.CommandObject{\n323\t\t\tCommand: commandCreator.NewCommand(\n324\t\t\t\toperation,\n325\t\t\t\tcqrsiam.Initiator(\"executor\"),\n326\t\t\t\t\"\",\n327\t\t\t\tevent,\n328\t\t\t),\n329\t\t\tSchemaID: lib.TaskV1SchemaID,\n330\t\t}\n331\t\tif err := p.commandObjectSender.SendCommandObject(ctx, commandObject); err != nil {\n332\t\t\treturn errors.Wrapf(ctx, err, \"send command for operation %s\", operation)\n333\t\t}\n334\t\treturn nil\n335\t}\n336\t\n337\t// PublishRaw exposes publishRaw for testing error path coverage.\n338\tfunc (p *resultPublisher) PublishRaw(\n339\t\tctx context.Context,\n340\t\toperation base.CommandOperation,\n341\t\tpayload interface{},\n342\t) error {\n343\t\treturn p.publishRaw(ctx, operation, payload)\n344\t}\n345\t"}]},"parent_tool_use_id":null,"session_id":"66607f9a-fb74-4a6f-9e0e-f3ec5b2597d7","uuid":"1d4b4bcf-619c-4c9c-80ae-df9bd80dd6c9","timestamp":"2026-08-31T22:03:37.924Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/result_publisher.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage pkg\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"sync\"\n\t\"time\"\n\n\tlib \"github.com/bborbe/agent\"\n\ttaskcmd \"github.com/bborbe/agent/command/task\"\n\t\"github.com/bborbe/cqrs/base\"\n\tcdb \"github.com/bborbe/cqrs/cdb\"\n\tcqrsiam \"github.com/bborbe/cqrs/iam\"\n\t\"github.com/bborbe/errors\"\n\tlibkafka \"github.com/bborbe/kafka\"\n\t\"github.com/bborbe/log\"\n\tlibtime \"github.com/bborbe/time\"\n\t\"github.com/golang/glog\"\n)\n\nconst (\n\tdedupeCapacity = 1024\n\tdedupeTTL      = 3600 * time.Second\n)\n\n//counterfeiter:generate -o ../mocks/result_publisher.go --fake-name FakeResultPublisher . ResultPublisher\n\n// ResultPublisher publishes agent-task-v1-request commands to Kafka so the\n// controller writes them to the vault task file.\ntype ResultPublisher interface {\n\t// PublishSpawnNotification publishes current_job, job_started_at, and\n\t// spawn_notification without touching any other frontmatter keys.\n\tPublishSpawnNotification(ctx context.Context, task lib.Task, jobName string) error\n\t// PublishFailure publishes a zombie failure: clears current_job and atomically\n\t// bumps trigger_count by 1 via a paired IncrementFrontmatterCommand. Leaves\n\t// phase, status, and assignee untouched so the existing trigger_count retry\n\t// cap (applyTriggerCap in task/controller/pkg/result/result_writer.go) handles\n\t// eventual operator-inbox escalation. Idempotent per current_job via a TTL'd\n\t// LRU; concurrent classifications for the same job emit one event.\n\tPublishFailure(ctx context.Context, task lib.Task, jobName string, reason string) error\n\t// PublishIncrementTriggerCount sends an IncrementFrontmatterCommand that atomically\n\t// increments trigger_count by 1. Must complete before SpawnJob is called.\n\tPublishIncrementTriggerCount(ctx context.Context, task lib.Task) error\n\t// PublishSetTriggerScope sends an UpdateFrontmatterCommand that records a\n\t// trigger_scope and sets trigger_count to count, in one atomic write. Called\n\t// instead of PublishIncrementTriggerCount in the two cases where the scope\n\t// itself has to be written:\n\t//\n\t//   - the scope CHANGED (count 1): a re-dispatch against a new phase or a new\n\t//     ref starts from a fresh budget, counting the spawn about to happen.\n\t//   - the scope was ABSENT (count = existing trigger_count + 1): the task\n\t//     predates the field and adopts the current scope WITHOUT a budget reset.\n\t//     Absent must not be treated as changed — every task in flight today has no\n\t//     trigger_scope, so resetting on absence would hand each of them a free\n\t//     budget on the first event after deploy, including one already at cap.\n\t//\n\t// This is an UpdateFrontmatterCommand rather than a result publish on purpose.\n\t// trigger_count is controller-owned: the result writer's ownership guard\n\t// (MergeFrontmatter in task/controller) discards any incoming counter value, so\n\t// a reset routed through a result payload would be silently dropped. The atomic\n\t// frontmatter commands take a different path (buildUpdateModifyFn), which applies\n\t// Updates directly to the on-disk frontmatter — an explicit, intentional write\n\t// rather than a stale spawn-time snapshot.\n\tPublishSetTriggerScope(ctx context.Context, task lib.Task, scope string, count int) error\n\t// PublishTypeMismatchFailure publishes a synthetic failure when the task's task_type\n\t// is not in the agent's effective type set. Clears assignee and current_job so the\n\t// task surfaces in the operator inbox via assignee==\"\" filter. Does not bump\n\t// trigger_count or retry_count.\n\tPublishTypeMismatchFailure(ctx context.Context, task lib.Task, reason string) error\n\t// PublishRaw publishes a raw payload for testing error paths.\n\tPublishRaw(ctx context.Context, operation base.CommandOperation, payload interface{}) error\n}\n\n// NewResultPublisher creates a ResultPublisher.\nfunc NewResultPublisher(\n\tsyncProducer libkafka.SyncProducer,\n\ttopicPrefix base.TopicPrefix,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n) ResultPublisher {\n\treturn &resultPublisher{\n\t\tcommandObjectSender: cdb.NewCommandObjectSender(\n\t\t\tsyncProducer,\n\t\t\ttopicPrefix,\n\t\t\tlog.DefaultSamplerFactory,\n\t\t),\n\t\tcurrentDateTime: currentDateTime,\n\t\tdedupe:          newDedupe(dedupeCapacity, currentDateTime),\n\t}\n}\n\n// ttlDedupe implements a minimal TTL'd LRU with RWMutex for publish-layer dedupe.\n// The eviction order is tracked via a separate []string so map lookups never\n// hold stale slice indices after the oldest entry is shifted out.\ntype ttlDedupe struct {\n\tmu       sync.RWMutex\n\tcapacity int\n\tttl      time.Duration\n\torder    []string             // insertion order; index 0 is oldest\n\tseen     map[string]time.Time // jobName -> insertion ts; existence = \"in dedupe window\"\n\tnow      libtime.CurrentDateTimeGetter\n}\n\nfunc newDedupe(capacity int, now libtime.CurrentDateTimeGetter) *ttlDedupe {\n\treturn &ttlDedupe{\n\t\tcapacity: capacity,\n\t\tttl:      dedupeTTL,\n\t\torder:    make([]string, 0, capacity),\n\t\tseen:     make(map[string]time.Time, capacity),\n\t\tnow:      now,\n\t}\n}\n\n// checkDedupe returns true if a non-expired entry exists for jobName.\n// No mutation occurs.\nfunc (d *ttlDedupe) checkDedupe(jobName string) bool {\n\td.mu.RLock()\n\tdefer d.mu.RUnlock()\n\tts, ok := d.seen[jobName]\n\tif !ok {\n\t\treturn false\n\t}\n\treturn d.now.Now().Time().Sub(ts) < d.ttl\n}\n\n// recordDedupe inserts or refreshes the entry for jobName with the current timestamp.\n// Evicts the oldest entry if at capacity.\nfunc (d *ttlDedupe) recordDedupe(jobName string) {\n\td.mu.Lock()\n\tdefer d.mu.Unlock()\n\tnow := d.now.Now().Time()\n\tif _, ok := d.seen[jobName]; ok {\n\t\td.seen[jobName] = now // refresh ts\n\t\treturn\n\t}\n\tif len(d.order) >= d.capacity {\n\t\toldest := d.order[0]\n\t\td.order = d.order[1:]\n\t\tdelete(d.seen, oldest)\n\t}\n\td.order = append(d.order, jobName)\n\td.seen[jobName] = now\n}\n\n// resultPublisher implements ResultPublisher by sending CQRS command objects to Kafka.\ntype resultPublisher struct {\n\tcommandObjectSender cdb.CommandObjectSender\n\tcurrentDateTime     libtime.CurrentDateTimeGetter\n\tdedupe              *ttlDedupe\n}\n\nfunc (p *resultPublisher) PublishSpawnNotification(\n\tctx context.Context,\n\ttask lib.Task,\n\tjobName string,\n) error {\n\tcmd := taskcmd.UpdateFrontmatterCommand{\n\t\tTaskIdentifier: task.TaskIdentifier,\n\t\tUpdates: lib.TaskFrontmatter{\n\t\t\t\"spawn_notification\": true,\n\t\t\t\"current_job\":        jobName,\n\t\t\t\"job_started_at\":     p.currentDateTime.Now().UTC().Format(\"2006-01-02T15:04:05Z07:00\"),\n\t\t},\n\t}\n\treturn p.publishRaw(ctx, taskcmd.UpdateFrontmatterCommandOperation, cmd)\n}\n\nfunc (p *resultPublisher) PublishFailure(\n\tctx context.Context,\n\ttask lib.Task,\n\tjobName string,\n\treason string,\n) error {\n\tif p.dedupe.checkDedupe(jobName) {\n\t\tglog.V(2).Infof(\"event=zombie_dedupe job=%s task=%s\", jobName, task.TaskIdentifier)\n\t\treturn nil\n\t}\n\n\tnow := p.currentDateTime.Now().UTC().Format(time.RFC3339)\n\tsection := fmt.Sprintf(\n\t\t\"## Failure\\n\\n- **Timestamp:** %s\\n- **Job:** %s\\n- **Reason:** %s\\n\",\n\t\tnow,\n\t\tjobName,\n\t\treason,\n\t)\n\tupdateCmd := taskcmd.UpdateFrontmatterCommand{\n\t\tTaskIdentifier: task.TaskIdentifier,\n\t\tUpdates: lib.TaskFrontmatter{\n\t\t\t\"current_job\": \"\",\n\t\t},\n\t\tBody: &taskcmd.BodySection{\n\t\t\tHeading: \"## Failure\",\n\t\t\tSection: section,\n\t\t},\n\t}\n\tif err := p.publishRaw(ctx, taskcmd.UpdateFrontmatterCommandOperation, updateCmd); err != nil {\n\t\treturn errors.Wrapf(\n\t\t\tctx,\n\t\t\terr,\n\t\t\t\"publish zombie failure update for task %s\",\n\t\t\ttask.TaskIdentifier,\n\t\t)\n\t}\n\n\tincrementCmd := taskcmd.IncrementFrontmatterCommand{\n\t\tTaskIdentifier: task.TaskIdentifier,\n\t\tField:          \"trigger_count\",\n\t\tDelta:          1,\n\t}\n\tif err := p.publishRaw(ctx, taskcmd.IncrementFrontmatterCommandOperation, incrementCmd); err != nil {\n\t\treturn errors.Wrapf(\n\t\t\tctx,\n\t\t\terr,\n\t\t\t\"publish zombie failure trigger_count increment for task %s\",\n\t\t\ttask.TaskIdentifier,\n\t\t)\n\t}\n\n\t// Record dedupe only after BOTH publishes succeed. If the increment fails,\n\t// the next cycle re-sends both messages — the duplicate current_job=\"\"\n\t// write is idempotent (writing empty to already-empty is a no-op visually),\n\t// and the retry allows trigger_count to eventually bump so the retry cap\n\t// (applyTriggerCap in result_writer.go) fires.\n\tp.dedupe.recordDedupe(jobName)\n\n\treturn nil\n}\n\nfunc (p *resultPublisher) PublishIncrementTriggerCount(ctx context.Context, task lib.Task) error {\n\tcmd := taskcmd.IncrementFrontmatterCommand{\n\t\tTaskIdentifier: task.TaskIdentifier,\n\t\tField:          \"trigger_count\",\n\t\tDelta:          1,\n\t}\n\treturn p.publishRaw(ctx, taskcmd.IncrementFrontmatterCommandOperation, cmd)\n}\n\nfunc (p *resultPublisher) PublishSetTriggerScope(\n\tctx context.Context,\n\ttask lib.Task,\n\tscope string,\n\tcount int,\n) error {\n\tcmd := taskcmd.UpdateFrontmatterCommand{\n\t\tTaskIdentifier: task.TaskIdentifier,\n\t\tUpdates: lib.TaskFrontmatter{\n\t\t\t\"trigger_scope\": scope,\n\t\t\t// Never 0: this cycle is about to spawn, and that spawn must be counted\n\t\t\t// in the same write. Writing 0 and relying on a follow-up increment\n\t\t\t// would need two publishes for one spawn, which can interleave.\n\t\t\t\"trigger_count\": count,\n\t\t},\n\t}\n\tif err := p.publishRaw(ctx, taskcmd.UpdateFrontmatterCommandOperation, cmd); err != nil {\n\t\treturn errors.Wrapf(\n\t\t\tctx,\n\t\t\terr,\n\t\t\t\"publish set trigger scope for task %s\",\n\t\t\ttask.TaskIdentifier,\n\t\t)\n\t}\n\treturn nil\n}\n\nfunc (p *resultPublisher) PublishTypeMismatchFailure(\n\tctx context.Context,\n\ttask lib.Task,\n\treason string,\n) error {\n\tnow := p.currentDateTime.Now().UTC().Format(time.RFC3339)\n\tpriorAssignee := string(task.Frontmatter.Assignee())\n\tsection := fmt.Sprintf(\n\t\t\"## Failure\\n\\n- **Timestamp:** %s\\n- **Assignee:** %s\\n- **Reason:** %s\\n\",\n\t\tnow,\n\t\tpriorAssignee,\n\t\treason,\n\t)\n\n\tupdates := lib.TaskFrontmatter{\n\t\t\"assignee\":    \"\",\n\t\t\"current_job\": \"\",\n\t}\n\tif priorAssignee != \"\" {\n\t\tupdates[\"previous_assignee\"] = priorAssignee\n\t}\n\n\tcmd := taskcmd.UpdateFrontmatterCommand{\n\t\tTaskIdentifier: task.TaskIdentifier,\n\t\tUpdates:        updates,\n\t\tBody: &taskcmd.BodySection{\n\t\t\tHeading: \"## Failure\",\n\t\t\tSection: section,\n\t\t},\n\t}\n\tif err := p.publishRaw(ctx, taskcmd.UpdateFrontmatterCommandOperation, cmd); err != nil {\n\t\treturn errors.Wrapf(\n\t\t\tctx,\n\t\t\terr,\n\t\t\t\"publish type mismatch failure for task %s\",\n\t\t\ttask.TaskIdentifier,\n\t\t)\n\t}\n\treturn nil\n}\n\nfunc (p *resultPublisher) publishRaw(\n\tctx context.Context,\n\toperation base.CommandOperation,\n\tpayload interface{},\n) error {\n\tevent, err := base.ParseEvent(ctx, payload)\n\tif err != nil {\n\t\treturn errors.Wrapf(ctx, err, \"parse event for operation %s\", operation)\n\t}\n\n\trequestIDCh := make(chan base.RequestID, 1)\n\trequestIDCh <- base.NewRequestID()\n\tcommandCreator := base.NewCommandCreator(requestIDCh)\n\tcommandObject := cdb.CommandObject{\n\t\tCommand: commandCreator.NewCommand(\n\t\t\toperation,\n\t\t\tcqrsiam.Initiator(\"executor\"),\n\t\t\t\"\",\n\t\t\tevent,\n\t\t),\n\t\tSchemaID: lib.TaskV1SchemaID,\n\t}\n\tif err := p.commandObjectSender.SendCommandObject(ctx, commandObject); err != nil {\n\t\treturn errors.Wrapf(ctx, err, \"send command for operation %s\", operation)\n\t}\n\treturn nil\n}\n\n// PublishRaw exposes publishRaw for testing error path coverage.\nfunc (p *resultPublisher) PublishRaw(\n\tctx context.Context,\n\toperation base.CommandOperation,\n\tpayload interface{},\n) error {\n\treturn p.publishRaw(ctx, operation, payload)\n}\n","numLines":345,"startLine":1,"totalLines":345}}}
